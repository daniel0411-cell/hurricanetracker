---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import { articleSchema, faqSchema, graph, websiteSchema } from "../lib/schema";

const title = "About HurricaneHub";
const description = "Learn about HurricaneHub's mission to provide accurate hurricane tracking, emergency preparedness guidance, and NOAA/NHC source transparency.";
const url = `${site.url}/about/`;
const lastModified = site.contentLastModified;
const pageFaqs = [
  {
    question: "Where does HurricaneHub get hurricane information?",
    answer:
      "HurricaneHub organizes public information from NOAA, the National Hurricane Center, the National Weather Service, RainViewer, NOAA-linked satellite services, and related public weather data providers. Official NHC, NWS, and local emergency management sources should be treated as authoritative."
  },
  {
    question: "How quickly can live storm and alert information change?",
    answer:
      "NHC advisories follow the schedule set by the storm situation, while NWS alerts can update at any time. HurricaneHub caches public feeds briefly for performance, so users should refresh during active threats and verify urgent decisions with official sources."
  },
  {
    question: "Does HurricaneHub issue forecasts or evacuation orders?",
    answer:
      "No. HurricaneHub does not issue forecasts, warnings, evacuation orders, shelter rules, rescue instructions, or road-closure guidance. It turns public data and preparedness information into easier navigation and planning prompts."
  },
  {
    question: "What should I check before making a life-safety decision?",
    answer:
      "Check the latest NHC advisory for storm position and hazards, the NWS alert for your county or zone, and your local emergency management instructions for evacuation zones, shelters, bridges, and road conditions."
  }
];
const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title, description, url, dateModified: lastModified }),
  faqSchema(pageFaqs)
);
---
<Layout title={title} description={description} canonical={url} jsonLd={jsonLd} lastModified={lastModified}>
  <section class="band" aria-labelledby="about-title">
    <div class="inner">
      <p class="eyebrow">Mission and source transparency</p>
      <h1 id="about-title">About HurricaneHub</h1>
      <p class="answer">HurricaneHub helps people track hurricanes, understand official alerts, and prepare earlier using NOAA, National Hurricane Center, and National Weather Service public data.</p>
    </div>
  </section>

  <section class="band" aria-labelledby="mission-heading">
    <div class="inner grid-2">
      <article class="panel">
        <h2 id="mission-heading">Our Mission</h2>
        <h3>Accurate Tracking</h3>
        <p>We organize official storm and alert feeds into readable decision support for North American coastal households.</p>
        <h3>Preparedness Guidance</h3>
        <p>We emphasize checklists, decision levels, and practical timing so users can prepare before watches become warnings.</p>
      </article>
      <article class="panel">
        <h2>Data Sources</h2>
        <p>HurricaneHub uses NOAA, National Hurricane Center, National Weather Service, RainViewer radar, and NOAA-linked GOES satellite imagery made available through public data services. This site is not affiliated with NOAA, NHC, NWS, RainViewer, or Iowa State Mesonet and does not replace official emergency instructions.</p>
        <h3>Radar and Satellite Sources</h3>
        <p>The radar page uses RainViewer public radar tiles and GOES-East infrared satellite tiles served by Iowa State Mesonet from NOAA satellite data. These visual layers are for situational awareness only.</p>
      </article>
    </div>
  </section>

  <section class="band" aria-labelledby="methodology-heading">
    <div class="inner">
      <p class="eyebrow">How the site is organized</p>
      <h2 id="methodology-heading">HurricaneHub Methodology</h2>
      <div class="grid-3 section-grid">
        <article class="panel">
          <h3>Official Data First</h3>
          <p>Live storm and alert pages begin with public NHC and NWS data, then add plain-language context so users know which official source to verify before acting.</p>
          <a href="/hurricane-tracker/live/">Open live tracker</a>
        </article>
        <article class="panel">
          <h3>Local Context Second</h3>
          <p>State and city pages help connect broad storm information with local surge, flooding, evacuation-route, bridge, outage, and alert considerations.</p>
          <a href="/hurricane-tracker/city/">Browse city trackers</a>
        </article>
        <article class="panel">
          <h3>Decision Tools Last</h3>
          <p>Tools turn alert language and household details into planning prompts, while preserving the rule that official local instructions control life-safety decisions.</p>
          <a href="/tools/">Browse hurricane tools</a>
        </article>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="coverage-heading">
    <div class="inner grid-2">
      <article>
        <p class="eyebrow">Coverage</p>
        <h2 id="coverage-heading">What HurricaneHub Covers</h2>
        <p class="answer">The site focuses on North American Atlantic and Gulf hurricane risk: active NHC storm context, NWS alerts, state trackers, city trackers, preparedness tools, and plain-language learning pages.</p>
        <ul class="check-list">
          <li><a href="/tracker/">State hurricane trackers</a></li>
          <li><a href="/hurricane-tracker/storm/">Named hurricane trackers</a></li>
          <li><a href="/learn/">Hurricane learning center</a></li>
          <li><a href="/blog/">Preparedness and warning guides</a></li>
          <li><a href="/site-map/">Full HurricaneHub site map</a></li>
        </ul>
      </article>
      <article class="panel">
        <h2>What HurricaneHub Does Not Do</h2>
        <p>HurricaneHub does not issue forecasts, evacuation orders, shelter rules, road-closure instructions, rescue guidance, or official emergency alerts. It organizes public data and planning resources so users can reach official sources faster.</p>
      </article>
    </div>
  </section>

  <section class="band" aria-labelledby="source-check-heading">
    <div class="inner">
      <p class="eyebrow">Source checking</p>
      <h2 id="source-check-heading">How To Verify HurricaneHub Information</h2>
      <div class="grid-3 section-grid">
        <article class="panel">
          <h3>Storm Track and Intensity</h3>
          <p>Use HurricaneHub to find the current storm page, then verify the latest advisory, cone, wind field, and discussion with the National Hurricane Center before relying on storm position or intensity.</p>
          <a href="/hurricane-tracker/storm/">Open storm trackers</a>
        </article>
        <article class="panel">
          <h3>Local Watches and Warnings</h3>
          <p>Use state, city, and alert pages to see active hazards, then confirm your county or zone wording directly with National Weather Service alerts and local emergency management.</p>
          <a href="/alerts/">Check active alerts</a>
        </article>
        <article class="panel">
          <h3>Household Decisions</h3>
          <p>Use tools for planning prompts, not official orders. Evacuation zones, shelters, bridges, school closures, and rescue guidance come from county and city authorities.</p>
          <a href="/tools/evacuation-decision-helper/">Open evacuation helper</a>
        </article>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="freshness-heading">
    <div class="inner grid-2">
      <article>
        <p class="eyebrow">Freshness and limits</p>
        <h2 id="freshness-heading">Data Freshness, Caching, and Safety Limits</h2>
        <p class="answer">Weather information can change faster than any website can summarize it. HurricaneHub uses short-lived public feed caching so pages load quickly during high-interest periods, but a cached page can still be behind the newest official advisory or alert.</p>
        <p>During an active threat, refresh the page, check the timestamp shown by the source when available, and compare the page with official NHC advisories, NWS alerts, and local emergency management instructions before acting.</p>
      </article>
      <article class="panel">
        <h3>Editorial Principles</h3>
        <ul class="check-list">
          <li>Official source language is prioritized over social posts or model speculation.</li>
          <li>Preparedness guidance avoids promising safety or predicting exact local impacts.</li>
          <li>Decision tools show planning prompts, not official evacuation instructions.</li>
          <li>Pages link onward to live trackers, city context, alerts, and preparedness tools.</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="band" aria-labelledby="about-faq-heading">
    <div class="inner stack">
      <h2 id="about-faq-heading">About HurricaneHub FAQ</h2>
      {pageFaqs.map((faq) => (
        <article class="faq-item">
          <h3>{faq.question}</h3>
          <p>{faq.answer}</p>
        </article>
      ))}
    </div>
  </section>
</Layout>
