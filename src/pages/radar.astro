---
import FaqBlock from "../components/FaqBlock.astro";
import StormCard from "../components/StormCard.astro";
import Layout from "../layouts/Layout.astro";
import { faqs, site, states } from "../data/site";
import { articleSchema, faqSchema, graph, howToSchema, itemListSchema, websiteSchema } from "../lib/schema";

const title = "Hurricane Map: Live Radar, Satellite & NHC Tracks";
const description = "Use the live hurricane map to compare NHC storm tracks, current positions, radar, satellite imagery, and forecast layers with official advisory updates.";
const url = `${site.url}/radar/`;
const lastModified = site.contentLastModified;
const radarNextPaths = [
  {
    name: "Open the live hurricane tracker",
    href: "/hurricane-tracker/live/",
    description: "Compare radar and satellite context with current NHC storm position, advisory links, and storm tracker shortcuts."
  },
  {
    name: "Check active NWS alerts",
    href: "/alerts/",
    description: "Use official watch, warning, surge, flood, and tornado alert language before changing household plans."
  },
  {
    name: "Find a city hurricane tracker",
    href: "/hurricane-tracker/city/",
    description: "Move from map context to local surge, flooding, route, bridge, outage, and evacuation considerations."
  },
  {
    name: "Decode alert action language",
    href: "/tools/alert-action-decoder/",
    description: "Translate watches, warnings, flood alerts, surge alerts, and evacuation wording into planning prompts."
  },
  {
    name: "Compare storm distance",
    href: "/tools/storm-distance-calculator/",
    description: "Compare a ZIP code with current storm coordinates while keeping distance-only context in perspective."
  },
  {
    name: "Read the radar vs satellite guide",
    href: "/blog/hurricane-radar-vs-satellite/",
    description: "Learn when radar, satellite, forecast, and wind layers answer different hurricane tracking questions."
  }
];
const pageFaqs = [
  {
    question: "What does the HurricaneHub radar page show?",
    answer:
      "It shows RainViewer precipitation radar, an interactive GOES-East GeoColor true-color satellite layer and VIIRS infrared cloud-top temperature, a high-resolution NOAA GOES-East full-disk preview, the NCEP HRRR forecast radar layer, a server-key wind layer, current NHC storm markers when available, and a state-level NWS alert panel for decision context."
  },
  {
    question: "How often should I refresh the radar and alerts?",
    answer:
      "Radar frames and alerts can change quickly. Use the refresh button, then verify important decisions with official NHC advisories, weather.gov alerts, and local emergency management."
  },
  {
    question: "Should I use hurricane radar or satellite first?",
    answer:
      "Use satellite first when a tropical system is far offshore or organizing over open water, then use radar when rain bands move within range of coastal radar sites. For household decisions, pair both layers with NWS alerts and local evacuation guidance."
  },
  {
    question: "What should I do after seeing hurricane rain bands on radar?",
    answer:
      "Check whether your state or county has active NWS alerts, review your nearest city tracker, then move from monitoring to preparation or evacuation planning if official warnings, surge risk, or local orders apply."
  },
  ...faqs
];
const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title, description, url, dateModified: lastModified }),
  howToSchema({
    name: "How to use hurricane radar and satellite before making a local decision",
    description:
      "A practical sequence for comparing live radar, satellite, storm markers, and NWS alerts before choosing a household hurricane action.",
    url,
    steps: [
      {
        name: "Start with satellite for storm structure",
        text: "Open the satellite layer when the storm is offshore to inspect cloud organization, eye structure, and broad tropical moisture."
      },
      {
        name: "Switch to radar near land",
        text: "Use the radar layer when rain bands approach coastal radar coverage to see precipitation timing and squall-line movement."
      },
      {
        name: "Check active NWS alerts",
        text: "Load your state alerts and treat watches, warnings, surge alerts, flood alerts, and evacuation language as the decision anchor."
      },
      {
        name: "Move to a local plan",
        text: "Open the city tracker or household planning tools to translate the map view into monitoring, preparation, action, or evacuation steps."
      }
    ]
  }),
  itemListSchema(radarNextPaths.map((path) => ({
    name: path.name,
    description: path.description,
    url: `${site.url}${path.href}`
  }))),
  faqSchema(pageFaqs)
);
---
<Layout title={title} description={description} canonical={url} jsonLd={jsonLd} lastModified={lastModified}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://cdn.star.nesdis.noaa.gov" crossorigin />
    <link rel="preconnect" href="https://gibs.earthdata.nasa.gov" crossorigin />
    <link rel="preconnect" href="https://{s}.tile.openstreetmap.org" />
    <link rel="preconnect" href="https://{s}.basemaps.cartocdn.com" />
    <link rel="preconnect" href="https://mesonet.agron.iastate.edu" crossorigin />
    <link rel="preconnect" href="https://tile.openweathermap.org" crossorigin />
    <link rel="preconnect" href="https://api.weather.gov" crossorigin />
    <link rel="preconnect" href="https://api.rainviewer.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
  </Fragment>
  <section class="radar-page" aria-labelledby="radar-title">
    <div class="bg-red-100 p-2 text-center text-sm radar-warning">
      ⚠️ Data sourced from NOAA/RainViewer. Not for life-critical decisions. Visit <a href="https://www.weather.gov/">weather.gov</a>.
    </div>

    <div class="radar-intro">
      <p class="eyebrow">Live radar and satellite</p>
      <h1 id="radar-title">Hurricane Radar</h1>
      <p class="answer">This page shows a live hurricane radar feed and NOAA GOES-East satellite preview for the North Atlantic so users can compare precipitation, cloud organization, and storm context before checking official NOAA/NWS alerts.</p>
    </div>

    <section class="radar-stage" aria-label="Interactive North Atlantic map">
      <div class="radar-toolbar" aria-label="Radar layer controls">
        <div class="radar-toolbar-cluster">
          <div class="layer-toggle" role="group" aria-label="Map layer">
            <button type="button" class="layer-button active" data-layer="radar" aria-pressed="true">
              <i class="fa-solid fa-cloud-showers-heavy" aria-hidden="true"></i>
              <span>Radar</span>
            </button>
            <button type="button" class="layer-button" data-layer="satellite" aria-pressed="false">
              <i class="fa-solid fa-satellite-dish" aria-hidden="true"></i>
              <span>Satellite</span>
            </button>
            <button type="button" class="layer-button" data-layer="forecast" aria-pressed="false">
              <i class="fa-solid fa-bolt-lightning" aria-hidden="true"></i>
              <span>Forecast</span>
            </button>
            <button type="button" class="layer-button" data-layer="wind" aria-pressed="false">
              <i class="fa-solid fa-wind" aria-hidden="true"></i>
              <span>Wind</span>
            </button>
          </div>
          <div class="layer-toggle fema-toggle" role="group" aria-label="FEMA flood overlay">
            <button type="button" class="fema-button" id="fema-toggle" data-fema="on" aria-pressed="false">
              <i class="fa-solid fa-water" aria-hidden="true"></i>
              <span>FEMA Flood</span>
            </button>
          </div>
          <div class="layer-toggle" role="group" aria-label="Map theme">
            <button type="button" class="theme-button active" data-theme="light" aria-pressed="true">
              <i class="fa-solid fa-sun" aria-hidden="true"></i>
              <span>Light</span>
            </button>
            <button type="button" class="theme-button" data-theme="dark" aria-pressed="false">
              <i class="fa-solid fa-moon" aria-hidden="true"></i>
              <span>Dark</span>
            </button>
          </div>
          <div class="layer-toggle radar-schemes" role="group" aria-label="Radar color scheme">
            <button type="button" class="scheme-button active" data-scheme="2" aria-pressed="true" title="Standard">Std</button>
            <button type="button" class="scheme-button" data-scheme="0" aria-pressed="false" title="Monochrome">Mono</button>
            <button type="button" class="scheme-button" data-scheme="1" aria-pressed="false" title="Tropical">Trop</button>
            <button type="button" class="scheme-button" data-scheme="3" aria-pressed="false" title="Enhanced">Enh</button>
            <button type="button" class="scheme-button" data-scheme="4" aria-pressed="false" title="Snow">Snow</button>
            <button type="button" class="scheme-button" data-scheme="5" aria-pressed="false" title="Night">Night</button>
            <button type="button" class="scheme-button" data-scheme="6" aria-pressed="false" title="Severe">Sev</button>
            <button type="button" class="scheme-button" data-scheme="7" aria-pressed="false" title="Universal">Uni</button>
            <button type="button" class="scheme-button" data-scheme="8" aria-pressed="false" title="Satellite">Sat</button>
          </div>
        </div>
        <div class="layer-toggle radar-presets" role="group" aria-label="Map presets">
          <button type="button" class="preset-button" data-view="atlantic">Atlantic</button>
          <button type="button" class="preset-button" data-view="gulf">Gulf</button>
          <button type="button" class="preset-button" data-view="florida">Florida</button>
          <button type="button" class="preset-button" data-view="caribbean">Caribbean</button>
        </div>
        <div class="radar-toolbar-cluster radar-toolbar-actions">
          <button type="button" class="map-action" id="locate-map" title="Find alerts near me">
            <i class="fa-solid fa-location-crosshairs" aria-hidden="true"></i>
            <span>Locate</span>
          </button>
          <button type="button" class="map-action" id="watch-save" title="Save this area to your watch list">
            <i class="fa-solid fa-bookmark" aria-hidden="true"></i>
            <span>Watch</span>
          </button>
          <button type="button" class="map-action" id="reset-map">
            <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
            <span>Atlantic</span>
          </button>
          <button type="button" class="map-action" id="refresh-map">
            <i class="fa-solid fa-rotate" aria-hidden="true"></i>
            <span>Refresh</span>
          </button>
          <button type="button" class="map-action" id="full-map">
            <i class="fa-solid fa-expand" aria-hidden="true"></i>
            <span>Full</span>
          </button>
        </div>
      </div>

      <div class="radar-layout">
        <div class="radar-map-shell">
          <div id="map" class="h-[70vh] w-full radar-map" style="height: 70vh;" aria-label="Interactive North Atlantic hurricane radar and satellite map"></div>
          <div class="satellite-preview" id="satellite-preview" hidden aria-live="polite">
            <div class="satellite-preview-head">
              <span id="satellite-preview-title">GOES-East GeoColor</span>
              <div class="satellite-bands" role="group" aria-label="Satellite band">
                <button type="button" class="band-button active" data-band="geocolor" aria-pressed="true">Geo</button>
                <button type="button" class="band-button" data-band="ir" aria-pressed="false">IR</button>
              </div>
            </div>
            <div class="satellite-preview-body">
              <p id="satellite-preview-desc">Natural-color GOES-East imagery over the Atlantic and Americas. Pan and zoom to inspect cloud systems in true color.</p>
              <div class="satellite-opacity">
                <label for="satellite-opacity">Layer opacity</label>
                <input id="satellite-opacity" type="range" min="0.2" max="1" step="0.05" value="0.85" />
              </div>
              <button type="button" class="satellite-full-disk" id="open-full-disk">
                <i class="fa-solid fa-expand" aria-hidden="true"></i>
                <span>Open full-disk HD image</span>
              </button>
            </div>
          </div>

          <div class="satellite-modal" id="satellite-modal" hidden>
            <div class="satellite-modal-backdrop"></div>
            <div class="satellite-modal-content" role="dialog" aria-modal="true" aria-labelledby="satellite-modal-title">
              <div class="satellite-modal-head">
                <h3 id="satellite-modal-title">NOAA GOES-East Full Disk</h3>
                <button type="button" class="satellite-modal-close" id="close-full-disk" aria-label="Close full disk view">
                  <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
              </div>
              <img
                id="satellite-modal-image"
                src="https://cdn.star.nesdis.noaa.gov/GOES19/ABI/FD/GEOCOLOR/1808x1808.jpg"
                alt="Latest NOAA GOES-East full disk GeoColor satellite view"
                loading="lazy"
              />
              <p>High-resolution full disk preview from NOAA GOES-East. Use the interactive map layer for zoomed analysis.</p>
            </div>
          </div>
        </div>
        <aside class="radar-sidebar" aria-label="Live storm and alert panel">
          <div class="sidebar-kicker">
            <span class="live-dot" aria-hidden="true"></span>
            <span>Operations panel</span>
          </div>
          <section class="radar-card">
            <div class="radar-card-head">
              <div>
                <p class="eyebrow">Live alerts</p>
                <h2>NWS Weather Alerts</h2>
              </div>
              <span class="badge" id="alert-decision">Loading</span>
            </div>
            <form class="radar-alert-form" id="radar-alert-form">
              <label for="radar-state">Alert area</label>
              <select id="radar-state" name="state">
                {states.map(([code, name]) => <option value={code} selected={code === "FL"}>{name}</option>)}
              </select>
              <button type="submit">Load alerts</button>
            </form>
            <div class="radar-metrics">
              <div><strong id="alert-count">--</strong><span>active alerts</span></div>
              <div><strong id="storm-count">--</strong><span>NHC systems</span></div>
            </div>
            <p class="radar-scope small" id="alert-scope">Area: Florida</p>
            <div class="radar-categories" id="alert-categories" aria-live="polite"></div>
            <div id="alert-list" class="radar-feed-list" aria-live="polite">
              <p class="source-note">Loading state alerts...</p>
            </div>
            <ul class="radar-watch-list" id="watch-list" aria-label="Saved watch locations"></ul>
          </section>

          <section class="radar-card">
            <div class="radar-card-head">
              <div>
                <p class="eyebrow">NHC storm markers</p>
                <h2>Active Storms</h2>
              </div>
            </div>
            <div id="storm-list" class="radar-feed-list" aria-live="polite">
              <p class="source-note">Loading current storms...</p>
            </div>
            <StormCard />
          </section>

          <section class="radar-card">
            <div class="radar-card-head">
              <div>
                <p class="eyebrow">US alert density</p>
                <h2>Alert Heatmap</h2>
              </div>
            </div>
            <p class="small" id="heatmap-summary">Loading national alert counts…</p>
            <div class="radar-heatmap" id="heatmap-grid" aria-label="Active alert count by state"></div>
            <ol class="radar-heatmap-top" id="heatmap-top"></ol>
          </section>
        </aside>
      </div>

      <div class="radar-attribution">
        <div class="radar-legend" aria-label="Radar legend">
          <span><i class="legend-swatch rain"></i> Rain bands</span>
          <span><i class="legend-swatch alert"></i> NWS alert area</span>
          <span><i class="legend-swatch storm"></i> NHC storm marker</span>
          <span><i class="legend-swatch fema"></i> FEMA flood zone</span>
        </div>
        <span id="radar-status" role="status">Loading radar...</span>
      </div>
    </section>

    <section class="radar-notes" aria-labelledby="radar-ops-heading">
      <h2 id="radar-ops-heading">Live Map Operations</h2>
      <div class="grid-3">
        <article class="panel">
          <h3>Radar + Satellite Toggle</h3>
          <p>Switch between precipitation radar and the NOAA GOES-East satellite preview. Use radar for rain bands and satellite for tropical cloud organization.</p>
        </article>
        <article class="panel">
          <h3>Storm Markers</h3>
          <p>When NHC provides current storm coordinates, the map drops storm markers and links to official NHC advisory pages.</p>
        </article>
        <article class="panel">
          <h3>State Alerts</h3>
          <p>The sidebar loads NWS active alerts for a selected state, draws their areas on the map, and turns them into a Monitor, Prepare, Act, or Leave decision snapshot.</p>
          <p><a href="/tools/my-hurricane-dashboard/">Build my hurricane dashboard</a></p>
        </article>
      </div>
    </section>

    <section class="radar-notes" aria-labelledby="radar-notes-heading">
      <h2 id="radar-notes-heading">How To Use This View</h2>
      <div class="grid-3">
        <article class="panel">
          <h3>RainViewer Radar</h3>
          <p>Use the radar layer to inspect recent precipitation bands and squall-line structure. Radar coverage is strongest where ground radar networks are available.</p>
        </article>
        <article class="panel">
          <h3>Interactive Satellite Layers</h3>
          <p>Switch to satellite mode for a zoomable GOES-East GeoColor true-color layer and VIIRS infrared cloud-top temperature. Open the NOAA full-disk preview for high-resolution detail.</p>
        </article>
        <article class="panel">
          <h3>Decision Check</h3>
          <p>Confirm any action with NHC advisories, NWS alerts, and local emergency management. This map is context, not an evacuation order.</p>
        </article>
      </div>
    </section>

    <section class="radar-notes" aria-labelledby="radar-decision-heading">
      <p class="eyebrow">Radar search guide</p>
      <h2 id="radar-decision-heading">Hurricane Radar vs Satellite: What To Check First</h2>
      <div class="grid-2">
        <article>
          <p class="answer">Hurricane radar and hurricane satellite answer different questions. Satellite is better for storms over open water because it shows cloud organization, convective bursts, and whether the circulation is becoming better defined. Radar becomes more useful near land because it can show rain-band timing, embedded thunderstorms, and short-term changes closer to a specific city.</p>
          <p>If you are using a live hurricane radar map during a developing threat, do not stop at the map. Use radar for near-term precipitation context, satellite for storm structure, the <a href="/hurricane-tracker/live/">live hurricane tracker</a> for NHC storm position, and <a href="/alerts/">NWS alerts</a> for official watch and warning language.</p>
        </article>
        <article class="panel">
          <h3>Best next page by intent</h3>
          <ul class="check-list">
            <li><a href="/tools/alert-action-decoder/">Decode a hurricane watch, warning, flood alert, or surge alert</a></li>
            <li><a href="/hurricane-tracker/city/">Find a city hurricane tracker for local context</a></li>
            <li><a href="/tools/storm-distance-calculator/">Compare your ZIP code with active storm positions</a></li>
            <li><a href="/blog/hurricane-radar-vs-satellite/">Read the radar vs satellite explainer</a></li>
          </ul>
        </article>
      </div>
    </section>

    <section class="radar-notes" aria-labelledby="radar-action-heading">
      <p class="eyebrow">From map to action</p>
      <h2 id="radar-action-heading">What To Do After You See Bands Near Your Area</h2>
      <div class="grid-3">
        <article class="panel">
          <h3>Monitor</h3>
          <p>If bands are offshore and no local warning is active, save your area, refresh the map periodically, and read the <a href="/blog/how-to-read-the-hurricane-cone-of-uncertainty/">cone of uncertainty guide</a> before assuming the centerline is the only risk.</p>
        </article>
        <article class="panel">
          <h3>Prepare</h3>
          <p>If rain bands are approaching or watches are active, use the <a href="/tools/preparedness-checklist/">preparedness checklist</a>, review outage needs, and check whether household members need earlier transportation or medical planning.</p>
        </article>
        <article class="panel">
          <h3>Act</h3>
          <p>If warnings, surge alerts, evacuation orders, or dangerous flooding are in effect, follow local emergency management instructions and use the <a href="/tools/evacuation-decision-helper/">evacuation decision helper</a> only as a planning aid.</p>
        </article>
      </div>
    </section>

    <FaqBlock faqs={pageFaqs} />
  </section>

  <script>
    // @ts-nocheck
    import L from "leaflet";
    import "leaflet/dist/leaflet.css";
    import { alertRisk } from "../lib/weather";

    document.addEventListener("DOMContentLoaded", () => {
      const ATLANTIC_CENTER = [25.0, -75.0];
      const ATLANTIC_ZOOM = 5;
      const VIEWS = {
        atlantic: { center: [25.0, -75.0], zoom: 5, label: "North Atlantic" },
        gulf: { center: [26.0, -90.0], zoom: 5, label: "Gulf of Mexico" },
        florida: { center: [27.7, -81.7], zoom: 6, label: "Florida peninsula" },
        caribbean: { center: [18.5, -72.5], zoom: 5, label: "Caribbean" }
      };
      const US_STATES = ["AL","AK","AZ","AR","CA","CO","CT","DE","FL","GA","HI","ID","IL","IN","IA","KS","KY","LA","ME","MD","MA","MI","MN","MS","MO","MT","NE","NV","NH","NJ","NM","NY","NC","ND","OH","OK","OR","PA","RI","SC","SD","TN","TX","UT","VT","VA","WA","WV","WI","WY"];

      let activeScheme = 2;
      let activeSatBand = "geocolor";
      let satOpacity = 0.85;
      let currentScope = { state: "FL" };
      let lastAlerts = [];
      const alertGeo = new Map();
      const shownAlerts = new Map();
      // GOES-East full-disk imagery is a geostationary disk. We anchor it to the
      // real sub-satellite footprint (centered near 75W) so the Atlantic and
      // Americas line up naturally on the web-mercator map.
      const GOES_EAST_BOUNDS = [[75, -160], [-75, 10]];
      const SATELLITE_SOURCES = {
        geocolor: {
          title: "GOES-East GeoColor",
          desc: "Natural-color GOES-East imagery (day true color fused with night infrared) over the Atlantic and Americas. Pan and zoom to inspect cloud systems in true color.",
          type: "image",
          url: "https://cdn.star.nesdis.noaa.gov/GOES19/ABI/FD/GEOCOLOR/1808x1808.jpg",
          bounds: GOES_EAST_BOUNDS,
          cacheBust: true,
          attribution: '<a href="https://www.star.nesdis.noaa.gov/goes/">NOAA</a>',
          fullDisk: "https://cdn.star.nesdis.noaa.gov/GOES19/ABI/FD/GEOCOLOR/1808x1808.jpg"
        },
        ir: {
          title: "VIIRS IR Band I5",
          desc: "Interactive infrared brightness temperature tiles from VIIRS NOAA-20. Brighter clouds are colder and higher.",
          type: "tile",
          url: "https://gibs.earthdata.nasa.gov/wmts/epsg3857/best/VIIRS_NOAA20_Brightness_Temp_BandI5_Night/default/GoogleMapsCompatible_Level9/{z}/{y}/{x}.jpg",
          attribution: '<a href="https://earthdata.nasa.gov/gibs">NASA GIBS</a>',
          maxZoom: 8,
          fullDisk: "https://cdn.star.nesdis.noaa.gov/GOES19/ABI/FD/GEOCOLOR/1808x1808.jpg"
        }
      };

      const statusEl = document.querySelector("#radar-status");
      const resetButton = document.querySelector("#reset-map");
      const refreshButton = document.querySelector("#refresh-map");
      const fullButton = document.querySelector("#full-map");
      const locateButton = document.querySelector("#locate-map");
      const watchSaveButton = document.querySelector("#watch-save");
      const buttons = Array.from(document.querySelectorAll(".layer-button"));
      const themeButtons = Array.from(document.querySelectorAll(".theme-button"));
      const schemeButtons = Array.from(document.querySelectorAll(".scheme-button"));
      const bandButtons = Array.from(document.querySelectorAll(".band-button"));
      const presetButtons = Array.from(document.querySelectorAll(".preset-button"));
      const mapEl = document.querySelector("#map");
      const stageEl = document.querySelector(".radar-stage");
      const alertForm = document.querySelector("#radar-alert-form");
      const stateSelect = document.querySelector("#radar-state");
      const alertList = document.querySelector("#alert-list");
      const stormList = document.querySelector("#storm-list");
      const alertCountEl = document.querySelector("#alert-count");
      const stormCountEl = document.querySelector("#storm-count");
      const decisionEl = document.querySelector("#alert-decision");
      const satellitePreview = document.querySelector("#satellite-preview");
      const satellitePreviewTitle = document.querySelector("#satellite-preview-title");
      const satellitePreviewDesc = document.querySelector("#satellite-preview-desc");
      const satelliteOpacityInput = document.querySelector("#satellite-opacity");
      const openFullDiskButton = document.querySelector("#open-full-disk");
      const satelliteModal = document.querySelector("#satellite-modal");
      const closeFullDiskButton = document.querySelector("#close-full-disk");
      const satelliteModalImage = document.querySelector("#satellite-modal-image");
      const categoriesEl = document.querySelector("#alert-categories");
      const alertScopeEl = document.querySelector("#alert-scope");
      const watchListEl = document.querySelector("#watch-list");
      const heatmapSummaryEl = document.querySelector("#heatmap-summary");
      const heatmapGridEl = document.querySelector("#heatmap-grid");
      const heatmapTopEl = document.querySelector("#heatmap-top");
      const femaButton = document.querySelector("#fema-toggle");

      // FEMA National Flood Hazard Layer overlay (client-side fetch; no Worker proxy).
      let femaActive = false;
      let femaOnMap = false;
      let femaLoading = false;
      let femaLayerId = null;
      let femaTimer = null;
      const femaLayer = L.layerGroup();
      const FEMA_BASE = "https://hazards.fema.gov/gis/nfhl/rest/services/public/NFHL/MapServer";

      function setStatus(message, isError = false) {
        if (!statusEl) return;
        statusEl.textContent = message;
        statusEl.classList.toggle("radar-error", isError);
      }

      function setActiveButton(name) {
        buttons.forEach((button) => {
          const isActive = button.dataset.layer === name;
          button.classList.toggle("active", isActive);
          button.setAttribute("aria-pressed", String(isActive));
        });
      }

      function setActiveTheme(name) {
        themeButtons.forEach((button) => {
          const isActive = button.dataset.theme === name;
          button.classList.toggle("active", isActive);
          button.setAttribute("aria-pressed", String(isActive));
        });
      }

      function escapeHtml(value) {
        const replacements = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" };
        return String(value ?? "").replace(/[&<>"']/g, (char) => replacements[char] ?? char);
      }

      function coordinate(value) {
        const text = String(value ?? "").trim().toUpperCase();
        const number = Number.parseFloat(text);
        if (!Number.isFinite(number)) return null;
        if (text.endsWith("S") || text.endsWith("W")) return -Math.abs(number);
        return number;
      }

      function badgeClass(text) {
        if (/Leave|Extreme|Severe|Warning|Evacuation/i.test(text)) return "badge danger";
        if (/Act|Watch|Flood|Tropical|Prepare/i.test(text)) return "badge warn";
        return "badge";
      }

      function timeUntil(iso) {
        if (!iso) return "";
        const t = new Date(iso).getTime();
        if (!Number.isFinite(t)) return "";
        const diff = t - Date.now();
        if (diff <= 0) return "expired";
        const totalMinutes = Math.floor(diff / 60000);
        const h = Math.floor(totalMinutes / 60);
        const m = totalMinutes % 60;
        return h > 0 ? `${h}h ${m}m` : `${m}m`;
      }

      function isNew(sent) {
        if (!sent) return false;
        const t = new Date(sent).getTime();
        if (!Number.isFinite(t)) return false;
        return Date.now() - t < 30 * 60 * 1000;
      }

      function slug(text) {
        return String(text ?? "").toLowerCase().replace(/[^a-z]+/g, "-").replace(/(^-|-$)/g, "");
      }

      if (!mapEl || typeof L === "undefined") {
        setStatus("Radar temporarily unavailable. Please refresh shortly.", true);
        return;
      }

      const map = L.map("map", {
        center: ATLANTIC_CENTER,
        zoom: ATLANTIC_ZOOM,
        minZoom: 3,
        maxZoom: 8,
        zoomControl: true,
        worldCopyJump: true,
        touchZoom: true,
        scrollWheelZoom: true
      });

      let activeBase = null;
      const baseLayers = {
        light: L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
          maxZoom: 8,
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        }),
        dark: L.tileLayer("https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png", {
          maxZoom: 8,
          attribution: '&copy; <a href="https://carto.com/attributions">CARTO</a> &copy; OpenStreetMap'
        })
      };

      function showTheme(name) {
        const nextBase = baseLayers[name] ?? baseLayers.light;
        if (activeBase) map.removeLayer(activeBase);
        activeBase = nextBase.addTo(map);
        setActiveTheme(name);
        stageEl?.classList.toggle("radar-dark", name === "dark");
      }

      const stormLayer = L.layerGroup().addTo(map);
      const alertPolyLayer = L.layerGroup().addTo(map);
      let activeOverlay = null;
      const layers = { radar: null, satellite: null, forecast: null, wind: null };

      function createSatelliteLayer(band) {
        const source = SATELLITE_SOURCES[band] || SATELLITE_SOURCES.geocolor;
        if (source.type === "image") {
          const url = source.cacheBust
            ? `${source.url}?t=${Math.floor(Date.now() / 600000)}`
            : source.url;
          return L.imageOverlay(url, source.bounds, {
            opacity: satOpacity,
            attribution: source.attribution
          });
        }
        const layer = L.tileLayer(source.url, {
          opacity: satOpacity,
          maxZoom: source.maxZoom,
          attribution: source.attribution,
          subdomains: ""
        });
        layer.on("tileerror", () => {
          setStatus(`${source.title} tile temporarily unavailable.`, true);
        });
        return layer;
      }

      function updateSatellitePreview(band) {
        const source = SATELLITE_SOURCES[band] || SATELLITE_SOURCES.geocolor;
        if (satellitePreviewTitle) satellitePreviewTitle.textContent = source.title;
        if (satellitePreviewDesc) satellitePreviewDesc.textContent = source.desc;
        if (satelliteModalImage) {
          satelliteModalImage.src = source.fullDisk;
          satelliteModalImage.alt = `Latest NOAA GOES-East full disk ${source.title} satellite view`;
        }
      }

      function attachTileError(layer, message) {
        layer.on("tileerror", () => setStatus(message, true));
        return layer;
      }

      // HRRR simulated reflectivity (forecast radar) from Iowa Environmental
      // Mesonet. hrrr::REFD-F0000-0 = latest model run, minute-0 (analysis)
      // reflectivity. Free, no key. Standard XYZ tiles.
      function createHrrrLayer() {
        const layer = L.tileLayer(
          "https://mesonet.agron.iastate.edu/cache/tile.py/1.0.0/hrrr::REFD-F0000-0/{z}/{x}/{y}.png",
          {
            opacity: 0.7,
            maxZoom: 8,
            attribution: '<a href="https://mesonet.agron.iastate.edu/">IEM</a> / NCEP HRRR'
          }
        );
        layer.on("tileerror", () =>
          setStatus("HRRR forecast radar temporarily unavailable.", true)
        );
        return layer;
      }

      // Surface wind field, proxied through /api/wind so the API key stays
      // server-side. Requires OPENWEATHER_API_KEY configured on Cloudflare.
      function createWindLayer() {
        const layer = L.tileLayer("/api/wind/{z}/{x}/{y}.png", {
          opacity: 0.65,
          maxZoom: 8,
          attribution: '<a href="https://openweathermap.org/">OpenWeatherMap</a>'
        });
        layer.on("tileerror", () =>
          setStatus(
            "Wind layer needs an OpenWeatherMap API key configured on the server. See project notes.",
            true
          )
        );
        return layer;
      }

      async function createRainViewerLayer() {
        try {
          const response = await fetch("/api/radar/rainviewer.json", { cache: "no-store" });
          if (!response.ok) throw new Error("RainViewer timeline unavailable");

          const data = await response.json();
          const frames = data.radar?.past?.length ? data.radar.past : (data.radar?.nowcast ?? []);
          const latest = frames[frames.length - 1];
          if (!latest?.path || !data.host) throw new Error("RainViewer frame unavailable");
          const radarTime = latest.time
            ? new Date(latest.time * 1000).toLocaleString([], { dateStyle: "medium", timeStyle: "short" })
            : "latest frame";
          setStatus(`RainViewer radar frame loaded: ${radarTime}.`);

          return L.tileLayer(`${data.host}${latest.path}/256/{z}/{x}/{y}/${activeScheme}/1_1.png`, {
            opacity: 0.76,
            maxNativeZoom: 7,
            maxZoom: 8,
            attribution: '<a href="https://www.rainviewer.com/">RainViewer</a>'
          });
        } catch (error) {
          console.error("HurricaneHub radar layer failed", error);
          setStatus("Radar temporarily unavailable. Satellite is still available.", true);
          return L.tileLayer("https://tile.rainviewer.com/v2/radar/{z}/{x}/{y}.png", {
            opacity: 0.76,
            maxNativeZoom: 7,
            maxZoom: 8,
            attribution: '<a href="https://www.rainviewer.com/">RainViewer</a>'
          });
        }
      }

      function showLayer(name) {
        if (name === "satellite") {
          if (activeOverlay) {
            map.removeLayer(activeOverlay);
            activeOverlay = null;
          }
          if (satellitePreview instanceof HTMLElement) satellitePreview.hidden = false;
          const satLayer = createSatelliteLayer(activeSatBand);
          layers.satellite = satLayer;
          if (satLayer) {
            activeOverlay = satLayer.addTo(map);
            setStatus(`${SATELLITE_SOURCES[activeSatBand]?.title || "Satellite"} layer active. Pan and zoom to explore.`);
          } else {
            setStatus("Satellite layer temporarily unavailable. Tap the HD button for the full-disk preview.");
          }
          setActiveButton(name);
          return;
        }

        const nextLayer = layers[name];
        if (!nextLayer) {
          setStatus("Layer temporarily unavailable. Please refresh shortly.", true);
          return;
        }

        if (satellitePreview instanceof HTMLElement) satellitePreview.hidden = true;
        if (satelliteModal instanceof HTMLElement) satelliteModal.hidden = true;
        if (activeOverlay) map.removeLayer(activeOverlay);
        activeOverlay = name === "radar" ? attachTileError(nextLayer, "Radar temporarily unavailable.") : nextLayer;
        activeOverlay.addTo(map);
        setActiveButton(name);
        if (name === "forecast") {
          setStatus("HRRR forecast radar active — simulated reflectivity from the latest NCEP model run.");
        } else if (name === "wind") {
          setStatus("Surface wind layer loading. If tiles fail, the server needs an OpenWeatherMap key.");
        }
      }

      function toggleAlertOnMap(id) {
        if (shownAlerts.has(id)) {
          alertPolyLayer.removeLayer(shownAlerts.get(id));
          shownAlerts.delete(id);
          return false;
        }
        const geo = alertGeo.get(id);
        if (!geo) return false;
        try {
          const layer = L.geoJSON(geo, {
            style: { color: "#f05d4f", weight: 2, fillColor: "#f05d4f", fillOpacity: 0.16 }
          });
          alertPolyLayer.addLayer(layer);
          shownAlerts.set(id, layer);
          const bounds = layer.getBounds();
          if (bounds.isValid()) map.fitBounds(bounds, { maxZoom: 7, padding: [20, 20] });
          return true;
        } catch (error) {
          console.error("HurricaneHub alert polygon failed", error);
          return false;
        }
      }

      function femaStyle(feature) {
        const props = feature.properties || {};
        const zone = String(props.ZONE_SUBTY || props.FLD_ZONE || props.zone || "").toUpperCase();
        if (/^V|^AE|^A/.test(zone)) {
          // Special Flood Hazard Area (100-year / coastal high-risk)
          return { color: "#ff4d6d", weight: 1.5, fillColor: "#ff4d6d", fillOpacity: 0.22 };
        }
        if (/^X/.test(zone)) {
          // Minimal / moderate flood hazard (0.2% annual chance)
          return { color: "#3fa7ff", weight: 1, fillColor: "#3fa7ff", fillOpacity: 0.08 };
        }
        return { color: "#ffb703", weight: 1, fillColor: "#ffb703", fillOpacity: 0.14 };
      }

      async function discoverFemaLayer() {
        if (femaLayerId !== null) return femaLayerId;
        const res = await fetch(`${FEMA_BASE}?f=json`, { headers: { Accept: "application/json" } });
        if (!res.ok) throw new Error("NFHL metadata " + res.status);
        const data = await res.json();
        const layersMeta = data.layers || [];
        let found = layersMeta.find((l) => /flood[_\s-]?hazard[_\s-]?zone/i.test(l.name));
        if (!found) found = layersMeta.find((l) => /flood/i.test(l.name));
        femaLayerId = found ? found.id : (layersMeta[0] && layersMeta[0].id);
        return femaLayerId;
      }

      async function loadFemaZones() {
        if (femaLoading) return;
        femaLoading = true;
        try {
          const layerId = await discoverFemaLayer();
          if (layerId === null || layerId === undefined) throw new Error("No NFHL layer found");
          const b = map.getBounds();
          const sw = b.getSouthWest();
          const ne = b.getNorthEast();
          const bbox = `${sw.lng},${sw.lat},${ne.lng},${ne.lat}`;
          const url =
            `${FEMA_BASE}/${layerId}/query` +
            `?where=1%3D1` +
            `&geometry=${encodeURIComponent(bbox)}` +
            `&geometryType=esriGeometryEnvelope` +
            `&spatialRel=esriSpatialRelIntersects` +
            `&inSR=4326&outSR=4326&maxAllowableOffset=0.015` +
            `&resultRecordCount=2500&f=geojson&returnGeometry=true`;
          const res = await fetch(url, { headers: { Accept: "application/json" } });
          if (!res.ok) throw new Error("NFHL query " + res.status);
          const gj = await res.json();
          femaLayer.clearLayers();
          const drawn = L.geoJSON(gj, {
            style: femaStyle,
            onEachFeature: (f, layer) => {
              const p = f.properties || {};
              const z = p.ZONE_SUBTY || p.FLD_ZONE || "";
              layer.bindTooltip(`FEMA flood zone: ${z || "see map"}`);
            }
          });
          femaLayer.addLayer(drawn);
          const count = (gj.features || []).length;
          setStatus(`FEMA flood zones loaded (${count}). Source: FEMA National Flood Hazard Layer.`);
        } catch (error) {
          console.error("HurricaneHub FEMA layer failed", error);
          femaActive = false;
          femaOnMap = false;
          femaButton?.classList.remove("active");
          femaButton?.setAttribute("aria-pressed", "false");
          if (femaLayer._map) map.removeLayer(femaLayer);
          setStatus("FEMA flood data unavailable right now (provider blocked cross-origin or offline). Radar stays on.", true);
        } finally {
          femaLoading = false;
        }
      }

      function toggleFema() {
        femaActive = !femaActive;
        femaButton?.classList.toggle("active", femaActive);
        femaButton?.setAttribute("aria-pressed", String(femaActive));
        if (femaActive) {
          if (!femaOnMap) {
            femaLayer.addTo(map);
            femaOnMap = true;
          }
          setStatus("Loading FEMA flood zones for the current view…");
          loadFemaZones();
        } else if (femaOnMap) {
          map.removeLayer(femaLayer);
          femaLayer.clearLayers();
          femaOnMap = false;
        }
      }

      function renderCategories(alerts) {
        if (!categoriesEl) return;
        const cats = {};
        alerts.forEach((alert) => {
          const risk = alertRisk(alert);
          cats[risk] = (cats[risk] ?? 0) + 1;
        });
        const order = ["Evacuation", "Storm surge", "Hurricane wind", "Flooding", "Tornado", "Tropical storm", "Other"];
        const entries = order.filter((key) => cats[key]).map((key) => [key, cats[key]]);
        categoriesEl.innerHTML = entries.length
          ? entries.map(([key, count]) => `<span class="cat-chip cat-${slug(key)}">${escapeHtml(key)} <b>${count}</b></span>`).join("")
          : '<span class="small">No categorized alerts.</span>';
      }

      if (satelliteModalImage instanceof HTMLImageElement) {
        satelliteModalImage.addEventListener("error", () => {
          setStatus("NOAA full-disk preview is temporarily unavailable. Interactive tiles remain available.", true);
        });
      }

      async function loadAlerts(scope) {
        scope = scope || (currentScope && currentScope.point ? currentScope : { state: stateSelect?.value || "FL" });
        currentScope = scope;
        const params = scope.point
          ? `point=${encodeURIComponent(scope.point)}`
          : `area=${encodeURIComponent(scope.state || "FL")}`;

        if (alertList) alertList.innerHTML = '<p class="source-note">Loading NWS alerts...</p>';
        try {
          const response = await fetch(`/api/nws/alerts.json?${params}`);
          if (!response.ok) throw new Error("NWS alert feed failed");
          const data = await response.json();
          const alerts = data.alerts ?? [];
          lastAlerts = alerts;
          alertGeo.clear();
          shownAlerts.forEach((layer, id) => { alertPolyLayer.removeLayer(layer); shownAlerts.delete(id); });

          const decision = data.decisionLevel ?? (alerts.length ? "Prepare" : "Monitor");
          if (alertCountEl) alertCountEl.textContent = String(alerts.length);
          if (decisionEl) {
            decisionEl.textContent = decision;
            decisionEl.className = badgeClass(decision);
          }
          if (alertScopeEl) {
            alertScopeEl.textContent = `Area: ${data.state || (data.point ? "your location" : "?")}`;
          }
          if (alertList) {
            alertList.innerHTML = alerts.length
              ? alerts.slice(0, 12).map((alert) => {
                  alertGeo.set(alert.id, alert.geometry);
                  const newBadge = isNew(alert.sent) ? '<span class="alert-new">NEW</span>' : "";
                  const countdown = alert.expires ? `<span class="alert-countdown" data-expires="${escapeHtml(alert.expires)}">${timeUntil(alert.expires)}</span>` : "";
                  const hasGeo = alert.geometry ? '<button type="button" class="alert-map-btn" data-alert-id="' + escapeHtml(alert.id) + '" aria-pressed="false" title="Show area on map"><i class="fa-solid fa-map-location-dot"></i></button>' : "";
                  return `
                <article class="mini-alert">
                  <header><h3>${escapeHtml(alert.event || "Weather alert")}</h3><span class="${badgeClass(alert.severity)}">${escapeHtml(alert.severity)}</span></header>
                  <p>${escapeHtml(alert.headline || alert.areaDesc)}</p>
                  <p class="small">${escapeHtml(alert.urgency)} · ${escapeHtml(alert.certainty)} · expires ${countdown} ${newBadge}</p>
                  ${hasGeo}
                </article>`;
                }).join("")
              : '<p class="source-note">No active NWS alerts returned for this area. This is not an all-clear for your county or evacuation zone.</p>';
          }
          renderCategories(alerts);
        } catch (error) {
          console.error("HurricaneHub radar alerts failed", error);
          if (alertList) alertList.innerHTML = '<p class="source-note radar-error">Alerts temporarily unavailable. Check weather.gov for official alerts.</p>';
          if (decisionEl) {
            decisionEl.textContent = "Unavailable";
            decisionEl.className = "badge danger";
          }
        }
      }

      async function loadStorms() {
        stormLayer.clearLayers();
        if (stormList) stormList.innerHTML = '<p class="source-note">Loading NHC storms...</p>';
        try {
          const response = await fetch("/api/nhc/current.json");
          if (!response.ok) throw new Error("NHC feed failed");
          const data = await response.json();
          const storms = data.storms ?? [];
          if (stormCountEl) stormCountEl.textContent = String(storms.length);
          const stormItems = [];
          storms.forEach((storm) => {
            const lat = coordinate(storm.latitude);
            const lon = coordinate(storm.longitude);
            if (lat !== null && lon !== null) {
              const marker = L.circleMarker([lat, lon], {
                radius: 9,
                color: "#9f2d1f",
                weight: 3,
                fillColor: "#ffe3de",
                fillOpacity: 0.9
              }).addTo(stormLayer);
              marker.bindPopup(`
                <strong>${escapeHtml(storm.name || storm.id || "Active storm")}</strong><br />
                ${escapeHtml(storm.classification || "NHC storm")}<br />
                ${escapeHtml(storm.summary || "Current NHC storm marker.")}
                ${storm.publicAdvisory ? `<br /><a href="${escapeHtml(storm.publicAdvisory)}" rel="nofollow">NHC advisory</a>` : ""}
              `);
            }
            stormItems.push(`
              <article class="mini-alert">
                <header><h3>${escapeHtml(storm.name || storm.id || "Active storm")}</h3><span class="badge warn">${escapeHtml(storm.classification || "NHC")}</span></header>
                <p>${escapeHtml(storm.summary || "Current NHC storm data loaded.")}</p>
                <p class="small">Position: ${escapeHtml(storm.latitude || "pending")}, ${escapeHtml(storm.longitude || "pending")} · ${escapeHtml(storm.lastUpdate || data.updatedAt || "time pending")}</p>
                ${storm.publicAdvisory ? `<a href="${escapeHtml(storm.publicAdvisory)}" rel="nofollow">Official NHC advisory</a>` : ""}
              </article>
            `);
          });
          if (stormList) {
            stormList.innerHTML = stormItems.length
              ? stormItems.join("")
              : '<p class="source-note">No active NHC tropical cyclone listed right now. Keep monitoring during hurricane season.</p>';
          }
        } catch (error) {
          console.error("HurricaneHub radar storm markers failed", error);
          if (stormList) stormList.innerHTML = '<p class="source-note radar-error">NHC storm markers temporarily unavailable.</p>';
          if (stormCountEl) stormCountEl.textContent = "--";
        }
      }

      async function updateHeatmap() {
        try {
          const response = await fetch("/api/nws/states.json", { cache: "no-store" });
          if (!response.ok) throw new Error("heatmap feed failed");
          const data = await response.json();
          const counts = {};
          (data.states ?? []).forEach((entry) => { counts[entry.code] = entry.count; });
          const max = Math.max(1, ...(data.states ?? []).map((entry) => entry.count));
          if (heatmapSummaryEl) heatmapSummaryEl.textContent = `${data.total ?? 0} active alerts nationwide`;
          if (heatmapGridEl) {
            heatmapGridEl.innerHTML = US_STATES.map((code) => {
              const count = counts[code] || 0;
              const level = count === 0 ? 0 : count >= max * 0.66 ? 3 : count >= max * 0.33 ? 2 : 1;
              return `<span class="heat-cell heat-${level}" title="${code}: ${count}">${code}</span>`;
            }).join("");
          }
          if (heatmapTopEl) {
            heatmapTopEl.innerHTML = (data.top ?? []).map((entry) => `<li><span>${entry.code}</span><b>${entry.count}</b></li>`).join("");
          }
        } catch (error) {
          console.error("HurricaneHub heatmap failed", error);
          if (heatmapSummaryEl) heatmapSummaryEl.textContent = "National alert counts unavailable.";
        }
      }

      function scopeKey(scope) {
        return scope.point ? `point:${scope.point}` : `state:${scope.state || "FL"}`;
      }

      function loadWatches() {
        try {
          return JSON.parse(localStorage.getItem("hurricanehub:watch") || "[]");
        } catch {
          return [];
        }
      }

      function saveWatches(list) {
        try {
          localStorage.setItem("hurricanehub:watch", JSON.stringify(list));
        } catch {
          /* storage unavailable */
        }
      }

      function renderWatches() {
        if (!watchListEl) return;
        const list = loadWatches();
        watchListEl.innerHTML = list.length
          ? list.map((watch, index) => `<li><button type="button" class="watch-load" data-i="${index}">${escapeHtml(watch.label)}</button><button type="button" class="watch-del" data-i="${index}" aria-label="Remove watch"><i class="fa-solid fa-xmark"></i></button></li>`).join("")
          : '<li class="small">Save an area to track it here.</li>';
      }

      showTheme("light");
      layers.forecast = createHrrrLayer();
      layers.wind = createWindLayer();
      updateSatellitePreview(activeSatBand);
      createRainViewerLayer().then((layer) => {
        layers.radar = layer;
        showLayer("radar");
      });
      loadAlerts(currentScope);
      loadStorms();
      updateHeatmap();
      renderWatches();

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const layer = button.dataset.layer;
          if (layer) showLayer(layer);
        });
      });

      femaButton?.addEventListener("click", toggleFema);
      map.on("moveend", () => {
        if (femaActive && femaOnMap) {
          window.clearTimeout(femaTimer);
          femaTimer = window.setTimeout(loadFemaZones, 600);
        }
      });

      themeButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const theme = button.dataset.theme;
          if (theme === "light" || theme === "dark") showTheme(theme);
        });
      });

      schemeButtons.forEach((button) => {
        button.addEventListener("click", async () => {
          const scheme = Number(button.dataset.scheme);
          if (!Number.isFinite(scheme)) return;
          activeScheme = scheme;
          schemeButtons.forEach((other) => {
            const isActive = other === button;
            other.classList.toggle("active", isActive);
            other.setAttribute("aria-pressed", String(isActive));
          });
          setStatus("Switching radar color scheme...");
          const layer = await createRainViewerLayer();
          layers.radar = layer;
          showLayer("radar");
        });
      });

      bandButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const band = button.dataset.band;
          if (!band || !SATELLITE_SOURCES[band]) return;
          activeSatBand = band;
          bandButtons.forEach((other) => {
            const isActive = other === button;
            other.classList.toggle("active", isActive);
            other.setAttribute("aria-pressed", String(isActive));
          });
          updateSatellitePreview(band);
          const isSatelliteMode = buttons.some((btn) => btn.dataset.layer === "satellite" && btn.classList.contains("active"));
          if (isSatelliteMode) {
            showLayer("satellite");
          }
        });
      });

      satelliteOpacityInput?.addEventListener("input", (event) => {
        satOpacity = Number(event.target?.value) || 0.85;
        if (activeOverlay && activeOverlay.setOpacity) {
          activeOverlay.setOpacity(satOpacity);
        }
      });

      function openFullDisk() {
        if (satelliteModal instanceof HTMLElement) {
          const source = SATELLITE_SOURCES[activeSatBand] || SATELLITE_SOURCES.geocolor;
          if (satelliteModalImage) {
            satelliteModalImage.src = source.fullDisk;
            satelliteModalImage.alt = `Latest NOAA GOES-East full disk ${source.title} satellite view`;
          }
          satelliteModal.hidden = false;
        }
      }

      function closeFullDisk() {
        if (satelliteModal instanceof HTMLElement) satelliteModal.hidden = true;
      }

      openFullDiskButton?.addEventListener("click", openFullDisk);
      closeFullDiskButton?.addEventListener("click", closeFullDisk);
      satelliteModal?.querySelector(".satellite-modal-backdrop")?.addEventListener("click", closeFullDisk);
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeFullDisk();
      });

      presetButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const view = VIEWS[button.dataset.view] ?? VIEWS.atlantic;
          map.setView(view.center, view.zoom);
          setStatus(`View focused on ${view.label}.`);
        });
      });

      resetButton?.addEventListener("click", () => {
        map.setView(ATLANTIC_CENTER, ATLANTIC_ZOOM);
        setStatus("View reset to the North Atlantic hurricane belt.");
      });

      refreshButton?.addEventListener("click", async () => {
        setStatus("Refreshing radar, alerts, and storm markers...");
        const scope = currentScope && currentScope.point ? currentScope : { state: stateSelect?.value || "FL" };
        const radarLayer = await createRainViewerLayer();
        layers.radar = radarLayer;
        showLayer("radar");
        await Promise.all([loadAlerts(scope), loadStorms(), updateHeatmap()]);
        setStatus("Radar, alerts, and storm markers refreshed.");
      });

      fullButton?.addEventListener("click", () => {
        stageEl?.classList.toggle("radar-fullscreen");
        const expanded = stageEl?.classList.contains("radar-fullscreen") ?? false;
        fullButton.querySelector("span").textContent = expanded ? "Exit" : "Full";
        setStatus(expanded ? "Full view enabled." : "Full view closed.");
        window.setTimeout(() => map.invalidateSize(), 150);
      });

      alertForm?.addEventListener("submit", (event) => {
        event.preventDefault();
        const selectedState = stateSelect instanceof HTMLSelectElement ? stateSelect.value : "FL";
        loadAlerts({ state: selectedState });
      });

      locateButton?.addEventListener("click", () => {
        if (!("geolocation" in navigator)) {
          setStatus("Geolocation is not supported by this browser.", true);
          return;
        }
        setStatus("Locating your position...");
        navigator.geolocation.getCurrentPosition(
          async (position) => {
            const { latitude, longitude } = position.coords;
            const point = `${latitude},${longitude}`;
            await loadAlerts({ point, label: `Near ${latitude.toFixed(2)}, ${longitude.toFixed(2)}` });
            setStatus(`Loaded alerts near ${latitude.toFixed(2)}, ${longitude.toFixed(2)}.`);
          },
          (error) => {
            setStatus(`Location unavailable: ${error.message}`, true);
          },
          { enableHighAccuracy: false, timeout: 10000, maximumAge: 600000 }
        );
      });

      watchSaveButton?.addEventListener("click", () => {
        const scope = currentScope || { state: stateSelect?.value || "FL" };
        const label = scope.label || `Area: ${scope.state || "FL"}`;
        const list = loadWatches();
        if (list.some((watch) => watch.key === scopeKey(scope))) {
          setStatus("Already watching this area.");
          return;
        }
        list.push({ ...scope, label, key: scopeKey(scope) });
        saveWatches(list);
        renderWatches();
        setStatus(`Saved watch location: ${label}`);
      });

      watchListEl?.addEventListener("click", async (event) => {
        const loadBtn = event.target.closest(".watch-load");
        const delBtn = event.target.closest(".watch-del");
        const list = loadWatches();
        if (delBtn) {
          list.splice(Number(delBtn.dataset.i), 1);
          saveWatches(list);
          renderWatches();
          return;
        }
        if (loadBtn) {
          const watch = list[Number(loadBtn.dataset.i)];
          if (watch) {
            await loadAlerts(watch);
            setStatus(`Loaded watch location: ${watch.label}`);
          }
        }
      });

      alertList?.addEventListener("click", (event) => {
        const btn = event.target.closest(".alert-map-btn");
        if (!btn) return;
        const id = btn.dataset.alertId;
        const added = toggleAlertOnMap(id);
        btn.classList.toggle("active", added);
        btn.setAttribute("aria-pressed", String(added));
        setStatus(added ? "Alert area added to map." : "Alert area removed from map.");
      });

      let refreshTimer = null;
      function refreshIntervalMs() {
        const urgent = (lastAlerts || []).some((alert) => /Tornado Warning|Flash Flood Warning/i.test(alert.event || ""));
        return urgent ? 2 * 60 * 1000 : 10 * 60 * 1000;
      }
      function scheduleRefresh() {
        if (refreshTimer) clearTimeout(refreshTimer);
        refreshTimer = window.setTimeout(async () => {
          const scope = currentScope && currentScope.point ? currentScope : { state: stateSelect?.value || "FL" };
          await Promise.all([loadAlerts(scope), loadStorms(), updateHeatmap()]);
          scheduleRefresh();
        }, refreshIntervalMs());
      }
      scheduleRefresh();

      window.setInterval(() => {
        document.querySelectorAll(".alert-countdown").forEach((el) => {
          const iso = el.getAttribute("data-expires");
          el.textContent = timeUntil(iso);
        });
      }, 60 * 1000);

      window.setTimeout(() => map.invalidateSize(), 150);
    });
  </script>
</Layout>

