    cursor: pointer;
  }

  .satellite-full-disk:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .satellite-modal {
    position: fixed;
    inset: 0;
    z-index: 900;
    display: grid;
    place-items: center;
    padding: 24px;
  }

  .satellite-modal[hidden] {
    display: none;
  }

  .satellite-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(7, 20, 29, 0.86);
  }

  .satellite-modal-content {
    position: relative;
    z-index: 1;
    width: min(980px, calc(100vw - 48px));
    max-height: calc(100vh - 48px);
    overflow: auto;
    border-radius: 12px;
    background: #08141f;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
  }

  .satellite-modal-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 14px 18px;
    border-bottom: 1px solid rgba(226, 239, 243, 0.18);
    color: #fff;
  }

  .satellite-modal-head h3 {
    margin: 0;
