---
import FaqBlock from "../components/FaqBlock.astro";
import Layout from "../layouts/Layout.astro";
import { faqs, site, states } from "../data/site";
import { articleSchema, faqSchema, graph, websiteSchema } from "../lib/schema";

const title = "Hurricane Radar | Live NOAA Data";
const description = "Live hurricane radar feed, GOES satellite imagery, and real-time storm tracking for the North Atlantic using RainViewer and NOAA-linked public data sources.";
const url = `${site.url}/radar/`;
const lastModified = site.contentLastModified;
const pageFaqs = [
  {
    question: "What does the HurricaneHub radar page show?",
    answer:
      "It shows RainViewer precipitation radar, GOES-East infrared satellite imagery, current NHC storm markers when available, and a state-level NWS alert panel for decision context."
  },
  {
    question: "How often should I refresh the radar and alerts?",
    answer:
      "Radar frames and alerts can change quickly. Use the refresh button, then verify important decisions with official NHC advisories, weather.gov alerts, and local emergency management."
  },
  ...faqs
];
const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title, description, url, dateModified: lastModified }),
  faqSchema(pageFaqs)
);
---
<Layout title={title} description={description} canonical={url} jsonLd={jsonLd} lastModified={lastModified}>
  <Fragment slot="head">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <script is:inline defer src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
  </Fragment>
  <section class="radar-page" aria-labelledby="radar-title">
    <div class="bg-red-100 p-2 text-center text-sm radar-warning">
      ⚠️ Data sourced from NOAA/RainViewer. Not for life-critical decisions. Visit <a href="https://www.weather.gov/">weather.gov</a>.
    </div>

    <div class="radar-intro">
      <p class="eyebrow">Live radar and satellite</p>
      <h1 id="radar-title">Hurricane Radar</h1>
      <p class="answer">This page shows a live hurricane radar feed and GOES-East infrared satellite imagery for the North Atlantic so users can compare precipitation, cloud tops, and storm context before checking official NOAA/NWS alerts.</p>
    </div>

    <section class="radar-stage" aria-label="Interactive North Atlantic map">
      <div class="radar-toolbar" aria-label="Radar layer controls">
        <div class="layer-toggle" role="group" aria-label="Map layer">
          <button type="button" class="layer-button active" data-layer="radar" aria-pressed="true">
            <i class="fa-solid fa-cloud-showers-heavy" aria-hidden="true"></i>
            <span>Radar</span>
          </button>
          <button type="button" class="layer-button" data-layer="satellite" aria-pressed="false">
            <i class="fa-solid fa-satellite-dish" aria-hidden="true"></i>
            <span>Satellite</span>
          </button>
        </div>
        <div class="layer-toggle" role="group" aria-label="Map theme">
          <button type="button" class="theme-button active" data-theme="light" aria-pressed="true">
            <i class="fa-solid fa-sun" aria-hidden="true"></i>
            <span>Light</span>
          </button>
          <button type="button" class="theme-button" data-theme="dark" aria-pressed="false">
            <i class="fa-solid fa-moon" aria-hidden="true"></i>
            <span>Dark</span>
          </button>
        </div>
        <div class="layer-toggle radar-presets" role="group" aria-label="Map presets">
          <button type="button" class="preset-button" data-view="atlantic">Atlantic</button>
          <button type="button" class="preset-button" data-view="gulf">Gulf</button>
          <button type="button" class="preset-button" data-view="florida">Florida</button>
          <button type="button" class="preset-button" data-view="caribbean">Caribbean</button>
        </div>
        <button type="button" class="map-action" id="reset-map">
          <i class="fa-solid fa-location-crosshairs" aria-hidden="true"></i>
          <span>Atlantic</span>
        </button>
        <button type="button" class="map-action" id="refresh-map">
          <i class="fa-solid fa-rotate" aria-hidden="true"></i>
          <span>Refresh</span>
        </button>
        <button type="button" class="map-action" id="full-map">
          <i class="fa-solid fa-expand" aria-hidden="true"></i>
          <span>Full View</span>
        </button>
      </div>

      <div class="radar-layout">
        <div id="map" class="h-[70vh] w-full radar-map" style="height: 70vh;" aria-label="Interactive North Atlantic hurricane radar and satellite map"></div>
        <aside class="radar-sidebar" aria-label="Live storm and alert panel">
          <section class="radar-card">
            <div class="radar-card-head">
              <div>
                <p class="eyebrow">Live alerts</p>
                <h2>NWS Weather Alerts</h2>
              </div>
              <span class="badge" id="alert-decision">Loading</span>
            </div>
            <form class="radar-alert-form" id="radar-alert-form">
              <label for="radar-state">Alert area</label>
              <select id="radar-state" name="state">
                {states.map(([code, name]) => <option value={code} selected={code === "FL"}>{name}</option>)}
              </select>
              <button type="submit">Load alerts</button>
            </form>
            <div class="radar-metrics">
              <div><strong id="alert-count">--</strong><span>active alerts</span></div>
              <div><strong id="storm-count">--</strong><span>NHC systems</span></div>
            </div>
            <div id="alert-list" class="radar-feed-list" aria-live="polite">
              <p class="source-note">Loading state alerts...</p>
            </div>
          </section>

          <section class="radar-card">
            <div class="radar-card-head">
              <div>
                <p class="eyebrow">NHC storm markers</p>
                <h2>Active Storms</h2>
              </div>
            </div>
            <div id="storm-list" class="radar-feed-list" aria-live="polite">
              <p class="source-note">Loading current storms...</p>
            </div>
          </section>
        </aside>
      </div>

      <div class="radar-attribution">
        <span id="radar-status" role="status">Loading radar...</span>
      </div>
    </section>

    <section class="radar-notes" aria-labelledby="radar-ops-heading">
      <h2 id="radar-ops-heading">Live Map Operations</h2>
      <div class="grid-3">
        <article class="panel">
          <h3>Radar + Satellite Toggle</h3>
          <p>Switch between precipitation radar and GOES-East infrared imagery. Use radar for rain bands and satellite for tropical cloud organization.</p>
        </article>
        <article class="panel">
          <h3>Storm Markers</h3>
          <p>When NHC provides current storm coordinates, the map drops storm markers and links to official NHC advisory pages.</p>
        </article>
        <article class="panel">
          <h3>State Alerts</h3>
          <p>The sidebar loads NWS active alerts for a selected state and turns them into a Monitor, Prepare, Act, or Leave decision snapshot.</p>
        </article>
      </div>
    </section>

    <section class="radar-notes" aria-labelledby="radar-notes-heading">
      <h2 id="radar-notes-heading">How To Use This View</h2>
      <div class="grid-3">
        <article class="panel">
          <h3>RainViewer Radar</h3>
          <p>Use the radar layer to inspect recent precipitation bands and squall-line structure. Radar coverage is strongest where ground radar networks are available.</p>
        </article>
        <article class="panel">
          <h3>GOES Infrared</h3>
          <p>Use the satellite layer to view cold cloud tops and tropical organization over the Atlantic, Caribbean, Gulf of Mexico, and Bahamas region.</p>
        </article>
        <article class="panel">
          <h3>Decision Check</h3>
          <p>Confirm any action with NHC advisories, NWS alerts, and local emergency management. This map is context, not an evacuation order.</p>
        </article>
      </div>
    </section>
    <FaqBlock faqs={pageFaqs} />
  </section>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const ATLANTIC_CENTER = [25.0, -75.0];
      const ATLANTIC_ZOOM = 5;
      const VIEWS = {
        atlantic: { center: [25.0, -75.0], zoom: 5, label: "North Atlantic" },
        gulf: { center: [26.0, -90.0], zoom: 5, label: "Gulf of Mexico" },
        florida: { center: [27.7, -81.7], zoom: 6, label: "Florida peninsula" },
        caribbean: { center: [18.5, -72.5], zoom: 5, label: "Caribbean" }
      };
      const statusEl = document.querySelector("#radar-status");
      const resetButton = document.querySelector("#reset-map");
      const refreshButton = document.querySelector("#refresh-map");
      const fullButton = document.querySelector("#full-map");
      const buttons = Array.from(document.querySelectorAll(".layer-button"));
      const themeButtons = Array.from(document.querySelectorAll(".theme-button"));
      const presetButtons = Array.from(document.querySelectorAll(".preset-button"));
      const mapEl = document.querySelector("#map");
      const stageEl = document.querySelector(".radar-stage");
      const alertForm = document.querySelector("#radar-alert-form");
      const stateSelect = document.querySelector("#radar-state");
      const alertList = document.querySelector("#alert-list");
      const stormList = document.querySelector("#storm-list");
      const alertCountEl = document.querySelector("#alert-count");
      const stormCountEl = document.querySelector("#storm-count");
      const decisionEl = document.querySelector("#alert-decision");

      function setStatus(message, isError = false) {
        if (!statusEl) return;
        statusEl.textContent = message;
        statusEl.classList.toggle("radar-error", isError);
      }

      function setActiveButton(name) {
        buttons.forEach((button) => {
          const isActive = button.dataset.layer === name;
          button.classList.toggle("active", isActive);
          button.setAttribute("aria-pressed", String(isActive));
        });
      }

      function setActiveTheme(name) {
        themeButtons.forEach((button) => {
          const isActive = button.dataset.theme === name;
          button.classList.toggle("active", isActive);
          button.setAttribute("aria-pressed", String(isActive));
        });
      }

      function escapeHtml(value) {
        const replacements = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" };
        return String(value ?? "").replace(/[&<>"']/g, (char) => replacements[char] ?? char);
      }

      function coordinate(value) {
        const text = String(value ?? "").trim().toUpperCase();
        const number = Number.parseFloat(text);
        if (!Number.isFinite(number)) return null;
        if (text.endsWith("S") || text.endsWith("W")) return -Math.abs(number);
        return number;
      }

      function badgeClass(text) {
        if (/Leave|Extreme|Severe|Warning|Evacuation/i.test(text)) return "badge danger";
        if (/Act|Watch|Flood|Tropical|Prepare/i.test(text)) return "badge warn";
        return "badge";
      }

      if (!mapEl || !window.L) {
        setStatus("Radar temporarily unavailable. Please refresh shortly.", true);
        return;
      }

      const map = window.L.map("map", {
        center: ATLANTIC_CENTER,
        zoom: ATLANTIC_ZOOM,
        minZoom: 3,
        maxZoom: 8,
        zoomControl: true,
        worldCopyJump: true,
        touchZoom: true,
        scrollWheelZoom: true
      });

      let activeBase = null;
      const baseLayers = {
        light: window.L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
          maxZoom: 8,
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        }),
        dark: window.L.tileLayer("https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png", {
          maxZoom: 8,
          attribution: '&copy; <a href="https://carto.com/attributions">CARTO</a> &copy; OpenStreetMap'
        })
      };

      function showTheme(name) {
        const nextBase = baseLayers[name] ?? baseLayers.light;
        if (activeBase) map.removeLayer(activeBase);
        activeBase = nextBase.addTo(map);
        setActiveTheme(name);
        stageEl?.classList.toggle("radar-dark", name === "dark");
      }

      let activeOverlay = null;
      const stormLayer = window.L.layerGroup().addTo(map);
      const layers = {
        radar: null,
        satellite: window.L.tileLayer("https://mesonet.agron.iastate.edu/cache/tile.py/1.0.0/goes-east-ir-4km/{z}/{x}/{y}.png", {
          opacity: 0.82,
          maxZoom: 8,
          attribution: 'GOES-East IR via <a href="https://mesonet.agron.iastate.edu/">Iowa State Mesonet</a> / NOAA'
        })
      };

      function attachTileError(layer, message) {
        layer.on("tileerror", () => setStatus(message, true));
        return layer;
      }

      async function createRainViewerLayer() {
        try {
          const response = await fetch("https://api.rainviewer.com/public/weather-maps.json", { cache: "no-store" });
          if (!response.ok) throw new Error("RainViewer timeline unavailable");

          const data = await response.json();
          const frames = data.radar?.past?.length ? data.radar.past : (data.radar?.nowcast ?? []);
          const latest = frames[frames.length - 1];
          if (!latest?.path || !data.host) throw new Error("RainViewer frame unavailable");
          const radarTime = latest.time
            ? new Date(latest.time * 1000).toLocaleString([], { dateStyle: "medium", timeStyle: "short" })
            : "latest frame";
          setStatus(`RainViewer radar frame loaded: ${radarTime}.`);

          return window.L.tileLayer(`${data.host}${latest.path}/256/{z}/{x}/{y}/2/1_1.png`, {
            opacity: 0.76,
            maxZoom: 8,
            attribution: '<a href="https://www.rainviewer.com/">RainViewer</a>'
          });
        } catch (error) {
          console.error("HurricaneHub radar layer failed", error);
          setStatus("Radar temporarily unavailable. Satellite is still available.", true);
          return window.L.tileLayer("https://tile.rainviewer.com/tiles/radar/{z}/{x}/{y}.png", {
            opacity: 0.76,
            maxZoom: 8,
            attribution: '<a href="https://www.rainviewer.com/">RainViewer</a>'
          });
        }
      }

      function showLayer(name) {
        const nextLayer = layers[name];
        if (!nextLayer) {
          setStatus("Radar temporarily unavailable. Please refresh shortly.", true);
          return;
        }

        if (activeOverlay) map.removeLayer(activeOverlay);
        activeOverlay = attachTileError(
          nextLayer,
          name === "radar" ? "Radar temporarily unavailable." : "Satellite temporarily unavailable."
        );
        activeOverlay.addTo(map);
        setActiveButton(name);
        if (name === "satellite") setStatus("GOES-East infrared satellite loaded.");
      }

      async function loadAlerts(state = "FL") {
        if (alertList) alertList.innerHTML = '<p class="source-note">Loading NWS alerts...</p>';
        try {
          const response = await fetch(`/api/nws/alerts.json?area=${encodeURIComponent(state)}`);
          if (!response.ok) throw new Error("NWS alert feed failed");
          const data = await response.json();
          const alerts = data.alerts ?? [];
          const decision = data.decisionLevel ?? (alerts.length ? "Prepare" : "Monitor");
          if (alertCountEl) alertCountEl.textContent = String(alerts.length);
          if (decisionEl) {
            decisionEl.textContent = decision;
            decisionEl.className = badgeClass(decision);
          }
          if (alertList) {
            alertList.innerHTML = alerts.length
              ? alerts.slice(0, 8).map((alert) => `
                <article class="mini-alert">
                  <header><h3>${escapeHtml(alert.event)}</h3><span class="${badgeClass(alert.severity)}">${escapeHtml(alert.severity)}</span></header>
                  <p>${escapeHtml(alert.headline || alert.areaDesc)}</p>
                  <p class="small">${escapeHtml(alert.urgency)} · ${escapeHtml(alert.certainty)} · expires ${escapeHtml(alert.expires || "time unavailable")}</p>
                </article>
              `).join("")
              : '<p class="source-note">No active NWS alerts returned for this state. This is not an all-clear for your county or evacuation zone.</p>';
          }
        } catch (error) {
          console.error("HurricaneHub radar alerts failed", error);
          if (alertList) alertList.innerHTML = '<p class="source-note radar-error">Alerts temporarily unavailable. Check weather.gov for official alerts.</p>';
          if (decisionEl) {
            decisionEl.textContent = "Unavailable";
            decisionEl.className = "badge danger";
          }
        }
      }

      async function loadStorms() {
        stormLayer.clearLayers();
        if (stormList) stormList.innerHTML = '<p class="source-note">Loading NHC storms...</p>';
        try {
          const response = await fetch("/api/nhc/current.json");
          if (!response.ok) throw new Error("NHC feed failed");
          const data = await response.json();
          const storms = data.storms ?? [];
          if (stormCountEl) stormCountEl.textContent = String(storms.length);
          const stormItems = [];
          storms.forEach((storm) => {
            const lat = coordinate(storm.latitude);
            const lon = coordinate(storm.longitude);
            if (lat !== null && lon !== null) {
              const marker = window.L.circleMarker([lat, lon], {
                radius: 9,
                color: "#9f2d1f",
                weight: 3,
                fillColor: "#ffe3de",
                fillOpacity: 0.9
              }).addTo(stormLayer);
              marker.bindPopup(`
                <strong>${escapeHtml(storm.name || storm.id || "Active storm")}</strong><br />
                ${escapeHtml(storm.classification || "NHC storm")}<br />
                ${escapeHtml(storm.summary || "Current NHC storm marker.")}
                ${storm.publicAdvisory ? `<br /><a href="${escapeHtml(storm.publicAdvisory)}" rel="nofollow">NHC advisory</a>` : ""}
              `);
            }
            stormItems.push(`
              <article class="mini-alert">
                <header><h3>${escapeHtml(storm.name || storm.id || "Active storm")}</h3><span class="badge warn">${escapeHtml(storm.classification || "NHC")}</span></header>
                <p>${escapeHtml(storm.summary || "Current NHC storm data loaded.")}</p>
                <p class="small">Position: ${escapeHtml(storm.latitude || "pending")}, ${escapeHtml(storm.longitude || "pending")} · ${escapeHtml(storm.lastUpdate || data.updatedAt || "time pending")}</p>
                ${storm.publicAdvisory ? `<a href="${escapeHtml(storm.publicAdvisory)}" rel="nofollow">Official NHC advisory</a>` : ""}
              </article>
            `);
          });
          if (stormList) {
            stormList.innerHTML = stormItems.length
              ? stormItems.join("")
              : '<p class="source-note">No active NHC tropical cyclone listed right now. Keep monitoring during hurricane season.</p>';
          }
        } catch (error) {
          console.error("HurricaneHub radar storm markers failed", error);
          if (stormList) stormList.innerHTML = '<p class="source-note radar-error">NHC storm markers temporarily unavailable.</p>';
          if (stormCountEl) stormCountEl.textContent = "--";
        }
      }

      showTheme("light");
      createRainViewerLayer().then((layer) => {
        layers.radar = layer;
        showLayer("radar");
      });
      loadAlerts("FL");
      loadStorms();

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const layer = button.dataset.layer;
          if (layer === "radar" || layer === "satellite") showLayer(layer);
        });
      });

      themeButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const theme = button.dataset.theme;
          if (theme === "light" || theme === "dark") showTheme(theme);
        });
      });

      presetButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const view = VIEWS[button.dataset.view] ?? VIEWS.atlantic;
          map.setView(view.center, view.zoom);
          setStatus(`View focused on ${view.label}.`);
        });
      });

      resetButton?.addEventListener("click", () => {
        map.setView(ATLANTIC_CENTER, ATLANTIC_ZOOM);
        setStatus("View reset to the North Atlantic hurricane belt.");
      });

      refreshButton?.addEventListener("click", async () => {
        setStatus("Refreshing radar, alerts, and storm markers...");
        const selectedState = stateSelect instanceof HTMLSelectElement ? stateSelect.value : "FL";
        const radarLayer = await createRainViewerLayer();
        layers.radar = radarLayer;
        showLayer("radar");
        await Promise.all([loadAlerts(selectedState), loadStorms()]);
        setStatus("Radar, alerts, and storm markers refreshed.");
      });

      fullButton?.addEventListener("click", () => {
        stageEl?.classList.toggle("radar-fullscreen");
        const expanded = stageEl?.classList.contains("radar-fullscreen") ?? false;
        fullButton.querySelector("span").textContent = expanded ? "Exit Full" : "Full View";
        setStatus(expanded ? "Full view enabled." : "Full view closed.");
        window.setTimeout(() => map.invalidateSize(), 150);
      });

      alertForm?.addEventListener("submit", (event) => {
        event.preventDefault();
        const selectedState = stateSelect instanceof HTMLSelectElement ? stateSelect.value : "FL";
        loadAlerts(selectedState);
      });

      window.setInterval(() => {
        const selectedState = stateSelect instanceof HTMLSelectElement ? stateSelect.value : "FL";
        loadAlerts(selectedState);
        loadStorms();
      }, 10 * 60 * 1000);

      window.setTimeout(() => map.invalidateSize(), 150);
    });
  </script>
</Layout>

<style>
  .radar-page {
    background: var(--surface);
  }

  .radar-warning {
    position: sticky;
    top: 67px;
    z-index: 30;
    color: #7f1d1d;
    font-weight: 800;
    line-height: 1.45;
  }

  .radar-warning a {
    color: #7f1d1d;
    text-decoration-thickness: 2px;
  }

  .radar-intro,
  .radar-stage,
  .radar-notes {
    width: min(1180px, calc(100% - 36px));
    margin: 0 auto;
  }

  .radar-intro {
    padding: clamp(28px, 5vw, 54px) 0 18px;
  }

  .radar-intro .eyebrow {
    color: var(--ocean);
  }

  .radar-stage {
    position: relative;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #dcecef;
    box-shadow: var(--shadow);
  }

  .radar-toolbar {
    position: absolute;
    inset-inline: 12px;
    top: 12px;
    z-index: 700;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    pointer-events: none;
  }

  .layer-toggle {
    display: inline-flex;
    gap: 6px;
    padding: 6px;
    border: 1px solid rgba(23, 33, 43, 0.12);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 10px 30px rgba(23, 33, 43, 0.14);
    pointer-events: auto;
  }

  .layer-button,
  .theme-button,
  .preset-button,
  .map-action {
    width: auto;
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 0;
    border-radius: 6px;
    padding: 0 13px;
    background: transparent;
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 800;
  }

  .layer-button.active {
    background: var(--signal);
    color: #fff;
  }

  .theme-button.active {
    background: var(--ocean);
    color: #fff;
  }

  .preset-button {
    padding-inline: 10px;
  }

  .map-action {
    border: 1px solid rgba(23, 33, 43, 0.12);
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 10px 30px rgba(23, 33, 43, 0.14);
    pointer-events: auto;
  }

  .radar-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(310px, 0.36fr);
    min-height: 70vh;
  }

  .radar-map {
    position: relative;
    z-index: 1;
    min-height: 500px;
    background: #dcecef;
    touch-action: pan-x pan-y;
  }

  .radar-sidebar {
    display: grid;
    gap: 12px;
    align-content: start;
    max-height: 70vh;
    overflow: auto;
    padding: 78px 12px 12px;
    border-left: 1px solid var(--line);
    background: rgba(244, 247, 248, 0.96);
  }

  .radar-card {
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--panel);
  }

  .radar-card h2 {
    font-size: 1.25rem;
  }

  .radar-card-head {
    display: flex;
    gap: 12px;
    align-items: start;
    justify-content: space-between;
  }

  .radar-alert-form {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px;
    margin-top: 12px;
  }

  .radar-alert-form label {
