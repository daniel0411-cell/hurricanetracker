---
import FaqBlock from "../components/FaqBlock.astro";
import Layout from "../layouts/Layout.astro";
import ContentFigure from "../components/ContentFigure.astro";
import { site } from "../data/site";
import { coastalStates } from "../data/states";
import { articleSchema, breadcrumbSchema, faqSchema, graph, websiteSchema } from "../lib/schema";
import { readStormRegistry } from "../lib/stormRegistry";
import { getNhcCurrentFeed, NHC_CURRENT_CACHE_TTL_SECONDS, type NhcCurrentFeed } from "../lib/nhcCurrent";
import { advisoryUrl } from "../lib/weather";
import { formatWind } from "../lib/wind-speed";

const url = `${site.url}/2026-hurricane-season/`;
const names2026 = ["Arthur", "Bertha", "Cristobal", "Dolly", "Edouard", "Fay", "Gonzalo", "Hanna", "Isaias", "Josephine", "Kyle", "Leah", "Marco", "Nana", "Omar", "Paulette", "Rene", "Sally", "Teddy", "Vicky", "Wilfred"];

let feed: NhcCurrentFeed | null = null;
try {
  const current = await getNhcCurrentFeed();
  const fetchedAt = Date.parse(current.feed.fetchedAt);
  if (current.cacheStatus === "stale" || !Number.isFinite(fetchedAt) || Date.now() - fetchedAt > NHC_CURRENT_CACHE_TTL_SECONDS * 1000) {
    throw new Error("NHC season feed is stale or has no valid timestamp");
  }
  if (!Array.isArray(current.feed.storms) || current.feed.storms.some((storm) => typeof storm?.id !== "string" || !storm.id)) {
    throw new Error("NHC season feed is missing storm data");
  }
  feed = current.feed;
} catch (error) {
  console.error("HurricaneHub season hub feed failed", { error });
}

const feedAvailable = feed !== null;
const storms = (feed?.storms ?? []).filter((storm) => storm.id?.toUpperCase().startsWith("AL") && storm.classification !== "PTC");
const otherBasinStorms = (feed?.storms ?? []).filter((storm) => !storm.id?.toUpperCase().startsWith("AL"));
const registryStorms = await readStormRegistry();
const seasonRegistry = registryStorms.filter((storm) => storm.id?.toUpperCase().startsWith("AL") && (storm.id.toUpperCase().endsWith("2026") || storm.firstSeen.startsWith("2026-")));
const endedStorms = seasonRegistry.filter((storm) => !storm.active).sort((a, b) => b.lastSeen.localeCompare(a.lastSeen));
const activeNames = new Set(storms.map((storm) => storm.name?.toLowerCase()).filter(Boolean));
const archivedNames = new Set([...seasonRegistry.map((storm) => storm.name?.toLowerCase()).filter(Boolean), "arthur", "bertha", "cristobal", "dolly"]);
const lastUsedIndex = names2026.reduce((last, name, index) => activeNames.has(name.toLowerCase()) || archivedNames.has(name.toLowerCase()) ? index : last, -1);
const nextName = feedAvailable && seasonRegistry.length > 0 ? names2026[lastUsedIndex + 1] : undefined;
const nextNameAnswer = !feedAvailable || seasonRegistry.length === 0
  ? "The next unused Atlantic name could not be verified from the available records."
  : nextName ? `The next name after the latest recorded 2026 Atlantic system is ${nextName}.` : "The standard 2026 name list has been used.";
const nameRows = names2026.map((name) => ({
  name,
  status: activeNames.has(name.toLowerCase()) ? "active" : archivedNames.has(name.toLowerCase()) ? "recorded" : name === nextName ? "next" : "not recorded"
}));
const stormNameLinks: Record<string, string> = {
  Arthur: "/storm/2026-arthur/", Bertha: "/storm/2026-bertha/", Cristobal: "/storm/2026-cristobal/",
  Dolly: "/hurricane-tracker/storm/dolly/", Edouard: "/hurricane-tracker/storm/edouard/", Fay: "/hurricane-tracker/storm/fay/",
  Isaias: "/hurricane-tracker/storm/isaias/"
};
const namedStorms = new Set([...activeNames, ...archivedNames]).size;
const lastModified = feed?.updatedAt ?? feed?.fetchedAt ?? "2026-10-15T00:00:00.000Z";
const activeStormNames = storms.map((storm) => storm.name).filter(Boolean);
const currentAnswer = !feedAvailable
  ? "Current NHC data is temporarily unavailable. Check official NHC advisories and local NWS alerts for current conditions."
  : storms.length ? `The latest NHC Atlantic feed lists ${storms.length} active system${storms.length === 1 ? "" : "s"}${activeStormNames.length ? `: ${activeStormNames.join(", ")}` : ""}.` : "The latest NHC Atlantic feed lists no active Atlantic tropical cyclones.";
const title = "2026 Hurricane Season: Dates, Storms & Live Tracker";
const description = feedAvailable
  ? `The 2026 Atlantic hurricane season runs June 1-November 30. ${storms.length ? `${storms.length} active system${storms.length === 1 ? "" : "s"}${activeStormNames.length ? `: ${activeStormNames.join(", ")}` : ""}.` : "No active Atlantic systems."} Track NHC updates, storms and names. Updated ${new Date(lastModified).toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" })}.`
  : "The 2026 Atlantic hurricane season runs June 1-November 30. Current NHC data is temporarily unavailable; check official advisories, storm names and local alerts.";
const verifiedLabel = new Date(lastModified).toLocaleString("en-US", { month: "short", day: "numeric", year: "numeric", hour: "numeric", minute: "2-digit", timeZone: "UTC" });
const faqs = [
  { question: "When is the 2026 hurricane season?", answer: "The Atlantic hurricane season runs from June 1 through November 30. Tropical cyclones can occur outside those dates, so official outlooks remain the source for current conditions." },
  { question: "How many storms are predicted for 2026?", answer: "Seasonal outlooks can change as ocean and atmospheric conditions evolve. Check NOAA's current Atlantic outlook rather than relying on an older forecast total." },
  { question: "What is the first name on the 2026 Atlantic list?", answer: "Arthur is the first name on the 2026 Atlantic list. A name-list position does not mean a named storm has formed; use the current NHC feed for observed storm status." },
  { question: "When does hurricane season peak?", answer: "Atlantic hurricane activity statistically peaks around September 10, with the busiest period generally running from mid-August through October." },
  { question: "Where can I track active hurricanes?", answer: "Use HurricaneHub's live hurricane tracker for map context and follow the National Hurricane Center for official advisories, forecasts, watches, and warnings." }
];
const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title, description, url, datePublished: "2026-06-01T00:00:00.000Z", dateModified: lastModified }),
  faqSchema(faqs),
  breadcrumbSchema([{ name: "Home", url: site.canonicalUrl }, { name: "2026 Hurricane Season", url }])
);
---

<Layout title={title} description={description} canonical={url} jsonLd={jsonLd} lastModified={lastModified}>
  <section class="band season-hero" aria-labelledby="season-title">
    <div class="inner hero-grid">
      <div>
        <p class="eyebrow">Atlantic hurricane season</p>
        <h1 id="season-title">2026 Hurricane Season Live Tracker</h1>
        <p class="answer">{currentAnswer} {nextNameAnswer} {feedAvailable && <>Feed checked {verifiedLabel} UTC; use each storm's advisory timestamp for the official observation time.</>}</p>
        <p class="section-actions"><a class="action-link" href="/hurricane-tracker/live/">Are there any hurricanes right now?</a><a class="action-link secondary-action" href="https://www.nhc.noaa.gov/" rel="noopener nofollow">Official NHC advisories</a></p>
      </div>
      <aside class="status-panel" aria-label="Current 2026 Atlantic season status"><strong>{feedAvailable ? storms.length : "?"}</strong><span>{feedAvailable ? `active Atlantic NHC system${storms.length === 1 ? "" : "s"}` : "Current status unavailable"}</span><small>{feedAvailable ? `Feed checked ${verifiedLabel} UTC` : "Check official NHC advisories"}</small></aside>
    </div>
  </section>

  <section class="band" aria-labelledby="active-storms">
    <div class="inner">
      <p class="eyebrow">Current NHC Atlantic feed</p><h2 id="active-storms">Active Atlantic Tropical Cyclones</h2>
      {!feedAvailable ? <div class="empty-state"><strong>Current Atlantic status could not be verified.</strong><p>{currentAnswer}</p><a href="https://www.nhc.noaa.gov/" rel="noopener nofollow">Check official NHC advisories</a></div> : storms.length ? <div class="grid-2 section-grid">{storms.map((storm) => <article class="season-card"><span class="status active">Active</span><h3>{storm.name ?? storm.id ?? "NHC system"}</h3><p>{storm.classification ?? "Tropical cyclone"} · {storm.intensity ? formatWind(Number(storm.intensity)) : storm.windSpeed ?? "Intensity pending"}</p><p>Position {storm.latitude ?? "pending"}, {storm.longitude ?? "pending"}</p><p class="source-note">Updated {storm.lastUpdate ?? lastModified}</p><p class="card-links"><a href={`/hurricane-tracker/storm/${(storm.name ?? storm.id ?? "storm").toLowerCase().replace(/[^a-z0-9]+/g, "-")}/`}>Open storm tracker</a>{advisoryUrl(storm.publicAdvisory) && <a href={advisoryUrl(storm.publicAdvisory)} rel="noopener nofollow">NHC advisory</a>}</p></article>)}</div> : <div class="empty-state"><strong>No active Atlantic tropical cyclones at this time.</strong><p>{nextNameAnswer}</p><p>Other NHC basins may have active systems. <a href="/hurricane-tracker/live/">Open the live tracker for all current NHC systems.</a></p></div>}
    </div>
  </section>

  {otherBasinStorms.length > 0 && <section class="band" aria-labelledby="other-basin-storms"><div class="inner"><p class="eyebrow">Other current NHC basins</p><h2 id="other-basin-storms">Current Pacific Systems</h2><p class="answer">These systems are outside the 2026 Atlantic season count, but they remain visible in the all-basin live tracker with current NHC positions and advisories.</p><div class="grid-2 section-grid">{otherBasinStorms.map((storm) => <article class="season-card"><span class="status next">Other basin</span><h3>{storm.name ?? storm.id ?? "NHC system"}</h3><p>{storm.classification ?? "Tropical cyclone"} · {storm.intensity ? formatWind(Number(storm.intensity)) : storm.windSpeed ?? "Intensity pending"}</p><p>Position {storm.latitude ?? "pending"}, {storm.longitude ?? "pending"}</p><p class="source-note">Updated {storm.lastUpdate ?? lastModified}</p><p class="card-links"><a href="/hurricane-tracker/live/">Open all-basin live tracker</a>{advisoryUrl(storm.publicAdvisory) && <a href={advisoryUrl(storm.publicAdvisory)} rel="noopener nofollow">NHC advisory</a>}</p></article>)}</div></div></section>}

  {endedStorms.length > 0 && <section class="band" aria-labelledby="ended-storms"><div class="inner"><p class="eyebrow">Recorded 2026 Atlantic systems</p><h2 id="ended-storms">Recently Ended Atlantic Storms</h2><p class="answer">These systems have left the active NHC feed. Their tracker pages preserve the last recorded status and official source context without presenting them as current threats.</p><div class="grid-2 section-grid">{endedStorms.slice(0, 8).map((storm) => <article class="season-card"><span class="status dissipated">Ended</span><h3>{storm.name ?? storm.id ?? "Atlantic system"}</h3><p>{storm.classification ?? "Final classification"}{storm.intensity ? ` · ${formatWind(Number(storm.intensity))}` : ""}</p><p class="source-note">Last recorded {new Date(storm.lastSeen).toLocaleString("en-US", { dateStyle: "medium", timeStyle: "short", timeZone: "UTC" })} UTC</p><p class="card-links"><a href={`/hurricane-tracker/storm/${storm.slug}/`}>Open {storm.name ?? "storm"} archive</a></p></article>)}</div></div></section>}

  <section class="band stats-band" aria-labelledby="season-statistics"><div class="inner"><p class="eyebrow">Recorded season activity</p><h2 id="season-statistics">2026 Season Statistics</h2><p class="answer"><strong>{currentAnswer}</strong> {feedAvailable && <>Feed checked {verifiedLabel} UTC; check the advisory timestamp again before acting.</>}</p><div class="stats"><div><strong>{namedStorms}</strong><span>Named storms recorded</span></div><div><strong>Not verified</strong><span>Season hurricane total</span></div><div><strong>Not verified</strong><span>Season major hurricane total</span></div></div><p class="source-note">Named storms reflect HurricaneHub's observed registry, not a complete official season tally. Hurricane and major hurricane totals require each storm's historical peak intensity. The registry preserves latest status, not complete peak-intensity history; a post-tropical or ended storm may previously have been a hurricane. Consult <a href="https://www.nhc.noaa.gov/data/tcr/" rel="noopener nofollow">NHC Tropical Cyclone Reports</a> for official historical records as they become available.</p></div></section>

  <section class="band" aria-labelledby="season-timeline"><div class="inner"><p class="eyebrow">Season timing</p><h2 id="season-timeline">When Atlantic Hurricane Activity Usually Peaks</h2><ContentFigure src="/images/guides/atlantic-hurricane-season-timeline.svg" alt="Atlantic hurricane season timeline from June through November with the historical activity peak near September 10" caption="NOAA and NHC climatology place the historical peak near September 10. The curve provides seasonal context, not a forecast for 2026 or any individual storm." /></div></section>

  <section class="band" aria-labelledby="name-list"><div class="inner"><p class="eyebrow">Official sequence</p><h2 id="name-list">2026 Atlantic Storm Name List</h2><p class="answer">Names follow the <a href="https://www.nhc.noaa.gov/aboutnames.shtml" rel="noopener nofollow">official NHC 2026 Atlantic list</a>. Active and recorded labels reflect observed feed or registry records; “next” follows the latest recorded name. An unrecorded name does not prove that a storm has never formed. {nextNameAnswer}</p><ol class="name-grid">{nameRows.map((item) => <li>{stormNameLinks[item.name] ? <a href={stormNameLinks[item.name]}><span>{item.name}</span><small class:list={["status", item.status]}>{item.status}</small></a> : <span class="name-row"><span>{item.name}</span><small class:list={["status", item.status]}>{item.status}</small></span>}</li>)}</ol></div></section>

  <section class="band" aria-labelledby="state-impact"><div class="inner"><p class="eyebrow">Local planning</p><h2 id="state-impact">State-by-State Hurricane Impact</h2><p class="answer">Pair the season outlook with local NWS alerts, evacuation zones, surge risk, and county emergency instructions.</p><div class="state-grid">{coastalStates.map((state) => <article class="season-card"><h3>{state.name}</h3><p>{state.risks.slice(0, 3).join(" · ")}</p><a href={`/tracker/${state.slug}/`}>Open {state.name} tracker</a></article>)}</div></div></section>

  <section class="band prep-band" aria-labelledby="prepare-now"><div class="inner prep-grid"><div><p class="eyebrow">Household planning</p><h2 id="prepare-now">Prepare Before the Next Threat</h2><p>Build your supply plan, confirm evacuation triggers, and save official alert sources. Follow any current local warnings and evacuation orders.</p></div><p class="section-actions"><a class="action-link" href="/preparedness/">Preparedness guide</a><a class="action-link secondary-action" href="/tools/">Hurricane tools</a></p></div></section>

  <FaqBlock faqs={faqs} />

  <section class="band" aria-labelledby="related-season-links"><div class="inner"><p class="eyebrow">Continue monitoring</p><h2 id="related-season-links">2026 Season Resources</h2><nav class="related-links" aria-label="Related hurricane season pages"><a href="/storm-archive/">Storm archive</a><a href="/hurricane-tracker/live/">Live hurricane tracker</a><a href="/hurricane-tracker/tropical-disturbances/">Atlantic tropical outlook</a><a href="/blog/how-el-nino-affects-hurricanes/">How El Niño affects Atlantic hurricanes</a><a href="/blog/">Hurricane guides</a></nav></div></section>
</Layout>

<style>
  .season-hero { background: #092c3e; color: #fff; }
  .season-hero .answer { color: #dcebf1; }
  .hero-grid, .prep-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(240px, 340px); gap: 32px; align-items: center; }
  .status-panel { display: grid; gap: 4px; padding: 24px; border: 1px solid #477487; border-radius: 8px; background: #0d3c51; }
  .status-panel strong { font-size: 3rem; line-height: 1; }
  .status-panel span { font-weight: 800; }
  .status-panel small { color: #c6dce5; }
  .season-card, .empty-state { padding: 20px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface, #fff); }
  .season-card h3 { margin: 10px 0; }
  .card-links, .related-links { display: flex; flex-wrap: wrap; gap: 16px; font-weight: 800; }
  .stats-band, .prep-band { background: var(--surface, #f4f7f9); }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .stats div { display: grid; gap: 4px; padding: 20px; border-left: 4px solid var(--ocean); background: var(--bg, #fff); }
  .stats strong { font-size: 2rem; }
  .stats span { font-weight: 700; }
  .name-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; padding: 0; list-style-position: inside; }
  .name-grid li { border-bottom: 1px solid var(--line); }
  .name-grid a, .name-row { display: flex; justify-content: space-between; gap: 10px; padding: 12px 8px; font-weight: 800; text-decoration: none; }
  .status { align-self: start; width: fit-content; padding: 3px 7px; border-radius: 4px; background: #dce5e9; color: #27353b; font-size: .75rem; font-weight: 800; text-transform: uppercase; }
  .status.active { background: #bce8d1; color: #115b35; }
  .status.dissipated { background: #dce5e9; color: #35464e; }
  .status.next { background: #ffe3a8; color: #684600; }
  .state-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 760px) { .hero-grid, .prep-grid, .stats, .name-grid, .state-grid { grid-template-columns: 1fr; } }
  :global([data-theme="dark"]) .season-card, :global([data-theme="dark"]) .empty-state { background: #111d22; }
  :global([data-theme="dark"]) .stats div { background: #111d22; }
</style>
