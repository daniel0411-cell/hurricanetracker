---
import FaqBlock from "../components/FaqBlock.astro";
import AlertTimeline from "../components/AlertTimeline.astro";
import LiveDashboard from "../components/LiveDashboard.astro";
import LocalRiskWidget from "../components/LocalRiskWidget.astro";
import Layout from "../layouts/Layout.astro";
import { faqs, site, states } from "../data/site";
import { articleSchema, faqSchema, graph, websiteSchema } from "../lib/schema";

const title = "NWS Hurricane and Severe Weather Alerts by State";
const description = "View active National Weather Service alerts by coastal state with hurricane-focused severity and urgency context.";
const url = `${site.url}/alerts/`;

let lastModified = site.contentLastModified;
let initialAlerts: import("../lib/weather").NwsAlert[] = [];
try {
  const response = await fetch(new URL("/api/nws/alerts.json?area=AL", Astro.url));
  if (response.ok) {
    const feed = await response.json() as { updatedAt?: string; fetchedAt?: string; alerts?: import("../lib/weather").NwsAlert[] };
    lastModified = feed.updatedAt ?? feed.fetchedAt ?? lastModified;
    initialAlerts = feed.alerts ?? [];
  } else {
    console.error("HurricaneHub alerts page feed error", { status: response.status });
  }
} catch (error) {
  console.error("HurricaneHub alerts page feed failed", { error });
}

const jsonLd = graph(websiteSchema(), articleSchema({ title, description, url, dateModified: lastModified }), faqSchema(faqs));
---
<Layout title={title} description={description} canonical={url} jsonLd={jsonLd} lastModified={lastModified}>
  <section class="band" aria-labelledby="alerts-title">
    <div class="inner">
      <p class="eyebrow">NWS alert proxy</p>
      <h1 id="alerts-title">NWS Alerts by State</h1>
      <p class="answer">This page shows live NWS hurricane and severe weather alerts by state, with urgency, severity, and a HurricaneHub decision level for emergency planning.</p>
    </div>
  </section>
  <LocalRiskWidget />
  <LiveDashboard />
  <section class="band" aria-labelledby="timeline-heading">
    <div class="inner">
      <h2 id="timeline-heading">Example Alert Timeline</h2>
      <p class="answer">The timeline sorts a current example feed by alert status and effective time so you can see what is active now, what may start next, and when an alert expires.</p>
      <AlertTimeline alerts={initialAlerts} stateName="Alabama" />
    </div>
  </section>
  <section class="band" aria-labelledby="state-coverage">
    <div class="inner">
      <h2 id="state-coverage">Tracked Coastal States</h2>
      <p class="answer">Open any state tracker for live NWS alerts, NHC storm context, county planning notes, and a household decision level.</p>
      <div class="grid-3" style="margin-top: 18px;">
        {states.map(([, name]) => {
          const slug = name.toLowerCase().replace(/[^a-z]+/g, "-").replace(/^-|-$/g, "");
          return (
            <article class="panel">
              <h3>{name}</h3>
              <p>Active NWS alerts, storm context, and a household decision level for {name}.</p>
              <p><a class="action-link" href={`/tracker/${slug}/`}>Open {name} tracker</a></p>
            </article>
          );
        })}
      </div>
    </div>
  </section>
  <FaqBlock faqs={faqs} />
</Layout>
