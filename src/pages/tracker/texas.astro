---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StateAlerts from "../../components/StateAlerts.astro";
import StateActionPaths from "../../components/StateActionPaths.astro";
import StateTrackerSeoLinks from "../../components/StateTrackerSeoLinks.astro";
import StateCurrentAnswer from "../../components/StateCurrentAnswer.astro";
import { hurricaneCities } from "../../data/cities";
import { getStateSeoProfile } from "../../data/stateSeo";
import { getStateBySlug } from "../../data/states";
import { articleSchema, faqSchema, governmentServiceSchema, graph, itemListSchema, websiteSchema } from "../../lib/schema";
import { site } from "../../data/site";
import { getStateCurrentStatus, stateCurrentFaqs } from "../../lib/stateCurrent";

const state = getStateBySlug("texas")!;
const code = state.code;
const name = state.name;
const region = state.region;
const seo = getStateSeoProfile(state);
const title = seo.title;
const description = seo.description;
const canonical = `${site.url}/tracker/${state.slug}/`;
const lastModified = site.contentLastModified;
const currentStatus = await getStateCurrentStatus(code);

const intro = `Texas guards about 367 miles of Gulf of Mexico coastline, from the marshy upper coast near Port Arthur to the brush country around Brownsville. Most Texas hurricanes form in the western Gulf or recurve out of the Bay of Campeche, then drive north or northeast toward Galveston, Matagorda, or Corpus Christi. The state's wide, shallow shelf amplifies storm surge, while slow-moving systems can dump feet of rain far inland around Houston. Historically, Hurricane Harvey (2017) stalled over South Texas and became the wettest tropical cyclone in U.S. history, flooding entire communities. The 2026 Atlantic hurricane season runs June 1 through November 30, and late August is within the peak-season window, when Gulf waters are warmest. Because Texas evacuations can mean 100-plus-mile drives inland and long power outages, residents should prepare generators safely, stock water and fuel, and learn their county evacuation zone before a storm threatens.`;

const stateCities = hurricaneCities.filter((city) => city.stateCode === code);
const stateActionPaths = [
  {
    name: `${name} local risk action plan`,
    description: `Build a 72/48/24-hour household action plan from ${name} alerts, coastal hazards, and local constraints.`,
    url: `${site.url}/tools/local-risk-plan/?state=${code}`
  },
  {
    name: `${name} evacuation decision helper`,
    description: `Check whether surge exposure, housing type, transport, pets, or medical needs should move a ${name} household toward evacuation.`,
    url: `${site.url}/tools/evacuation-decision-helper/`
  },
  {
    name: `${name} alert action decoder`,
    description: `Translate official hurricane, surge, flood, tornado, and evacuation alerts into next actions for ${name} households.`,
    url: `${site.url}/tools/alert-action-decoder/`
  },
  {
    name: `${name} power outage planner`,
    description: `Plan charging, food safety, generator placement, medicine, and communication backup for ${name} hurricane outages.`,
    url: `${site.url}/tools/power-outage-planner/`
  }
];
const adjacent = ["louisiana"];

const faqs = [
  {
    question: `When is hurricane season in ${name}?`,
    answer: `The Atlantic hurricane season runs June 1 to November 30, with Texas most active from August through September as Gulf waters peak in warmth. Late August is within the peak-season window, so Gulf Coast households should keep an evacuation and power-outage plan ready.`
  },
  {
    question: `What was the worst hurricane to hit ${name}?`,
    answer: `Hurricane Harvey (2017) stalled over South Texas and dropped more than 60 inches of rain near Houston, causing catastrophic flooding. It remains the wettest tropical cyclone in U.S. recorded history and one of the costliest disasters nationwide.`
  },
  {
    question: `Does ${name} have hurricane evacuation routes?`,
    answer: `Yes. Texas coastal communities publish evacuation zones and routes. Residents should know local instructions, plan more than one route and destination, and leave at the directed time. Contraflow or lane reversal applies only when officials activate it for the event.`
  },
  {
    question: "How should I prepare for hurricane season in Texas?",
    answer: "Know the local evacuation zone, prepare water and food, protect medication and documents, plan for pets, check flood and surge exposure, arrange safe generator use, and account for long drives and extended heat during outages."
  }
];

const jsonLd = graph(
  websiteSchema(),
  governmentServiceSchema({ areaServed: name }),
  articleSchema({ title, description, url: canonical, dateModified: lastModified }),
  itemListSchema([
    ...stateCities.map((city) => ({
      name: `${city.name} Hurricane Tracker`,
      description: city.planningNote,
      url: `${site.url}/hurricane-tracker/city/${city.slug}/`
    })),
    ...stateActionPaths
  ]),
  faqSchema([...stateCurrentFaqs(name, currentStatus), ...faqs])
);
---
<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd} lastModified={lastModified}>
  <article class="band" aria-labelledby="tracker-state-title">
    <div class="inner">
      <p class="eyebrow">{region} hurricane operations</p>
      <h1 id="tracker-state-title">{seo.headline}</h1>
      <p class="answer">{intro}</p>
      <StateCurrentAnswer stateCode={code} stateName={name} status={currentStatus} />

      <section class="intent-answer" aria-labelledby="texas-outlook-heading">
        <h2 id="texas-outlook-heading">Tropical Storm Edouard: Texas Watch</h2>
        <p>NHC named Tropical Storm Edouard in the northwestern Gulf on August 31. A Tropical Storm Warning covers the Upper Texas coast from Port Bolivar eastward, and a Storm Surge Watch begins at High Island. Heavy rain and flash flooding are expected from the coast into east-central Texas as the system moves inland.</p>
        <p><a href="/hurricane-tracker/storm/edouard/">Track Tropical Storm Edouard and the latest NHC path</a></p>
      </section>

      <section class="intent-answer" aria-labelledby="texas-intent-heading">
        <h2 id="texas-intent-heading">Texas Hurricane Questions Today</h2>
        <p>This page answers “is there a hurricane coming to Texas,” “is Texas getting a hurricane,” “will the hurricane hit Texas,” and “is a hurricane coming to Houston” with current NHC context, Gulf risk, and Texas NWS alerts.</p>
      </section>

      <section class="intent-answer" aria-labelledby="texas-season-heading">
        <h2 id="texas-season-heading">How to Prepare for Hurricane Season in Texas</h2>
        <p>Texas hurricane preparation must cover both coastal surge and inland rainfall. Confirm the county evacuation zone and routes, choose a destination far enough from the threatened area, protect documents and medication, and prepare for heat, food safety, fuel limits, and prolonged outages. Houston-area households should treat bayou and street flooding as a separate risk from the forecast landfall point.</p>
        <p>Use the <a href="/tools/preparedness-checklist/">hurricane supply checklist</a> for household essentials and the <a href="/hurricane-tracker/evacuation-plan/">evacuation plan guide</a> for transport, destinations, pets, medical needs, and local triggers.</p>
      </section>

      <h2 id="alerts-heading">Active {name} NWS Alerts</h2>
      <p class="source-note">Live alerts are fetched directly from NOAA and NWS. Verify your county or evacuation zone before acting.</p>
      <StateAlerts state={code} />

      <h2 id="city-trackers">{name} City Hurricane Trackers</h2>
      <p class="source-note">Open city guides for local surge, flooding, evacuation-route, and outage planning notes within {name}.</p>
      <div class="grid-3" style="margin-top: 18px;">
        {stateCities.map((city) => (
          <article class="panel">
            <h3>{city.name} Hurricane Tracker</h3>
            <p>{city.planningNote}</p>
            <a href={`/hurricane-tracker/city/${city.slug}/`}>Open {city.name}</a>
          </article>
        ))}
      </div>

      <StateActionPaths state={state} />

      <StateTrackerSeoLinks state={state} cities={stateCities} />
      <p class="basin-link"><a href="/hurricane-tracker/gulf/">Compare this Texas track with the Gulf Hurricane Tracker</a> · <a href="/hurricane-tracker/live/">Check the live NHC hurricane tracker</a> · <a href="/2026-hurricane-season/">Review the 2026 hurricane season tracker</a></p>

      <h2 id="nearby-heading">Nearby State Hurricane Trackers</h2>
      <ul class="check-list">
        {adjacent.map((slug) => {
          const neighbor = getStateBySlug(slug);
          return neighbor ? <li><a href={`/tracker/${neighbor.slug}/`}>{neighbor.name} Hurricane Tracker</a></li> : null;
        })}
      </ul>
    </div>
  </article>
</BaseLayout>

<style>
  .answer { font-size: 1.05rem; line-height: 1.75; }
  .intent-answer { margin: 24px 0; padding: 18px 20px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface, #f3f7fa); }
  .intent-answer h2 { margin-top: 0; }
  .basin-link { margin: 24px 0; font-weight: 800; }
</style>
