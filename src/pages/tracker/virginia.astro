---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StateAlerts from "../../components/StateAlerts.astro";
import { getStateBySlug } from "../../data/states";
import { faqSchema, graph, websiteSchema } from "../../lib/schema";
import { site } from "../../data/site";

const state = getStateBySlug("virginia")!;
const code = state.code;
const name = state.name;
const region = state.region;
const title = `${name} Hurricane Tracker – Live NHC Data & Alerts`;
const description = `${name} real-time hurricane tracking with NOAA data, NWS alerts, evacuation info, and live updates for ${region}.`;
const canonical = `${site.url}/tracker/${state.slug}/`;
const lastModified = "2026-08-07";

const intro = `Virginia's hurricane exposure centers on the Chesapeake Bay and the Hampton Roads region, with about 110 miles of tidal shoreline opening to the Atlantic. Systems usually reach Virginia after recurving up the Mid-Atlantic coast, arriving as hurricanes or strong tropical storms that drive tidal flooding through the bay, spin up tornadoes, and topple trees onto power lines. Bridge-tunnels become critical constraints during evacuations. In 2003, Hurricane Isabel struck as a major hurricane and caused widespread wind damage, tidal flooding, and long outages across the Chesapeake region, the most damaging storm in recent Virginia memory. The 2026 Atlantic hurricane season runs June 1 through November 30, and early August is within the active window, so bay communities should monitor tropical threats and plan for tidal and river flooding, not just wind.`;

const adjacent = ["north-carolina"];

const faqs = [
  {
    question: `When is hurricane season in ${name}?`,
    answer: `Virginia's season runs June 1 through November 30, with risk highest from August through October as systems recurve up the Mid-Atlantic coast. Early August is within the active period, so Chesapeake Bay communities should monitor tropical threats.`
  },
  {
    question: `What was the worst hurricane to hit ${name}?`,
    answer: `Hurricane Isabel (2003) struck the Virginia coast as a major hurricane, causing widespread wind damage, tidal flooding, and prolonged power outages across the Chesapeake Bay region. It remains the most damaging hurricane in recent Virginia memory.`
  },
  {
    question: `Does ${name} have hurricane evacuation routes?`,
    answer: `Yes. Virginia's coastal and Chesapeake communities use evacuation zones set by locality, with bridge-tunnel constraints on routes like the Hampton Roads crossings. Residents should follow local orders and plan for tidal and river flooding, not just wind.`
  }
];

const jsonLd = graph(websiteSchema(), faqSchema(faqs));
---
<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd} lastModified={lastModified}>
  <article class="band" aria-labelledby="tracker-state-title">
    <div class="inner">
      <p class="eyebrow">{region} hurricane operations</p>
      <h1 id="tracker-state-title">{name} Hurricane Tracker – Live Updates</h1>
      <p class="answer">{intro}</p>

      <h2 id="alerts-heading">Active {name} NWS Alerts</h2>
      <p class="source-note">Live alerts are fetched directly from NOAA and NWS. Verify your county or evacuation zone before acting.</p>
      <StateAlerts state={code} />

      <h2 id="nearby-heading">Nearby State Hurricane Trackers</h2>
      <ul class="check-list">
        {adjacent.map((slug) => {
          const neighbor = getStateBySlug(slug);
          return neighbor ? <li><a href={`/tracker/${neighbor.slug}/`}>{neighbor.name} Hurricane Tracker</a></li> : null;
        })}
      </ul>
    </div>
  </article>
</BaseLayout>

<style>
  .answer { font-size: 1.05rem; line-height: 1.75; }
</style>
