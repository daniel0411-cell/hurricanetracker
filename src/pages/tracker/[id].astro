---
import Layout from "../../layouts/Layout.astro";
import StormLocationCompare from "../../components/StormLocationCompare.astro";
import { faqs, site } from "../../data/site";
import { articleSchema, faqSchema, graph, websiteSchema } from "../../lib/schema";
import { advisoryUrl, type NhcStorm } from "../../lib/weather";

type StormFeed = {
  storms?: Array<NhcStorm & { summary?: string }>;
  updatedAt?: string;
  fetchedAt?: string;
};

const id = Astro.params.id ?? "";
const title = `Live Hurricane Detail: ${id}`;
const description = "View a live NHC storm detail with current position, advisory context, approximate ZIP distance, and official emergency-planning links.";
const url = `${site.url}/tracker/${encodeURIComponent(id)}/`;

let feed: StormFeed | null = null;
try {
  const response = await fetch(new URL("/api/nhc/current.json", Astro.url));
  if (response.ok) {
    feed = await response.json() as StormFeed;
  } else {
    console.error("HurricaneHub storm detail feed error", { id, status: response.status });
  }
} catch (error) {
  console.error("HurricaneHub storm detail feed failed", { id, error });
}

const storm = (feed?.storms ?? []).find((item) => {
  const keys = [item.id, item.name, item.binNumber].filter(Boolean).map((value) => String(value).toLowerCase());
  return keys.includes(id.toLowerCase());
});
const publicAdvisory = advisoryUrl(storm?.publicAdvisory);
const forecastAdvisory = advisoryUrl(storm?.forecastAdvisory);
const lastModified = feed?.updatedAt ?? feed?.fetchedAt ?? site.contentLastModified;
const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title, description, url, dateModified: lastModified }),
  faqSchema(faqs)
);
---
<Layout title={title} description={description} canonical={url} jsonLd={jsonLd} lastModified={lastModified}>
  <section class="band" aria-labelledby="storm-detail-title">
    <div class="inner">
      <p class="eyebrow">NHC storm detail</p>
      <h1 id="storm-detail-title">{storm?.name ?? "暂无活跃风暴"}</h1>
      <p class="answer">This page shows the latest NHC details for this active storm, including its current position, intensity, movement, official advisory links, and an approximate ZIP-to-storm distance for planning context.</p>
    </div>
  </section>

  <section class="band" aria-labelledby="detail-heading">
    <div class="inner grid-2">
      <article class="panel">
        <h2 id="detail-heading">Current Advisory</h2>
        {storm ? (
          <>
            <h3>{storm.classification ?? "Tropical system"}</h3>
            <p>{storm.summary ?? "NHC advisory data loaded for this system."}</p>
            <table>
              <tbody>
                <tr><th>Intensity</th><td>{storm.intensity ?? storm.windSpeed ?? "pending"}</td></tr>
                <tr><th>Pressure</th><td>{storm.pressure ?? "pending"}</td></tr>
                <tr><th>Position</th><td>{storm.latitude ?? "pending"}, {storm.longitude ?? "pending"}</td></tr>
                <tr><th>Movement</th><td>{storm.movementDir ?? "pending"} at {storm.movementSpeed ?? "pending"}</td></tr>
                <tr><th>NHC update</th><td>{storm.lastUpdate ?? feed?.updatedAt ?? "pending"}</td></tr>
              </tbody>
            </table>
            <p class="storm-detail-links">
              {publicAdvisory && <a href={publicAdvisory} rel="nofollow">Read NHC public advisory</a>}
              {forecastAdvisory && <a href={forecastAdvisory} rel="nofollow">Read NHC forecast advisory</a>}
            </p>
          </>
        ) : (
          <>
            <h3>暂无活跃风暴</h3>
            <p>No active NHC storm matched this detail URL. Return to the tracker for the current storm list.</p>
          </>
        )}
      </article>
      <article class="panel">
        <h2>Decision Note</h2>
        <h3>Before Acting</h3>
        <p>Confirm your county warning, evacuation order, shelter status, and travel route. A storm's current position does not show its future impact area, so local emergency management controls official instructions.</p>
        <p><a class="action-link" href="/tools/local-risk-plan/">Check my local risk and action plan</a></p>
      </article>
    </div>
  </section>

  {storm && (
    <section class="band">
      <div class="inner">
        <StormLocationCompare
          stormName={storm.name ?? storm.id ?? "this storm"}
          latitude={storm.latitude}
          longitude={storm.longitude}
          publicAdvisory={publicAdvisory}
          forecastAdvisory={forecastAdvisory}
        />
      </div>
    </section>
  )}
</Layout>

<style>
  .storm-detail-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin: 18px 0 0;
    font-weight: 800;
  }
</style>
