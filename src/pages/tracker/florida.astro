---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StateAlerts from "../../components/StateAlerts.astro";
import StateActionPaths from "../../components/StateActionPaths.astro";
import StateTrackerSeoLinks from "../../components/StateTrackerSeoLinks.astro";
import StateCurrentAnswer from "../../components/StateCurrentAnswer.astro";
import { hurricaneCities } from "../../data/cities";
import { getStateSeoProfile } from "../../data/stateSeo";
import { getStateBySlug } from "../../data/states";
import { articleSchema, faqSchema, governmentServiceSchema, graph, itemListSchema, websiteSchema } from "../../lib/schema";
import { site } from "../../data/site";
import { getStateCurrentStatus, stateCurrentFaqs } from "../../lib/stateCurrent";

const state = getStateBySlug("florida")!;
const code = state.code;
const name = state.name;
const region = state.region;
const seo = getStateSeoProfile(state);
const title = seo.title;
const description = seo.description;
const canonical = `${site.url}/tracker/${state.slug}/`;
const lastModified = site.contentLastModified;
const currentStatus = await getStateCurrentStatus(code);

const intro = `Florida faces the Atlantic and Gulf of Mexico at once, giving it more than 1,300 miles of tidal coastline—the longest of any hurricane-prone state. Storms typically organize near the Bahamas or in the Caribbean and track west across South Florida, or curve north into the Panhandle and Big Bend, while others develop in the Gulf and threaten Tampa Bay or the central coast. Because the peninsula is low and surrounded by warm water, rapid intensification just before landfall is common. In recent memory, Hurricane Michael (2018) struck the Panhandle as a catastrophic Category 5, and Hurricane Ian (2022) produced deadly storm surge and flooding across southwest Florida. The 2026 Atlantic hurricane season runs June 1 through November 30, and late August falls within the climatological peak-season window, when sea-surface temperatures are warmest. Residents should confirm evacuation zones and keep a ready-to-go plan before any system forms, because bridge and causeway closures often arrive well ahead of landfall.`;

const stateCities = hurricaneCities.filter((city) => city.stateCode === code);
const stateActionPaths = [
  {
    name: `${name} local risk action plan`,
    description: `Build a 72/48/24-hour household action plan from ${name} alerts, coastal hazards, and local constraints.`,
    url: `${site.url}/tools/local-risk-plan/?state=${code}`
  },
  {
    name: `${name} evacuation decision helper`,
    description: `Check whether surge exposure, housing type, transport, pets, or medical needs should move a ${name} household toward evacuation.`,
    url: `${site.url}/tools/evacuation-decision-helper/`
  },
  {
    name: `${name} alert action decoder`,
    description: `Translate official hurricane, surge, flood, tornado, and evacuation alerts into next actions for ${name} households.`,
    url: `${site.url}/tools/alert-action-decoder/`
  },
  {
    name: `${name} power outage planner`,
    description: `Plan charging, food safety, generator placement, medicine, and communication backup for ${name} hurricane outages.`,
    url: `${site.url}/tools/power-outage-planner/`
  }
];
const adjacent = ["georgia", "alabama"];
const gulfLinks = [
  { href: "/hurricane-tracker/gulf/", label: "Gulf Hurricane Tracker" },
  { href: "/tracker/texas/", label: "Texas Hurricane Tracker" },
  { href: "/tracker/louisiana/", label: "Louisiana Hurricane Tracker" },
  { href: "/tracker/mississippi/", label: "Mississippi Hurricane Tracker" },
  { href: "/tracker/alabama/", label: "Alabama Hurricane Tracker" }
];

const faqs = [
  {
    question: `When is hurricane season in ${name}?`,
    answer: `The Atlantic hurricane season runs June 1 through November 30. Florida faces elevated risk from August through October, with the climatological peak around September 10. Late August is within the peak-season window, so residents should keep supplies current and know their evacuation zone year-round.`
  },
  {
    question: `What was the worst hurricane to hit ${name}?`,
    answer: `Hurricane Michael (2018) was a catastrophic Category 5 landfall on the Florida Panhandle, among the strongest U.S. landfalls on record. Hurricane Ian (2022) caused deadly storm surge and historic flooding across southwest Florida, making it one of the costliest storms in state history.`
  },
  {
    question: `Does ${name} have hurricane evacuation routes?`,
    answer: `Yes. Florida counties set evacuation zones and routes for local hazards. Coastal and barrier-island residents should learn their zone and plan more than one route. Lane reversals or special traffic controls apply only when officials announce them for the current storm.`
  },
  {
    question: "What belongs on a Florida hurricane supply list?",
    answer: "Include water, shelf-stable food, medication, first aid, lighting, batteries, charging, documents, cash, hygiene, pet needs, weather alerts, and portable evacuation supplies. Adjust the list for heat, flooding, housing, and medical needs."
  },
  {
    question: "How do I make a Florida hurricane evacuation plan?",
    answer: "Confirm the county evacuation zone, choose two destinations and routes, plan transport for people and pets, record official alerts, and leave when local authorities direct the zone. Do not use an insurance flood zone as the only trigger."
  }
];

const jsonLd = graph(
  websiteSchema(),
  governmentServiceSchema({ areaServed: name }),
  articleSchema({ title, description, url: canonical, dateModified: lastModified }),
  itemListSchema([
    ...stateCities.map((city) => ({
      name: `${city.name} Hurricane Tracker`,
      description: city.planningNote,
      url: `${site.url}/hurricane-tracker/city/${city.slug}/`
    })),
    ...stateActionPaths
  ]),
  faqSchema([...stateCurrentFaqs(name, currentStatus), ...faqs])
);
---
<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd} lastModified={lastModified}>
  <article class="band" aria-labelledby="tracker-state-title">
    <div class="inner">
      <p class="eyebrow">{region} hurricane operations</p>
      <h1 id="tracker-state-title">{seo.headline}</h1>
      <p class="answer">{intro}</p>
      <StateCurrentAnswer stateCode={code} stateName={name} status={currentStatus} />

      <section class="intent-answer" aria-labelledby="florida-intent-heading">
        <h2 id="florida-intent-heading">Florida Hurricane Questions Today</h2>
        <p>Users searching “is there a hurricane coming to Florida,” “is Florida getting a hurricane,” and “will the hurricane hit Florida” should start here. Check the live NHC answer above, then compare Florida NWS alerts, evacuation zones, and city trackers for Miami, Tampa, Orlando, Jacksonville, and the Panhandle.</p>
      </section>

      <section class="intent-answer" aria-labelledby="florida-preparedness-heading">
        <h2 id="florida-preparedness-heading">How to Prepare for a Hurricane in Florida</h2>
        <p>Start before a storm forms: confirm the county evacuation zone, identify a safe room and two destinations, protect documents, refill permitted prescriptions, plan for pets, and prepare for heat and extended outages. A “Florida hurricane box” should be a portable part of the broader plan, not the entire plan.</p>
        <p><a href="/tools/preparedness-checklist/">Build a Florida hurricane supply list</a>, then use the <a href="/hurricane-tracker/evacuation-plan/">hurricane evacuation plan</a> to record routes, transport, contacts, and departure triggers.</p>
      </section>

      <section class="intent-answer" aria-labelledby="florida-evacuation-heading">
        <h2 id="florida-evacuation-heading">Florida Hurricane Evacuation Plan</h2>
        <p>Use the county address lookup rather than ZIP code or an insurance flood map. Choose a primary and backup destination outside the threatened area, plan more than one route, and allow extra time for barrier islands, bridges, medical equipment, disability, children, pets, or no personal vehicle. Follow current county and state instructions; do not assume contraflow or a bridge will remain open.</p>
      </section>

      <h2 id="alerts-heading">Active {name} NWS Alerts</h2>
      <p class="source-note">Live alerts are fetched directly from NOAA and NWS. Verify your county or evacuation zone before acting.</p>
      <StateAlerts state={code} />

      <h2 id="city-trackers">Florida Hurricane Tracker by City</h2>
      <p class="source-note">Open city guides for local surge, flooding, evacuation-route, and outage planning notes within {name}.</p>
      <div class="grid-3" style="margin-top: 18px;">
        {stateCities.map((city) => (
          <article class="panel">
            <h3>{city.name} Hurricane Tracker</h3>
            <p>{city.planningNote}</p>
            <a href={`/hurricane-tracker/city/${city.slug}/`}>Open {city.name}</a>
          </article>
        ))}
      </div>

      <section class="city-intent-strip" aria-labelledby="florida-city-intent-heading">
        <h3 id="florida-city-intent-heading">Florida Hurricane Tracker Today by City</h3>
        <p>For local searches such as Orlando hurricane today, Miami hurricane tracker, or Tampa Bay storm risk, open the closest city guide and verify county alerts.</p>
        <div class="city-intent-links">
          {stateCities.slice(0, 8).map((city) => <a href={`/hurricane-tracker/city/${city.slug}/`}>{city.name} hurricane tracker</a>)}
        </div>
      </section>

      <StateActionPaths state={state} />

      <StateTrackerSeoLinks state={state} cities={stateCities} />

      <section class="gulf-links" aria-labelledby="florida-gulf-heading">
        <h2 id="florida-gulf-heading">Florida Gulf Hurricane Tracker Connections</h2>
        <p>Florida Gulf searches overlap with Texas, Louisiana, Mississippi, and Alabama storm questions. Use the Gulf basin page first, then open the state page closest to your location.</p>
        <ul class="check-list">{gulfLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
      </section>

      <h2 id="nearby-heading">Nearby State Hurricane Trackers</h2>
      <ul class="check-list">
        {adjacent.map((slug) => {
          const neighbor = getStateBySlug(slug);
          return neighbor ? <li><a href={`/tracker/${neighbor.slug}/`}>{neighbor.name} Hurricane Tracker</a></li> : null;
        })}
      </ul>
    </div>
  </article>
</BaseLayout>

<style>
  .answer { font-size: 1.05rem; line-height: 1.75; }
  .intent-answer { margin: 24px 0; padding: 18px 20px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface, #f3f7fa); }
  .intent-answer h2 { margin-top: 0; }
  .gulf-links { margin-top: 28px; padding: 20px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface, #f3f7fa); }
  .gulf-links h2 { margin-top: 0; }
  .city-intent-strip { margin: 24px 0; padding: 18px 20px; border-top: 3px solid var(--ocean); background: var(--surface, #f3f7fa); }
  .city-intent-strip h3 { margin-top: 0; }
  .city-intent-links { display: flex; flex-wrap: wrap; gap: 8px 16px; font-weight: 800; }
</style>
