---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StateAlerts from "../../components/StateAlerts.astro";
import StateActionPaths from "../../components/StateActionPaths.astro";
import StateTrackerSeoLinks from "../../components/StateTrackerSeoLinks.astro";
import { hurricaneCities } from "../../data/cities";
import { getStateBySlug } from "../../data/states";
import { articleSchema, faqSchema, graph, itemListSchema, websiteSchema } from "../../lib/schema";
import { site } from "../../data/site";

const state = getStateBySlug("florida")!;
const code = state.code;
const name = state.name;
const region = state.region;
const title = `${name} Hurricane Tracker – Live NHC Data & Alerts`;
const description = `${name} real-time hurricane tracking with NOAA data, NWS alerts, evacuation info, and live updates for ${region}.`;
const canonical = `${site.url}/tracker/${state.slug}/`;
const lastModified = "2026-08-07";

const intro = `Florida faces the Atlantic and Gulf of Mexico at once, giving it more than 1,300 miles of tidal coastline—the longest of any hurricane-prone state. Storms typically organize near the Bahamas or in the Caribbean and track west across South Florida, or curve north into the Panhandle and Big Bend, while others develop in the Gulf and threaten Tampa Bay or the central coast. Because the peninsula is low and surrounded by warm water, rapid intensification just before landfall is common. In recent memory, Hurricane Michael (2018) struck the Panhandle as a catastrophic Category 5, and Hurricane Ian (2022) produced deadly storm surge and flooding across southwest Florida. The 2026 Atlantic hurricane season runs June 1 through November 30, and early August sits in the climatological ramp toward the September peak, when sea-surface temperatures are warmest. Residents should confirm evacuation zones and keep a ready-to-go plan before any system forms, because bridge and causeway closures often arrive well ahead of landfall.`;

const stateCities = hurricaneCities.filter((city) => city.stateCode === code);
const stateActionPaths = [
  {
    name: `${name} local risk action plan`,
    description: `Build a 72/48/24-hour household action plan from ${name} alerts, coastal hazards, and local constraints.`,
    url: `${site.url}/tools/local-risk-plan/?state=${code}`
  },
  {
    name: `${name} evacuation decision helper`,
    description: `Check whether surge exposure, housing type, transport, pets, or medical needs should move a ${name} household toward evacuation.`,
    url: `${site.url}/tools/evacuation-decision-helper/`
  },
  {
    name: `${name} alert action decoder`,
    description: `Translate official hurricane, surge, flood, tornado, and evacuation alerts into next actions for ${name} households.`,
    url: `${site.url}/tools/alert-action-decoder/`
  },
  {
    name: `${name} power outage planner`,
    description: `Plan charging, food safety, generator placement, medicine, and communication backup for ${name} hurricane outages.`,
    url: `${site.url}/tools/power-outage-planner/`
  }
];
const adjacent = ["georgia", "alabama"];

const faqs = [
  {
    question: `When is hurricane season in ${name}?`,
    answer: `The Atlantic hurricane season runs June 1 through November 30. Florida faces elevated risk from August through October, with the climatological peak around September 10. Early August is already inside the active window, so residents should keep supplies current and know their evacuation zone year-round.`
  },
  {
    question: `What was the worst hurricane to hit ${name}?`,
    answer: `Hurricane Michael (2018) was a catastrophic Category 5 landfall on the Florida Panhandle, among the strongest U.S. landfalls on record. Hurricane Ian (2022) caused deadly storm surge and historic flooding across southwest Florida, making it one of the costliest storms in state history.`
  },
  {
    question: `Does ${name} have hurricane evacuation routes?`,
    answer: `Yes. Florida uses labeled evacuation zones (A, B, C and beyond) set by county emergency management, not ZIP code. Coastal and barrier-island residents should learn their zone, identify Contraflow routes, and plan to leave before bridges and causeways close.`
  }
];

const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title, description, url: canonical, dateModified: lastModified }),
  itemListSchema([
    ...stateCities.map((city) => ({
      name: `${city.name} Hurricane Tracker`,
      description: city.planningNote,
      url: `${site.url}/hurricane-tracker/city/${city.slug}/`
    })),
    ...stateActionPaths
  ]),
  faqSchema(faqs)
);
---
<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd} lastModified={lastModified}>
  <article class="band" aria-labelledby="tracker-state-title">
    <div class="inner">
      <p class="eyebrow">{region} hurricane operations</p>
      <h1 id="tracker-state-title">{name} Hurricane Tracker – Live Updates</h1>
      <p class="answer">{intro}</p>

      <h2 id="alerts-heading">Active {name} NWS Alerts</h2>
      <p class="source-note">Live alerts are fetched directly from NOAA and NWS. Verify your county or evacuation zone before acting.</p>
      <StateAlerts state={code} />

      <h2 id="city-trackers">{name} City Hurricane Trackers</h2>
      <p class="source-note">Open city guides for local surge, flooding, evacuation-route, and outage planning notes within {name}.</p>
      <div class="grid-3" style="margin-top: 18px;">
        {stateCities.map((city) => (
          <article class="panel">
            <h3>{city.name} Hurricane Tracker</h3>
            <p>{city.planningNote}</p>
            <a href={`/hurricane-tracker/city/${city.slug}/`}>Open {city.name}</a>
          </article>
        ))}
      </div>

      <StateActionPaths state={state} />

      <StateTrackerSeoLinks state={state} cities={stateCities} />

      <h2 id="nearby-heading">Nearby State Hurricane Trackers</h2>
      <ul class="check-list">
        {adjacent.map((slug) => {
          const neighbor = getStateBySlug(slug);
          return neighbor ? <li><a href={`/tracker/${neighbor.slug}/`}>{neighbor.name} Hurricane Tracker</a></li> : null;
        })}
      </ul>
    </div>
  </article>
</BaseLayout>

<style>
  .answer { font-size: 1.05rem; line-height: 1.75; }
</style>
