---
import FaqBlock from "../../components/FaqBlock.astro";
import ConeVsImpact from "../../components/ConeVsImpact.astro";
import Layout from "../../layouts/Layout.astro";
import { faqs, site } from "../../data/site";
import { hurricaneCities } from "../../data/cities";
import { coastalStates } from "../../data/states";
import { topicPages } from "../../data/topicPages";
import { articleSchema, faqSchema, governmentServiceSchema, graph, websiteSchema } from "../../lib/schema";
import type { NhcStorm, NwsAlert } from "../../lib/weather";

type StormFeed = {
  storms?: Array<NhcStorm & { summary?: string }>;
  fetchedAt?: string;
  updatedAt?: string;
  error?: string;
};

type AlertFeed = {
  alerts?: NwsAlert[];
  decisionLevel?: string;
  fetchedAt?: string;
  updatedAt?: string;
  error?: string;
};

const title = "Live Hurricane Tracker";
const description = "Track live hurricanes approaching North America with NHC storm advisories, Alabama NWS alerts, and emergency decision context.";
const url = `${site.url}/tracker/`;

async function loadJson<T>(path: string): Promise<T | null> {
  try {
    const response = await fetch(new URL(path, Astro.url));
    if (!response.ok) {
      console.error("HurricaneHub tracker feed error", { path, status: response.status });
      return null;
    }
    return await response.json() as T;
  } catch (error) {
    console.error("HurricaneHub tracker feed failed", { path, error });
    return null;
  }
}

const [stormFeed, alertFeed] = await Promise.all([
  loadJson<StormFeed>("/api/nhc/current.json"),
  loadJson<AlertFeed>("/api/nws/alerts.json?area=AL")
]);

const storms = stormFeed?.storms ?? [];
const alerts = alertFeed?.alerts ?? [];
const decisionLevel = alertFeed?.decisionLevel ?? (storms.length ? "Prepare" : "Monitor");
const lastModified = stormFeed?.updatedAt ?? alertFeed?.updatedAt ?? site.contentLastModified;
const featuredCities = hurricaneCities.slice(0, 12);
const stateDemandOrder = ["georgia", "north-carolina", "texas", "florida", "virginia", "south-carolina", "louisiana", "mississippi", "alabama"];
const orderedStates = [...coastalStates].sort((a, b) => stateDemandOrder.indexOf(a.slug) - stateDemandOrder.indexOf(b.slug));
const trackerTopicHubs = topicPages.map((page) => ({
  title: page.title,
  href: `/hurricane-tracker/${page.slug}/`,
  description: page.description,
  intent: page.intent
}));
const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title, description, url, dateModified: lastModified }),
  governmentServiceSchema({ areaServed: "United States Atlantic and Gulf Coast states" }),
  faqSchema(faqs)
);
---
<Layout title={title} description={description} canonical={url} jsonLd={jsonLd} lastModified={lastModified}>
  <section class="band tracker-hero" aria-labelledby="tracker-title">
    <div class="inner tracker-hero-grid">
      <article class="section-intro">
        <p class="eyebrow">NHC + NWS live data</p>
        <h1 id="tracker-title">Live Hurricane Tracker</h1>
        <p class="answer">This page shows live hurricanes approaching North America, current NHC storm summaries, state NWS alerts, and decision-focused links for coastal households preparing for severe tropical weather.</p>
        <p class="section-actions">
          <a class="action-link" href="/tools/my-hurricane-dashboard/">Build my dashboard</a>
          <a class="action-link tracker-secondary" href="/hurricane-tracker/storm/">Browse named storms</a>
        </p>
      </article>

      <aside class="panel tracker-summary" aria-label="Current tracker summary">
        <p class="eyebrow">Current snapshot</p>
        <h2>{decisionLevel}</h2>
        <div class="tracker-metrics">
          <div class="metric"><strong>{storms.length}</strong><span>active NHC systems</span></div>
          <div class="metric"><strong>{alerts.length}</strong><span>Alabama NWS alerts</span></div>
        </div>
        <p class="source-note">Updated {new Date(lastModified).toLocaleString("en-US", { timeZone: "UTC" })} UTC.</p>
      </aside>
    </div>
  </section>

  <section class="band" aria-labelledby="tracker-shortcuts-heading">
    <div class="inner grid-3 section-grid">
      <article class="panel">
        <p class="eyebrow">Live map hub</p>
        <h2 id="tracker-shortcuts-heading">Live Hurricane Tracker Map</h2>
        <p>Use the keyword-focused live tracker hub for active storm checks, radar shortcuts, alerts, and local page links.</p>
        <a href="/hurricane-tracker/live/">Open live map hub</a>
      </article>
      <article class="panel">
        <p class="eyebrow">Storm names</p>
        <h2>Named Hurricane Trackers</h2>
        <p>Open standing storm-name pages that check the current NHC feed and link to official advisory context.</p>
        <a href="/hurricane-tracker/storm/">Browse named storms</a>
      </article>
      <article class="panel">
        <p class="eyebrow">Local pages</p>
        <h2>City Hurricane Trackers</h2>
        <p>Move from storm position to local surge, flood, route, outage, and alert context by city.</p>
        <a href="/hurricane-tracker/city/">Browse city trackers</a>
      </article>
    </div>
  </section>

  <section class="band" aria-labelledby="state-trackers-heading">
    <div class="inner">
      <p class="eyebrow">State desks</p>
      <h2 id="state-trackers-heading">Choose a State Hurricane Tracker</h2>
      <p class="answer">Open a state page for local NWS alerts, county planning notes, source timestamps, and a Monitor/Prepare/Act/Leave decision guide.</p>
      <div class="grid-3 section-grid">
        {orderedStates.map((state) => (
          <article class="panel">
            <h3>{state.name}</h3>
            <p>{state.region}. Watch for {state.risks.slice(0, 2).join(" and ")}.</p>
            <a href={`/tracker/${state.slug}/`}>View {state.name} tracker</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="tracker-topic-heading">
    <div class="inner">
      <p class="eyebrow">Popular tracker intents</p>
      <h2 id="tracker-topic-heading">Hurricane Tracker Topic Hubs</h2>
      <p class="answer">Open these pages when your question is about maps, path tracking, evacuation zones, or storm surge instead of one state.</p>
      <div class="grid-2 section-grid">
        {trackerTopicHubs.map((hub) => (
          <article class="panel">
            <p class="eyebrow">{hub.intent}</p>
            <h3><a href={hub.href}>{hub.title}</a></h3>
            <p>{hub.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="city-trackers-heading">
    <div class="inner">
      <p class="eyebrow">City risk desks</p>
      <h2 id="city-trackers-heading">Local City Hurricane Trackers</h2>
      <p class="answer">Open a city page for local storm surge, flooding, route, bridge, outage, and evacuation notes tied to state alerts and NHC context.</p>
      <p class="section-actions"><a class="action-link tracker-secondary" href="/hurricane-tracker/city/">Browse all city trackers</a></p>
      <div class="grid-3 section-grid">
        {featuredCities.map((city) => (
          <article class="panel">
            <h3>{city.name}</h3>
            <p>{city.region}. Watch for {city.risks.slice(0, 2).join(" and ")}.</p>
            <a href={`/hurricane-tracker/city/${city.slug}/`}>View {city.name} tracker</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="live-data-heading">
    <div class="inner live-data-grid">
      <article class="storm-visual">
        <p class="eyebrow">Official feed view</p>
        <h2 id="live-data-heading">Active NHC Storms</h2>
        <div class="map-shell" role="img" aria-label="Stylized Gulf and Atlantic hurricane risk map">
          <div class="map-label">
            <span class="badge danger">Warning decisions</span>
            <span class="badge warn">Watch planning</span>
            <span class="badge">NHC advisory feed</span>
          </div>
        </div>
        <p class="source-note">Last checked: {new Date(lastModified).toLocaleString("en-US", { timeZone: "UTC" })} UTC</p>
      </article>

      <article class="panel decision-panel">
        <h2>Emergency Decision</h2>
        <div class="metric">
          <strong>{decisionLevel}</strong>
          <span>current Alabama decision level from NWS alerts and NHC storm context</span>
        </div>
        <h3>How to Use This</h3>
        <p>Start with your local warning, compare active storm movement, then choose whether to monitor, prepare, act, or leave before road and shelter options narrow.</p>
      </article>
    </div>
  </section>

  <section class="band" aria-labelledby="storms-heading">
    <div class="inner">
      <p class="eyebrow">NHC advisories</p>
      <h2 id="storms-heading">Storm Advisory List</h2>
      <div class="stack section-grid">
        {storms.length ? storms.map((storm) => (
          <article class="storm-row">
            <header>
              <h3>{storm.name ?? storm.id ?? "Active tropical system"}</h3>
              <span class="badge warn">{storm.classification ?? "NHC"}</span>
            </header>
            <p>{storm.summary ?? "NHC advisory data loaded for this system."}</p>
            <p class="small">
              Position: {storm.latitude ?? "pending"}, {storm.longitude ?? "pending"} ·
              Pressure: {storm.pressure ?? "pending"} ·
              Updated: {storm.lastUpdate ?? stormFeed?.fetchedAt ?? "pending"}
            </p>
            <a href={`/tracker/${encodeURIComponent(storm.id ?? storm.name ?? "storm")}/`}>View storm detail</a>
          </article>
        )) : (
          <article class="panel">
            <h3>暂无活跃风暴</h3>
            <p>No active NHC tropical cyclone is listed right now. Keep monitoring official advisories during hurricane season because tropical outlooks can change quickly.</p>
          </article>
        )}
      </div>
    </div>
  </section>

  <ConeVsImpact />

  <section class="band" aria-labelledby="alerts-heading">
    <div class="inner">
      <p class="eyebrow">Default state alert feed</p>
      <h2 id="alerts-heading">Alabama NWS Alerts</h2>
      <p class="source-note">Alabama is shown as the default live example. Use the state tracker links above for other coastal states.</p>
      <div class="stack section-grid">
        {alerts.length ? alerts.slice(0, 10).map((alert) => (
          <article class="alert-row">
            <header>
              <h3>{alert.event}</h3>
              <span class={alert.severity === "Severe" || alert.severity === "Extreme" ? "badge danger" : "badge warn"}>{alert.severity}</span>
            </header>
            <p>{alert.headline || alert.areaDesc}</p>
            <p class="small">{alert.urgency} · {alert.certainty} · expires {alert.expires}</p>
          </article>
        )) : (
          <article class="panel">
            <h3>No Active Alabama Alerts</h3>
            <p>No active NWS alerts were returned for Alabama. Use this as a monitoring state, not an all-clear for your county.</p>
          </article>
        )}
      </div>
    </div>
  </section>

  <FaqBlock faqs={faqs} />
</Layout>

<style>
  .tracker-secondary {
    background: var(--navy);
  }

  .tracker-hero {
    padding-top: clamp(54px, 7vw, 90px);
    padding-bottom: clamp(54px, 7vw, 90px);
  }

  .tracker-hero-grid,
  .live-data-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 430px);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
  }

  .tracker-summary {
    display: grid;
    gap: 16px;
  }

  .tracker-summary h2 {
    font-size: clamp(2rem, 4vw, 3.1rem);
  }

  .tracker-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .tracker-metrics .metric {
    min-height: 104px;
  }

  .section-grid {
    margin-top: 22px;
  }

  .storm-visual {
    min-width: 0;
  }

  .storm-visual .map-shell {
    margin-top: 18px;
  }

  .decision-panel {
    display: grid;
    gap: 18px;
  }

  .decision-panel .metric {
    min-height: 132px;
  }

  @media (max-width: 920px) {
    .tracker-hero-grid,
    .live-data-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
