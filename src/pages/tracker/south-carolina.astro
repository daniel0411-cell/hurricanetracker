---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StateAlerts from "../../components/StateAlerts.astro";
import StateActionPaths from "../../components/StateActionPaths.astro";
import StateTrackerSeoLinks from "../../components/StateTrackerSeoLinks.astro";
import StateCurrentAnswer from "../../components/StateCurrentAnswer.astro";
import { hurricaneCities } from "../../data/cities";
import { getStateBySlug } from "../../data/states";
import { getStateSeoProfile } from "../../data/stateSeo";
import { articleSchema, faqSchema, governmentServiceSchema, graph, itemListSchema, websiteSchema } from "../../lib/schema";
import { site } from "../../data/site";
import { getStateCurrentStatus, stateCurrentFaqs } from "../../lib/stateCurrent";

const state = getStateBySlug("south-carolina")!;
const code = state.code;
const name = state.name;
const region = state.region;
const seo = getStateSeoProfile(state);
const title = seo.title;
const description = seo.description;
const canonical = `${site.url}/tracker/${state.slug}/`;
const lastModified = site.contentLastModified;
const currentStatus = await getStateCurrentStatus(code);

const intro = `South Carolina's Atlantic coast spans roughly 185 miles, anchored by the Lowcountry around Charleston and the Grand Strand near Myrtle Beach. Hurricanes typically approach from the southeast or track up the Southeast seaboard, then curve into the coast where wide tidal estuaries and salt marshes magnify storm surge. The Lowcountry's bridges and causeways become vulnerable as winds rise, and heavy rain compounds coastal flooding. In 1989, Hurricane Hugo made a devastating Category 4 landfall near Charleston, leveling timber and producing a memorable surge that remains the state benchmark. The 2026 Atlantic hurricane season runs June 1 through November 30, and early August is inside the active window, so coastal households should confirm their evacuation zone and plan to leave before the reversal of I-26 and other routes jams with traffic.`;

const stateCities = hurricaneCities.filter((city) => city.stateCode === code);
const stateActionPaths = [
  {
    name: `${name} local risk action plan`,
    description: `Build a 72/48/24-hour household action plan from ${name} alerts, coastal hazards, and local constraints.`,
    url: `${site.url}/tools/local-risk-plan/?state=${code}`
  },
  {
    name: `${name} evacuation decision helper`,
    description: `Check whether surge exposure, housing type, transport, pets, or medical needs should move a ${name} household toward evacuation.`,
    url: `${site.url}/tools/evacuation-decision-helper/`
  },
  {
    name: `${name} alert action decoder`,
    description: `Translate official hurricane, surge, flood, tornado, and evacuation alerts into next actions for ${name} households.`,
    url: `${site.url}/tools/alert-action-decoder/`
  },
  {
    name: `${name} power outage planner`,
    description: `Plan charging, food safety, generator placement, medicine, and communication backup for ${name} hurricane outages.`,
    url: `${site.url}/tools/power-outage-planner/`
  }
];
const adjacent = ["north-carolina", "georgia"];

const faqs = [
  {
    question: `When is hurricane season in ${name}?`,
    answer: `South Carolina's season follows June 1–November 30, with the greatest danger from August through September as systems approach the Southeast coast. Early August is within the active period, so Lowcountry households should confirm zones before storms form.`
  },
  {
    question: `What was the worst hurricane to hit ${name}?`,
    answer: `Hurricane Hugo (1989) made landfall near Charleston as a major Category 4 storm, causing widespread wind damage and a devastating surge. It remains one of the most powerful hurricanes to strike the South Carolina coast.`
  },
  {
    question: `Does ${name} have hurricane evacuation routes?`,
    answer: `Yes. South Carolina designates coastal evacuation zones and routes. Residents should learn the local zone and follow current instructions for bridges, causeways, I-26, and other roads. Lane reversal applies only when officials activate it for the storm.`
  },
  {
    question: "What should South Carolina hurricane preparedness include?",
    answer: "Include the local evacuation zone, two destinations and routes, water and food, medications, documents, pet supplies, alerts, outage planning, and extra travel time for Lowcountry bridges, barrier islands, and coastal traffic."
  }
];

const jsonLd = graph(
  websiteSchema(),
  governmentServiceSchema({ areaServed: name }),
  articleSchema({ title, description, url: canonical, dateModified: lastModified }),
  itemListSchema([
    ...stateCities.map((city) => ({
      name: `${city.name} Hurricane Tracker`,
      description: city.planningNote,
      url: `${site.url}/hurricane-tracker/city/${city.slug}/`
    })),
    ...stateActionPaths
  ]),
  faqSchema([...stateCurrentFaqs(name, currentStatus), ...faqs])
);
---
<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd} lastModified={lastModified}>
  <article class="band" aria-labelledby="tracker-state-title">
    <div class="inner">
      <p class="eyebrow">{region} hurricane operations</p>
      <h1 id="tracker-state-title">{name} Hurricane Tracker – Live Updates</h1>
      <p class="answer">{intro}</p>
      <StateCurrentAnswer stateCode={code} stateName={name} status={currentStatus} />

      <section class="intent-answer" aria-labelledby="south-carolina-intent-heading">
        <h2 id="south-carolina-intent-heading">South Carolina Hurricane Questions Today</h2>
        <p>This page answers “is there a hurricane coming to South Carolina,” “is there a hurricane coming to SC,” and “is a hurricane coming to South Carolina next week” with current NHC context, Lowcountry risk, and local alerts.</p>
      </section>

      <section class="intent-answer" aria-labelledby="south-carolina-preparedness-heading">
        <h2 id="south-carolina-preparedness-heading">South Carolina Hurricane Preparedness</h2>
        <p>Lowcountry preparation starts with the official evacuation zone, bridge and causeway access, and a destination outside the threatened coast. Prepare water, food, medications, documents, pet supplies, charging, and safe outage plans before watches create heavy demand. Inland households should also plan for river flooding, tornadoes, falling trees, and heat after power loss.</p>
        <p>Generate a <a href="/tools/preparedness-checklist/">hurricane preparedness checklist</a> and record routes and destinations with the <a href="/hurricane-tracker/evacuation-plan/">hurricane evacuation plan guide</a>.</p>
      </section>

      <h2 id="alerts-heading">Active {name} NWS Alerts</h2>
      <p class="source-note">Live alerts are fetched directly from NOAA and NWS. Verify your county or evacuation zone before acting.</p>
      <StateAlerts state={code} />

      <h2 id="city-trackers">{name} City Hurricane Trackers</h2>
      <p class="source-note">Open city guides for local surge, flooding, evacuation-route, and outage planning notes within {name}.</p>
      <div class="grid-3" style="margin-top: 18px;">
        {stateCities.map((city) => (
          <article class="panel">
            <h3>{city.name} Hurricane Tracker</h3>
            <p>{city.planningNote}</p>
            <a href={`/hurricane-tracker/city/${city.slug}/`}>Open {city.name}</a>
          </article>
        ))}
      </div>

      <StateActionPaths state={state} />

      <StateTrackerSeoLinks state={state} cities={stateCities} />

      <h2 id="nearby-heading">Nearby State Hurricane Trackers</h2>
      <ul class="check-list">
        {adjacent.map((slug) => {
          const neighbor = getStateBySlug(slug);
          return neighbor ? <li><a href={`/tracker/${neighbor.slug}/`}>{neighbor.name} Hurricane Tracker</a></li> : null;
        })}
      </ul>
    </div>
  </article>
</BaseLayout>

<style>
  .answer { font-size: 1.05rem; line-height: 1.75; }
  .intent-answer { margin: 24px 0; padding: 18px 20px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface, #f3f7fa); }
  .intent-answer h2 { margin-top: 0; }
</style>
