---
import FaqBlock from "../components/FaqBlock.astro";
import Layout from "../layouts/Layout.astro";
import { blogPosts, getCategory } from "../data/blog";
import { site } from "../data/site";
import { topicPages } from "../data/topicPages";
import { articleSchema, faqSchema, graph, itemListSchema, websiteSchema } from "../lib/schema";

export const prerender = true;

const title = "Hurricane Learning Center";
const description =
  "Learn how to read hurricane tracker maps, NHC cones, spaghetti models, storm surge forecasts, radar, satellite, and category charts before a storm threatens.";
const url = `${site.url}/learn/`;
const lastModified = site.contentLastModified;

const featuredSlugs = [
  "real-time-hurricane-tracking-2026",
  "how-to-read-the-hurricane-cone-of-uncertainty",
  "how-to-read-hurricane-spaghetti-models",
  "saffir-simpson-hurricane-wind-scale-explained",
  "hurricane-storm-surge-forecasting",
  "hurricane-radar-vs-satellite"
];
const featuredPosts = featuredSlugs
  .map((slug) => blogPosts.find((post) => post.slug === slug))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));
const categoryGroups = ["Tracking & Forecasting", "Science & Basics", "Safety & Warnings", "Preparedness", "Insurance & Recovery"]
  .map((category) => ({
    category,
    posts: blogPosts.filter((post) => getCategory(post.slug) === category).slice(0, 6)
  }))
  .filter((group) => group.posts.length);
const learningPaths = [
  {
    title: "Track the storm path",
    intent: "live hurricane tracker, cone, radar, satellite",
    summary:
      "Use this path when you want to understand where a storm is now, how the forecast cone works, and which map layer answers which question.",
    links: [
      { label: "Open live tracker map", href: "/hurricane-tracker/live/" },
      { label: "Real-time hurricane tracking guide", href: "/blog/real-time-hurricane-tracking-2026/" },
      { label: "Cone of uncertainty explainer", href: "/blog/how-to-read-the-hurricane-cone-of-uncertainty/" },
      { label: "Radar vs satellite guide", href: "/blog/hurricane-radar-vs-satellite/" }
    ]
  },
  {
    title: "Decode alerts and warnings",
    intent: "hurricane watch warning, NWS alert meaning, storm surge warning",
    summary:
      "Use this path when an official alert appears and you need to translate watch, warning, surge, flood, or tornado language into a next action.",
    links: [
      { label: "Active NWS alerts", href: "/alerts/" },
      { label: "Alert action decoder", href: "/tools/alert-action-decoder/" },
      { label: "Watch vs warning guide", href: "/blog/what-hurricane-watch-warning-means/" },
      { label: "Storm surge vs hurricane warning", href: "/blog/storm-surge-warning-vs-hurricane-warning/" }
    ]
  },
  {
    title: "Decide whether to leave",
    intent: "evacuation zone, evacuation checklist, local hurricane risk",
    summary:
      "Use this path when your location, household needs, storm surge exposure, or local order may require an evacuation decision.",
    links: [
      { label: "Evacuation decision helper", href: "/tools/evacuation-decision-helper/" },
      { label: "Check city hurricane trackers", href: "/hurricane-tracker/city/" },
      { label: "Evacuation checklist", href: "/blog/hurricane-evacuation-checklist/" },
      { label: "How to check your evacuation zone", href: "/blog/how-to-check-your-hurricane-evacuation-zone/" }
    ]
  },
  {
    title: "Prepare the household",
    intent: "hurricane preparedness checklist, emergency kit, power outage plan",
    summary:
      "Use this path before peak season or during a watch to finish supplies, documents, communication, home protection, and outage planning.",
    links: [
      { label: "Preparedness checklist generator", href: "/tools/preparedness-checklist/" },
      { label: "Hurricane emergency kit checklist", href: "/blog/hurricane-emergency-kit-checklist/" },
      { label: "Family communication plan", href: "/tools/family-communication-plan/" },
      { label: "Power outage planner", href: "/tools/power-outage-planner/" }
    ]
  }
];
const trackerTopicHubs = topicPages.map((page) => ({
  title: page.title,
  href: `/hurricane-tracker/${page.slug}/`,
  description: page.description,
  intent: page.intent
}));
const questionPaths = [
  {
    question: "I need to know where the storm is right now.",
    answer: "Start with the live tracker, then read the cone and radar guides if the map product is unclear.",
    href: "/hurricane-tracker/live/",
    label: "Open live hurricane tracker",
    supportHref: "/blog/real-time-hurricane-tracking-2026/",
    supportLabel: "Read the real-time tracking guide"
  },
  {
    question: "I received a watch, warning, or flood alert.",
    answer: "Decode the alert language first, then compare the result with official NWS alerts and local evacuation guidance.",
    href: "/tools/alert-action-decoder/",
    label: "Use alert action decoder",
    supportHref: "/alerts/",
    supportLabel: "Check active NWS alerts"
  },
  {
    question: "I need local risk for my city.",
    answer: "Move from general learning pages into city trackers, nearby alerts, official resources, and household tools.",
    href: "/hurricane-tracker/city/",
    label: "Browse city hurricane trackers",
    supportHref: "/tools/local-risk-plan/",
    supportLabel: "Build a local risk plan"
  },
  {
    question: "I am deciding whether to evacuate.",
    answer: "Use official local orders as the source of truth, then use evacuation and impact tools to organize timing and supplies.",
    href: "/tools/evacuation-decision-helper/",
    label: "Use evacuation decision helper",
    supportHref: "/blog/how-to-check-your-hurricane-evacuation-zone/",
    supportLabel: "Learn how to check evacuation zones"
  },
  {
    question: "I want to prepare before the season gets active.",
    answer: "Start with a checklist, then fill gaps for power, documents, pets, medicine, and home hardening.",
    href: "/tools/preparedness-checklist/",
    label: "Generate preparedness checklist",
    supportHref: "/blog/hurricane-preparation-timeline-72-48-24-hours/",
    supportLabel: "Follow the 72/48/24 hour timeline"
  }
];
const faqs = [
  {
    question: "What should I learn first about hurricane tracking?",
    answer:
      "Start with the live tracker map, then learn the NHC cone, local watches and warnings, storm surge risk, radar, and satellite imagery. The storm center is only one part of local hurricane risk."
  },
  {
    question: "Are spaghetti models better than the official forecast cone?",
    answer:
      "No. Spaghetti models show a range of model tracks, while the official NHC forecast cone summarizes forecast uncertainty. Use spaghetti models for context and the official forecast for decisions."
  },
  {
    question: "Does hurricane category explain storm surge and flooding?",
    answer:
      "No. Hurricane category is based on wind speed. Storm surge, rainfall flooding, tornadoes, and outages require separate local alerts and preparedness decisions."
  },
  {
    question: "Why does HurricaneHub separate learning pages from live tracker pages?",
    answer:
      "Live tracker pages answer what is happening now. Learning pages explain how to interpret the map, cone, models, warnings, and hazards so users make better decisions during an active threat."
  }
];
const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title, description, url, dateModified: lastModified }),
  itemListSchema(featuredPosts.map((post) => ({
    name: post.title,
    description: post.description,
    url: `${site.url}/blog/${post.slug}/`
  }))),
  itemListSchema(questionPaths.map((path) => ({
    name: path.question,
    description: path.answer,
    url: `${site.url}${path.href}`
  }))),
  itemListSchema(trackerTopicHubs.map((hub) => ({
    name: hub.title,
    description: hub.description,
    url: `${site.url}${hub.href}`
  }))),
  faqSchema(faqs)
);
---
<Layout title={title} description={description} canonical={url} jsonLd={jsonLd} lastModified={lastModified}>
  <section class="band" aria-labelledby="learn-title">
    <div class="inner">
      <p class="eyebrow">Hurricane basics and map reading</p>
      <h1 id="learn-title">Hurricane Learning Center</h1>
      <p class="answer">Use these guides to understand live hurricane tracker maps, forecast cones, spaghetti models, radar, satellite imagery, storm surge, categories, watches, and warnings before a storm is close.</p>
      <p class="section-actions">
        <a class="action-link" href="/hurricane-tracker/live/">Open live tracker map</a>
        <a class="action-link secondary-action" href="/blog/">Browse all articles</a>
      </p>
    </div>
  </section>

  <section class="band" aria-labelledby="featured-learn">
    <div class="inner">
      <p class="eyebrow">High-intent explainers</p>
      <h2 id="featured-learn">Start With These Hurricane Tracker Guides</h2>
      <div class="grid-3 section-grid">
        {featuredPosts.map((post) => (
          <article class="panel">
            <p class="eyebrow">{getCategory(post.slug)}</p>
            <h3><a href={`/blog/${post.slug}/`}>{post.title}</a></h3>
            <p>{post.description}</p>
            <p><a class="action-link" href={`/blog/${post.slug}/`}>Read guide</a></p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="learn-by-topic">
    <div class="inner">
      <p class="eyebrow">Topic clusters</p>
      <h2 id="learn-by-topic">Learn by Search Intent</h2>
      <div class="grid-2 section-grid">
        {categoryGroups.map((group) => (
          <article class="panel">
            <h3>{group.category}</h3>
            <ul>
              {group.posts.map((post) => (
                <li><a href={`/blog/${post.slug}/`}>{post.title}</a></li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="tracker-topic-hubs">
    <div class="inner">
      <p class="eyebrow">Tracker keyword hubs</p>
      <h2 id="tracker-topic-hubs">Hurricane Tracker Topics</h2>
      <p class="answer">These pages connect high-intent searches to live tools, official-source context, city trackers, and household decision paths.</p>
      <div class="grid-2 section-grid">
        {trackerTopicHubs.map((hub) => (
          <article class="panel">
            <p class="eyebrow">{hub.intent}</p>
            <h3><a href={hub.href}>{hub.title}</a></h3>
            <p>{hub.description}</p>
            <p><a class="action-link" href={hub.href}>Open topic</a></p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="learning-paths">
    <div class="inner">
      <p class="eyebrow">Learning paths</p>
      <h2 id="learning-paths">Follow the Right Hurricane Learning Path</h2>
      <p class="answer">Each path links an explainer to the live tracker, local pages, or decision tool that turns the lesson into a concrete action.</p>
      <div class="grid-2 section-grid">
        {learningPaths.map((path) => (
          <article class="panel">
            <p class="eyebrow">{path.intent}</p>
            <h3>{path.title}</h3>
            <p>{path.summary}</p>
            <ol class="path-list">
              {path.links.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ol>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="question-paths">
    <div class="inner">
      <p class="eyebrow">Question to next page</p>
      <h2 id="question-paths">Choose the Right Hurricane Page for Your Situation</h2>
      <p class="answer">Searchers often arrive with one urgent question. Use this section to move from the learning center into the most useful tracker, local page, article, or decision tool.</p>
      <div class="link-list question-list">
        {questionPaths.map((path) => (
          <article class="link-row">
            <h3>{path.question}</h3>
            <p>{path.answer}</p>
            <p class="question-actions">
              <a href={path.href}>{path.label}</a>
              <a href={path.supportHref}>{path.supportLabel}</a>
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="learn-workflow">
    <div class="inner grid-2">
      <article class="panel">
        <p class="eyebrow">During an active storm</p>
        <h2 id="learn-workflow">Use Learning Pages With Live Tools</h2>
        <p>When a storm is active, read the explainer only long enough to understand the product, then move back to live NHC advisories, NWS alerts, city trackers, and decision tools.</p>
      </article>
      <article class="panel">
        <p class="eyebrow">Useful shortcuts</p>
        <h2>Connect Knowledge to Action</h2>
        <ul>
          <li><a href="/hurricane-tracker/live/">Live hurricane tracker</a></li>
          <li><a href="/radar/">Radar and satellite map</a></li>
          <li><a href="/hurricane-tracker/city/">City hurricane trackers</a></li>
          <li><a href="/tools/evacuation-decision-helper/">Evacuation decision helper</a></li>
        </ul>
      </article>
    </div>
  </section>

  <FaqBlock faqs={faqs} />
</Layout>

<style>
  .path-list {
    display: grid;
    gap: 9px;
    margin: 16px 0 0;
    padding-left: 1.35rem;
  }

  .path-list a {
    font-weight: 800;
  }

  .question-list {
    margin-top: 1.25rem;
  }

  .question-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }

  .question-actions a {
    font-weight: 800;
  }
</style>
