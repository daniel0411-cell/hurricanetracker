---
import FaqBlock from "../components/FaqBlock.astro";
import Layout from "../layouts/Layout.astro";
import ContentFigure from "../components/ContentFigure.astro";
import { site } from "../data/site";
import { articleSchema, faqSchema, graph, howToSchema, itemListSchema, websiteSchema } from "../lib/schema";

const title = "Hurricane Preparedness Decision Matrix";
const description = "Match hurricane, surge, tornado and extreme wind warnings to the right household action, then confirm zones, transport, contacts and shelter arrangements.";
const url = `${site.url}/preparedness/`;
const lastModified = "2026-11-10T00:00:00.000Z";
const timelineWindows = [
  {
    window: "72 hours before possible impacts",
    focus: "Supplies, documents, routes, and household roles",
    body:
      "Use this window to finish the low-regret work: water, food, batteries, prescriptions, cash, document photos, pet supplies, and a written destination if evacuation becomes likely.",
    links: [
      { label: "Generate a preparedness checklist", href: "/tools/preparedness-checklist/" },
      { label: "Read the 72/48/24 hour timeline", href: "/blog/hurricane-preparation-timeline-72-48-24-hours/" }
    ]
  },
  {
    window: "48 hours before possible impacts",
    focus: "Fuel, alerts, local risk, and evacuation readiness",
    body:
      "Compare the latest NWS alerts, NHC storm context, evacuation-zone instructions, and household constraints. People with medical, mobility, pet, or transportation needs may need to move earlier.",
    links: [
      { label: "Build a local risk plan", href: "/tools/local-risk-plan/" },
      { label: "Check city hurricane trackers", href: "/hurricane-tracker/city/" }
    ]
  },
  {
    window: "24 hours before possible impacts",
    focus: "Final protective actions while conditions allow",
    body:
      "Finish protective actions that can be done safely, move vehicles away from flood-prone spots, charge devices, pack medications and documents, and stop outdoor work when conditions deteriorate.",
    links: [
      { label: "Use the evacuation decision helper", href: "/tools/evacuation-decision-helper/" },
      { label: "Review hurricane warning checklist", href: "/blog/what-to-do-during-a-hurricane-warning/" }
    ]
  }
];
const householdScenarios = [
  {
    title: "If you may evacuate",
    body:
      "Prioritize destination, route, fuel, documents, prescriptions, pet records, chargers, and a contact who knows where you are going.",
    href: "/blog/hurricane-evacuation-checklist/",
    label: "Open evacuation checklist"
  },
  {
    title: "If you plan to shelter in place",
    body:
      "Check local evacuation instructions and whether the building is suitable for the expected hazards. Identify an interior shelter location and prepare for outages, water disruption, heat, and limited communication. Being outside a mapped zone alone does not establish that a building is safe.",
    href: "/tools/power-outage-planner/",
    label: "Build outage plan"
  },
  {
    title: "If someone has medical or mobility needs",
    body:
      "Plan earlier than the general timeline: registrations, equipment power, refrigerated medicine, accessible transportation, and caregiver communication should be ready before watches escalate.",
    href: "/blog/hurricane-medical-needs-registry-preparedness/",
    label: "Read medical needs guide"
  },
  {
    title: "If pets are part of the plan",
    body:
      "Pack food, carriers, leashes, medications, vaccine records, waste bags, and pet-friendly lodging or shelter options before roads and hotels fill.",
    href: "/blog/hurricane-pet-safety/",
    label: "Read pet safety guide"
  }
];
const preparednessToolChains = [
  {
    title: "Before a storm is named",
    body: "Use quiet weather to finish supplies, documents, insurance photos, family contacts, pet plans, and backup power decisions.",
    links: [
      { label: "Preparedness checklist generator", href: "/tools/preparedness-checklist/" },
      { label: "Documents and insurance checklist", href: "/blog/hurricane-documents-insurance-checklist/" },
      { label: "Family communication plan", href: "/tools/family-communication-plan/" }
    ]
  },
  {
    title: "When a watch is possible",
    body: "Move from general readiness into local risk: storm surge, flooding, evacuation zones, city context, fuel, routes, and household constraints.",
    links: [
      { label: "Local hurricane risk hub", href: "/local-hurricane-risk/" },
      { label: "City hurricane trackers", href: "/hurricane-tracker/city/" },
      { label: "Evacuation zone guide", href: "/blog/how-to-check-your-hurricane-evacuation-zone/" }
    ]
  },
  {
    title: "When a warning is issued",
    body: "Complete protective actions only while safe, follow official instructions, and use decision tools to organize evacuation or shelter timing.",
    links: [
      { label: "Alert action decoder", href: "/tools/alert-action-decoder/" },
      { label: "Evacuation decision helper", href: "/tools/evacuation-decision-helper/" },
      { label: "Hurricane warning checklist", href: "/blog/what-to-do-during-a-hurricane-warning/" }
    ]
  },
  {
    title: "After impacts begin",
    body: "Shift from preparation to safety, outage management, communication, and official reentry or recovery instructions.",
    links: [
      { label: "Power outage planner", href: "/tools/power-outage-planner/" },
      { label: "What to do after a hurricane", href: "/blog/what-to-do-after-a-hurricane/" },
      { label: "Mold prevention after flooding", href: "/blog/hurricane-mold-prevention-after-flood/" }
    ]
  }
];
const preparednessFaqs = [
  {
    question: "What is the first thing to do for hurricane preparedness?",
    answer:
      "Start with your location: check whether your home is in an evacuation, flood, storm surge, mobile home, or medically vulnerable situation. Then build supplies, documents, contacts, and route plans around that local risk."
  },
  {
    question: "Is a hurricane kit enough if I may need to evacuate?",
    answer:
      "No. A home kit helps if you shelter in place, but an evacuation plan needs a smaller go-bag, destination, route, fuel, documents, medicine, chargers, pet supplies, and a contact who knows where you are going."
  },
  {
    question: "When should I move from preparing to acting?",
    answer:
      "Move from preparing to acting when official alerts, evacuation-zone instructions, storm surge risk, flash flooding, tornado warnings, or household constraints mean waiting could reduce safe options."
  },
  {
    question: "How early should households with medical needs prepare?",
    answer:
      "Households with medical equipment, refrigerated medicine, mobility limits, oxygen, dialysis, caregiving, or transportation constraints should prepare earlier than the general timeline and verify local registry or shelter options before a storm is close."
  },
  {
    question: "Should renters and apartment residents use the same checklist as homeowners?",
    answer:
      "Some supplies overlap, but renters also need building rules, elevator and stair plans, lease and renters insurance records, parking decisions, pet rules, and property-manager communication."
  }
];
const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title, description, url, dateModified: lastModified }),
  howToSchema({
    name: "How to Use the Hurricane Preparedness Decision Matrix",
    description,
    url,
    steps: [
      {
        name: "Monitor official storm and alert sources",
        text: "When no local warning or nearby active system is present, review the forecast, confirm contacts, and keep basic supplies ready."
      },
      {
        name: "Prepare when a tropical system, watch, or flood risk appears",
        text: "Fuel vehicles, organize medication and documents, inspect supplies, and review evacuation options before conditions worsen."
      },
      {
        name: "Act when warning-level hazards are issued",
        text: "Follow official warnings, complete protective actions, move vulnerable people early, and stop nonessential travel as conditions deteriorate."
      },
      {
        name: "Distinguish evacuation instructions from immediate shelter warnings",
        text: "Follow local evacuation orders and deadlines before travel becomes unsafe. An Extreme Wind Warning or Tornado Warning calls for immediate shelter, not beginning a road evacuation."
      }
    ]
  }),
  itemListSchema(preparednessToolChains.flatMap((chain) => chain.links.map((link) => ({
    name: link.label,
    description: chain.body,
    url: `${site.url}${link.href}`
  })))),
  faqSchema(preparednessFaqs)
);
---
<Layout title={title} description={description} canonical={url} jsonLd={jsonLd} lastModified={lastModified}>
  <section class="band" aria-labelledby="preparedness-title">
    <div class="inner">
      <p class="eyebrow">Emergency decision support</p>
      <h1 id="preparedness-title">Hurricane Preparedness Decision Matrix</h1>
      <p class="answer">Read the hazard and its specific instruction before choosing an action. Evacuating before a local deadline and taking immediate shelter during a wind or tornado warning are different decisions.</p>
    </div>
  </section>
  <section class="band" aria-labelledby="matrix-heading">
    <div class="inner">
      <h2 id="matrix-heading">Match the Instruction to the Hazard</h2>
      <table>
        <thead>
          <tr><th>Situation</th><th>What to check</th><th>Action</th></tr>
        </thead>
        <tbody>
          <tr><td>Monitor</td><td>No local warning and no nearby active system</td><td>Review forecast twice daily and confirm contact list.</td></tr>
          <tr><td>Prepare</td><td>Tropical system active or watch/flood risk appears</td><td>Fuel vehicle, secure medication, document property, inspect supplies.</td></tr>
          <tr><td>Hurricane or storm surge warning</td><td>Affected area, timing and local evacuation instructions</td><td>Complete protective actions while safe. If ordered to evacuate, follow the local deadline and recommended routes.</td></tr>
          <tr><td>Local evacuation order</td><td>Your address or zone, deadline, transport and destination</td><td>Follow the order before travel becomes unsafe; communicate your destination and check current road instructions.</td></tr>
          <tr><td>Extreme Wind Warning</td><td>NWS warning for your location</td><td>Take immediate shelter in an interior part of a well-built structure. Do not start a road evacuation into the extreme winds.</td></tr>
          <tr><td>Tornado Warning</td><td>NWS warning for your location</td><td>Move immediately to a basement, safe room or interior room away from windows in a sturdy building.</td></tr>
          <tr><td>Flash Flood Warning</td><td>Location-specific warning and safe access to higher ground</td><td>Follow the warning's instructions immediately. Stay out of floodwater and never drive across flooded roads.</td></tr>
        </tbody>
      </table>
      <p class="source-note">Warning guidance checked November 10, 2026: <a href="https://www.weather.gov/safety/hurricane-ww">NWS hurricane watches and warnings</a> and <a href="https://www.weather.gov/safety/tornado-during">NWS tornado safety</a>. NWS describes an Extreme Wind Warning as major-hurricane sustained winds of 115 mph or greater expected within an hour, requiring immediate interior shelter.</p>
    </div>
  </section>
  <section class="band" aria-labelledby="quiet-weather-record">
    <div class="inner">
      <h2 id="quiet-weather-record">A Useful Task Even When No Storm Is Active</h2>
      <p>Make a private, dated household record. Save your county's address-based evacuation-zone result and official order channel; list a confirmed driver, a destination and backup; write down medication or equipment needs; and choose an out-of-area contact. Keep an offline copy. Recheck event-specific orders and availability when weather threatens.</p>
      <p>Mark each arrangement as confirmed, pending or unknown. For transport and lodging, include who confirmed it, when, and how to reach them. A checklist tick should represent an actual arrangement, not just a website visited.</p>
      <h3>Practice: Is This Household Ready to Leave?</h3>
      <p>Hypothetical example: supplies are packed and the county zone lookup is saved, but the ride request is pending and the intended hotel has not confirmed pet accommodation. Which items need follow-up?</p>
      <p><strong>Answer:</strong> transport and lodging remain unresolved. Confirm pickup with the provider, verify the destination's availability and pet arrangements, and retain alternatives. Packed supplies do not resolve either gap. If an order arrives first, contact local emergency management about available assistance and follow current instructions.</p>
      <p>Planning sources: <a href="https://gema.georgia.gov/make-plan-plan-evacuate">GEMA evacuation planning</a> covers destinations, transport, alternate routes and pets; <a href="/tools/family-communication-plan/">the communication worksheet</a> helps retain contacts offline.</p>
    </div>
  </section>
  <section class="band" aria-labelledby="next-steps-heading">
    <div class="inner grid-2">
      <article>
        <h2 id="next-steps-heading">Turn the Matrix Into a Plan</h2>
        <p>Use the hazard-specific instructions above with tools that organize local alerts, checklist items, outage planning, and household communication.</p>
        <ul class="check-list">
          <li><a href="/tools/local-risk-plan/">Build a state alert action plan</a></li>
          <li><a href="/local-hurricane-risk/">Check local hurricane risk</a></li>
          <li><a href="/tools/preparedness-checklist/">Generate a preparedness checklist</a></li>
          <li><a href="/tools/evacuation-decision-helper/">Use the evacuation decision helper</a></li>
          <li><a href="/tools/family-communication-plan/">Create a family communication plan</a></li>
        </ul>
      </article>
      <article class="panel">
        <h2>Learn Before the Next Watch</h2>
        <p>Read plain-language guides for the NHC cone, spaghetti models, radar, satellite imagery, storm surge, and hurricane categories before an active warning compresses your decision time.</p>
        <p><a class="action-link secondary-action" href="/learn/">Open learning center</a></p>
      </article>
    </div>
  </section>

  <section class="band" aria-labelledby="preparedness-timeline">
    <div class="inner">
      <p class="eyebrow">Time-based planning</p>
      <h2 id="preparedness-timeline">Hurricane Preparedness by Time Window</h2>
      <p class="answer">These are illustrative preparation windows, not watch or warning definitions and not a promise of time remaining. A rapidly changing event or a household's assistance needs can require earlier action. Local instructions take priority over this schedule.</p>
      <ContentFigure src="/images/guides/hurricane-preparedness-timeline.svg" alt="Illustrative household preparation sequence from quiet weather through 72, 48 and 24 hour planning windows" caption="An illustrative task sequence, not a warning clock or guaranteed safe window. Follow current forecasts, alerts and local instructions even when they require earlier action." />
      <div class="grid-3 section-grid">
        {timelineWindows.map((item) => (
          <article class="panel">
            <p class="eyebrow">{item.window}</p>
            <h3>{item.focus}</h3>
            <p>{item.body}</p>
            <ul class="prep-links">
              {item.links.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="preparedness-scenarios">
    <div class="inner">
      <p class="eyebrow">Household scenarios</p>
      <h2 id="preparedness-scenarios">Match Preparedness to Your Household</h2>
      <p class="answer">A hurricane checklist should change when your household has evacuation exposure, medical needs, pets, mobility limits, or outage risk.</p>
      <div class="grid-2 section-grid">
        {householdScenarios.map((scenario) => (
          <article class="panel">
            <h3>{scenario.title}</h3>
            <p>{scenario.body}</p>
            <p><a class="action-link secondary-action" href={scenario.href}>{scenario.label}</a></p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="preparedness-tool-chains">
    <div class="inner">
      <p class="eyebrow">Preparedness paths</p>
      <h2 id="preparedness-tool-chains">Use the Right Page at the Right Time</h2>
      <p class="answer">Preparedness changes as a storm gets closer. These paths connect the decision matrix to the most useful HurricaneHub tool or guide for each stage.</p>
      <div class="grid-2 section-grid">
        {preparednessToolChains.map((chain) => (
          <article class="panel">
            <h3>{chain.title}</h3>
            <p>{chain.body}</p>
            <ul class="prep-links">
              {chain.links.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <FaqBlock faqs={preparednessFaqs} />
</Layout>

<style>
  .prep-links {
    display: grid;
    gap: 8px;
    margin: 16px 0 0;
    padding-left: 1.2rem;
  }

  .prep-links a {
    font-weight: 800;
  }
</style>
