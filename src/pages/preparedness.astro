---
import FaqBlock from "../components/FaqBlock.astro";
import Layout from "../layouts/Layout.astro";
import { faqs, site } from "../data/site";
import { articleSchema, faqSchema, graph, howToSchema, websiteSchema } from "../lib/schema";

const title = "Hurricane Preparedness Decision Matrix";
const description = "Use a clear hurricane decision matrix for monitoring, preparing, acting, and leaving before tropical cyclone hazards arrive.";
const url = `${site.url}/preparedness/`;
const lastModified = site.contentLastModified;
const timelineWindows = [
  {
    window: "72 hours before possible impacts",
    focus: "Supplies, documents, routes, and household roles",
    body:
      "Use this window to finish the low-regret work: water, food, batteries, prescriptions, cash, document photos, pet supplies, and a written destination if evacuation becomes likely.",
    links: [
      { label: "Generate a preparedness checklist", href: "/tools/preparedness-checklist/" },
      { label: "Read the 72/48/24 hour timeline", href: "/blog/hurricane-preparation-timeline-72-48-24-hours/" }
    ]
  },
  {
    window: "48 hours before possible impacts",
    focus: "Fuel, alerts, local risk, and evacuation readiness",
    body:
      "Compare the latest NWS alerts, NHC storm context, evacuation-zone instructions, and household constraints. People with medical, mobility, pet, or transportation needs may need to move earlier.",
    links: [
      { label: "Build a local risk plan", href: "/tools/local-risk-plan/" },
      { label: "Check city hurricane trackers", href: "/hurricane-tracker/city/" }
    ]
  },
  {
    window: "24 hours before possible impacts",
    focus: "Final safety actions and no-risk decisions",
    body:
      "Finish protective actions that can be done safely, move vehicles away from flood-prone spots, charge devices, pack medications and documents, and stop outdoor work when conditions deteriorate.",
    links: [
      { label: "Use the evacuation decision helper", href: "/tools/evacuation-decision-helper/" },
      { label: "Review hurricane warning checklist", href: "/blog/what-to-do-during-a-hurricane-warning/" }
    ]
  }
];
const householdScenarios = [
  {
    title: "If you may evacuate",
    body:
      "Prioritize destination, route, fuel, documents, prescriptions, pet records, chargers, and a contact who knows where you are going.",
    href: "/blog/hurricane-evacuation-checklist/",
    label: "Open evacuation checklist"
  },
  {
    title: "If you plan to shelter in place",
    body:
      "Confirm you are outside surge and evacuation zones, identify an interior safe room, and prepare for outages, water disruption, heat, and limited communication.",
    href: "/tools/power-outage-planner/",
    label: "Build outage plan"
  },
  {
    title: "If someone has medical or mobility needs",
    body:
      "Plan earlier than the general timeline: registrations, equipment power, refrigerated medicine, accessible transportation, and caregiver communication should be ready before watches escalate.",
    href: "/blog/hurricane-medical-needs-registry-preparedness/",
    label: "Read medical needs guide"
  },
  {
    title: "If pets are part of the plan",
    body:
      "Pack food, carriers, leashes, medications, vaccine records, waste bags, and pet-friendly lodging or shelter options before roads and hotels fill.",
    href: "/blog/hurricane-pet-safety/",
    label: "Read pet safety guide"
  }
];
const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title, description, url, dateModified: lastModified }),
  howToSchema({
    name: "How to Use the Hurricane Preparedness Decision Matrix",
    description,
    url,
    steps: [
      {
        name: "Monitor official storm and alert sources",
        text: "When no local warning or nearby active system is present, review the forecast, confirm contacts, and keep basic supplies ready."
      },
      {
        name: "Prepare when a tropical system, watch, or flood risk appears",
        text: "Fuel vehicles, organize medication and documents, inspect supplies, and review evacuation options before conditions worsen."
      },
      {
        name: "Act when warning-level hazards are issued",
        text: "Follow official warnings, complete protective actions, move vulnerable people early, and stop nonessential travel as conditions deteriorate."
      },
      {
        name: "Leave when evacuation or life-threatening hazard language applies",
        text: "Follow local evacuation instructions, use official routes, and tell contacts your route and destination before deadlines pass."
      }
    ]
  }),
  faqSchema(faqs)
);
---
<Layout title={title} description={description} canonical={url} jsonLd={jsonLd} lastModified={lastModified}>
  <section class="band" aria-labelledby="preparedness-title">
    <div class="inner">
      <p class="eyebrow">Emergency decision support</p>
      <h1 id="preparedness-title">Hurricane Preparedness Decision Matrix</h1>
      <p class="answer">Use monitor, prepare, act, and leave levels to convert official warnings into household actions before wind, surge, flooding, or road congestion removes good options.</p>
    </div>
  </section>
  <section class="band" aria-labelledby="matrix-heading">
    <div class="inner">
      <h2 id="matrix-heading">Decision Levels</h2>
      <table>
        <thead>
          <tr><th>Level</th><th>Trigger</th><th>Action</th></tr>
        </thead>
        <tbody>
          <tr><td>Monitor</td><td>No local warning and no nearby active system</td><td>Review forecast twice daily and confirm contact list.</td></tr>
          <tr><td>Prepare</td><td>Tropical system active or watch/flood risk appears</td><td>Fuel vehicle, secure medication, document property, inspect supplies.</td></tr>
          <tr><td>Act</td><td>Hurricane, surge, tornado, or flash flood warning</td><td>Move inland or shelter as directed; stop nonessential travel.</td></tr>
          <tr><td>Leave</td><td>Evacuation, extreme wind, or life-threatening surge signal</td><td>Depart before deadline and tell contacts route and destination.</td></tr>
        </tbody>
      </table>
    </div>
  </section>
  <section class="band" aria-labelledby="next-steps-heading">
    <div class="inner grid-2">
      <article>
        <h2 id="next-steps-heading">Turn the Matrix Into a Plan</h2>
        <p>Use the decision level above with HurricaneHub tools that already organize local alerts, checklist items, outage planning, and household communication.</p>
        <ul class="check-list">
          <li><a href="/tools/local-risk-plan/">Build a local 72-hour action plan</a></li>
          <li><a href="/local-hurricane-risk/">Check local hurricane risk</a></li>
          <li><a href="/tools/preparedness-checklist/">Generate a preparedness checklist</a></li>
          <li><a href="/tools/evacuation-decision-helper/">Use the evacuation decision helper</a></li>
          <li><a href="/tools/family-communication-plan/">Create a family communication plan</a></li>
        </ul>
      </article>
      <article class="panel">
        <h2>Learn Before the Next Watch</h2>
        <p>Read plain-language guides for the NHC cone, spaghetti models, radar, satellite imagery, storm surge, and hurricane categories before an active warning compresses your decision time.</p>
        <p><a class="action-link secondary-action" href="/learn/">Open learning center</a></p>
      </article>
    </div>
  </section>

  <section class="band" aria-labelledby="preparedness-timeline">
    <div class="inner">
      <p class="eyebrow">Time-based planning</p>
      <h2 id="preparedness-timeline">Hurricane Preparedness by Time Window</h2>
      <p class="answer">The safest hurricane plan is staged before warnings compress your options. Use these windows with official alerts and local instructions.</p>
      <div class="grid-3 section-grid">
        {timelineWindows.map((item) => (
          <article class="panel">
            <p class="eyebrow">{item.window}</p>
            <h3>{item.focus}</h3>
            <p>{item.body}</p>
            <ul class="prep-links">
              {item.links.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="preparedness-scenarios">
    <div class="inner">
      <p class="eyebrow">Household scenarios</p>
      <h2 id="preparedness-scenarios">Match Preparedness to Your Household</h2>
      <p class="answer">A hurricane checklist should change when your household has evacuation exposure, medical needs, pets, mobility limits, or outage risk.</p>
      <div class="grid-2 section-grid">
        {householdScenarios.map((scenario) => (
          <article class="panel">
            <h3>{scenario.title}</h3>
            <p>{scenario.body}</p>
            <p><a class="action-link secondary-action" href={scenario.href}>{scenario.label}</a></p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <FaqBlock faqs={faqs} />
</Layout>

<style>
  .prep-links {
    display: grid;
    gap: 8px;
    margin: 16px 0 0;
    padding-left: 1.2rem;
  }

  .prep-links a {
    font-weight: 800;
  }
</style>
