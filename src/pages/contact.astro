---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
import { articleSchema, breadcrumbSchema, graph, websiteSchema } from "../lib/schema";

const title = "Contact HurricaneHub";
const description = "Contact HurricaneHub about corrections, source attribution, privacy requests, accessibility, partnerships, and general site feedback.";
const url = `${site.url}/contact/`;
const lastModified = "2026-09-07T00:00:00.000Z";
const jsonLd = graph(websiteSchema(), articleSchema({ title, description, url, dateModified: lastModified }), breadcrumbSchema([{ name: "Home", url: site.canonicalUrl }, { name: "Contact", url }]));
---
<Layout title={title} description={description} canonical={url} jsonLd={jsonLd} lastModified={lastModified}>
  <section class="band"><div class="inner"><p class="eyebrow">Questions and corrections</p><h1>Contact HurricaneHub</h1><p class="answer">Email <a href="mailto:weather-data@hurricanetracker.cc">weather-data@hurricanetracker.cc</a> for site feedback, factual corrections, source attribution, privacy requests, accessibility issues, or partnership inquiries.</p></div></section>
  <section class="band"><div class="inner grid-2">
    <article class="panel"><h2>What To Include</h2><ul class="check-list"><li>The page URL and a short description of the issue.</li><li>The official source or evidence supporting a correction.</li><li>For privacy requests, the email address used to subscribe and the feature involved.</li></ul><p>We do not need passwords, government IDs, payment details, medical records, or precise household information.</p></article>
    <article class="panel"><h2>Emergency Information</h2><p>HurricaneHub does not provide emergency dispatch, forecasts, evacuation orders, shelter placement, or individual safety advice. For an immediate emergency, contact local emergency services. For official tropical forecasts use the <a href="https://www.nhc.noaa.gov/" rel="noopener nofollow">National Hurricane Center</a>; for local warnings use the <a href="https://www.weather.gov/" rel="noopener nofollow">National Weather Service</a> and local emergency management.</p></article>
  </div></section>
  <section class="band"><div class="inner"><h2>Response Expectations</h2><p>We prioritize factual corrections, broken official-source links, privacy requests, and accessibility issues. HurricaneHub cannot guarantee a response time during severe-weather events.</p><p><a href="/about/">About HurricaneHub and its sources</a> · <a href="/privacy/">Privacy Policy</a> · <a href="/terms/">Terms of Use</a></p></div></section>
  <section class="band"><div class="inner grid-2"><article><p class="eyebrow">Institutional pilot</p><h2>Property, Business, School, and Community Partnerships</h2><p class="answer">Property managers, small businesses, schools, nonprofits, and local media can contact us about a manual pilot using HurricaneHub's printable planning tools or embeddable public-safety resources.</p><p>Email <a href="mailto:weather-data@hurricanetracker.cc?subject=HurricaneHub%20institutional%20pilot">weather-data@hurricanetracker.cc</a> with the organization type, number of locations, audience, and planning problem. Do not send resident, employee, student, medical, or payment records.</p></article><article class="panel"><h3>Current Pilot Boundaries</h3><ul class="check-list"><li>No self-service account or paid subscription is offered.</li><li>No white-label or service-level commitment is implied.</li><li>Pilots do not replace official emergency management plans.</li><li>Any sponsored relationship will be disclosed.</li></ul></article></div></section>
</Layout>
