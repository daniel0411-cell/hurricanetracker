---
import FaqBlock from "../components/FaqBlock.astro";
import LiveDashboard from "../components/LiveDashboard.astro";
import LocalRiskWidget from "../components/LocalRiskWidget.astro";
import ReminderSignup from "../components/ReminderSignup.astro";
import Layout from "../layouts/Layout.astro";
import { differentiators, faqs, site, stats } from "../data/site";
import { coastalStates } from "../data/states";
import { blogPosts } from "../data/blog";
import { hurricaneCities } from "../data/cities";
import { articleSchema, faqSchema, graph, websiteSchema } from "../lib/schema";
import type { NhcStorm, NwsAlert } from "../lib/weather";

const title = "North America Hurricane Tracker and Emergency Decision Hub";
const description = "Track active North American hurricanes, official NWS alerts, evacuation decision levels, and preparedness actions from NOAA, NHC, and NWS data.";

type StormFeed = {
  storms?: Array<NhcStorm & { summary?: string }>;
  fetchedAt?: string;
  updatedAt?: string;
};

type AlertFeed = {
  alerts?: NwsAlert[];
  decisionLevel?: string;
  fetchedAt?: string;
  updatedAt?: string;
};

async function loadJson<T>(path: string): Promise<T | null> {
  try {
    const response = await fetch(new URL(path, Astro.url));
    if (!response.ok) {
      console.error("HurricaneHub home feed error", { path, status: response.status });
      return null;
    }
    return await response.json() as T;
  } catch (error) {
    console.error("HurricaneHub home feed failed", { path, error });
    return null;
  }
}

const [stormFeed, floridaAlertFeed] = await Promise.all([
  loadJson<StormFeed>("/api/nhc/current.json"),
  loadJson<AlertFeed>("/api/nws/alerts.json?area=FL")
]);

const storms = stormFeed?.storms ?? [];
const floridaAlerts = floridaAlertFeed?.alerts ?? [];
const featuredStateName = "Florida";
const featuredDecisionLevel = floridaAlertFeed?.decisionLevel ?? (storms.length ? "Prepare" : "Monitor");
const lastModified = floridaAlertFeed?.updatedAt ?? stormFeed?.updatedAt ?? site.contentLastModified;
const nextAction =
  featuredDecisionLevel === "Leave"
    ? "Follow local evacuation orders now."
    : featuredDecisionLevel === "Act"
      ? "Move vulnerable people and finish protective actions."
      : featuredDecisionLevel === "Prepare"
        ? "Finish supplies, documents, fuel, and route planning."
        : "Monitor official advisories and confirm your zone.";

const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title, description, url: site.canonicalUrl, dateModified: lastModified }),
  faqSchema(faqs)
);

const tools = [
  { href: "/tools/preparedness-checklist/", icon: "fa-clipboard-check", title: "Preparedness Checklist Generator", body: "Create a kit list for 1–4 people, with optional pet supplies and document reminders." },
  { href: "/tools/evacuation-decision-helper/", icon: "fa-route", title: "Evacuation Decision Helper", body: "Answer a few household questions to sort your situation into Monitor, Prepare, Act, or Leave." },
  { href: "/tools/hurricane-brief/", icon: "fa-file-lines", title: "Hurricane Brief Generator", body: "Turn a ZIP code and live official feeds into a printable household brief you can share with family." },
  { href: "/tools/impact-window-estimator/", icon: "fa-clock", title: "Impact Window Estimator", body: "Use current alert timing and storm context to decide whether to monitor, prepare, act, or leave." },
  { href: "/tools/storm-distance-calculator/", icon: "fa-location-crosshairs", title: "Storm Distance Calculator", body: "Compare a ZIP code with the current NHC storm position, then verify the forecast and local alerts." }
];
const featuredCities = hurricaneCities.slice(0, 9);
---

<Layout title={title} description={description} canonical={site.url} jsonLd={jsonLd} lastModified={lastModified} showTopAd={true}>
  <Fragment slot="head">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  </Fragment>
  <section class="hero band" aria-labelledby="home-title">
    <div class="inner hero-grid">
      <div>
        <p class="eyebrow">North America hurricane operations</p>
        <h1 id="home-title">HurricaneHub</h1>
        <p class="answer">HurricaneHub shows live hurricanes approaching North America, official NHC storm context, state NWS warnings, and emergency decision tools so coastal households can monitor, prepare, act, or leave with fewer tabs open.</p>
        <p class="section-actions">
          <a class="action-link" href="/tools/my-hurricane-dashboard/">Build my hurricane dashboard</a>
          <a class="action-link secondary-action" href="/tools/local-risk-plan/">Check local risk</a>
        </p>
      </div>
      <div class="decision-card" aria-label="Current emergency decision snapshot">
        <p class="eyebrow">Current snapshot</p>
        <h2>{featuredDecisionLevel}</h2>
        <p>{nextAction}</p>
        <div class="dashboard compact-dashboard" aria-label="Current official feed metrics">
          <div class="metric"><strong>{storms.length}</strong><span>active NHC systems</span></div>
          <div class="metric"><strong>{floridaAlerts.length}</strong><span>{featuredStateName} NWS alerts</span></div>
        </div>
        <p class="source-note">Official {featuredStateName} feed checked {new Date(lastModified).toLocaleString("en-US", { timeZone: "UTC" })} UTC.</p>
      </div>
    </div>
  </section>

  <section class="band persona-band" aria-labelledby="persona-heading">
    <div class="inner">
      <p class="eyebrow">Start where you are</p>
      <h2 id="persona-heading">Pick Your Situation</h2>
      <div class="grid-3 section-grid persona-grid">
        <article class="state-card persona-card">
          <span class="why-icon" aria-hidden="true"><i class="fa-solid fa-house-chimney-crack"></i></span>
          <h3>Coastal resident getting ready</h3>
          <p>Build your kit, confirm your evacuation zone, and set a family communication plan before a storm forms.</p>
          <a href="/preparedness/">Prepare my household</a>
        </article>
        <article class="state-card persona-card">
          <span class="why-icon" aria-hidden="true"><i class="fa-solid fa-triangle-exclamation"></i></span>
          <h3>A storm is heading my way</h3>
          <p>Check live NWS alerts for your area, run the evacuation decision helper, and watch the radar in real time.</p>
          <a href="/alerts/">See active alerts</a>
        </article>
        <article class="state-card persona-card">
          <span class="why-icon" aria-hidden="true"><i class="fa-solid fa-book-open"></i></span>
          <h3>Just want to understand hurricanes</h3>
          <p>Learn how the Saffir-Simpson scale, cone of uncertainty, and spaghetti models actually work — plain language, no jargon.</p>
          <a href="/blog/">Read the guides</a>
        </article>
      </div>
    </div>
  </section>

  <LocalRiskWidget />

  <section class="band stats-band" aria-labelledby="stats-heading">
    <div class="inner">
      <p class="eyebrow">By the numbers</p>
      <h2 id="stats-heading">HurricaneHub At A Glance</h2>
      <div class="metric-strip">
        <div class="metric"><i class="fa-solid fa-map-location-dot"></i><div><strong>{coastalStates.length}</strong><span>coastal states tracked</span></div></div>
        <div class="metric"><i class="fa-solid fa-satellite-dish"></i><div><strong>{stats.liveFeeds}</strong><span>live official data feeds</span></div></div>
        <div class="metric"><i class="fa-solid fa-toolbox"></i><div><strong>{stats.tools}</strong><span>decision tools</span></div></div>
        <div class="metric"><i class="fa-solid fa-book-open"></i><div><strong>{blogPosts.length}</strong><span>preparedness guides</span></div></div>
      </div>
    </div>
  </section>

  <div id="dashboard"><LiveDashboard /></div>

  <section class="band why-hub" id="why-hurricanehub" aria-labelledby="why-heading">
    <div class="inner">
      <p class="eyebrow">Preparedness platform</p>
      <h2 id="why-heading">Why HurricaneHub?</h2>
      <div class="grid-3 why-grid">
        <article class="why-card">
          <span class="why-icon" aria-hidden="true"><i class="fa-solid fa-satellite-dish"></i></span>
          <h3>Real-Time NOAA Data</h3>
          <p>HurricaneHub pulls live storm positions and alerts straight from NOAA and the National Hurricane Center, so you see the same official data meteorologists use—no third-party delays or reinterpretation.</p>
        </article>
        <article class="why-card">
          <span class="why-icon" aria-hidden="true"><i class="fa-solid fa-mobile-screen-button"></i></span>
          <h3>No App Download Needed</h3>
          <p>Everything runs in your browser. Open the tracker, check your state, and build a plan on any phone or laptop—no install, no account, no update prompts getting in the way when a storm approaches.</p>
        </article>
        <article class="why-card">
          <span class="why-icon" aria-hidden="true"><i class="fa-solid fa-broom"></i></span>
          <h3>Clean, Ad-Light Experience</h3>
          <p>Unlike cluttered weather portals buried in autoplay video and pop-ups, HurricaneHub stays focused on the decision in front of you: monitor, prepare, act, or leave.</p>
        </article>
      </div>
      <p class="why-cta">
        <a class="action-link" href="#dashboard">Start Tracking Now — No Signup, No Clutter</a>
      </p>
    </div>
  </section>

  <section class="band" aria-labelledby="quick-actions-heading">
    <div class="inner">
      <p class="eyebrow">5-second decision path</p>
      <h2 id="quick-actions-heading">What To Do First</h2>
      <div class="grid-3 section-grid">
        <article class="state-card">
          <span class="badge danger">Leave</span>
          <h3>Evacuation order or surge zone?</h3>
          <p>Do not wait for the map to look worse. Follow county orders, move early if anyone depends on power or medical equipment, and keep routes flexible.</p>
        </article>
        <article class="state-card">
          <span class="badge warn">Act</span>
          <h3>Warning-level wind, surge, flood, or tornado alert?</h3>
          <p>Finish window protection, bring in loose items, charge phones, move vehicles, and check shelter rules before conditions deteriorate.</p>
        </article>
        <article class="state-card">
          <span class="badge">Monitor</span>
          <h3>No active local warning?</h3>
          <p>Use the tracker and state page as a watch desk: confirm your zone, review the kit list, and check official advisories twice daily during hurricane season.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="state-heading">
    <div class="inner">
      <p class="eyebrow">Choose your state</p>
      <h2 id="state-heading">State Hurricane Trackers</h2>
      <p class="answer">Start with your state page to combine official NHC storm context, active NWS alerts, county planning notes, and a household decision level.</p>
      <div class="grid-3 section-grid">
        {coastalStates.map((state) => (
          <article class="state-card">
            <h3>{state.name} Hurricane Tracker</h3>
            <div class="risk-tags">
              {state.risks.slice(0, 3).map((risk) => <span class="risk-tag">{risk}</span>)}
            </div>
            <a href={`/tracker/${state.slug}/`}>Open {state.name}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="tools-heading">
    <div class="inner">
      <article class="section-intro">
        <p class="eyebrow">Emergency decisions</p>
        <h2 id="tools-heading">Tools That Turn Alerts Into Actions</h2>
        <p class="answer">HurricaneHub is built around household decisions: what to pack, when to prepare, whether to leave early, and which official alert should change your plan.</p>
      </article>
      <div class="tool-grid section-grid">
        {tools.map((tool) => (
          <article class="tool-card">
            <span class="tool-icon" aria-hidden="true"><i class="fa-solid {tool.icon}"></i></span>
            <h3>{tool.title}</h3>
            <p>{tool.body}</p>
            <a href={tool.href}>Open tool</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="advantage-heading">
    <div class="inner">
      <p class="eyebrow">Differentiation from radar-only tracking</p>
      <h2 id="advantage-heading">What HurricaneHub Adds</h2>
      <div class="grid-2 section-grid">
        <article class="state-card">
          <h3>Emergency Decision Layer</h3>
          <p>Stormtracking.io-style radar, satellite, and alert views answer what is happening. HurricaneHub adds what a household should decide next, with source-labeled state alerts and risk thresholds built for search and AI answer engines.</p>
        </article>
        <article class="state-card">
          <h3>First-Party Data Notes</h3>
          <p>The MVP records feed path, cache window, and runtime behavior. These notes create information gain for SEO/GEO pages because they explain exactly how official data is acquired and refreshed.</p>
        </article>
      </div>
      <div class="grid-3 section-grid">
        {differentiators.map((item) => (
          <article class="state-card">
            <h3>{item.split(" ")[0]} Advantage</h3>
            <p>{item}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="city-heading">
    <div class="inner">
      <p class="eyebrow">Local landing pages</p>
      <h2 id="city-heading">City Hurricane Trackers</h2>
      <p class="answer">Start with a city page for local planning notes, nearby counties, state alert links, and decision tools.</p>
      <p class="section-actions"><a class="action-link secondary-action" href="/hurricane-tracker/city/">Browse all city trackers</a></p>
      <div class="grid-3 section-grid">
        {featuredCities.map((city) => (
          <article class="state-card">
            <h3>{city.name} Hurricane Tracker</h3>
            <div class="risk-tags">
              {city.risks.slice(0, 3).map((risk) => <span class="risk-tag">{risk}</span>)}
            </div>
            <a href={`/hurricane-tracker/city/${city.slug}/`}>Open {city.name}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ReminderSignup source="Homepage reminder signup" />

  <FaqBlock faqs={faqs} />
</Layout>

<style>
  .secondary-action {
    background: var(--navy);
  }

  .section-grid {
    margin-top: 22px;
  }

  /* Subtle tech grid across the whole homepage body (theme-aware, faint). */
  :global(body) {
    background-image: radial-gradient(circle at 1px 1px, rgba(14, 111, 143, 0.05) 1px, transparent 0);
    background-size: 28px 28px;
  }

  /* ---------- Hero: command-center treatment ---------- */
  .hero {
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.07) 1px, transparent 1px);
    background-size: 42px 42px;
    -webkit-mask-image: radial-gradient(ellipse at 28% 42%, #000 28%, transparent 78%);
    mask-image: radial-gradient(ellipse at 28% 42%, #000 28%, transparent 78%);
    pointer-events: none;
  }

  .hero::after {
    content: "";
    position: absolute;
    width: 52%;
    height: 130%;
    top: -25%;
    right: -8%;
    background: radial-gradient(circle, rgba(120, 220, 240, 0.30), transparent 62%);
    filter: blur(46px);
    pointer-events: none;
  }

  .hero h1 {
    background: linear-gradient(120deg, #ffffff 0%, #bdeef7 55%, #74c7d9 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .decision-card {
    box-shadow: 0 26px 64px rgba(0, 0, 0, 0.38);
  }

  .decision-card .metric {
    background: rgba(255, 255, 255, 0.10);
    border-color: rgba(255, 255, 255, 0.18);
    color: #fff;
  }

  .decision-card .metric span {
    color: rgba(255, 255, 255, 0.82);
  }

  .decision-card .source-note {
    color: rgba(255, 255, 255, 0.7);
  }

  /* ---------- Shared card surface (tech glass) ---------- */
  .why-card,
  .state-card,
  .tool-card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--panel);
    box-shadow: var(--soft-shadow);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }

  .why-card:hover,
  .state-card:hover,
  .tool-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
    border-color: rgba(14, 111, 143, 0.4);
  }

  .why-card::before,
  .state-card::before,
  .tool-card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--ocean), #6fd0e0);
  }

  /* ---------- Why cards ---------- */
  .why-hub {
    background: #f0f6ff;
  }

  .why-grid {
    margin-top: 22px;
  }

  .why-card {
    padding: 26px 22px;
  }

  .why-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: rgba(14, 111, 143, 0.10);
    color: var(--ocean);
    font-size: 1.35rem;
    margin-bottom: 14px;
  }

  .why-card h3 {
    margin: 0 0 8px;
  }

  .why-card p {
    margin: 0;
    color: var(--muted);
  }

  .why-cta {
    margin-top: 26px;
    text-align: center;
  }

  /* ---------- State / generic cards ---------- */
  .state-card {
    padding: 20px;
  }

  .state-card h3 {
    margin: 0 0 10px;
  }

  .state-card p {
    color: var(--muted);
    margin: 0 0 14px;
  }

  .risk-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 14px;
  }

  .risk-tag {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 3px 9px;
    border-radius: 999px;
    background: rgba(14, 111, 143, 0.10);
    color: var(--ocean);
    border: 1px solid rgba(14, 111, 143, 0.18);
  }

  .state-card a {
    font-weight: 800;
    color: var(--ocean);
    text-decoration: none;
  }

  .state-card a:hover {
    text-decoration: underline;
  }

  /* ---------- Badges (decision levels) ---------- */
  .badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 10px;
    border-radius: 6px;
    margin-bottom: 10px;
    background: var(--ocean);
    color: #fff;
  }

  .badge.danger { background: var(--signal); }
  .badge.warn { background: var(--amber); }

  /* ---------- Tools grid (clean, no fragile centering) ---------- */
  .tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: clamp(16px, 2vw, 22px);
  }

  .tool-card {
    display: flex;
    flex-direction: column;
    padding: 22px 20px;
  }

  .tool-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(14, 111, 143, 0.10);
    color: var(--ocean);
    font-size: 1.3rem;
    margin-bottom: 12px;
  }

  .tool-card h3 {
    margin: 0 0 8px;
  }

  .tool-card p {
    color: var(--muted);
    margin: 0 0 16px;
  }

  .tool-card a {
    margin-top: auto;
    align-self: flex-start;
    font-weight: 800;
    color: var(--ocean);
    text-decoration: none;
  }

  .tool-card a:hover {
    text-decoration: underline;
  }

  /* ---------- Homepage card grids: equal height + bottom-aligned CTAs ---------- */
  .persona-grid,
  .why-grid,
  .section-grid {
    align-items: stretch;
  }

  .persona-card,
  .why-card,
  .section-grid > .state-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .persona-card > a:last-child,
  .section-grid > .state-card > a:last-child {
    margin-top: auto;
    align-self: flex-start;
  }
</style>
