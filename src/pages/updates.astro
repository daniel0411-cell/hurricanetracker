---
import Layout from "../layouts/Layout.astro";
import { blogPosts } from "../data/blog";
import { hurricaneCities } from "../data/cities";
import { site } from "../data/site";
import { stormTrackerPages } from "../data/stormPages";
import { topicPages } from "../data/topicPages";
import { articleSchema, graph, itemListSchema, websiteSchema } from "../lib/schema";
import type { NhcStorm } from "../lib/weather";
import { getAtlanticOutlook } from "../lib/nhcOutlook";

const title = "Latest Hurricane Tracker Updates";
const description = "Recent HurricaneHub updates: new hurricane preparedness articles, city tracker pages, storm tracker pages, tools, and sitemap discovery sections.";
const url = `${site.url}/updates/`;
let activeStorms: NhcStorm[] = [];
let lastModified = site.contentLastModified;
const atlanticOutlook = await getAtlanticOutlook();
try {
  const response = await fetch(new URL("/api/nhc/current.json", Astro.url));
  if (response.ok) {
    const feed = await response.json() as { storms?: NhcStorm[]; updatedAt?: string; fetchedAt?: string };
    activeStorms = feed.storms ?? [];
    lastModified = feed.updatedAt ?? feed.fetchedAt ?? lastModified;
  }
} catch (error) {
  console.error("HurricaneHub updates feed failed", { error });
}

const toolUpdates = [
  { title: "Hurricane Topics", href: "/topics/", description: "Content clusters for tracking, local evacuation risk, preparedness, alerts, storm surge, insurance, and recovery.", date: lastModified, type: "Topic Hub" },
  { title: "Local Hurricane Risk", href: "/local-hurricane-risk/", description: "ZIP, city, state, surge, evacuation-zone, and household planning paths for local hurricane risk.", date: lastModified, type: "Topic Hub" },
  { title: "My Hurricane Dashboard", href: "/tools/my-hurricane-dashboard/", description: "Track saved locations and active threats.", date: lastModified, type: "Tool" },
  { title: "Storm Surge ZIP Checker", href: "/tools/storm-surge-checker/", description: "Check nearby surge-related NWS alerts by ZIP code.", date: lastModified, type: "Tool" },
  { title: "Local Risk Plan", href: "/tools/local-risk-plan/", description: "Build a localized hurricane plan from a ZIP code or address.", date: lastModified, type: "Tool" },
  { title: "Alert Action Decoder", href: "/tools/alert-action-decoder/", description: "Translate watches, warnings, and advisories into planning prompts.", date: lastModified, type: "Tool" }
];

const cityUpdates = hurricaneCities.slice(-12).reverse().map((city) => ({
  title: `${city.name} Hurricane Tracker`,
  href: `/hurricane-tracker/city/${city.slug}/`,
  description: city.planningNote,
  date: lastModified,
  type: "City Tracker"
}));

const stormUpdates = stormTrackerPages.map((storm) => ({
  title: `Hurricane ${storm.name} Tracker`,
  href: `/hurricane-tracker/storm/${storm.slug}/`,
  description: storm.searchDemandNote,
  date: lastModified,
  type: "Storm Tracker"
}));
const activeStormUpdates = activeStorms.filter((storm) => storm.name).map((storm) => ({
  title: `${storm.name} Live Tracker`,
  href: `/hurricane-tracker/storm/${String(storm.name).toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "")}/`,
  description: `${storm.classification ?? "NHC system"} ${storm.name}: current position, forecast path, advisory and radar context.`,
  date: storm.lastUpdate ?? lastModified,
  type: "Active Storm"
}));

const topicUpdates = topicPages.map((page) => ({
  title: page.title,
  href: `/hurricane-tracker/${page.slug}/`,
  description: page.description,
  date: lastModified,
  type: "Tracker Hub"
}));
const freshTopicSlugs = ["live-tracker", "preparedness-checklist", "spaghetti-models", "radar", "storm-surge-map", "evacuation-zones"];
const freshTopicUpdates = freshTopicSlugs
  .map((slug) => topicUpdates.find((item) => item.href === `/hurricane-tracker/${slug}/`))
  .filter((item): item is NonNullable<typeof item> => Boolean(item));
const updateUseCases = [
  {
    title: "New to the site",
    body: "Start with topic clusters and the learning center, then move into live tracking, local risk, or preparedness when a storm becomes relevant.",
    links: [
      { label: "Hurricane topics", href: "/topics/" },
      { label: "Learning center", href: "/learn/" }
    ]
  },
  {
    title: "Tracking an active storm",
    body: "Use the live tracker, NWS alerts, radar, and city pages before relying on any single update or article.",
    links: [
      { label: "Live hurricane tracker", href: "/hurricane-tracker/live/" },
      { label: "Active NWS alerts", href: "/alerts/" },
      { label: "Interactive radar", href: "/radar/" }
    ]
  },
  {
    title: "Checking what was recently added",
    body: "Use the update sections to find new topic hubs, recent guides, city trackers, named-storm pages, and household tools.",
    links: [
      { label: "Recent guides", href: "#guides" },
      { label: "Recent city trackers", href: "#cities" },
      { label: "Tool updates", href: "#tools" }
    ]
  }
];

const blogUpdates = blogPosts
  .slice()
  .sort((a, b) => new Date(b.dateModified).getTime() - new Date(a.dateModified).getTime())
  .slice(0, 18)
  .map((post) => ({
    title: post.title,
    href: `/blog/${post.slug}/`,
    description: post.description,
    date: post.dateModified || post.datePublished,
    type: "Guide"
  }));

const updates = [...activeStormUpdates, ...blogUpdates, ...topicUpdates, ...cityUpdates, ...stormUpdates, ...toolUpdates]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const sections = [
  { id: "active-storms", title: "Active Storm Updates", items: activeStormUpdates },
  { id: "topics", title: "Tracker Topic Hubs", items: topicUpdates },
  { id: "guides", title: "Recent Guides", items: blogUpdates },
  { id: "cities", title: "Recent City Trackers", items: cityUpdates },
  { id: "storms", title: "Storm Tracker Updates", items: stormUpdates },
  { id: "tools", title: "Tool Updates", items: toolUpdates }
];

const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title, description, url, dateModified: lastModified }),
  itemListSchema(updates.slice(0, 30).map((item) => ({
    name: item.title,
    url: new URL(item.href, site.url).href,
    description: item.description
  }))),
  itemListSchema(updateUseCases.flatMap((useCase) => useCase.links.map((link) => ({
    name: link.label,
    url: new URL(link.href, site.url).href,
    description: useCase.body
  }))))
);
---
<Layout title={title} description={description} canonical={url} jsonLd={jsonLd} lastModified={lastModified}>
  <section class="band" aria-labelledby="updates-title">
    <div class="inner">
      <p class="eyebrow">Fresh discovery hub</p>
      <h1 id="updates-title">Latest HurricaneHub Updates</h1>
      <p class="answer">Use this page to find recently added hurricane preparedness guides, local city trackers, named storm pages, and planning tools. For live storm decisions, always pair these pages with official NHC advisories, weather.gov alerts, and local emergency management.</p>
      <div class="quick-links" aria-label="Update sections">
        {sections.map((section) => <a href={`#${section.id}`}>{section.title}</a>)}
        <a href="/sitemap-index.xml">Sitemap index</a>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="fresh-topic-heading">
    <div class="inner">
      <p class="eyebrow">Recently expanded tracker paths</p>
      <h2 id="fresh-topic-heading">New Hurricane Tracker Topic Paths</h2>
      <p class="answer">These topic pages connect high-intent searches to live tools, official-source context, state and city trackers, and household planning decisions.</p>
      <div class="grid-3 section-grid">
        {freshTopicUpdates.map((item) => (
          <article class="panel">
            <p class="eyebrow">{item.type}</p>
            <h3><a href={item.href}>{item.title}</a></h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {atlanticOutlook && <section class="band" aria-labelledby="atlantic-watch-heading"><div class="inner"><p class="eyebrow">NHC Atlantic outlook · {atlanticOutlook.issued}</p><h2 id="atlantic-watch-heading">Developing Areas To Watch Now</h2><p class="answer">{atlanticOutlook.text}</p><p class="section-actions"><a class="action-link" href="/hurricane-tracker/tropical-disturbances/">Open disturbance tracker</a><a class="action-link secondary-action" href="/tracker/texas/">Texas tracker</a><a class="action-link secondary-action" href="/tracker/louisiana/">Louisiana tracker</a></p><p class="source-note">This is the latest official formation outlook, not a named-storm advisory or landfall forecast.</p></div></section>}

  <section class="band" aria-labelledby="updates-use-cases">
    <div class="inner">
      <p class="eyebrow">How to use updates</p>
      <h2 id="updates-use-cases">Choose the Update Path That Matches Your Goal</h2>
      <p class="answer">This page is both a recent-content feed and a discovery hub. Use it to find new pages, but switch to live official-source pages when a storm or alert affects your location.</p>
      <div class="grid-3 section-grid">
        {updateUseCases.map((useCase) => (
          <article class="panel">
            <h3>{useCase.title}</h3>
            <p>{useCase.body}</p>
            <ul class="check-list">
              {useCase.links.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  {sections.map((section) => (
    <section class="band" id={section.id} aria-labelledby={`${section.id}-heading`}>
      <div class="inner">
        <div class="section-heading">
          <p class="eyebrow">{section.items.length} updates</p>
          <h2 id={`${section.id}-heading`}>{section.title}</h2>
        </div>
        <div class="link-list">
          {section.items.map((item) => (
            <article class="link-row">
              <p class="eyebrow">{item.type} · Updated {new Date(item.date).toLocaleDateString("en-US", { timeZone: "UTC" })}</p>
              <h3><a href={item.href}>{item.title}</a></h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="band" aria-labelledby="sitemap-discovery-heading">
    <div class="inner grid-2">
      <article class="panel">
        <h2 id="sitemap-discovery-heading">Sitemap Discovery Sections</h2>
        <p>These XML files split the site into clearer discovery groups while the original sitemap remains available.</p>
        <ul class="check-list">
          <li><a href="/sitemap-pages.xml">Core pages sitemap</a></li>
          <li><a href="/sitemap-blog.xml">Blog sitemap</a></li>
          <li><a href="/sitemap-tools.xml">Tools sitemap</a></li>
          <li><a href="/sitemap-locations.xml">Locations sitemap</a></li>
        </ul>
      </article>
      <article>
        <p class="eyebrow">Next step after browsing</p>
        <h2>Move From Reading to Action</h2>
        <p class="answer">Open the live tracker, alerts page, city tracker, or household tool that matches your current question before relying on any single article.</p>
        <ul class="check-list">
          <li><a href="/hurricane-tracker/live/">Live hurricane tracker</a></li>
          <li><a href="/alerts/">Active NWS alerts</a></li>
          <li><a href="/hurricane-tracker/city/">City hurricane trackers</a></li>
          <li><a href="/tools/">Hurricane tools</a></li>
        </ul>
      </article>
    </div>
  </section>
</Layout>
