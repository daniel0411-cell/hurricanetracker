    max-width: 720px;
    margin: 0 auto;
    padding: 2rem 1.25rem 3rem;
    line-height: 1.7;
  }
  .prose h1 {
    font-size: 2rem;
    line-height: 1.2;
    margin-bottom: 1rem;
  }
  .prose h2 {
    font-size: 1.35rem;
    margin: 2rem 0 0.75rem;
  }
  .lead {
    font-size: 1.1rem;
    color: var(--muted, #4a5568);
  }
  .prose a {
    color: var(--accent, #1f6feb);
    text-decoration: underline;
  }
  .table-scroll { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: .95rem; }
  caption { text-align: left; padding: .5rem 0; }
  th, td { text-align: left; vertical-align: top; padding: .65rem; border: 1px solid var(--border, #e2e8f0); min-width: 8rem; }
  details { margin-block: 1rem; }
  summary { cursor: pointer; font-weight: 600; }
  .byline {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border, #e2e8f0);
    font-style: italic;
    color: var(--muted, #4a5568);
  }
</style>
