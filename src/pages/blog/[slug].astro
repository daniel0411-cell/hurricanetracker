---
import Layout from "../../layouts/Layout.astro";
import { blogPosts } from "../../data/blog";
import { faqs, site } from "../../data/site";
import { articleSchema, faqSchema, graph, websiteSchema } from "../../lib/schema";

const slug = Astro.params.slug ?? "";
const post = blogPosts.find((item) => item.slug === slug) ?? blogPosts[0];
const title = post.title;
const description = post.description;
const url = `${site.url}/blog/${post.slug}/`;
const lastModified = new Date(post.dateModified).toISOString();
const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title, description, url, dateModified: lastModified }),
  faqSchema(faqs)
);
---
<Layout title={title} description={description} canonical={url} jsonLd={jsonLd} lastModified={lastModified}>
  <article class="band" aria-labelledby="post-title">
    <div class="inner">
      <p class="eyebrow">HurricaneHub blog</p>
      <h1 id="post-title">{post.title}</h1>
      <p class="answer">{post.description}</p>
      <p class="small">Published {post.datePublished} · Last modified {post.dateModified}</p>
    </div>
  </article>

  <section class="band" aria-labelledby="article-body">
    <div class="inner grid-2">
      <div class="stack">
        <h2 id="article-body">Key Takeaways</h2>
        <p>Use official NOAA, National Hurricane Center, and National Weather Service updates as the source of truth. Seasonal outlooks and preparedness articles can help you plan, but they do not replace local alerts or evacuation orders.</p>
        <h3>Preparedness Timing</h3>
        <p>Prepare supplies, documents, transportation, and communication plans before a named storm threatens your area. Waiting for a warning can reduce safe options.</p>
        <div class="ad-slot ad-slot-incontent"><!-- AD SLOT 3: In-Content Native --></div>
        <h3>Official Source Check</h3>
        <p>Before making a life-safety decision, check weather.gov, your local emergency management agency, and current NHC advisories.</p>
      </div>
      <aside class="panel">
        <h2>NOAA/NHC Source Note</h2>
        <p>This article is informational and uses official weather agencies as source context. It is not an official forecast, evacuation order, or emergency instruction.</p>
      </aside>
    </div>
  </section>
</Layout>
