---
import Layout from "../../layouts/Layout.astro";
import FaqBlock from "../../components/FaqBlock.astro";
import AdPlacement from "../../components/AdPlacement.astro";
import ReferenceText from "../../components/ReferenceText.astro";
import { blogPosts, getBlogOgImage, getCategory, getRelatedPosts } from "../../data/blog";
import { site } from "../../data/site";
import { blogPostingSchema, faqSchema, graph, itemListSchema, websiteSchema } from "../../lib/schema";

const slug = Astro.params.slug ?? "";
const post = blogPosts.find((item) => item.slug === slug);
if (!post) {
  return Astro.redirect("/blog/");
}
const title = post.title;
const description = post.description;
const url = `${site.url}/blog/${post.slug}/`;
const lastModified = new Date(post.dateModified).toISOString();
const relatedPosts = getRelatedPosts(post.slug, 3);
const category = getCategory(post.slug);
const postFaqs = post.faqs ?? [];
const adsEnabled = import.meta.env.PUBLIC_ADS_ENABLED === "true";
const textSignal = [
  post.slug,
  post.title,
  post.description,
  category,
  ...post.sections.flatMap((section) => [section.heading, section.body, ...(section.bullets ?? [])])
].join(" ").toLowerCase();
const actionLibrary = [
  {
    name: "Build a preparedness checklist",
    href: "/tools/preparedness-checklist/",
    description: "Turn the article into a supplies, documents, pets, and household readiness checklist.",
    match: /prepared|checklist|kit|home|pet|family|document|medicine|medical|senior|children|disability/
  },
  {
    name: "Decode current alert language",
    href: "/tools/alert-action-decoder/",
    description: "Translate watch, warning, surge, flood, tornado, and evacuation wording into household actions.",
    match: /watch|warning|alert|evacuation|surge|flood|tornado|zone|leave|nws/
  },
  {
    name: "Open the live hurricane tracker",
    href: "/hurricane-tracker/live/",
    description: "Check current NHC storm context, live map shortcuts, radar, and active alert pathways.",
    match: /tracker|tracking|forecast|cone|spaghetti|rapid|intensification|radar|satellite|category|scale|cyclone|typhoon/
  },
  {
    name: "Check city hurricane trackers",
    href: "/hurricane-tracker/city/",
    description: "Move from general guidance to local storm surge, flooding, route, outage, and alert context.",
    match: /local|city|county|coast|inland|landfall|route|bridge|state/
  },
  {
    name: "Plan for power outages",
    href: "/tools/power-outage-planner/",
    description: "Prepare for charging, food safety, refrigerated medicine, generators, pets, and communication.",
    match: /power|outage|generator|food|refrigerated|charging|device|devices/
  },
  {
    name: "Estimate storm distance",
    href: "/tools/storm-distance-calculator/",
    description: "Compare a ZIP code with current NHC storm positions and understand distance limits.",
    match: /distance|far|position|latitude|location/
  },
  {
    name: "Review insurance and recovery steps",
    href: "/blog/hurricane-insurance-claim-guide-documentation/",
    description: "Organize damage evidence, insurer contacts, receipts, and questions about a claim.",
    match: /insurance|claim|deductible|nfip|damage|recovery|after|document/
  }
];
const matchedActions = actionLibrary.filter((action) => action.match.test(textSignal));
const defaultActions = [
  actionLibrary[0],
  actionLibrary[1],
  actionLibrary[2],
  actionLibrary[3]
];
const nextActions = [...matchedActions, ...defaultActions]
  .filter((action, index, arr) => action.href !== `/blog/${post.slug}/` && arr.findIndex((item) => item.href === action.href) === index)
  .slice(0, 2);
const ogImage = getBlogOgImage(post);
const jsonLd = graph(
  websiteSchema(),
  blogPostingSchema({ title, description, url, datePublished: new Date(post.datePublished).toISOString(), dateModified: lastModified, image: new URL(ogImage, site.url).href }),
  itemListSchema([
    ...nextActions.map((action) => ({
      name: action.name,
      description: action.description,
      url: `${site.url}${action.href}`
    })),
    ...relatedPosts.map((item) => ({
      name: item.title,
      description: item.description,
      url: `${site.url}/blog/${item.slug}/`
    }))
  ]),
  ...(postFaqs.length ? [faqSchema(postFaqs)] : [])
);
---
<Layout title={title} description={description} canonical={url} jsonLd={jsonLd} lastModified={lastModified} image={post.image} ogImage={ogImage} imageAlt={post.imageAlt} publishedTime={new Date(post.datePublished).toISOString()}>
  <article class="band" aria-labelledby="post-title">
    <div class="inner">
      <p class="eyebrow">HurricaneHub blog</p>
      <h1 id="post-title">{post.title}</h1>
      <p class="answer">{post.description}</p>
      <p class="small">By <a href="/about/">HurricaneHub</a> · Published {post.datePublished} · Last modified {post.dateModified}</p>
      <figure>
        <img class="article-hero-image" src={post.image} alt={post.imageAlt} width="1600" height="900" decoding="async" fetchpriority="high" />
        <figcaption class="small">{post.imageCaption ?? "Editorial cover illustration, not an official forecast graphic or an observed image of the event described."}</figcaption>
      </figure>
      {post.review && <p class="small">Correction check {post.review.date} · {post.review.scope}. {post.review.correction}</p>}
    </div>
  </article>

  <section class="band" aria-labelledby="article-body">
    <div class="inner grid-2 article-grid">
      <div class="stack">
        <h2 id="article-body">{post.title}</h2>
        {post.sections.map((section, index) => (
          <section aria-labelledby={`section-${index}`}>
            <h3 id={`section-${index}`}>{section.heading}</h3>
            {section.body && <p><ReferenceText text={section.body} /></p>}
            {section.bullets && (
              <ul class="check-list">
                {section.bullets.map((bullet) => <li><ReferenceText text={bullet} /></li>)}
              </ul>
            )}
            {section.links && (
              <ul class="check-list">
                {section.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
              </ul>
            )}
          </section>
        ))}
        {post.figures?.map((figure) => (
          <figure class="article-figure">
            <img src={figure.src} alt={figure.alt} width="1600" height="900" loading="lazy" decoding="async" />
            <figcaption>{figure.caption}</figcaption>
          </figure>
        ))}
        <AdPlacement placement="in-content" enabled={adsEnabled} />
        <section aria-labelledby="article-sources">
          <h2 id="article-sources">References</h2>
          <ul class="check-list">{post.sources.map((source) => <li><a href={source.href}>{source.label}</a></li>)}</ul>
          <p class="small">References provide background; they are not an endorsement of HurricaneHub. Current warnings and local evacuation orders take priority over this article.</p>
        </section>
        <section aria-labelledby="next-actions-heading">
          <h2 id="next-actions-heading">Next Actions After Reading</h2>
          <div class="article-action-grid">
            {nextActions.map((action) => (
              <article class="article-action">
                <h3><a href={action.href}>{action.name}</a></h3>
                <p>{action.description}</p>
              </article>
            ))}
          </div>
        </section>
      </div>
      <aside class="stack">
        <section class="panel">
          <h2>Related Articles</h2>
          <ul class="related-list">
            {relatedPosts.map((item) => (
              <li>
                <a href={`/blog/${item.slug}/`} class="related-link">{item.title}</a>
                <p class="related-desc">{item.description}</p>
              </li>
            ))}
          </ul>
        </section>
      </aside>
    </div>
  </section>
  {postFaqs.length > 0 && <FaqBlock faqs={postFaqs} />}
</Layout>

<style>
  .related-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .related-link {
    display: block;
    font-weight: 800;
    line-height: 1.35;
    color: var(--accent, #0b63ce);
    text-decoration: none;
  }
  .related-link:hover {
    text-decoration: underline;
  }
  .related-desc {
    margin: 4px 0 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--muted, #6b7280);
  }
  .article-action-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    margin-top: 16px;
  }
  .article-action {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 14px;
    background: rgba(127, 127, 127, 0.04);
  }
  .article-action h3 {
    margin-top: 0;
  }
</style>
