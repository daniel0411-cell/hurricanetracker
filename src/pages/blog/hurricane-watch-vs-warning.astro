    font-size: 1.35rem;
    margin: 2rem 0 0.75rem;
  }
  .lead {
    font-size: 1.1rem;
    color: var(--muted, #4a5568);
  }
  .table-scroll { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  caption { text-align: left; padding: 0.5rem 0; }
  th, td { text-align: left; vertical-align: top; padding: 0.65rem; border: 1px solid var(--border, #e2e8f0); min-width: 8rem; }
  .prose a {
    color: var(--accent, #1f6feb);
    text-decoration: underline;
  }
