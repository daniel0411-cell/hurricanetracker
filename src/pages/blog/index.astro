---
import Layout from "../../layouts/Layout.astro";
import { blogPosts, getCategory, BLOG_CATEGORY_LIST, BLOG_CATEGORY_PAGES } from "../../data/blog";
import { faqs, site } from "../../data/site";
import { articleSchema, faqSchema, graph, itemListSchema, websiteSchema } from "../../lib/schema";

// Newest-first so the latest articles appear at the top of the listing.
const sortedPosts = [...blogPosts].sort((a, b) => b.datePublished.localeCompare(a.datePublished));
const clusterDefinitions = [
  {
    title: "Prepare Before a Storm Forms",
    intent: "preparedness checklist, hurricane kit, home preparation",
    description: "Use these guides when you are building supplies, protecting the home, organizing documents, and preparing pets or vulnerable household members.",
    slugs: [
      "hurricane-emergency-kit-checklist",
      "hurricane-preparation-timeline-72-48-24-hours",
      "hurricane-home-preparedness-room-by-room-checklist",
      "hurricane-home-hardening-checklist"
    ],
    actionHref: "/tools/preparedness-checklist/",
    actionLabel: "Generate a checklist"
  },
  {
    title: "Understand Watches, Warnings, and Evacuation",
    intent: "hurricane warning meaning, evacuation checklist, storm surge warning",
    description: "Start here when an alert appears and you need to translate official wording into household action without guessing.",
    slugs: [
      "what-hurricane-watch-warning-means",
      "nws-hurricane-alert-meanings",
      "storm-surge-warning-vs-hurricane-warning",
      "hurricane-evacuation-checklist"
    ],
    actionHref: "/tools/alert-action-decoder/",
    actionLabel: "Decode an alert"
  },
  {
    title: "Read Tracker Maps and Forecast Products",
    intent: "live hurricane tracker, cone of uncertainty, spaghetti models",
    description: "Learn how to interpret the cone, models, radar, satellite, category, and distance before relying on a single map signal.",
    slugs: [
      "real-time-hurricane-tracking-2026",
      "how-to-read-the-hurricane-cone-of-uncertainty",
      "how-to-read-hurricane-spaghetti-models",
      "hurricane-radar-vs-satellite"
    ],
    actionHref: "/hurricane-tracker/live/",
    actionLabel: "Open live tracker"
  },
  {
    title: "Plan for Flooding, Outages, and Recovery",
    intent: "flood insurance, hurricane claims, power outage planning",
    description: "Use these articles for the problems that continue after landfall: flooding, food safety, medicine, insurance records, and recovery documentation.",
    slugs: [
      "hurricane-power-outage-food-medicine-plan",
      "hurricane-flood-insurance-guide-nfip",
      "hurricane-insurance-claim-guide-documentation",
      "what-to-do-after-a-hurricane"
    ],
    actionHref: "/tools/power-outage-planner/",
    actionLabel: "Build outage plan"
  },
  {
    title: "Learn Hurricane Basics",
    intent: "hurricane category, typhoon vs cyclone, storm surge forecast",
    description: "Use these explainers when you want the science and vocabulary behind hurricane products before a storm is threatening your area.",
    slugs: [
      "saffir-simpson-hurricane-wind-scale-explained",
      "hurricane-vs-typhoon-vs-cyclone",
      "hurricane-storm-surge-forecasting",
      "hurricane-rapid-intensification"
    ],
    actionHref: "/learn/",
    actionLabel: "Open learning center"
  }
];
const clusters = clusterDefinitions.map((cluster) => ({
  ...cluster,
  posts: cluster.slugs
    .map((slug) => blogPosts.find((post) => post.slug === slug))
    .filter((post): post is NonNullable<typeof post> => Boolean(post))
}));
const categoryLinks = BLOG_CATEGORY_PAGES.map((category) => ({
  ...category,
  count: blogPosts.filter((post) => getCategory(post.slug) === category.name).length
}));
const intentBridgeLinks = [
  {
    intent: "I am tracking an active storm.",
    description: "Use articles for context, then move to the live map, radar, alerts, and storm pages for current information.",
    links: [
      { label: "Open live hurricane tracker", href: "/hurricane-tracker/live/" },
      { label: "Use radar and satellite map", href: "/radar/" },
      { label: "Browse active storm pages", href: "/hurricane-tracker/storm/" }
    ]
  },
  {
    intent: "I need local hurricane risk.",
    description: "Start with local city and state trackers, then use tools to turn that local context into a household plan.",
    links: [
      { label: "Browse city hurricane trackers", href: "/hurricane-tracker/city/" },
      { label: "Open state trackers", href: "/hurricane-tracker/" },
      { label: "Build local risk plan", href: "/tools/local-risk-plan/" }
    ]
  },
  {
    intent: "I need to understand official alert language.",
    description: "Pair watch, warning, flood, surge, and evacuation explainers with live NWS alert pages and the action decoder.",
    links: [
      { label: "Decode an alert", href: "/tools/alert-action-decoder/" },
      { label: "Check active NWS alerts", href: "/alerts/" },
      { label: "Read watch vs warning guide", href: "/blog/what-hurricane-watch-warning-means/" }
    ]
  },
  {
    intent: "I am preparing a household plan.",
    description: "Move from reading into practical tools for supplies, evacuation, communication, power, and special household needs.",
    links: [
      { label: "Generate preparedness checklist", href: "/tools/preparedness-checklist/" },
      { label: "Create family communication plan", href: "/tools/family-communication-plan/" },
      { label: "Build power outage plan", href: "/tools/power-outage-planner/" }
    ]
  }
];

const title = "Hurricane Preparedness Blog";
const description = "Read HurricaneHub articles about hurricane season outlooks, home preparedness, alerts, and emergency decision-making using NOAA/NHC source context.";
const url = `${site.url}/blog/`;
const lastModified = site.contentLastModified;
const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title, description, url, dateModified: lastModified }),
  itemListSchema(sortedPosts.map((post) => ({
    name: post.title,
    description: post.description,
    url: `${site.url}/blog/${post.slug}/`
  }))),
  itemListSchema(intentBridgeLinks.map((item) => ({
    name: item.intent,
    description: item.description,
    url: `${site.url}${item.links[0].href}`
  }))),
  faqSchema(faqs)
);
---
<Layout title={title} description={description} canonical={url} jsonLd={jsonLd} lastModified={lastModified}>
  <section class="band" aria-labelledby="blog-title">
    <div class="inner">
      <p class="eyebrow">Preparedness articles</p>
      <h1 id="blog-title">Hurricane Preparedness Blog</h1>
      <p class="answer">This blog explains hurricane outlooks, home preparation, official warning language, and emergency decisions using NOAA/NHC source context.</p>
      <p class="section-actions"><a class="action-link" href="/learn/">Open hurricane learning center</a></p>
    </div>
  </section>

  <section class="band" aria-labelledby="cluster-heading">
    <div class="inner">
      <p class="eyebrow">Topic clusters</p>
      <h2 id="cluster-heading">Browse Hurricane Guides by Search Intent</h2>
      <div class="grid-2 section-grid">
        {clusters.map((cluster) => (
          <article class="panel">
            <p class="eyebrow">{cluster.intent}</p>
            <h3>{cluster.title}</h3>
            <p>{cluster.description}</p>
            <ul class="cluster-list">
              {cluster.posts.map((post) => (
                <li>
                  <a href={`/blog/${post.slug}/`}>{post.title}</a>
                  <span>{getCategory(post.slug)}</span>
                </li>
              ))}
            </ul>
            <p><a class="action-link secondary-action" href={cluster.actionHref}>{cluster.actionLabel}</a></p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="category-hubs-heading">
    <div class="inner">
      <p class="eyebrow">Indexable category hubs</p>
      <h2 id="category-hubs-heading">Browse Articles by Hurricane Topic</h2>
      <div class="link-list">
        {categoryLinks.map((category) => (
          <article class="link-row">
            <h3><a href={`/blog/category/${category.slug}/`}>{category.title}</a></h3>
            <p>{category.description} ({category.count} articles)</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="blog-path-heading">
    <div class="inner grid-2">
      <article>
        <p class="eyebrow">From reading to action</p>
        <h2 id="blog-path-heading">Use Articles With Live Hurricane Tools</h2>
        <p class="answer">The articles explain how to interpret warnings, tracker maps, storm surge, evacuation zones, and preparedness choices. After reading, move to the live tracker, city trackers, or tools page for the current storm context.</p>
      </article>
      <article class="panel">
        <h3>Useful next pages</h3>
        <ul class="check-list">
          <li><a href="/hurricane-tracker/live/">Live hurricane tracker map</a></li>
          <li><a href="/hurricane-tracker/city/">City hurricane trackers</a></li>
          <li><a href="/tools/">Hurricane tools by situation</a></li>
          <li><a href="/alerts/">Active NWS alerts by state</a></li>
        </ul>
      </article>
    </div>
  </section>

  <section class="band" aria-labelledby="blog-intent-bridge">
    <div class="inner">
      <p class="eyebrow">Reading to action</p>
      <h2 id="blog-intent-bridge">Where to Go After Reading a Hurricane Article</h2>
      <p class="answer">Blog articles are strongest when they connect a search question to a live page, local tracker, or planning tool. Use these paths when the article answers the background but the situation still needs action.</p>
      <div class="grid-2 section-grid">
        {intentBridgeLinks.map((item) => (
          <article class="panel">
            <h3>{item.intent}</h3>
            <p>{item.description}</p>
            <ul class="intent-links">
              {item.links.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="post-list-heading">
    <div class="inner">
      <h2 id="post-list-heading">Latest Articles</h2>
      <div class="filter-bar" role="group" aria-label="Filter articles by category">
        {BLOG_CATEGORY_LIST.map((cat) => (
          cat === "All" ? (
            <button type="button" class="filter-chip" data-filter={cat} aria-pressed="true">{cat}</button>
          ) : (
            <a class="filter-chip filter-link" href={`/blog/category/${BLOG_CATEGORY_PAGES.find((item) => item.name === cat)?.slug}/`}>{cat}</a>
          )
        ))}
      </div>
      <div class="blog-grid">
        {sortedPosts.map((post) => {
          const cat = getCategory(post.slug);
          return (
          <article class="post-card" data-category={cat}>
            <a href={`/blog/${post.slug}/`} class="post-card-media" aria-hidden="true" tabindex="-1">
              <img class="post-image" src={post.image} alt={post.imageAlt} loading="lazy" width="1600" height="900" />
            </a>
            <span class="post-category">{cat}</span>
            <h3><a href={`/blog/${post.slug}/`} class="post-card-title">{post.title}</a></h3>
            <p>{post.description}</p>
            <p class="small">Last modified {post.dateModified}</p>
            <a href={`/blog/${post.slug}/`} class="post-card-link">Read article</a>
          </article>
          );
        })}
      </div>
    </div>
  </section>
  <style>
    .filter-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin: 0.5rem 0 1.75rem;
    }
    .filter-chip {
      border: 1px solid #2a3b56;
      background: transparent;
      color: #cdd9ec;
      padding: 0.4rem 0.9rem;
      border-radius: 999px;
      font-size: 0.9rem;
      cursor: pointer;
      transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    }
    .filter-link {
      display: inline-flex;
      align-items: center;
      text-decoration: none;
    }
    .filter-chip:hover { border-color: #4a7aaa; }
    .filter-chip[aria-pressed="true"] {
      background: #4a7aaa;
      color: #fff;
      border-color: #4a7aaa;
    }
    .post-category {
      display: inline-block;
      font-size: 0.72rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: #5b9bd5;
      margin: 0.6rem 0 0.2rem;
      font-weight: 600;
    }
    .cluster-list {
      display: grid;
      gap: 0.75rem;
      list-style: none;
      margin: 1rem 0 1.2rem;
      padding: 0;
    }
    .cluster-list li {
      display: grid;
      gap: 0.18rem;
      padding-top: 0.75rem;
      border-top: 1px solid var(--line, rgba(148, 163, 184, 0.28));
    }
    .cluster-list a {
      font-weight: 800;
      line-height: 1.35;
      text-decoration: none;
    }
    .cluster-list a:hover { text-decoration: underline; }
    .cluster-list span {
      color: var(--muted, #6b7280);
      font-size: 0.84rem;
    }
    .intent-links {
      display: grid;
      gap: 0.55rem;
      margin: 1rem 0 0;
      padding-left: 1.2rem;
    }
    .intent-links a {
      font-weight: 800;
    }
    .is-hidden { display: none !important; }
  </style>

  <script>
    const bar = document.querySelector(".filter-bar");
    if (bar) {
      const chips = bar.querySelectorAll<HTMLElement>(".filter-chip");
      const cards = document.querySelectorAll<HTMLElement>(".post-card");
      bar.addEventListener("click", (e) => {
        if (!(e.target instanceof Element)) return;
        const btn = e.target.closest<HTMLElement>(".filter-chip");
        if (!btn) return;
        const filter = btn.dataset.filter;
        chips.forEach((c) => c.setAttribute("aria-pressed", c === btn ? "true" : "false"));
        cards.forEach((card) => {
          const show = filter === "All" || card.dataset.category === filter;
          card.classList.toggle("is-hidden", !show);
        });
      });
    }
  </script>
</Layout>
