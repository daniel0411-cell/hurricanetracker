---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import { articleSchema, faqSchema, howToSchema, graph, itemListSchema, websiteSchema } from "../lib/schema";

const title = "HurricaneHub Decision Levels – When to Monitor, Prepare, Act, or Leave";
const description = "A plain-language guide to hurricane decision levels: what Monitor, Prepare, Act, and Leave mean, the official signals behind each, and the household actions to take at every stage.";
const url = `${site.url}/decision-guide/`;
const lastModified = "2026-11-04";

const levels = [
  {
    id: "monitor",
    name: "Monitor",
    body: "Monitor is the everyday baseline during the June 1–November 30 hurricane season. No hurricane watch or warning is active for your location, but tropical systems may be developing hundreds of miles away. At this level the right move is preparation without panic: learn your evacuation zone, bookmark official sources, and keep your emergency kit stocked and current. Monitor is also when households with medical, mobility, or pet needs should map out extra time and routes. Because hurricane risk can rise from calm to warning in days, the Monitor habit—checking advisories and confirming plans—keeps you ahead of the forecast instead of reacting to it.",
    points: [
      "Check NHC and NWS advisories at least twice daily during hurricane season.",
      "Confirm your county evacuation zone and shelter options before a storm forms.",
      "Keep your emergency kit, documents, and medication list current.",
      "Note bridge, causeway, and fuel constraints that matter for your area."
    ]
  },
  {
    id: "prepare",
    name: "Prepare",
    body: "Prepare indicates a watch or advisory in the returned feed. Read the event's own area and timing; not every watch shares a 48-hour window. Confirm supplies, medication, transport, and a destination while conditions are safe. If a local evacuation order already applies, follow that instruction rather than waiting for this label to change. Household needs should be planned in advance, not converted into an automatic departure recommendation from a state-level watch.",
    points: [
      "Stock water, food, cash, fuel, and a cooler plan before traffic builds.",
      "Photograph documents, back up records, and refill prescriptions.",
      "Charge battery packs and prepare power-outage options safely.",
      "Arrange transport and suitable shelter for mobile-home, medical, or mobility needs before a threat; record the local authority's deadline."
    ]
  },
  {
    id: "act",
    name: "Act",
    body: "Act means a warning requires its specific protective action now. Extreme Wind and Tornado Warnings call for immediate shelter in a sturdy structure; Flash Flood Warnings require action away from rising water. Hurricane and Storm Surge Warnings have separate instructions and affected areas. Act is not a 36-hour preparation window and does not establish that roads or shelters remain available. Check any overlapping local order without treating the label alone as an instruction to travel.",
    points: [
      "Extreme Wind Warning: take immediate shelter in the interior of a well-built structure.",
      "Tornado Warning: use a basement or small interior room on the lowest safe floor; protect your head.",
      "Flash Flood Warning: follow the warning's direction to higher ground; never cross floodwater.",
      "Hurricane or surge warning: read the full product and the local order; finish outdoor work only while safe."
    ]
  },
  {
    id: "leave",
    name: "Leave",
    body: "Leave is reserved in the automatic alert summary for an explicit evacuation event. Confirm whether the issuing authority's order includes your address, the required action, deadline, and route. Local orders may exist outside the NWS feed, so a different HurricaneHub label never cancels one. Extreme wind, tornado, and flooding require their own immediate protective instructions; a power outage alone does not establish a safe time or route to depart. If you cannot follow the order safely, contact local emergency services for assistance.",
    points: [
      "Follow evacuation orders for your specific zone immediately and safely.",
      "Use current official routes; lane reversal is available only when activated. Avoid flooded roads.",
      "Take your go-bag: documents, medicine, phone chargers, and water.",
      "Tell a contact your destination and expected arrival."
    ]
  }
];

const faqs = [
  {
    question: "What does Monitor level mean?",
    answer: "Monitor is the baseline level during hurricane season when no watch or warning is active for your area. At Monitor you check official advisories, confirm your evacuation zone, and keep your kit current—preparation without panic."
  },
  {
    question: "Should I evacuate at Prepare level?",
    answer: "The label cannot decide for your address. Confirm local orders and arrange transport, medication, and suitable shelter before conditions deteriorate. A local order takes priority even if the state alert summary still says Prepare."
  },
  {
    question: "How often do levels update?",
    answer: "Decision levels are derived from official NWS alerts and NHC storm context that update continuously. Re-check several times per day during an active threat, because watches and warnings can be issued or upgraded with little notice."
  },
  {
    question: "Can I get alerts for my specific county?",
    answer: "NWS issues alerts by county, zone, or warning polygon. Read the full alert's affected area at weather.gov. The local risk planner selects a state from your ZIP; it does not filter warnings to your county or address."
  },
  {
    question: "Is Leave level mandatory?",
    answer: "HurricaneHub does not issue mandatory orders. Read the actual issuing authority's order for your address and follow its area, action, and deadline. An automatic label cannot establish a legal order or a safe route."
  },
  {
    question: "Does HurricaneHub send push notifications?",
    answer: "Yes. After you enable reminders, HurricaneHub can notify you when new NWS alerts or decision-level changes affect your chosen area, so you do not have to keep the page open."
  }
];

const decisionPaths = [
  {
    name: "Read state alerts and build an action record",
    description: "Use a ZIP code or state to connect the current decision level with NWS alerts, local hazards, and household actions.",
    url: `${site.url}/tools/local-risk-plan/`
  },
  {
    name: "Decide whether your household should evacuate",
    description: "Sort housing type, surge exposure, transportation, pets, and medical needs into Monitor, Prepare, Act, or Leave.",
    url: `${site.url}/tools/evacuation-decision-helper/`
  },
  {
    name: "Decode official alert language",
    description: "Translate hurricane, storm surge, flood, tornado, and evacuation wording into plain-language next actions.",
    url: `${site.url}/tools/alert-action-decoder/`
  },
  {
    name: "Find your city hurricane tracker",
    description: "Move from a general decision level to city-specific risk context, nearby alerts, and local preparedness links.",
    url: `${site.url}/hurricane-tracker/city/`
  }
];

const levelLinks = [
  {
    level: "Monitor",
    href: "/hurricane-tracker/live/",
    label: "Open the live hurricane tracker",
    body: "Use this when no local warning is active but you want to watch active storms, source links, and basin context."
  },
  {
    level: "Prepare",
    href: "/tools/preparedness-checklist/",
    label: "Generate a preparedness checklist",
    body: "Use this when a tropical system could affect your area and you need supplies, documents, pet items, and medication ready."
  },
  {
    level: "Act",
    href: "/radar/",
    label: "Compare radar with alerts",
    body: "Read the specific warning and its protective action immediately. A tornado or extreme wind warning means shelter, not outdoor preparation."
  },
  {
    level: "Leave",
    href: "/blog/how-to-check-your-hurricane-evacuation-zone/",
    label: "Check evacuation-zone guidance",
    body: "Use this when local officials issue evacuation instructions or your household needs to leave before travel becomes unsafe."
  }
];

const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title, description, url, dateModified: lastModified }),
  itemListSchema(decisionPaths),
  faqSchema(faqs),
  howToSchema({
    name: "How to choose your hurricane decision level",
    description: "Match the current official alert and storm context to one of four household actions: Monitor, Prepare, Act, or Leave.",
    url,
    steps: [
      { name: "Monitor", text: "During hurricane season with no active watch or warning, check NHC and NWS advisories twice daily and confirm your evacuation zone." },
      { name: "Prepare", text: "Read the watch or advisory's own affected area and timing. Arrange supplies, transport, medication, and a destination while conditions are safe; record the actual local deadline." },
      { name: "Act", text: "Follow the specific warning's protective action now. Extreme wind and tornado warnings require immediate shelter; flood warnings require action away from rising water." },
      { name: "Leave", text: "Read the local evacuation order's affected area, deadline, and routes. A summary label does not replace that instruction or determine that travel is safe." }
    ]
  })
);
---

<BaseLayout title={title} description={description} canonical={url} jsonLd={jsonLd} lastModified={lastModified}>
  <article class="band" aria-labelledby="dg-title">
    <div class="inner">
      <p class="eyebrow">Household decision framework</p>
      <h1 id="dg-title">HurricaneHub Decision Levels – When to Monitor, Prepare, Act, or Leave</h1>
      <p class="answer">HurricaneHub sorts official alerts and storm context into four simple levels so a household knows what to do next. Use the level that matches your current official warning, not the scariest forecast headline.</p>
    </div>
  </article>

  {
    levels.map((level) => (
      <section class="band" aria-labelledby={`level-${level.id}`}>
        <div class="inner">
          <h2 id={`level-${level.id}`}>{level.name} Level</h2>
          <p>{level.body}</p>
          <ul class="check-list">
            {level.points.map((point) => <li>{point}</li>)}
          </ul>
        </div>
      </section>
    ))
  }

  <section class="band" aria-labelledby="dg-faq">
    <div class="inner stack">
      <h2 id="dg-faq">Decision Level FAQ</h2>
      {faqs.map((faq) => (
        <article class="faq-item">
          <h3>{faq.question}</h3>
          <p>{faq.answer}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="band" aria-labelledby="dg-paths">
    <div class="inner">
      <p class="eyebrow">Next-step paths</p>
      <h2 id="dg-paths">Turn a Decision Level Into the Right Page</h2>
      <p class="answer">The level tells you the urgency. The next page should answer the specific decision: local risk, evacuation, alert meaning, or city-level context.</p>
      <div class="grid-2 section-grid">
        {decisionPaths.map((path) => (
          <article class="panel">
            <h3><a href={new URL(path.url).pathname}>{path.name}</a></h3>
            <p>{path.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="dg-level-links">
    <div class="inner">
      <p class="eyebrow">Level shortcuts</p>
      <h2 id="dg-level-links">Best Starting Point for Each Level</h2>
      <div class="grid-2 section-grid">
        {levelLinks.map((item) => (
          <article class="panel">
            <p class="eyebrow">{item.level}</p>
            <h3><a href={item.href}>{item.label}</a></h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="dg-cta">
    <div class="inner">
      <h2 id="dg-cta">Put Your Level to Work</h2>
      <p class="answer">Open your state tracker for live NWS alerts, or build a personal action plan that maps your household to the right level automatically.</p>
      <p class="section-actions">
        <a class="action-link" href="/tracker/florida/">Open a state tracker</a>
        <a class="action-link secondary-action" href="/tools/local-risk-plan/">Build my action plan</a>
      </p>
    </div>
  </section>
</BaseLayout>
