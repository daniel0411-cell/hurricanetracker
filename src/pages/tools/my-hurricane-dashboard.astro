---
import FaqBlock from "../../components/FaqBlock.astro";
import Layout from "../../layouts/Layout.astro";
import { faqs, site } from "../../data/site";
import { articleSchema, faqSchema, graph, webApplicationSchema, websiteSchema } from "../../lib/schema";

const title = "Hurricane Tracking Dashboard for Saved US Locations";
const description = "Build a hurricane tracking dashboard for up to five US locations with local NWS alerts, active NHC storms, decision levels and saved alert preferences.";
const url = `${site.url}/tools/my-hurricane-dashboard/`;
const pageFaqs = [
  {
    question: "Where are my saved locations stored?",
    answer: "Saved locations and alert preferences stay in this browser on this device. HurricaneHub does not require an account for this dashboard."
  },
  {
    question: "How precise are dashboard alerts?",
    answer: "The dashboard uses the approximate ZIP-code center to request active NWS alerts for that point. Always verify your county, evacuation zone, and official local instructions."
  },
  {
    question: "Do dashboard alert preferences enable push notifications?",
    answer: "Not yet. The preferences saved here control how each location is presented and prepare the dashboard for a later push-alert upgrade."
  },
  ...faqs
];
const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title, description, url, dateModified: site.contentLastModified }),
  webApplicationSchema({
    name: title,
    description,
    url,
    featureList: ["Multiple saved ZIP locations", "Point-based NWS alerts", "NHC storm summary", "Per-location alert preferences"]
  }),
  faqSchema(pageFaqs)
);
---
<Layout title={title} description={description} canonical={url} jsonLd={jsonLd} lastModified={site.contentLastModified} showBottomAd={true}>
  <section class="band" aria-labelledby="dashboard-title">
    <div class="inner dashboard-heading">
      <div>
        <p class="eyebrow">Personal storm desk</p>
        <h1 id="dashboard-title">My Hurricane Tracking Dashboard</h1>
        <p class="answer">Save up to five US ZIP-code locations and check active NWS alerts, the current NHC storm list, distance context, and Monitor, Prepare, Act, or Leave planning levels in one dashboard.</p>
      </div>
      <div class="privacy-note">
        <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
        <span>Locations stay in this browser.</span>
      </div>
    </div>
  </section>

  <section class="band dashboard-workspace" aria-labelledby="add-location-heading">
    <div class="inner">
      <form class="location-form" id="location-form">
        <div class="form-title">
          <h2 id="add-location-heading">Add a Location</h2>
          <span id="location-limit" class="small">0 of 5 saved</span>
        </div>
        <div class="form-fields">
          <label>
            <span>Location name</span>
            <input id="location-name" maxlength="28" placeholder="Home, Work, Parents" autocomplete="off" />
          </label>
          <label>
            <span>US ZIP code</span>
            <input id="location-zip" inputmode="numeric" autocomplete="postal-code" maxlength="5" pattern="\d{5}" placeholder="33139" required />
          </label>
          <button type="submit"><i class="fa-solid fa-plus" aria-hidden="true"></i> Add location</button>
        </div>
        <p id="dashboard-status" class="small" role="status">Add a ZIP code to start monitoring a location.</p>
      </form>

      <div class="dashboard-toolbar">
        <div>
          <h2>Saved Locations</h2>
          <p class="small">NWS alerts use the approximate center of each ZIP code.</p>
        </div>
        <button type="button" class="secondary icon-command" id="refresh-all" disabled>
          <i class="fa-solid fa-rotate" aria-hidden="true"></i> Refresh all
        </button>
      </div>

      <div id="empty-dashboard" class="empty-dashboard">
        <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
        <h3>No saved locations</h3>
        <p>Add home, work, or a family member's ZIP code to build your alert center.</p>
      </div>
      <div id="location-list" class="location-list" aria-live="polite"></div>
    </div>
  </section>

  <FaqBlock faqs={pageFaqs} />
</Layout>

<script>
  type AlertItem = {
    event?: string;
    headline?: string;
    severity?: string;
    urgency?: string;
    certainty?: string;
    areaDesc?: string;
    effective?: string;
    expires?: string;
    instruction?: string;
  };
  type AlertFeed = { alerts?: AlertItem[]; decisionLevel?: string; updatedAt?: string; fetchedAt?: string };
  type StormItem = {
    name?: string;
    id?: string;
    classification?: string;
    latitude?: string;
    longitude?: string;
    summary?: string;
    publicAdvisory?: { url?: string } | string;
    lastUpdate?: string;
  };
  type StormFeed = { storms?: StormItem[]; updatedAt?: string; fetchedAt?: string };
  type LocationResult = {
    zip: string;
    city?: string;
    state: string;
    stateName: string;
    latitude?: string | number | null;
    longitude?: string | number | null;
  };
  type AlertMode = "all" | "warning-only" | "off";
  type SavedLocation = LocationResult & {
    id: string;
    label: string;
    alertMode: AlertMode;
    addedAt: string;
  };

  const STORAGE_KEY = "hh-dashboard-locations-v1";
  const MAX_LOCATIONS = 5;
  const form = document.querySelector<HTMLFormElement>("#location-form");
  const nameInput = document.querySelector<HTMLInputElement>("#location-name");
  const zipInput = document.querySelector<HTMLInputElement>("#location-zip");
  const statusEl = document.querySelector<HTMLElement>("#dashboard-status");
  const limitEl = document.querySelector<HTMLElement>("#location-limit");
  const listEl = document.querySelector<HTMLElement>("#location-list");
  const emptyEl = document.querySelector<HTMLElement>("#empty-dashboard");
  const refreshAllButton = document.querySelector<HTMLButtonElement>("#refresh-all");
  let locations: SavedLocation[] = [];

  function escapeHtml(value: unknown) {
    const replacements: Record<string, string> = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" };
    return String(value ?? "").replace(/[&<>"']/g, (char) => replacements[char] ?? char);
  }

  function parseCoordinate(value: string | number | null | undefined) {
    const number = typeof value === "number" ? value : Number.parseFloat(value ?? "");
    return Number.isFinite(number) ? number : null;
  }

  function stormCoordinate(value: unknown) {
    const text = String(value ?? "").trim().toUpperCase();
    const number = Number.parseFloat(text);
    if (!Number.isFinite(number)) return null;
    if (text.endsWith("S") || text.endsWith("W")) return -Math.abs(number);
    return number;
  }

  function distanceMiles(lat1: number, lon1: number, lat2: number, lon2: number) {
    const toRadians = (value: number) => value * Math.PI / 180;
    const earthMiles = 3958.8;
    const deltaLat = toRadians(lat2 - lat1);
    const deltaLon = toRadians(lon2 - lon1);
    const a = Math.sin(deltaLat / 2) ** 2 + Math.cos(toRadians(lat1)) * Math.cos(toRadians(lat2)) * Math.sin(deltaLon / 2) ** 2;
    return earthMiles * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  }

  function loadLocations() {
    try {
      const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "[]");
      if (Array.isArray(saved)) locations = saved.slice(0, MAX_LOCATIONS);
    } catch {
      locations = [];
    }
  }

  function saveLocations() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(locations));
  }

  function displayName(location: SavedLocation) {
    return location.city ? `${location.city}, ${location.state}` : location.stateName;
  }

  function formatTime(value?: string) {
    if (!value) return "Not available";
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return "Not available";
    return new Intl.DateTimeFormat(undefined, { month: "short", day: "numeric", hour: "numeric", minute: "2-digit" }).format(date);
  }

  function actionsFor(level: string) {
    if (level === "Leave") return "Follow local evacuation instructions now and use official routes.";
    if (level === "Act") return "Read active warnings and complete immediate protective actions.";
    if (level === "Prepare") return "Finish supplies, documents, power, and route planning.";
    return "Confirm your evacuation zone and continue monitoring official alerts.";
  }

  function alertType(alert: AlertItem) {
    const text = `${alert.event ?? ""} ${alert.headline ?? ""}`;
    if (/Evacuation|Mandatory evacuation/i.test(text)) return "Evacuation order";
    if (/Storm Surge/i.test(text)) return "Storm surge threat";
    if (/Hurricane|Extreme Wind/i.test(text)) return "Hurricane wind threat";
    if (/Flash Flood/i.test(text)) return "Flash flood threat";
    if (/Flood|Coastal Flood/i.test(text)) return "Flooding threat";
    if (/Tornado/i.test(text)) return "Tornado threat";
    if (/Tropical Storm/i.test(text)) return "Tropical storm threat";
    if (/Heat/i.test(text)) return "Heat hazard";
    if (/Rip Current|High Surf/i.test(text)) return "Coastal water hazard";
    return "Weather hazard";
  }

  function plainMeaning(alert: AlertItem) {
    const type = alertType(alert);
    if (type === "Evacuation order") return "Local officials are telling people in a defined area to leave or prepare to leave. Follow county instructions and official routes.";
    if (type === "Storm surge threat") return "Water may rise into normally dry coastal areas. Roads can become unsafe before the strongest wind arrives.";
    if (type === "Hurricane wind threat") return "Damaging hurricane-force wind is possible or expected. Finish protective actions before conditions deteriorate.";
    if (type === "Flash flood threat") return "Water can rise quickly in low spots, streets, and drainage areas. Flooded roads are the main immediate danger.";
    if (type === "Flooding threat") return "Water may cover roads or low-lying areas. Local conditions can change faster than a broad state alert suggests.";
    if (type === "Tornado threat") return "A tornado is possible or indicated nearby. Shelter decisions may need to happen immediately.";
    if (type === "Tropical storm threat") return "Tropical-storm-force wind, heavy rain, and coastal impacts are possible or expected.";
    if (type === "Heat hazard") return "Heat can become dangerous, especially for older adults, outdoor workers, children, pets, and people without cooling.";
    if (type === "Coastal water hazard") return "Surf and currents can be dangerous even when skies look calm. Avoid entering hazardous water.";
    return "An official NWS alert is active for this point or nearby area. Read the full alert and local emergency instructions.";
  }

  function actionSteps(alert: AlertItem) {
    const type = alertType(alert);
    if (type === "Evacuation order") return ["Leave if your zone or household is included.", "Take IDs, medication, documents, pets, chargers, water, and cash.", "Use official evacuation routes and tell a contact where you are going."];
    if (type === "Storm surge threat") return ["Check your evacuation zone, not just your ZIP code.", "Move vehicles, medicine, documents, and valuables away from flood-prone areas.", "Leave early if officials order your zone to evacuate or your route floods easily."];
    if (type === "Hurricane wind threat") return ["Secure outdoor items and finish window or shutter actions while it is safe.", "Move vulnerable people, pets, and medical equipment earlier than the public deadline.", "Stop nonessential travel before winds make roads unsafe."];
    if (type === "Flash flood threat" || type === "Flooding threat") return ["Do not drive through flooded roads.", "Move to higher ground if water rises or officials instruct it.", "Keep phones charged and monitor local road and emergency updates."];
    if (type === "Tornado threat") return ["Go to an interior room on the lowest safe level.", "Stay away from windows.", "Keep shoes, flashlight, and phone nearby until the warning expires."];
    if (type === "Tropical storm threat") return ["Bring loose outdoor items inside.", "Prepare for power outages and blocked roads.", "Check official updates at least twice daily while the alert is active."];
    if (type === "Heat hazard") return ["Limit outdoor work during peak heat.", "Use air conditioning or cooling centers where available.", "Check on older adults, children, pets, and people without reliable cooling."];
    if (type === "Coastal water hazard") return ["Stay out of hazardous surf.", "Follow beach flag and lifeguard instructions.", "Keep children and pets away from jetties, piers, and rough water."];
    return ["Read the full official alert.", "Check county emergency management instructions.", "Refresh this location if conditions change."];
  }

  function urgencyText(alert: AlertItem) {
    const parts = [alert.severity, alert.urgency, alert.certainty].filter(Boolean);
    return parts.length ? parts.join(" · ") : "Official NWS alert";
  }

  function sentenceFromInstruction(value?: string) {
    const normalized = String(value ?? "").replace(/\s+/g, " ").trim();
    if (!normalized) return "";
    const [first] = normalized.split(/(?<=[.!?])\s+/);
    return first?.slice(0, 220) ?? "";
  }

  function renderAlertDetail(alert: AlertItem, index: number) {
    const steps = actionSteps(alert);
    const instruction = sentenceFromInstruction(alert.instruction);
    return `
      <article class="alert-detail-card">
        <header>
          <span class="alert-number">Alert ${index + 1}</span>
          <strong>${escapeHtml(alert.event ?? "Weather alert")}</strong>
          <span>${escapeHtml(urgencyText(alert))}</span>
        </header>
        <div class="alert-explainer-grid">
          <section>
            <h4>What it means</h4>
            <p>${escapeHtml(plainMeaning(alert))}</p>
          </section>
          <section>
            <h4>What to do now</h4>
            <ul>${steps.map((step) => `<li>${escapeHtml(step)}</li>`).join("")}</ul>
          </section>
        </div>
        <dl class="alert-facts">
          <div><dt>Area</dt><dd>${escapeHtml(alert.areaDesc || "Area details unavailable")}</dd></div>
          <div><dt>Effective</dt><dd>${escapeHtml(formatTime(alert.effective))}</dd></div>
          <div><dt>Expires</dt><dd>${escapeHtml(formatTime(alert.expires))}</dd></div>
        </dl>
        ${instruction ? `<p class="official-note"><strong>NWS instruction:</strong> ${escapeHtml(instruction)}</p>` : ""}
      </article>
    `;
  }

  function advisoryUrl(storm: StormItem) {
    if (typeof storm.publicAdvisory === "string") return storm.publicAdvisory;
    return storm.publicAdvisory?.url ?? "";
  }

  function renderStormContext(location: SavedLocation, storms: StormItem[]) {
    const lat = parseCoordinate(location.latitude);
    const lon = parseCoordinate(location.longitude);
    if (!storms.length) {
      return `
        <div class="storm-context-empty">
          <h4>No active NHC tropical cyclone listed</h4>
          <p>Keep checking NHC outlooks during hurricane season, especially if your local alerts or officials mention tropical weather.</p>
        </div>
      `;
    }
    if (lat === null || lon === null) {
      return `
        <div class="storm-context-empty">
          <h4>Storms active, distance unavailable</h4>
          <p>This saved ZIP did not return usable coordinates. Open the storm distance tool for manual context.</p>
        </div>
      `;
    }
    const rows = storms
      .map((storm) => {
        const stormLat = stormCoordinate(storm.latitude);
        const stormLon = stormCoordinate(storm.longitude);
        if (stormLat === null || stormLon === null) return null;
        return { storm, miles: Math.round(distanceMiles(lat, lon, stormLat, stormLon)) };
      })
      .filter((item): item is { storm: StormItem; miles: number } => Boolean(item))
      .sort((a, b) => a.miles - b.miles);
    if (!rows.length) {
      return `
        <div class="storm-context-empty">
          <h4>Storm distance unavailable</h4>
          <p>Current NHC storms did not include usable coordinates in this feed. Use official advisories for track and timing.</p>
        </div>
      `;
    }
    return rows.slice(0, 3).map(({ storm, miles }, index) => {
      const url = advisoryUrl(storm);
      return `
        <article class="storm-context-card">
          <span>${index === 0 ? "Nearest storm" : "Active storm"}</span>
          <h4>${escapeHtml(storm.name || storm.id || "Active storm")} · ${miles.toLocaleString("en-US")} mi</h4>
          <p>${escapeHtml(storm.summary || storm.classification || "NHC storm data loaded.")}</p>
          <p class="small">Position ${escapeHtml(storm.latitude || "?")}, ${escapeHtml(storm.longitude || "?")} · Updated ${escapeHtml(formatTime(storm.lastUpdate))}</p>
          ${url ? `<a href="${escapeHtml(url)}" rel="nofollow">Official NHC advisory</a>` : ""}
        </article>
      `;
    }).join("");
  }

  function renderLocations() {
    if (!listEl || !emptyEl || !limitEl || !refreshAllButton) return;
    limitEl.textContent = `${locations.length} of ${MAX_LOCATIONS} saved`;
    emptyEl.hidden = locations.length > 0;
    refreshAllButton.disabled = locations.length === 0;
    listEl.innerHTML = locations.map((location) => `
      <article class="location-card" data-location-id="${escapeHtml(location.id)}">
        <header class="location-card-header">
          <div>
            <p class="eyebrow">${escapeHtml(location.label)}</p>
            <h3>${escapeHtml(displayName(location))}</h3>
            <p class="location-meta">ZIP ${escapeHtml(location.zip)} · ${escapeHtml(location.stateName)}</p>
          </div>
          <div class="location-actions">
            <button type="button" class="icon-button" data-action="details" title="Show location details" aria-label="Show details for ${escapeHtml(location.label)}" aria-expanded="false">
              <i class="fa-solid fa-list-check" aria-hidden="true"></i>
            </button>
            <button type="button" class="icon-button" data-action="refresh" title="Refresh location" aria-label="Refresh ${escapeHtml(location.label)}">
              <i class="fa-solid fa-rotate" aria-hidden="true"></i>
            </button>
            <button type="button" class="icon-button danger" data-action="delete" title="Remove location" aria-label="Remove ${escapeHtml(location.label)}">
              <i class="fa-solid fa-trash" aria-hidden="true"></i>
            </button>
          </div>
        </header>
        <div class="location-state" data-state="loading">
          <i class="fa-solid fa-circle-notch fa-spin" aria-hidden="true"></i> Loading current conditions...
        </div>
        <div class="location-data" hidden>
          <div class="location-metrics">
            <div><strong data-field="level">--</strong><span>decision level</span></div>
            <div><strong data-field="alerts">--</strong><span>local alerts</span></div>
            <div><strong data-field="storms">--</strong><span>NHC storms</span></div>
          </div>
          <p class="location-guidance" data-field="guidance"></p>
          <div class="alert-preview" data-field="preview"></div>
          <section class="location-detail" data-field="detail" hidden>
            <div class="detail-heading">
              <div>
                <p class="eyebrow">Location detail</p>
                <h3>Alert Explanation</h3>
              </div>
              <span data-field="detail-status">Waiting for live alerts</span>
            </div>
            <div class="storm-context" data-field="storm-context"></div>
            <div data-field="detail-body"></div>
          </section>
          <div class="location-footer">
            <label class="alert-setting">
              <span>Alert preference</span>
              <select data-action="mode" aria-label="Alert preference for ${escapeHtml(location.label)}">
                <option value="all" ${location.alertMode === "all" ? "selected" : ""}>Watches and warnings</option>
                <option value="warning-only" ${location.alertMode === "warning-only" ? "selected" : ""}>Warnings only</option>
                <option value="off" ${location.alertMode === "off" ? "selected" : ""}>Off</option>
              </select>
            </label>
            <p class="updated" data-field="updated">Updated --</p>
          </div>
          <nav class="location-links" aria-label="Tools for ${escapeHtml(location.label)}">
            <a href="/alerts/?state=${encodeURIComponent(location.state)}">Alerts</a>
            <a href="/radar/">Radar</a>
            <a href="/tools/local-risk-plan/?state=${encodeURIComponent(location.state)}">Action plan</a>
          </nav>
        </div>
      </article>
    `).join("");
  }

  async function loadLocation(location: SavedLocation) {
    const card = listEl?.querySelector<HTMLElement>(`[data-location-id="${CSS.escape(location.id)}"]`);
    if (!card) return;
    const stateEl = card.querySelector<HTMLElement>(".location-state");
    const dataEl = card.querySelector<HTMLElement>(".location-data");
    if (stateEl) {
      stateEl.dataset.state = "loading";
      stateEl.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin" aria-hidden="true"></i> Loading current conditions...';
      stateEl.hidden = false;
    }
    if (dataEl) dataEl.hidden = true;

    const lat = parseCoordinate(location.latitude);
    const lon = parseCoordinate(location.longitude);
    const alertQuery = lat !== null && lon !== null
      ? `point=${encodeURIComponent(`${lat},${lon}`)}`
      : `area=${encodeURIComponent(location.state)}`;

    try {
      const [alertsResponse, stormsResponse] = await Promise.all([
        fetch(`/api/nws/alerts.json?${alertQuery}`),
        fetch("/api/nhc/current.json")
      ]);
      if (!alertsResponse.ok || !stormsResponse.ok) throw new Error("Live feed unavailable");
      const alerts = await alertsResponse.json() as AlertFeed;
      const storms = await stormsResponse.json() as StormFeed;
      const alertItems = alerts.alerts ?? [];
      const stormItems = storms.storms ?? [];
      const level = alerts.decisionLevel ?? (stormItems.length ? "Prepare" : "Monitor");
      const preview = alertItems.slice(0, 2);

      const levelEl = card.querySelector<HTMLElement>('[data-field="level"]');
      const alertsEl = card.querySelector<HTMLElement>('[data-field="alerts"]');
      const stormsEl = card.querySelector<HTMLElement>('[data-field="storms"]');
      const guidanceEl = card.querySelector<HTMLElement>('[data-field="guidance"]');
      const previewEl = card.querySelector<HTMLElement>('[data-field="preview"]');
      const detailStatusEl = card.querySelector<HTMLElement>('[data-field="detail-status"]');
      const stormContextEl = card.querySelector<HTMLElement>('[data-field="storm-context"]');
      const detailBodyEl = card.querySelector<HTMLElement>('[data-field="detail-body"]');
      const updatedEl = card.querySelector<HTMLElement>('[data-field="updated"]');
      if (levelEl) {
        levelEl.textContent = level;
        levelEl.dataset.level = level.toLowerCase();
      }
      if (alertsEl) alertsEl.textContent = String(alertItems.length);
      if (stormsEl) stormsEl.textContent = String(stormItems.length);
      if (guidanceEl) guidanceEl.textContent = actionsFor(level);
      if (previewEl) {
        previewEl.innerHTML = preview.length
          ? preview.map((alert) => `<div><strong>${escapeHtml(alert.event ?? "Weather alert")}</strong><span>${escapeHtml(alert.headline || alert.severity || "Official NWS alert")}</span></div>`).join("")
          : '<p>No active NWS alerts returned for this location. This is not an all-clear for your evacuation zone.</p>';
      }
      if (detailStatusEl) detailStatusEl.textContent = alertItems.length ? `${alertItems.length} active alert${alertItems.length === 1 ? "" : "s"}` : "No active NWS alerts";
      if (stormContextEl) stormContextEl.innerHTML = renderStormContext(location, stormItems);
      if (detailBodyEl) {
        detailBodyEl.innerHTML = alertItems.length
          ? alertItems.map(renderAlertDetail).join("")
          : `
            <div class="no-alert-detail">
              <h4>No active NWS alerts returned</h4>
              <p>This means the point query did not return an active NWS alert right now. It does not replace evacuation-zone checks, county instructions, or forecast updates.</p>
              <ul>
                <li>Confirm your evacuation zone and shelter rules.</li>
                <li>Keep supplies, documents, and charging plans ready during hurricane season.</li>
                <li>Refresh this location when a storm, watch, or warning is nearby.</li>
              </ul>
            </div>
          `;
      }
      if (updatedEl) updatedEl.textContent = `Updated ${formatTime(alerts.updatedAt ?? alerts.fetchedAt)}`;
      if (stateEl) stateEl.hidden = true;
      if (dataEl) dataEl.hidden = false;
    } catch (error) {
      console.error("HurricaneHub saved location failed", { location: location.zip, error });
      if (stateEl) {
        stateEl.dataset.state = "error";
        stateEl.innerHTML = '<i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> Live data is temporarily unavailable. This does not mean there are no alerts.';
      }
    }
  }

  async function refreshAll() {
    if (refreshAllButton) refreshAllButton.disabled = true;
    await Promise.all(locations.map(loadLocation));
    if (refreshAllButton) refreshAllButton.disabled = locations.length === 0;
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const zip = zipInput?.value.trim() ?? "";
    const requestedLabel = nameInput?.value.trim() ?? "";
    if (!/^\d{5}$/.test(zip)) {
      if (statusEl) statusEl.textContent = "Enter a valid five-digit ZIP code.";
      return;
    }
    if (locations.length >= MAX_LOCATIONS) {
      if (statusEl) statusEl.textContent = `You can save up to ${MAX_LOCATIONS} locations.`;
      return;
    }
    if (locations.some((location) => location.zip === zip)) {
      if (statusEl) statusEl.textContent = "That ZIP code is already saved.";
      return;
    }
    try {
      if (statusEl) statusEl.textContent = "Looking up location...";
      const response = await fetch(`/api/location/zip?zip=${encodeURIComponent(zip)}`);
      if (!response.ok) throw new Error("ZIP lookup failed");
      const result = await response.json() as LocationResult;
      const location: SavedLocation = {
        ...result,
        id: crypto.randomUUID(),
        label: requestedLabel || result.city || "Saved location",
        alertMode: "all",
        addedAt: new Date().toISOString()
      };
      locations.push(location);
      saveLocations();
      renderLocations();
      await loadLocation(location);
      form.reset();
      if (statusEl) statusEl.textContent = `${location.label} was saved on this device.`;
    } catch (error) {
      console.error("HurricaneHub location save failed", error);
      if (statusEl) statusEl.textContent = "That location could not be added right now. Check the ZIP code and retry.";
    }
  });

  listEl?.addEventListener("click", async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-action]");
    if (!button) return;
    const card = button.closest<HTMLElement>("[data-location-id]");
    const location = locations.find((item) => item.id === card?.dataset.locationId);
    if (!location) return;
    if (button.dataset.action === "details") {
      const detailEl = card?.querySelector<HTMLElement>('[data-field="detail"]');
      const expanded = button.getAttribute("aria-expanded") === "true";
      button.setAttribute("aria-expanded", String(!expanded));
      if (detailEl) detailEl.hidden = expanded;
    }
    if (button.dataset.action === "refresh") await loadLocation(location);
    if (button.dataset.action === "delete") {
      locations = locations.filter((item) => item.id !== location.id);
      saveLocations();
      renderLocations();
      await refreshAll();
      if (statusEl) statusEl.textContent = `${location.label} was removed from this device.`;
    }
  });

  listEl?.addEventListener("change", (event) => {
    if (!(event.target instanceof HTMLSelectElement) || event.target.dataset.action !== "mode") return;
    const select = event.target;
    const card = select.closest<HTMLElement>("[data-location-id]");
    const location = locations.find((item) => item.id === card?.dataset.locationId);
    if (!location) return;
    location.alertMode = select.value as AlertMode;
    saveLocations();
    if (statusEl) statusEl.textContent = `Alert preference saved for ${location.label}.`;
  });

  refreshAllButton?.addEventListener("click", refreshAll);
  loadLocations();
  renderLocations();
  refreshAll();
</script>

