---
import FaqBlock from "../../components/FaqBlock.astro";
import Layout from "../../layouts/Layout.astro";
import { faqs, site } from "../../data/site";
import { articleSchema, faqSchema, graph, webApplicationSchema, websiteSchema } from "../../lib/schema";

const title = "Hurricane Evacuation Assessment Tool & Decision Helper";
const description = "Use this hurricane evacuation assessment tool to sort risk into Monitor, Prepare, Act, or Leave using orders, surge zone, housing, pets, transport and medical needs.";
const url = `${site.url}/tools/evacuation-decision-helper/`;
const lastModified = "2026-10-23T00:00:00.000Z";
const pageFaqs = [
  {
    question: "Should I evacuate for a hurricane watch?",
    answer:
      "A watch means hurricane conditions are possible. Evacuate during a watch if your local officials tell you to leave, you live in a surge zone, or your household needs extra travel time for medical, mobility, pet, or transportation reasons."
  },
  {
    question: "What is the safest evacuation decision?",
    answer:
      "The safest decision is the one that follows local emergency management orders early enough for your household to travel before roads, fuel, shelters, or medical support become limited."
  },
  ...faqs
];
const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title, description, url, dateModified: lastModified }),
  webApplicationSchema({
    name: title,
    description,
    url,
    featureList: ["Evacuation decision scoring", "Household vulnerability prompts", "Monitor/Prepare/Act/Leave recommendation"]
  }),
  faqSchema(pageFaqs)
);
---
<Layout title={title} description={description} canonical={url} jsonLd={jsonLd} lastModified={lastModified} showBottomAd={true}>
  <section class="band" aria-labelledby="helper-title">
    <div class="inner">
      <p class="eyebrow">Household decision support</p>
      <h1 id="helper-title">Hurricane Evacuation Assessment and Decision Helper</h1>
      <p class="answer">Use this assessment to organize hurricane watches, warnings, evacuation orders, surge exposure, housing vulnerability, pets, transport, and medical needs into a Monitor, Prepare, Act, or Leave planning level. Local officials always control evacuation orders.</p>
    </div>
  </section>

  <section class="band" aria-labelledby="helper-form">
    <div class="inner grid-2 helper-layout">
      <form class="panel decision-tool" id="evacuation-tool">
        <h2 id="helper-form">Check Your Decision Level</h2>

        <label>
          Official local status
          <select name="officialStatus">
            <option value="none">No watch, warning, or evacuation order</option>
            <option value="watch">Hurricane or tropical storm watch</option>
            <option value="hurricane">Hurricane warning</option>
            <option value="surge">Storm surge warning</option>
            <option value="flood">Flood or flash flood warning</option>
            <option value="tornado">Tornado warning - take shelter now</option>
            <option value="evacuation">Mandatory evacuation order</option>
          </select>
        </label>

        <label>
          Home location
          <select name="locationRisk">
            <option value="0">Inland, outside known flood or surge zone</option>
            <option value="1">Coastal county or low-lying area</option>
            <option value="2">Flood zone, barrier island, bay, river, or surge zone</option>
          </select>
        </label>

        <label>
          Housing type
          <select name="housingRisk">
            <option value="0">Site-built home in good condition</option>
            <option value="1">Older home, apartment, or many trees nearby</option>
            <option value="2">Mobile home, RV, boat, or temporary housing</option>
          </select>
        </label>

        <fieldset>
          <legend>Household needs</legend>
          <label><input type="checkbox" name="medical" /> Medical equipment, mobility needs, or refrigerated medicine</label>
          <label><input type="checkbox" name="pets" /> Pets or livestock need transport planning</label>
          <label><input type="checkbox" name="transport" /> Limited vehicle access, fuel, or long evacuation route</label>
        </fieldset>

        <button type="submit">Calculate Decision</button>
      </form>

      <article class="panel" aria-live="polite">
        <h2>Recommended Planning Level</h2>
        <div class="metric" style="margin-top: 14px;">
          <strong id="decision-level">Monitor</strong>
          <span id="decision-summary">No high-risk choices selected yet. Keep checking official NHC/NWS and local emergency updates.</span>
        </div>
        <h3 style="margin-top: 18px;">Action List</h3>
        <ul class="check-list" id="decision-actions">
          <li>Check your county emergency management page.</li>
          <li>Review your evacuation zone and shelter options.</li>
          <li>Keep a 3-day water, food, medicine, and document kit ready.</li>
        </ul>
        <p class="source-note">This tool is a planning aid only. Evacuation orders and shelter rules come from local officials and weather.gov alerts.</p>
      </article>
    </div>
  </section>

  <section class="band" aria-labelledby="method-heading">
    <div class="inner">
      <h2 id="method-heading">How the Decision Helper Works</h2>
      <p>Mandatory evacuation orders take precedence over the household score. Tornado warnings require immediate shelter; flood, storm surge, and hurricane warnings require prompt action specific to the warning. Follow the full official warning and local instructions when several hazards overlap.</p>
      <table style="margin-top: 18px;">
        <thead><tr><th>Situation</th><th>Level</th><th>Meaning</th></tr></thead>
        <tbody>
          <tr><td>Mandatory evacuation order</td><td>Leave</td><td>Follow local evacuation instructions regardless of score.</td></tr>
          <tr><td>Tornado, flood, surge, or hurricane warning</td><td>Act</td><td>Take the protective action required for that hazard.</td></tr>
          <tr><td>Watch, or household score 2-3</td><td>Prepare</td><td>Prepare transport, supplies, and a destination.</td></tr>
          <tr><td>Household score 4+</td><td>Act</td><td>Arrange assistance early; the score alone is not an evacuation order.</td></tr>
          <tr><td>No official alert and household score 0-1</td><td>Monitor</td><td>Keep checking official alerts; this is not an all-clear.</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <FaqBlock faqs={pageFaqs} />
</Layout>

<style>
  .helper-layout > * { min-width: 0; }
  .decision-tool { min-width: 0; }
  .decision-tool select { width: 100%; min-width: 0; max-width: 100%; }
  .decision-tool fieldset { min-width: 0; }
  .decision-tool fieldset label { display: flex; align-items: flex-start; }
  .decision-tool input[type="checkbox"] { width: 18px; height: 18px; min-height: 18px; padding: 0; margin: 3px 0 0; flex: 0 0 18px; }
  table { table-layout: fixed; overflow-wrap: anywhere; }
</style>

<script>
  import { evacuationDecision, type OfficialStatus, type EvacuationRecommendation } from "../../lib/evacuationDecision";
  import { trackToolResult } from "../../lib/toolAnalytics";
  const form = document.querySelector<HTMLFormElement>("#evacuation-tool");
  const levelEl = document.querySelector<HTMLElement>("#decision-level");
  const summaryEl = document.querySelector<HTMLElement>("#decision-summary");
  const actionsEl = document.querySelector<HTMLElement>("#decision-actions");

  function render(recommendation: EvacuationRecommendation) {
    if (!levelEl || !summaryEl || !actionsEl || !recommendation) {
      trackToolResult("evacuation_decision", "error");
      return;
    }
    levelEl.textContent = recommendation.level;
    summaryEl.textContent = recommendation.summary;
    actionsEl.innerHTML = recommendation.actions.map((action) => `<li>${action}</li>`).join("");
    trackToolResult("evacuation_decision", "success");
  }

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const baseScore =
      Number(data.get("locationRisk") ?? 0) +
      Number(data.get("housingRisk") ?? 0);
    const needsScore = ["medical", "pets", "transport"].reduce((total, key) => total + (data.get(key) ? 1 : 0), 0);
    render(evacuationDecision(data.get("officialStatus") as OfficialStatus, baseScore + needsScore));
  });
</script>
