---
import FaqBlock from "../../components/FaqBlock.astro";
import Layout from "../../layouts/Layout.astro";
import { faqs, site, states } from "../../data/site";
import { articleSchema, faqSchema, graph, webApplicationSchema, websiteSchema } from "../../lib/schema";

const title = "State Weather Alerts and Hurricane Action Summary";
const description = "Read active state NWS alerts, hazard-specific protective actions, and current NHC storm context. Check alert expiration separately from wind arrival.";
const url = `${site.url}/tools/impact-window-estimator/`;
const pageFaqs = [
  {
    question: "Does the state alert summary predict landfall or wind arrival?",
    answer: "No. This state alert summary lists active NWS alerts and NHC system counts. Alert expiration is when a listed alert ends or needs replacement; it is not the time a hurricane or its winds will arrive."
  },
  {
    question: "What should I do if the state summary says Act or Leave?",
    answer: "Read each alert's affected area and instructions. Extreme Wind and Tornado Warnings call for immediate shelter; local evacuation orders have their own areas and deadlines. Follow the specific instruction rather than treating Act as a direction to travel."
  },
  ...faqs
];
const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title, description, url, dateModified: site.contentLastModified }),
  webApplicationSchema({
    name: title,
    description,
    url,
    featureList: ["State NWS alert summary", "Alert expiration labels", "Hazard-specific protective actions"]
  }),
  faqSchema(pageFaqs)
);
---
<Layout title={title} description={description} canonical={url} jsonLd={jsonLd} lastModified={site.contentLastModified} showBottomAd={true}>
  <section class="band" aria-labelledby="window-title">
    <div class="inner">
      <p class="eyebrow">State alert check</p>
      <h1 id="window-title">State Alerts and Protective Actions</h1>
      <p class="answer">Choose a state to read active NWS alerts and their protective actions, with the NHC system count for context. Match each alert's affected area to your county. To find wind-arrival guidance, open the storm's official NHC advisory and wind-arrival products.</p>
    </div>
  </section>

  <section class="band" aria-labelledby="window-form-heading">
    <div class="inner grid-2">
      <form class="panel window-form" id="window-form">
        <h2 id="window-form-heading">Check a State</h2>
        <label for="window-state">State</label>
        <select id="window-state">
          {states.map(([code, name]) => <option value={code} selected={code === "FL"}>{name}</option>)}
        </select>
        <button type="submit">Check alerts</button>
        <p id="window-status" class="small" role="status">Uses active NWS alerts and current NHC storm count.</p>
      </form>

      <article class="panel" aria-live="polite">
        <p class="eyebrow">State-level summary</p>
        <h2 id="window-level">Waiting for state</h2>
        <p id="window-summary">Select a state to load official alert timing.</p>
        <ul id="window-actions" class="check-list"></ul>
      </article>
    </div>
  </section>

  <section class="band" aria-labelledby="window-next-heading">
    <div class="inner grid-2">
      <article>
        <p class="eyebrow">Next step</p>
        <h2 id="window-next-heading">Record the Instruction, Area, and Deadline</h2>
        <p class="answer">Copy the alert event, affected county or zone, protective action, and issuing office into your household plan. An alert expiration can change when a warning is extended or replaced. Use <a href="https://www.weather.gov/alerts">the full NWS alert</a> for instructions and <a href="https://www.nhc.noaa.gov/aboutnhcgraphics.shtml#TOA">NHC wind-arrival product guidance</a> for the separate arrival question.</p>
      </article>
      <div class="link-grid" aria-label="Related hurricane planning tools">
        <a href="/decision-guide/">
          <strong>Decision Guide</strong>
          <span>Compare monitor, prepare, act, and leave signals in one place.</span>
        </a>
        <a href="/tools/local-risk-plan/">
          <strong>Local Risk Plan</strong>
          <span>Read state alerts and record your household's local instructions.</span>
        </a>
        <a href="/tools/hurricane-brief/">
          <strong>Hurricane Brief</strong>
          <span>Create a concise household brief from storm and alert information.</span>
        </a>
        <a href="/learn/">
          <strong>Learn Center</strong>
          <span>Review storm surge, wind, cone, and alert basics before conditions change.</span>
        </a>
      </div>
    </div>
  </section>

  <FaqBlock faqs={pageFaqs} />
</Layout>

<script>
  import { alertActionGuidance, decisionLevel } from "../../lib/weather";
  import { isAlertFeedAvailable, isStormFeedAvailable } from "../../lib/weatherFeedStatus";
  type AlertFeed = { alerts?: Array<{ event?: string; headline?: string; effective?: string; expires?: string; severity?: string; urgency?: string }>; decisionLevel?: string; updatedAt?: string; fetchedAt?: string };
  type StormFeed = { storms?: Array<{ id?: string }>; updatedAt?: string; fetchedAt?: string };

  const form = document.querySelector<HTMLFormElement>("#window-form");
  const stateSelect = document.querySelector("#window-state") as HTMLSelectElement | null;
  const statusEl = document.querySelector<HTMLElement>("#window-status");
  const levelEl = document.querySelector<HTMLElement>("#window-level");
  const summaryEl = document.querySelector<HTMLElement>("#window-summary");
  const actionsEl = document.querySelector<HTMLElement>("#window-actions");

  function escapeHtml(value: unknown) {
    const replacements: Record<string, string> = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" };
    return String(value ?? "").replace(/[&<>"']/g, (char) => replacements[char] ?? char);
  }


  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const state = stateSelect?.value ?? "FL";
    if (levelEl) levelEl.textContent = "Loading";
    if (summaryEl) summaryEl.textContent = "Checking state feeds...";
    if (actionsEl) actionsEl.innerHTML = "";
    try {
      if (statusEl) statusEl.textContent = "Loading official feeds...";
      const [alertResponse, stormResponse] = await Promise.all([
        fetch(`/api/nws/alerts.json?area=${encodeURIComponent(state)}`, { signal: AbortSignal.timeout(12000) }),
        fetch("/api/nhc/current.json", { signal: AbortSignal.timeout(12000) })
      ]);
      if (!alertResponse.ok || !stormResponse.ok) throw new Error("Feed unavailable");
      const alerts = await alertResponse.json() as AlertFeed;
      const storms = await stormResponse.json() as StormFeed;
      if (!isAlertFeedAvailable(alerts) || !isStormFeedAvailable(storms)) throw new Error("Feed malformed or stale");
      const alertCount = alerts.alerts?.length ?? 0;
      const stormCount = storms.storms?.length ?? 0;
      const level = decisionLevel(alerts.alerts ?? [], []);
      const expires = alerts.alerts?.map((alert) => Date.parse(alert.expires ?? "")).filter(Number.isFinite).sort((a, b) => a - b)[0];
      const expireText = expires ? ` Next listed alert expiration: ${new Date(expires).toLocaleString([], { dateStyle: "medium", timeStyle: "short" })}.` : "";
      if (levelEl) levelEl.textContent = level;
      if (summaryEl) summaryEl.textContent = `${state}: ${alertCount} active state alert${alertCount === 1 ? "" : "s"} and ${stormCount} active NHC system${stormCount === 1 ? "" : "s"} were returned.${expireText} Expiration is not wind arrival. Read affected areas in the full alerts.`;
      if (actionsEl) actionsEl.innerHTML = alertActionGuidance(alerts.alerts ?? []).map((action) => `<li>${escapeHtml(action)}</li>`).join("");
      if (statusEl) statusEl.textContent = `NWS checked ${new Date(alerts.fetchedAt!).toLocaleString()} · NHC checked ${new Date(storms.fetchedAt!).toLocaleString()}`;
    } catch (error) {
      console.error("HurricaneHub impact window failed", error);
      if (levelEl) levelEl.textContent = "Unavailable";
      if (summaryEl) summaryEl.textContent = "The feeds could not be verified. No current risk or empty-feed conclusion is available.";
      if (statusEl) statusEl.textContent = "State summary unavailable. Check weather.gov and retry shortly.";
    }
  });
</script>

<style>
  .window-form { display: grid; gap: 14px; align-content: start; }
  .window-form label { font-weight: 800; }
</style>
