---
import FaqBlock from "../../components/FaqBlock.astro";
import Layout from "../../layouts/Layout.astro";
import { faqs, site } from "../../data/site";
import { articleSchema, faqSchema, graph, webApplicationSchema, websiteSchema } from "../../lib/schema";

const title = "Storm Surge ZIP Checker";
const description = "Screen active NWS storm surge alerts at a ZIP representative point. Check local address-based evacuation guidance; results do not cover the whole ZIP.";
const url = `${site.url}/tools/storm-surge-checker/`;
const pageFaqs = [
  {
    question: "What does a storm surge watch mean for my ZIP code?",
    answer: "A storm surge watch means life-threatening inundation is possible in the listed areas, generally within 48 hours. It does not mean surge is certain — it means you should be ready to act quickly if the watch becomes a warning."
  },
  {
    question: "What does a storm surge warning mean?",
    answer: "A storm surge warning means life-threatening inundation is expected in the listed areas, generally within 36 hours. Follow local evacuation orders immediately if you are in a warned zone."
  },
  {
    question: "No alert was returned for the ZIP point. Is my address safe?",
    answer: "No. This tool queries one representative place coordinate, not your street address or the entire ZIP area. Other parts of the ZIP may be under a warning. Rainfall and river flooding also need separate checks. Use the official warning text and local address-based evacuation map."
  },
  ...faqs
];
const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title, description, url, dateModified: site.contentLastModified }),
  webApplicationSchema({
    name: title,
    description,
    url,
    featureList: ["ZIP representative-point storm surge alert screening", "Tropical alerts returned for the query point", "Official NWS alert language and expiration times"]
  }),
  faqSchema(pageFaqs)
);
---
<Layout title={title} description={description} canonical={url} jsonLd={jsonLd} lastModified={site.contentLastModified} showBottomAd={true}>
  <section class="band" aria-labelledby="surge-title">
    <div class="inner">
      <p class="eyebrow">Official NWS alert check</p>
      <h1 id="surge-title">Storm Surge ZIP Checker</h1>
      <p class="answer">
        Enter a five-digit ZIP code to screen active NWS storm surge and tropical alerts at
        one representative point. This does not check every address or the whole ZIP area.
      </p>
    </div>
  </section>

  <section class="band" aria-labelledby="surge-form-heading">
    <div class="inner grid-2">
      <form class="panel surge-form" id="surge-form" autocomplete="off">
        <h2 id="surge-form-heading">Check My ZIP</h2>
        <label for="surge-zip">ZIP code</label>
        <input
          id="surge-zip"
          name="zip"
          type="text"
          inputmode="numeric"
          pattern="\d{5}"
          maxlength="5"
          placeholder="e.g. 33139"
          required
        />
        <button type="submit">Check storm surge</button>
        <p class="small">A ZIP can cross alert boundaries. Confirm your exact address and evacuation zone with <a href="/hurricane-tracker/city/">local emergency-management resources</a> and read the <a href="https://www.weather.gov/">official NWS warning</a>.</p>
        <p id="surge-status" class="small" role="status">
          Results come from the National Weather Service active alerts feed.
        </p>
      </form>

      <article class="panel" aria-live="polite">
        <p class="eyebrow">Result</p>
        <h2 id="surge-level">Waiting for ZIP</h2>
        <p id="surge-summary">Enter a ZIP to screen its representative point. No result here can establish that your address is safe.</p>
        <ul id="surge-alerts" class="check-list"></ul>
      </article>
    </div>
  </section>

  <section class="band" aria-labelledby="surge-understand-heading">
    <div class="inner">
      <p class="eyebrow">Know the alert levels</p>
      <h2 id="surge-understand-heading">Storm Surge Watch vs Warning</h2>
      <div class="grid-3 section-grid">
        <article class="panel">
          <span class="badge warn">Watch</span>
          <h3>Possible, generally within 48 hours</h3>
          <p>Life-threatening inundation is possible. Review evacuation zone, fuel up, and prepare to move.</p>
        </article>
        <article class="panel">
          <span class="badge danger">Warning</span>
          <h3>Expected, generally within 36 hours</h3>
          <p>Life-threatening inundation is expected. Follow local evacuation orders immediately.</p>
        </article>
        <article class="panel">
          <span class="badge">Beyond surge</span>
          <h3>Rain and tornado risk continue</h3>
          <p>Inland flooding and tornadoes can happen far from the coast even when no surge alert exists for your ZIP.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="surge-next-heading">
    <div class="inner grid-2">
      <article class="panel">
        <p class="eyebrow">Learn the hazard</p>
        <h2 id="surge-next-heading">Understand Storm Surge Before the Alert</h2>
        <p>Storm surge is separate from hurricane category and can affect neighborhoods differently based on track, tide, elevation, bays, canals, and evacuation zones.</p>
        <ul class="check-list">
          <li><a href="/blog/storm-surge-warning-vs-hurricane-warning/">Storm surge warning vs hurricane warning</a></li>
          <li><a href="/blog/hurricane-storm-surge-forecasting/">How storm surge forecasting works</a></li>
          <li><a href="/learn/">Hurricane learning center</a></li>
        </ul>
      </article>
      <article class="panel">
        <p class="eyebrow">Next checks</p>
        <h2>Pair Surge With Local Context</h2>
        <p>After checking a ZIP code, compare state alerts, city pages, and your household plan so water risk is not separated from roads, outages, and local instructions.</p>
        <ul class="check-list">
          <li><a href="/hurricane-tracker/city/">City hurricane trackers</a></li>
          <li><a href="/alerts/">Active NWS alerts</a></li>
          <li><a href="/tools/local-risk-plan/">State alert action plan</a></li>
        </ul>
      </article>
    </div>
  </section>

  <FaqBlock faqs={pageFaqs} />
</Layout>

<script>
  import { isSurgeFeedAvailable } from "../../lib/weatherFeedStatus";
  type SurgeAlert = { event?: string; headline?: string; severity?: string; urgency?: string; expires?: string; isSurge?: boolean };
  type SurgeResult = {
    zip?: string;
    city?: string;
    state?: string;
    surgeLevel?: "warning" | "watch" | "none";
    inSurgeWarning?: boolean;
    inSurgeWatch?: boolean;
    relevantAlerts?: SurgeAlert[];
    fetchedAt?: string;
    latitude?: number;
    longitude?: number;
    error?: string;
  };

  const form = document.querySelector<HTMLFormElement>("#surge-form");
  const zipInput = document.querySelector<HTMLInputElement>("#surge-zip");
  const statusEl = document.querySelector<HTMLElement>("#surge-status");
  const levelEl = document.querySelector<HTMLElement>("#surge-level");
  const summaryEl = document.querySelector<HTMLElement>("#surge-summary");
  const alertsEl = document.querySelector<HTMLElement>("#surge-alerts");

  let requestId = 0;
  let controller: AbortController | undefined;
  function clearResult(heading: string, message: string) {
    if (levelEl) { levelEl.textContent = heading; levelEl.className = ""; }
    if (summaryEl) summaryEl.textContent = message;
    if (alertsEl) alertsEl.innerHTML = "";
  }
  zipInput?.addEventListener("input", () => {
    requestId++;
    controller?.abort();
    clearResult("Waiting for ZIP", "Submit the ZIP to load a new result. Previous results have been cleared.");
    if (statusEl) statusEl.textContent = "Ready for a new lookup.";
  });

  function escapeHtml(value: unknown) {
    const replacements: Record<string, string> = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" };
    return String(value ?? "").replace(/[&<>"']/g, (char) => replacements[char] ?? char);
  }

  function renderAlerts(alerts: SurgeAlert[]) {
    if (!alertsEl) return;
    if (!alerts.length) {
      alertsEl.innerHTML = "<li>No tropical alert was returned for this representative point. Other locations in the ZIP may have alerts; this is not an all-clear.</li>";
      return;
    }
    alertsEl.innerHTML = alerts
      .map((alert) => {
        const badge = alert.isSurge ? '<span class="badge danger">Surge</span>' : '<span class="badge warn">Tropical</span>';
        const expires = alert.expires ? ` expires ${new Date(alert.expires).toLocaleString([], { dateStyle: "medium", timeStyle: "short" })}` : "";
        return `<li>${badge} <strong>${escapeHtml(alert.event)}</strong> — ${escapeHtml(alert.headline)}${expires}</li>`;
      })
      .join("");
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const currentRequest = ++requestId;
    controller?.abort();
    const controllerForRequest = new AbortController();
    controller = controllerForRequest;
    clearResult("Waiting for valid ZIP", "No current result. Check weather.gov and local evacuation instructions.");
    const zip = (zipInput?.value ?? "").trim();
    if (!/^\d{5}$/.test(zip)) {
      if (statusEl) statusEl.textContent = "Enter a valid five-digit US ZIP code.";
      return;
    }
    const timeout = setTimeout(() => controllerForRequest.abort(), 20_000);
    try {
      clearResult("Checking...", "Waiting for a verified alert feed for this ZIP.");
      if (statusEl) statusEl.textContent = "Checking official NWS alerts...";
      if (levelEl) levelEl.textContent = "Checking...";
      const response = await fetch(`/api/nws/surge?zip=${encodeURIComponent(zip)}`, { signal: controllerForRequest.signal });
      const data = await response.json() as SurgeResult;
      if (!response.ok || !data || data.error || !isSurgeFeedAvailable(data) || data.zip !== zip) {
        throw new Error(data?.error ?? "Surge check unavailable");
      }

      if (currentRequest !== requestId) return;
      const place = `${data.city || data.zip}, ${data.state}`;
      let headline: string;
      if (data.surgeLevel === "warning") {
        headline = "Storm Surge Warning";
        if (levelEl) levelEl.className = "badge danger";
      } else if (data.surgeLevel === "watch") {
        headline = "Storm Surge Watch";
        if (levelEl) levelEl.className = "badge warn";
      } else {
        headline = "No surge alert returned for query point";
        if (levelEl) levelEl.className = "badge";
      }
      if (levelEl) {
        levelEl.textContent = headline;
        levelEl.classList.add("badge");
      }
      if (summaryEl) {
        summaryEl.textContent = `${place}, ZIP ${data.zip || zip}: the National Weather Service returned ${data.relevantAlerts?.length ?? 0} tropical alert${(data.relevantAlerts?.length ?? 0) === 1 ? "" : "s"} for the ZIP representative point, not all addresses. Read official warning boundaries and local evacuation instructions.`;
      }
      renderAlerts(data.relevantAlerts ?? []);
      if (statusEl) statusEl.textContent = `ZIP point ${data.latitude}, ${data.longitude}. NWS feed retrieved ${new Date(data.fetchedAt!).toLocaleString()}. Check each warning's issue and expiry times. Follow local emergency management instructions.`;
    } catch (error) {
      if (currentRequest !== requestId) return;
      clearResult("Surge check unavailable", "No current alert result could be verified. A failed lookup does not mean no surge risk. Check weather.gov and local evacuation instructions.");
      console.error("HurricaneHub surge checker failed", error);
      if (statusEl) statusEl.textContent = "Surge check unavailable. Check weather.gov and retry shortly.";
    } finally {
      clearTimeout(timeout);
    }
  });
</script>

<style>
  .surge-form {
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .surge-form label {
    font-weight: 800;
  }
  .surge-form input {
    min-height: 46px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: 6px;
    font-size: 1.05rem;
    width: 100%;
    box-sizing: border-box;
  }
  #surge-alerts li {
    display: grid;
    gap: 4px;
  }
  #surge-alerts .badge {
    width: fit-content;
  }
</style>
