---
import FaqBlock from "../../components/FaqBlock.astro";
import Layout from "../../layouts/Layout.astro";
import { faqs, site } from "../../data/site";
import { articleSchema, faqSchema, graph, webApplicationSchema, websiteSchema } from "../../lib/schema";

const title = "Hurricane Family Communication Plan Generator";
const description = "Create a printable hurricane family communication plan with contacts, meeting places, evacuation destination, pets, medication notes, and check-in times.";
const url = `${site.url}/tools/family-communication-plan/`;
const lastModified = "2026-11-09";
const pageFaqs = [
  {
    question: "What should a hurricane family communication plan include?",
    answer: "Include contacts, meeting places, destinations, transport and care needs, plus a dated check-in schedule with its time zone. Agree who acknowledges each message, who relays status, and what to do after a missed check-in. A sent message alone does not confirm it was received."
  },
  {
    question: "Why use an out-of-area contact during a hurricane?",
    answer: "Local calls and roads can be disrupted. An out-of-area contact can help family members relay status when everyone cannot reach each other directly."
  },
  ...faqs
];
const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title, description, url, dateModified: lastModified }),
  webApplicationSchema({
    name: title,
    description,
    url,
    featureList: ["Printable family communication plan", "Contact and meeting-place fields", "Evacuation destination and needs notes", "Dated check-ins, acknowledgement and missed-contact arrangements"]
  }),
  faqSchema(pageFaqs)
);
---
<Layout title={title} description={description} canonical={url} jsonLd={jsonLd} lastModified={lastModified} showBottomAd={true}>
  <section class="band" aria-labelledby="plan-title">
    <div class="inner">
      <p class="eyebrow">Family coordination</p>
      <h1 id="plan-title">Hurricane Family Communication Plan Generator</h1>
      <p class="answer">Fill in a few fields to create a printable family communication plan for check-ins, evacuation destinations, medical needs, pets, and backup contacts before a hurricane disrupts phones or travel.</p>
    </div>
  </section>

  <section class="band" aria-labelledby="plan-form-heading">
    <div class="inner grid-2">
      <form class="panel family-plan-form" id="family-plan-form">
        <h2 id="plan-form-heading">Build Communication Plan</h2>
        <label>Out-of-area contact<input name="outsideContact" placeholder="Name and phone" /></label>
        <label>Local contact<input name="localContact" placeholder="Name and phone" /></label>
        <label>Meeting place<input name="meetingPlace" placeholder="School, shelter, relative, or landmark" /></label>
        <label>Evacuation destination<input name="destination" placeholder="Address or town" /></label>
        <label>Backup destination<input name="backupDestination" placeholder="Second safe address, shelter, or town" /></label>
        <label>Transport and pickup plan<textarea name="transport" placeholder="Driver, vehicle, transit, school pickup, accessible transport, or neighbor plan"></textarea></label>
        <label>Plan date<input name="planDate" type="date" /></label>
        <label>Time zone<input name="timeZone" placeholder="For example: Eastern Standard Time (UTC-5)" /></label>
        <label>Check-in times<input name="checkIn" placeholder="Date and time, before leaving, and on arrival" /></label>
        <label>Receipt and relay agreement<textarea name="acknowledgement" placeholder="Who replies to confirm receipt? Who relays status to whom, and how soon? Distinguish sent, received and relayed."></textarea></label>
        <label>Missed check-in and backup channel<textarea name="fallback" placeholder="Who retries, after how long, using which backup number or channel? Name the next contact if no reply arrives."></textarea></label>
        <label>Important needs<textarea name="needs" placeholder="Medication, pets, mobility, pickup, school, work, or equipment notes"></textarea></label>
        <button type="submit">Generate plan</button>
      </form>

      <article class="panel" id="family-plan-output" aria-live="polite">
        <p class="eyebrow">Printable plan</p>
        <h2>Waiting for details</h2>
        <p>Add contacts and destinations, then print or copy the plan for your household.</p>
      </article>
    </div>
    <div class="inner"><p class="source-note">Plan details stay in this page; this tool does not send messages or monitor replies. Print a copy before closing or reloading.</p><p><a href="/downloads/hurricane-communication-checkin-record.txt" download>Download the blank check-in and acknowledgement record (TXT)</a> &middot; <a href="/blog/hurricane-family-communication-plan/">Review the family check-in protocol</a></p></div>
  </section>

  <FaqBlock faqs={pageFaqs} />
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>("#family-plan-form");
  const output = document.querySelector<HTMLElement>("#family-plan-output");
  function escapeHtml(value: unknown) {
    const replacements: Record<string, string> = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" };
    return String(value ?? "").replace(/[&<>"']/g, (char) => replacements[char] ?? char);
  }
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const outsideContact = String(data.get("outsideContact") || "Not set");
    const localContact = String(data.get("localContact") || "Not set");
    const meetingPlace = String(data.get("meetingPlace") || "Not set");
    const destination = String(data.get("destination") || "Not set");
    const backupDestination = String(data.get("backupDestination") || "Not set");
    const transport = String(data.get("transport") || "Not set");
    const planDate = String(data.get("planDate") || "Not set - agree a plan date");
    const timeZone = String(data.get("timeZone") || "Not set - agree the time zone");
    const checkIn = String(data.get("checkIn") || "Not set - agree dates and check-in times");
    const acknowledgement = String(data.get("acknowledgement") || "Not set - agree who confirms receipt and relays status");
    const fallback = String(data.get("fallback") || "Not set - agree a retry interval, backup channel and next contact");
    const needs = String(data.get("needs") || "No special notes added");
    if (!output) return;
    output.innerHTML = `
      <p class="eyebrow">Printable family plan</p>
      <h2>Hurricane Communication Plan</h2>
      <table>
        <tbody>
          <tr><th>Out-of-area contact</th><td>${escapeHtml(outsideContact)}</td></tr>
          <tr><th>Local contact</th><td>${escapeHtml(localContact)}</td></tr>
          <tr><th>Meeting place</th><td>${escapeHtml(meetingPlace)}</td></tr>
          <tr><th>Evacuation destination</th><td>${escapeHtml(destination)}</td></tr>
          <tr><th>Backup destination</th><td>${escapeHtml(backupDestination)}</td></tr>
          <tr><th>Transport and pickup</th><td>${escapeHtml(transport)}</td></tr>
          <tr><th>Plan date</th><td>${escapeHtml(planDate)}</td></tr>
          <tr><th>Time zone</th><td>${escapeHtml(timeZone)}</td></tr>
          <tr><th>Check-in times</th><td>${escapeHtml(checkIn)}</td></tr>
          <tr><th>Receipt and relay agreement</th><td>${escapeHtml(acknowledgement)}</td></tr>
          <tr><th>Missed check-in and backup channel</th><td>${escapeHtml(fallback)}</td></tr>
          <tr><th>Important needs</th><td>${escapeHtml(needs)}</td></tr>
        </tbody>
      </table>
      <h3 style="margin-top: 18px;">Check-in rules</h3>
      <ul class="check-list">
        <li>Use text first when calls are congested, and tell the out-of-area contact if plans change.</li>
        <li>A sent message is not confirmed receipt. Record the human reply and distinguish received from relayed status.</li>
        <li>Use the agreed retry and backup contact plan after a missed check-in; silence alone does not establish safety or harm.</li>
        <li>Do not make an unplanned pickup or return trip during unsafe conditions.</li>
        <li>Leave a paper copy with each household member and emergency documents.</li>
      </ul>
      <p class="source-note">Print this plan and keep a copy with emergency documents. Follow official evacuation and shelter instructions.</p>
      <p><button type="button" id="family-plan-print">Print plan</button></p>
    `;
    document.querySelector("#family-plan-print")?.addEventListener("click", () => window.print());
  });
</script>

<style>
  .family-plan-form { display: grid; gap: 14px; align-content: start; }
  .family-plan-form label { display: grid; gap: 7px; font-weight: 800; }
  .family-plan-form textarea { min-height: 120px; padding: 10px 12px; }
  #family-plan-output { min-width: 0; }
  #family-plan-output :global(table) { table-layout: fixed; }
  #family-plan-output :global(th) { width: 42%; font-size: 0.875rem; text-transform: none; letter-spacing: 0; }
  #family-plan-output :global(th), #family-plan-output :global(td) { overflow-wrap: anywhere; white-space: pre-wrap; }
  @media print { .site-header, .disclaimer, .family-plan-form, .site-footer, .ad-slot { display: none !important; } }
</style>
