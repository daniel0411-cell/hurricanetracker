---
import Layout from "../../layouts/Layout.astro";
import FaqBlock from "../../components/FaqBlock.astro";
import { faqs, site } from "../../data/site";
import { articleSchema, faqSchema, graph, itemListSchema, websiteSchema } from "../../lib/schema";

const title = "Hurricane Tools";
const description = "Use HurricaneHub tools for emergency preparedness, hurricane kit planning, and household decision support based on official NOAA and NHC source awareness.";
const url = `${site.url}/tools/`;
const lastModified = site.contentLastModified;
const tools = [
  {
    name: "My Hurricane Dashboard",
    description: "Build a ZIP-based dashboard with state alerts, active storms, radar shortcuts, and next decision tools.",
    url: `${site.url}/tools/my-hurricane-dashboard/`
  },
  {
    name: "Impact Window Estimator",
    description: "Use active alerts and storm context to estimate whether your household should monitor, prepare, act, or leave.",
    url: `${site.url}/tools/impact-window-estimator/`
  },
  {
    name: "Local Risk and Action Plan",
    description: "Check a ZIP code or state, understand active NWS hazards, and generate a 72/48/24-hour household action plan.",
    url: `${site.url}/tools/local-risk-plan/`
  },
  {
    name: "Local Hurricane Risk Hub",
    description: "Choose the right ZIP, city, state, storm surge, evacuation-zone, and household planning path for local hurricane risk.",
    url: `${site.url}/local-hurricane-risk/`
  },
  {
    name: "Preparedness Checklist Generator",
    description: "Create a household hurricane emergency kit list for 1-4 people, with optional pet supplies.",
    url: `${site.url}/tools/preparedness-checklist/`
  },
  {
    name: "Evacuation Decision Helper",
    description: "Sort your household into Monitor, Prepare, Act, or Leave using alert status, housing risk, pets, transport, and medical needs.",
    url: `${site.url}/tools/evacuation-decision-helper/`
  },
  {
    name: "Hurricane Brief Generator",
    description: "Generate a printable ZIP-based brief with current NWS alerts, NHC storm context, and next household decisions.",
    url: `${site.url}/tools/hurricane-brief/`
  },
  {
    name: "Power Outage Planner",
    description: "Plan for water, food safety, medical equipment, charging, generators, pets, and communication during an outage.",
    url: `${site.url}/tools/power-outage-planner/`
  },
  {
    name: "Storm Distance Calculator",
    description: "Compare your ZIP code with current NHC storm positions and understand the limits of distance-only context.",
    url: `${site.url}/tools/storm-distance-calculator/`
  },
  {
    name: "Alert Action Decoder",
    description: "Translate hurricane, surge, flood, tornado, and evacuation alert language into immediate household actions.",
    url: `${site.url}/tools/alert-action-decoder/`
  },
  {
    name: "Storm Surge ZIP Checker",
    description: "Check whether your ZIP code is inside an active NWS storm surge watch or warning, plus nearby official hurricane alerts.",
    url: `${site.url}/tools/storm-surge-checker/`
  },
  {
    name: "Family Communication Plan",
    description: "Generate a printable contact, meeting-place, evacuation destination, pet, and medical-needs plan.",
    url: `${site.url}/tools/family-communication-plan/`
  },
  {
    name: "Hurricane Comparison Tool",
    description: "Overlay today's active storm against Katrina, Ian, and Sandy — track maps, peak category, pressure, and intensity at the same latitude.",
    url: `${site.url}/compare/`
  }
];

const popularTools = [tools[0], tools[3], tools[4], tools[2]];
const workflows = [
  {
    name: "I need to know what is happening near me",
    summary: "Start with your saved locations, then compare active alerts with the local city tracker and live map.",
    steps: [
      { label: "Open My Hurricane Dashboard", href: "/tools/my-hurricane-dashboard/" },
      { label: "Check Local Hurricane Risk", href: "/local-hurricane-risk/" },
      { label: "Check City Hurricane Trackers", href: "/hurricane-tracker/city/" },
      { label: "Review Live Alerts", href: "/alerts/" }
    ]
  },
  {
    name: "I need to decide whether to leave",
    summary: "Use official alert language first, then layer in surge exposure, housing type, medical needs, pets, and transportation.",
    steps: [
      { label: "Use the Evacuation Helper", href: "/tools/evacuation-decision-helper/" },
      { label: "Decode the Alert", href: "/tools/alert-action-decoder/" },
      { label: "Build a Local Risk Plan", href: "/tools/local-risk-plan/" }
    ]
  },
  {
    name: "I need to prepare the house and family",
    summary: "Turn the forecast into supplies, contacts, outage planning, and a printable household brief.",
    steps: [
      { label: "Generate a Checklist", href: "/tools/preparedness-checklist/" },
      { label: "Plan for Power Outages", href: "/tools/power-outage-planner/" },
      { label: "Create a Family Plan", href: "/tools/family-communication-plan/" }
    ]
  }
];

const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title, description, url, dateModified: lastModified }),
  itemListSchema(tools),
  faqSchema(faqs)
);
---
<Layout title={title} description={description} canonical={url} jsonLd={jsonLd} lastModified={lastModified}>
  <section class="band" aria-labelledby="tools-title">
    <div class="inner">
      <p class="eyebrow">Emergency decision tools</p>
      <h1 id="tools-title">Hurricane Tools</h1>
      <p class="answer">HurricaneHub tools help households turn official NOAA/NHC storm information into preparedness actions, starting with a personalized emergency kit checklist.</p>
    </div>
  </section>

  <section class="band" aria-labelledby="workflow-heading">
    <div class="inner">
      <p class="eyebrow">Choose by situation</p>
      <h2 id="workflow-heading">Which Hurricane Tool Should I Use First?</h2>
      <div class="grid-3">
        {workflows.map((workflow) => (
          <article class="post-card">
            <h3>{workflow.name}</h3>
            <p>{workflow.summary}</p>
            <ol class="workflow-list">
              {workflow.steps.map((step) => (
                <li><a href={step.href}>{step.label}</a></li>
              ))}
            </ol>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band popular-band" aria-labelledby="popular-heading">
    <div class="inner">
      <p class="eyebrow">Most used</p>
      <h2 id="popular-heading">Start With These</h2>
      <div class="grid-3">
        {popularTools.map((tool) => (
          <article class="post-card">
            <h3>{tool.name}</h3>
            <p>{tool.description}</p>
            <a href={new URL(tool.url).pathname}>Open tool</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="tools-list">
    <div class="inner grid-3">
      {tools.map((tool, index) => (
        <article class="post-card">
          <h2 id={index === 0 ? "tools-list" : undefined}>{tool.name}</h2>
          <p>{tool.description}</p>
          <a href={new URL(tool.url).pathname}>Open tool</a>
        </article>
      ))}
    </div>
  </section>

  <section class="band" aria-labelledby="tool-context-heading">
    <div class="inner grid-2">
      <article>
        <p class="eyebrow">How tools fit together</p>
        <h2 id="tool-context-heading">From Storm Tracking to Household Action</h2>
        <p class="answer">A hurricane tool works best when it answers one decision at a time: where the storm is, what alerts are active, what hazards affect your location, and what your household should finish before conditions worsen.</p>
        <p>Use the <a href="/hurricane-tracker/live/">live hurricane tracker</a> for current storm context, the <a href="/local-hurricane-risk/">local hurricane risk hub</a> for ZIP, city, state, surge, and evacuation-zone paths, and the <a href="/learn/">Hurricane Learning Center</a> when you need plain-language explanations before using a checklist or decision helper.</p>
      </article>
      <article class="panel">
        <h3>High-intent hurricane searches covered here</h3>
        <ul class="check-list">
          <li>Hurricane preparedness checklist and emergency kit planning</li>
          <li>Evacuation decision support for surge zones and vulnerable households</li>
          <li>Storm distance, live tracker, and local alert interpretation</li>
          <li>Power outage, family communication, and printable household plans</li>
        </ul>
      </article>
    </div>
  </section>
  <FaqBlock faqs={faqs} />
</Layout>

<style>
  .workflow-list {
    display: grid;
    gap: 8px;
    margin: 16px 0 0;
    padding-left: 1.3rem;
  }
</style>
