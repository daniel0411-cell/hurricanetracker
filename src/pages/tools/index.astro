---
import Layout from "../../layouts/Layout.astro";
import { faqs, site } from "../../data/site";
import { articleSchema, faqSchema, graph, websiteSchema } from "../../lib/schema";

const title = "Hurricane Tools";
const description = "Use HurricaneHub tools for emergency preparedness, hurricane kit planning, and household decision support based on official NOAA and NHC source awareness.";
const url = `${site.url}/tools/`;
const lastModified = site.contentLastModified;
const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title, description, url, dateModified: lastModified }),
  faqSchema(faqs)
);
---
<Layout title={title} description={description} canonical={url} jsonLd={jsonLd} lastModified={lastModified}>
  <section class="band" aria-labelledby="tools-title">
    <div class="inner">
      <p class="eyebrow">Emergency decision tools</p>
      <h1 id="tools-title">Hurricane Tools</h1>
      <p class="answer">HurricaneHub tools help households turn official NOAA/NHC storm information into preparedness actions, starting with a personalized emergency kit checklist.</p>
    </div>
  </section>

  <section class="band" aria-labelledby="tools-list">
    <div class="inner grid-3">
      <article class="post-card">
        <h2 id="tools-list">Local Risk and Action Plan</h2>
        <p>Check a ZIP code or state, understand active NWS hazards, and generate a 72/48/24-hour household action plan.</p>
        <a href="/tools/local-risk-plan/">Check local risk</a>
      </article>
      <article class="post-card">
        <h2>Preparedness Checklist Generator</h2>
        <p>Create a household hurricane emergency kit list for 1-4 people, with optional pet supplies.</p>
        <a href="/tools/preparedness-checklist/">Open tool</a>
      </article>
      <article class="post-card">
        <h2>Evacuation Decision Helper</h2>
        <p>Sort your household into Monitor, Prepare, Act, or Leave using alert status, housing risk, pets, transport, and medical needs.</p>
        <a href="/tools/evacuation-decision-helper/">Open tool</a>
      </article>
    </div>
  </section>
</Layout>
