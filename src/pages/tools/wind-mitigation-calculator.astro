---
import FaqBlock from "../../components/FaqBlock.astro";
import Layout from "../../layouts/Layout.astro";
import { site } from "../../data/site";
import { articleSchema, faqSchema, graph, webApplicationSchema, websiteSchema, breadcrumbSchema } from "../../lib/schema";

const title = "Florida Wind Mitigation Savings Scenario Calculator";
const description = "Compare Florida wind mitigation savings using your actual wind premium and insurer-confirmed additional discount. Calculate annual savings and inspection payback.";
const url = `${site.url}/tools/wind-mitigation-calculator/`;
const lastModified = "2026-10-16";
const toolFaqs = [
  {
    question: "Does a wind mitigation inspection guarantee insurance savings?",
    answer: "No. Savings depend on verified construction features, your insurer's rating rules, and credits already applied to your policy. An inspection documents features; it does not establish a universal discount or guarantee a lower renewal premium. Ask your insurer for a written comparison before paying for improvements."
  },
  {
    question: "Which premium should I enter?",
    answer: "Enter the annual wind portion confirmed by your insurer, not your total homeowners premium. For an incremental savings scenario, ask for the wind premium before the proposed additional credit and the additional percentage that applies to that same amount. Do not apply a total credit again if it is already included in your bill."
  },
  {
    question: "How long is a Florida mitigation report valid?",
    answer: "Florida OIR states that Form OIR-B1-1802 is valid for up to five years provided there are no material changes to the structure or inaccuracies in the form. Ask your insurer whether a change such as a new roof requires updated documentation."
  },
  {
    question: "Which Florida inspection form is current?",
    answer: "OIR lists an updated Uniform Mitigation Verification Inspection Form, OIR-B1-1802, effective April 1, 2026. Use the current form and an inspector authorized under Florida law. The inspection form records construction features; it is not a universal percentage discount schedule."
  },
  {
    question: "Does this calculator support Texas or other coastal states?",
    answer: "No. The guidance here is limited to Florida. Other states and windstorm insurance programs have different certification and rating requirements. This calculator performs scenario arithmetic only and does not determine eligibility, quote insurance, or predict renewal rates."
  }
];
const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title, description, url, dateModified: lastModified }),
  webApplicationSchema({ name: title, description, url, featureList: [
    "User-supplied annual wind premium",
    "Insurer-confirmed additional discount scenario",
    "Annual savings and inspection cost payback"
  ] }),
  faqSchema(toolFaqs),
  breadcrumbSchema([
    { name: "Home", url: site.canonicalUrl },
    { name: "Tools", url: `${site.url}/tools/` },
    { name: "Wind Mitigation Calculator", url }
  ])
);
---

<Layout title={title} description={description} canonical={url} jsonLd={jsonLd} lastModified={lastModified} showBottomAd={true}>
  <section class="band" aria-labelledby="calc-heading">
    <div class="inner">
      <p class="eyebrow">Florida homeowner planning</p>
      <h1 id="calc-heading">Florida Wind Mitigation Savings Calculator</h1>
      <p class="answer">Compare a potential additional wind mitigation credit using figures confirmed by your insurer. Construction features alone cannot establish your discount. This is a savings scenario, not an insurance quote or a promise of a lower bill.</p>
    </div>
  </section>

  <section class="band" aria-labelledby="calc-tool-section">
    <div class="inner grid-2">
      <form class="panel decision-tool" id="wind-tool">
        <h2 id="calc-tool-section">Your Florida Policy Scenario</h2>
        <label for="wind-premium">Annual wind premium before the additional credit ($)
          <input type="number" id="wind-premium" name="windPremium" min="0" max="1000000" step="0.01" required />
        </label>
        <label for="additional-discount">Insurer-confirmed additional discount (%)
          <input type="number" id="additional-discount" name="discount" min="0" max="100" step="0.01" required />
        </label>
        <label for="inspection-cost">Inspection cost ($)
          <input type="number" id="inspection-cost" name="inspectionCost" min="0" max="1000000" step="0.01" required />
        </label>
        <button type="submit">Calculate Savings Scenario</button>
      </form>
      <article class="panel" aria-live="polite" aria-atomic="true">
        <h2>Your Savings Scenario</h2>
        <p id="savings-amount">No scenario calculated yet.</p>
        <p id="payback-period"></p>
        <p id="calculation-detail"></p>
        <p class="source-note">Discounts already included in your premium must not be counted again. Other rate changes, fees, coverage changes, and retrofit costs are excluded. A zero additional discount means zero additional savings.</p>
      </article>
    </div>
  </section>

  <section class="band" aria-labelledby="understanding-mitigation">
    <div class="inner">
      <h2 id="understanding-mitigation">Start With Your Insurer, Not a Percentage Estimate</h2>
      <p>Wind mitigation means reducing a building's vulnerability to wind damage and documenting its construction features. In Florida, an authorized inspector uses the Uniform Mitigation Verification Inspection Form, OIR-B1-1802, to record relevant features. The insurer then evaluates the documentation under its rating rules. A roof shape, window label, or construction year by itself is not enough to calculate a reliable dollar saving. This page deliberately does not assign percentages to those features or assume that wind coverage makes up a fixed share of your total premium.</p>
      <p>Before arranging an inspection, ask your agent which mitigation credits are already on your policy, which report is on file, and whether new documentation could change the rating. Request the annual wind premium separately from the total homeowners premium. Then ask for the additional credit, if any, that would apply to that same premium basis. If the insurer cannot confirm an additional percentage, use its written before-and-after premium amounts instead of treating an online estimate as an offer.</p>

      <h2>What the Savings Scenario Includes</h2>
      <p>The annual savings calculation is the wind premium you enter multiplied by the additional discount divided by 100. For example, a hypothetical $1,000 wind premium with a confirmed additional 10% credit produces $100 in annual savings. If the inspection costs $150, the simple payback is 18 months. These numbers are an arithmetic example only, not typical Florida premiums, expected credits, or a suggested inspection price. The form starts blank so that an illustrative value cannot be mistaken for a personalized estimate.</p>
      <p>Payback divides the inspection cost by annual savings and converts years to months, rounded upward. It assumes the additional saving remains constant. It does not include the cost of a new roof, shutters, windows, engineering work, financing, or future inspections. If you are comparing a retrofit, include those expenses separately in your household budget. When savings are zero, there is no payback from the credit. A zero-cost inspection has no inspection expense to recover, but that does not make later construction work free.</p>
      <p>An insurance renewal can increase even when a mitigation credit is added. Base rates, coverage limits, deductibles, policy terms, and other factors may change at the same time. Compare equivalent coverage and ask the insurer to separate the effect of the new credit from other renewal changes. Do not subtract this scenario result from your current bill and assume that the remainder is a future quote.</p>

      <h2>Prepare for a Florida Wind Mitigation Inspection</h2>
      <p>The Florida Office of Insurance Regulation lists a revised OIR-B1-1802 form effective April 1, 2026. Its resource page links the current form, inspector authorization requirements, and mitigation programs. Check the current official material before relying on an older report or an online checklist. OIR says a report may remain valid for up to five years if there are no material changes to the structure or inaccuracies in the form. Your insurer can explain whether your existing report is acceptable and what updates are needed after work on the home.</p>
      <ul class="check-list">
        <li><strong>Collect records:</strong> Gather the current mitigation report, roof permits, installation invoices, product approvals, and policy documents. Give copies to the inspector and insurer rather than trying to infer eligibility from a product name.</li>
        <li><strong>Verify the inspector:</strong> Confirm that the person is authorized to perform Florida mitigation inspections. Ask about scope, price, access requirements, photographs, and delivery of the signed report before booking.</li>
        <li><strong>Document roof features:</strong> Roof covering, roof deck attachment, roof-to-wall connections, roof geometry, and water resistance may require records or an on-site inspection. Do not enter an attic or climb a roof to self-certify them.</li>
        <li><strong>Check opening protection:</strong> Keep approval and installation records for windows, doors, shutters, and other openings. Partial protection should not be assumed to qualify for a particular credit; the inspector and insurer must evaluate the applicable requirements.</li>
        <li><strong>Request a written comparison:</strong> After submitting the report, ask which credits were accepted, their effective date, and the resulting premium. Keep the response with your renewal records.</li>
      </ul>

      <h2>Plan Improvements Beyond an Insurance Credit</h2>
      <p>A project can improve resilience without producing the insurance saving you expected. Discuss structural work with qualified professionals, verify permits and contractor credentials, and compare written scopes of work. Do not choose a roof or opening-protection project solely because an online tool suggests a high discount. Consider the home's condition, local building requirements, maintenance, water intrusion, and what your household can afford. No mitigation measure makes a home hurricane-proof or replaces evacuation instructions.</p>
      <p>Florida homeowners can check the My Safe Florida Home program through the official resources below. Funding, application periods, eligibility, inspections, and grant terms can change. Confirm current availability and whether approval is required before signing contracts or starting work. This calculator does not determine program eligibility and does not include a grant in its results. For homes outside Florida, consult your state's insurance department and relevant windstorm program instead of applying Florida report requirements to another jurisdiction.</p>
      <p>Keep insurance planning alongside practical household preparation. Maintain a property inventory, back up policy and inspection documents, review your deductible, and plan for outages. Insurance credits concern a policy's rating; they do not describe today's weather or the safety of staying in a particular building. Use official NHC, NWS, and local emergency management guidance when a storm threatens.</p>
      <h3>Official Florida Resources</h3>
      <ul>
        <li><a href="https://floir.gov/consumers/wind-mitigation-resources">Florida OIR wind mitigation forms, inspector requirements, and program links</a></li>
        <li><a href="https://mysafeflhome.com/">My Safe Florida Home program eligibility and current availability</a></li>
      </ul>
    </div>
  </section>

  <section class="band" aria-labelledby="faq-section">
    <div class="inner">
      <h2 id="faq-section">Wind Mitigation and Insurance Questions</h2>
      <FaqBlock faqs={toolFaqs} />
    </div>
  </section>
  <section class="band" aria-labelledby="related-tools">
    <div class="inner">
      <h2 id="related-tools">Related Household Planning</h2>
      <ul>
        <li><a href="/tools/power-outage-planner/">Plan household needs during a power outage</a></li>
        <li><a href="/tools/#inventory-heading">Prepare a home inventory checklist</a></li>
        <li><a href="/tools/evacuation-decision-helper/">Review household evacuation considerations</a></li>
      </ul>
    </div>
  </section>
</Layout>

<script>
  import { trackToolResult } from "../../lib/toolAnalytics";

  const form = document.querySelector<HTMLFormElement>("#wind-tool");
  const savings = document.querySelector<HTMLElement>("#savings-amount");
  const payback = document.querySelector<HTMLElement>("#payback-period");
  const detail = document.querySelector<HTMLElement>("#calculation-detail");
  const currency = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" });

  form?.addEventListener("input", () => {
    if (savings) savings.textContent = "Inputs changed. Recalculate to update your scenario.";
    if (payback) payback.textContent = "";
    if (detail) detail.textContent = "";
  });
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!savings || !payback || !detail) {
      trackToolResult("wind_mitigation", "error");
      return;
    }
    const data = new FormData(form);
    const raw = ["windPremium", "discount", "inspectionCost"].map((key) => String(data.get(key) ?? "").trim());
    const [premium, discount, cost] = raw.map(Number);
    if (!form.reportValidity() || raw.some((value) => !value) || ![premium, discount, cost].every(Number.isFinite)
      || premium < 0 || premium > 1000000 || discount < 0 || discount > 100 || cost < 0 || cost > 1000000) {
      savings.textContent = "Enter valid non-negative amounts and a discount from 0% to 100%.";
      payback.textContent = "";
      detail.textContent = "";
      trackToolResult("wind_mitigation", "error");
      return;
    }
    const annualSavings = premium * discount / 100;
    savings.textContent = `${currency.format(annualSavings)} per year in this scenario.`;
    payback.textContent = cost === 0 ? "No inspection cost to recover."
      : annualSavings === 0 ? "No inspection payback from this credit: additional savings are zero."
      : `Simple inspection payback: ${Math.ceil(cost / annualSavings * 12)} months, assuming unchanged annual savings.`;
    detail.textContent = `${currency.format(premium)} annual wind premium × ${discount}% additional credit. Inspection cost: ${currency.format(cost)}. Not a quote or a renewal prediction.`;
    trackToolResult("wind_mitigation", "success");
  });
</script>
