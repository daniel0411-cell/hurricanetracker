---
import FaqBlock from "../../components/FaqBlock.astro";
import Layout from "../../layouts/Layout.astro";
import { faqs, site } from "../../data/site";
import { articleSchema, faqSchema, graph, webApplicationSchema, websiteSchema } from "../../lib/schema";

const title = "Hurricane Alert Action Decoder";
const description = "Decode hurricane watches, warnings, storm surge alerts, flash flood warnings, tornado warnings, and evacuation orders into household action steps.";
const url = `${site.url}/tools/alert-action-decoder/`;
const pageFaqs = [
  {
    question: "What does a hurricane warning mean I should do?",
    answer: "A hurricane warning means hurricane conditions are expected. Finish protective actions, follow local instructions, and leave if officials order evacuation or your household needs extra time."
  },
  {
    question: "Which alert should make me leave?",
    answer: "Evacuation orders, storm surge warnings for your zone, unsafe housing, and household medical or mobility needs can all require leaving earlier. Local officials control evacuation decisions."
  },
  ...faqs
];
const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title, description, url, dateModified: site.contentLastModified }),
  webApplicationSchema({
    name: title,
    description,
    url,
    featureList: ["Hurricane alert decoding", "Storm surge and flood action guidance", "Household risk escalation"]
  }),
  faqSchema(pageFaqs)
);
---
<Layout title={title} description={description} canonical={url} jsonLd={jsonLd} lastModified={site.contentLastModified} showBottomAd={true}>
  <section class="band" aria-labelledby="decoder-title">
    <div class="inner">
      <p class="eyebrow">Plain-language alert actions</p>
      <h1 id="decoder-title">Hurricane Alert Action Decoder</h1>
      <p class="answer">Select an official alert type and your household risk to translate watch, warning, surge, flood, tornado, and evacuation language into practical next actions.</p>
    </div>
  </section>

  <section class="band" aria-labelledby="decoder-form-heading">
    <div class="inner grid-2">
      <form class="panel decoder-form" id="decoder-form">
        <h2 id="decoder-form-heading">Decode an Alert</h2>
        <label>Official alert type
          <select name="alert">
            <option value="watch">Hurricane or tropical storm watch</option>
            <option value="hurricane-warning">Hurricane warning</option>
            <option value="surge-watch">Storm surge watch</option>
            <option value="surge">Storm surge warning</option>
            <option value="flood">Flash flood or flood warning</option>
            <option value="tornado">Tornado warning</option>
            <option value="extreme-wind">Extreme wind warning</option>
            <option value="evacuation">Evacuation order</option>
          </select>
        </label>
        <label>Household risk
          <select name="risk">
            <option value="standard">Standard inland household</option>
            <option value="coastal">Coastal, low-lying, barrier island, or flood zone</option>
            <option value="vulnerable">Medical, mobility, transportation, pet, or mobile-home vulnerability</option>
          </select>
        </label>
        <button type="submit">Decode action</button>
      </form>

      <article class="panel" aria-live="polite">
        <p class="eyebrow">Recommended action level</p>
        <h2 id="decoder-level">Prepare</h2>
        <p id="decoder-summary">Choose an alert and household risk to see action steps.</p>
        <ul class="check-list" id="decoder-actions">
          <li>Read the full official alert at weather.gov.</li>
          <li>Confirm county emergency management instructions.</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="band" aria-labelledby="decoder-next-heading">
    <div class="inner grid-2">
      <article>
        <p class="eyebrow">Related guidance</p>
        <h2 id="decoder-next-heading">Read the Alert, Then Check Local Risk</h2>
        <p class="answer">Alert wording is only one part of the decision. Pair the decoded action with official instructions, your evacuation zone, and the type of hazard affecting your area.</p>
      </article>
      <div class="link-grid" aria-label="Related hurricane alert resources">
        <a href="/blog/nws-hurricane-alert-meanings/">
          <strong>NWS Alert Meanings</strong>
          <span>Understand the difference between watches, warnings, advisories, and statements.</span>
        </a>
        <a href="/blog/what-hurricane-watch-warning-means/">
          <strong>Watch vs Warning</strong>
          <span>Review how timing and confidence change between a hurricane watch and warning.</span>
        </a>
        <a href="/tools/evacuation-decision-helper/">
          <strong>Evacuation Helper</strong>
          <span>Organize evacuation-zone, household, and route factors before you leave.</span>
        </a>
        <a href="/alerts/">
          <strong>Live Alerts</strong>
          <span>Check active official alert feeds before making storm decisions.</span>
        </a>
      </div>
    </div>
  </section>

  <FaqBlock faqs={pageFaqs} />
</Layout>

<script>
  import { alertActionGuidance, decisionLevel, requiresImmediateShelter } from "../../lib/weather";
  const form = document.querySelector<HTMLFormElement>("#decoder-form");
  const levelEl = document.querySelector<HTMLElement>("#decoder-level");
  const summaryEl = document.querySelector<HTMLElement>("#decoder-summary");
  const actionsEl = document.querySelector<HTMLElement>("#decoder-actions");
  const matrix: Record<string, { event: string; summary: string }> = {
    watch: {
      event: "Hurricane Watch",
      summary: "Hurricane conditions are possible in the watch area. The usual 48-hour lead time is measured before anticipated tropical-storm-force winds."
    },
    "hurricane-warning": {
      event: "Hurricane Warning",
      summary: "Hurricane conditions are expected in the warning area. The usual 36-hour lead time is measured before anticipated tropical-storm-force winds."
    },
    "surge-watch": {
      event: "Storm Surge Watch",
      summary: "Life-threatening inundation is possible in the watch area, generally within 48 hours. Check your zone and local decision deadline."
    },
    surge: {
      event: "Storm Surge Warning",
      summary: "Life-threatening inundation is expected in the warned area, generally within 36 hours. Read local evacuation instructions and route conditions."
    },
    flood: {
      event: "Flash Flood Warning",
      summary: "Read the full flood warning for its affected area and required protective action. Floodwater can rise quickly and make roads deadly."
    },
    tornado: {
      event: "Tornado Warning",
      summary: "If you are in the warned area, a tornado warning requires immediate sheltering action."
    },
    "extreme-wind": {
      event: "Extreme Wind Warning",
      summary: "If you are in the warned area, take immediate shelter in the interior of a well-built structure."
    },
    evacuation: {
      event: "Evacuation Order",
      summary: "Follow the issuing authority's instruction for your specified zone, deadline, and route."
    }
  };

  function escapeHtml(value: unknown) {
    const replacements: Record<string, string> = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" };
    return String(value ?? "").replace(/[&<>"']/g, (char) => replacements[char] ?? char);
  }

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const alert = String(data.get("alert") ?? "watch");
    const risk = String(data.get("risk") ?? "standard");
    const base = matrix[alert] ?? matrix.watch;
    const alerts = [{ event: base.event }];
    const actions = alertActionGuidance(alerts);
    const level = decisionLevel(alerts, []);
    let summary = base.summary;
    if (risk === "coastal" && level === "Prepare") {
      summary = `${summary} Because you selected coastal or flood exposure, confirm your evacuation zone and local instructions now; the exposure choice does not turn a watch into a warning.`;
    }
    if (risk === "vulnerable" && level === "Prepare") {
      actions.push("Before conditions deteriorate, arrange medical support, accessible transport, and a destination. Record the local authority's actual deadline.");
    } else if (risk === "vulnerable" && requiresImmediateShelter(alerts)) {
      actions.push("Help household members reach the safest available interior shelter now. Keep essential medication and mobility aids with them if within reach.");
    }
    if (levelEl) levelEl.textContent = level;
    if (summaryEl) summaryEl.textContent = summary;
    if (actionsEl) actionsEl.innerHTML = actions.map((action) => `<li>${escapeHtml(action)}</li>`).join("");
  });
</script>

<style>
  .decoder-form { display: grid; gap: 14px; align-content: start; }
  .decoder-form label { display: grid; gap: 7px; font-weight: 800; }
</style>
