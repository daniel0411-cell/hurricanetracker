---
import FaqBlock from "../../../components/FaqBlock.astro";
import Layout from "../../../layouts/Layout.astro";
import { stormTrackerPages } from "../../../data/stormPages";
import { site } from "../../../data/site";
import { articleSchema, faqSchema, graph, itemListSchema, websiteSchema } from "../../../lib/schema";
import type { NhcStorm } from "../../../lib/weather";
import { isStormFeedAvailable } from "../../../lib/weatherFeedStatus";

const title = "Named Hurricane Trackers";
const description =
  "Find dated storm records, current NHC status checks, official advisory links, and local hazard context. Confirm the year and basin before comparing storms.";
const url = `${site.url}/hurricane-tracker/storm/`;
let activeStorms: NhcStorm[] = [];
let activeUpdatedAt = "";
let feedAvailable = false;
try {
  const response = await fetch(new URL("/api/nhc/current.json", Astro.url));
  if (response.ok) {
    const data = await response.json() as { storms?: NhcStorm[]; updatedAt?: string; fetchedAt?: string };
    if (!isStormFeedAvailable(data)) throw new Error("NHC feed malformed or stale");
    activeStorms = data.storms!;
    activeUpdatedAt = data.fetchedAt!;
    feedAvailable = true;
  }
} catch (error) {
  console.error("Named storm index feed failed", { error });
}
const activePages = activeStorms.filter((storm) => storm.name).map((storm) => ({
  slug: String(storm.name).toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, ""),
  name: String(storm.name),
  overview: `${storm.classification ?? "NHC system"} ${storm.name} appears in the verified current feed. Open its official advisory to check the issue time and hazards.`,
  basin: storm.id?.startsWith("cp") ? "Central Pacific" : storm.id?.startsWith("ep") ? "Eastern Pacific" : "Atlantic",
  searchDemandNote: `${storm.classification ?? "NHC system"} ${storm.name} is active. Open the live position, forecast path, radar, and official advisory links.`,
  primaryKeywords: [`${String(storm.name).toLowerCase()} tracker`, `${String(storm.name).toLowerCase()} path`, `${String(storm.name).toLowerCase()} live map`]
}));
const allStormPages = [...activePages, ...stormTrackerPages.filter((known) => !activePages.some((active) => active.slug === known.slug))];
const lastModified = "2026-11-04T00:00:00.000Z";
const faqs = [
  {
    question: "What is a named hurricane tracker page?",
    answer:
      "A named hurricane tracker page is a standing page for a specific storm name. It helps users find current-feed status, official advisory links, radar shortcuts, and related decision tools without assuming the storm is active."
  },
  {
    question: "Does a storm-name page mean that hurricane is active right now?",
    answer:
      "No. HurricaneHub checks the current NHC feed on each storm-name page and clearly separates active storm status from historical or preparedness search context."
  },
  {
    question: "Why create pages for storm names before or after a storm?",
    answer:
      "A dated storm record remains useful after advisories end. Confirm the year and basin identifier; a retained observation is not a current position or a complete post-season report."
  },
  {
    question: "Where should I go for official named-storm advisories?",
    answer:
      "Use National Hurricane Center advisories for official tropical cyclone forecasts, watches, warnings, and discussion. HurricaneHub organizes those links but is not an official advisory source."
  },
  {
    question: "How do named storm pages connect with local hurricane risk?",
    answer:
      "After checking the named storm, use city and state tracker pages to compare local NWS alerts, surge exposure, flooding risk, and household decision tools for your area."
  }
];
const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title, description, url, dateModified: lastModified }),
  faqSchema(faqs),
  itemListSchema(allStormPages.map((storm) => ({
    name: `${storm.name} Storm Record`,
    description: storm.overview,
    url: `${site.url}/hurricane-tracker/storm/${storm.slug}/`
  })))
);
---
<Layout title={title} description={description} canonical={url} jsonLd={jsonLd} lastModified={lastModified}>
  <section class="band" aria-labelledby="storm-index-title">
    <div class="inner">
      <p class="eyebrow">Storm records</p>
      <h1 id="storm-index-title">Named Hurricane Trackers</h1>
      <p class="answer">Choose a storm and confirm its year and basin identifier. Each page separates its current-feed check from dated observations and any sourced historical report.</p>
      <p class="source-note">{feedAvailable ? `Current NHC list checked ${activeUpdatedAt}.` : "Current NHC list unavailable or stale. The standing entries below do not establish current storm activity."}</p>
      <p class="section-actions">
        <a class="action-link" href="/hurricane-tracker/live/">Open live hurricane tracker</a>
        <a class="action-link secondary-action" href="/storm-archive/">Open storm archive</a>
      </p>
    </div>
  </section>

  <section class="band" aria-labelledby="storm-list">
    <div class="inner">
      <h2 id="storm-list">Choose a Storm Name</h2>
      <div class="grid-3 section-grid">
        {allStormPages.map((storm) => (
          <article class="panel">
            <p class="eyebrow">{storm.basin}</p>
            <h3>{storm.name} Storm Record</h3>
            <p>{storm.overview}</p>
            <p><a class="action-link" href={`/hurricane-tracker/storm/${storm.slug}/`}>Open {storm.name}</a></p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="storm-workflow">
    <div class="inner grid-2">
      <article class="panel">
        <p class="eyebrow">Use with live data</p>
        <h2 id="storm-workflow">Check Name, Map, Then Local Alerts</h2>
        <p>Named storm searches move fast during advisory cycles. Start with the storm-name page, confirm whether the current NHC feed lists that name, then use the live tracker, radar, and local NWS alerts for the details that affect real decisions.</p>
      </article>
      <article class="panel">
        <p class="eyebrow">Related tools</p>
        <h2>Plan Around Impact, Not Only the Cone</h2>
        <ul>
          <li><a href="/tools/impact-window-estimator/">Impact window estimator</a></li>
          <li><a href="/tools/storm-distance-calculator/">Storm distance calculator</a></li>
          <li><a href="/tools/storm-surge-checker/">Storm surge checker</a></li>
          <li><a href="/hurricane-tracker/city/">City hurricane trackers</a></li>
        </ul>
      </article>
    </div>
  </section>

  <FaqBlock faqs={faqs} />
</Layout>
