---
import FaqBlock from "../../components/FaqBlock.astro";
import StateAlerts from "../../components/StateAlerts.astro";
import Layout from "../../layouts/Layout.astro";
import { hurricaneCities } from "../../data/cities";
import { site } from "../../data/site";
import { getStateBySlug } from "../../data/states";
import { getTopicPage } from "../../data/topicPages";
import { articleSchema, faqSchema, graph, websiteSchema } from "../../lib/schema";
import type { NhcStorm, NwsAlert } from "../../lib/weather";

type StormFeed = {
  storms?: Array<NhcStorm & { summary?: string }>;
  fetchedAt?: string;
  updatedAt?: string;
};

type AlertFeed = {
  alerts?: NwsAlert[];
  decisionLevel?: string;
  fetchedAt?: string;
  updatedAt?: string;
};

const state = getStateBySlug(Astro.params.state);
const topic = getTopicPage(Astro.params.state ?? "");

if (!state) {
  if (topic) {
    return Astro.redirect(`/hurricane-tracker/${topic.slug}/`);
  }
  return Astro.redirect("/tracker/");
}

async function loadJson<T>(path: string): Promise<T | null> {
  try {
    const response = await fetch(new URL(path, Astro.url));
    if (!response.ok) {
      console.error("HurricaneHub state tracker feed error", { path, status: response.status });
      return null;
    }
    return await response.json() as T;
  } catch (error) {
    console.error("HurricaneHub state tracker feed failed", { path, error });
    return null;
  }
}

const [stormFeed, alertFeed] = await Promise.all([
  loadJson<StormFeed>("/api/nhc/current.json"),
  loadJson<AlertFeed>(`/api/nws/alerts.json?area=${state.code}`)
]);

const storms = stormFeed?.storms ?? [];
const decisionLevel = alertFeed?.decisionLevel ?? (storms.length ? "Prepare" : "Monitor");
const lastModified = alertFeed?.updatedAt ?? stormFeed?.updatedAt ?? site.contentLastModified;
const title = `${state.name} Hurricane Tracker – Live NHC Data & Alerts`;
const description = `Get ${state.name} real-time hurricane tracking with NOAA data, NWS alerts, evacuation info, and live updates for ${state.region}.`;
const url = `${site.url}/tracker/${state.slug}/`;
const stateCities = hurricaneCities.filter((city) => city.stateCode === state.code);
const localActionNotes: Record<string, { headline: string; points: string[]; aside: string }> = {
  florida: {
    headline: "Florida priority actions",
    points: [
      "Check whether your home is in a storm surge, flood, or evacuation zone before the forecast cone changes.",
      "Expect bridge, causeway, and fuel constraints to matter earlier than inland states.",
      "Have a route that avoids low-lying roads and keeps medical or pet needs in the car."
    ],
    aside: "Florida households should treat surge and evacuation timing as separate decisions."
  },
  texas: {
    headline: "Texas priority actions",
    points: [
      "Plan for long-drive evacuations, bay flooding, and the possibility of power outages lasting longer than the wind event.",
      "Make sure fuel, cash, chargers, and a cooler plan are ready before traffic backs up.",
      "If you rely on generators, keep them outside and away from enclosed spaces."
    ],
    aside: "Texas planning should combine coastal surge with inland rainfall and outage risk."
  },
  louisiana: {
    headline: "Louisiana priority actions",
    points: [
      "Monitor levee, surge, and road-closure conditions separately because they can diverge fast.",
      "Start evacuation decisions early if you live in a low-lying parish or mobile home.",
      "Use one folder for documents, prescriptions, and insurance records."
    ],
    aside: "Louisiana households should not wait for peak wind if the route can close first."
  }
};
const localAction = localActionNotes[state.slug] ?? {
  headline: `${state.name} priority actions`,
  points: [
    "Confirm your evacuation zone and shelter option with local emergency management.",
    "Match the current alert level to your household mobility, power dependency, and flood exposure.",
    "Treat the forecast as a moving target and decide earlier than the county deadline if you need extra time."
  ],
  aside: `${state.name} planning should pair NWS alerts with county instructions and route checks.`
};
const stateIntro: Record<string, string> = {
  florida: "Florida sits at the crossroads of the Atlantic and Gulf hurricane basins, with more than 1,300 miles of tidal coastline, barrier islands, and low-lying peninsular terrain that makes it the most frequently struck U.S. state. Storms typically approach from the southeast across the Bahamas and Caribbean, then track west across South Florida or curve north into the Panhandle and Big Bend. Others organize in the Gulf of Mexico and threaten Tampa Bay, the Nature Coast, or the central Gulf coast. Historically, Hurricane Michael (2018) became one of only four Category 5 landfalls on the U.S., devastating the Panhandle, while Hurricane Ian (2022) produced catastrophic storm surge and flooding across southwest Florida. The 2026 Atlantic hurricane season runs June 1 through November 30, and early August falls in the climatological ramp toward the September peak, when sea-surface temperatures are warmest and development risk is highest. Residents should confirm evacuation zones, review flood exposure, and keep a ready-to-go plan before any system forms, because bridge and causeway closures can arrive well ahead of landfall.",
  texas: "Texas guards roughly 367 miles of Gulf of Mexico coastline, from the humid marshes of the upper coast near Port Arthur to the dry brush country around Brownsville. Most Texas hurricanes form in the western Gulf or recurve out of the Bay of Campeche, then drive north or northeast toward the middle and upper coast around Galveston, Matagorda, and Corpus Christi. The state's long shelf and shallow bays amplify storm surge, while slow-moving systems can dump feet of rain far inland around Houston. Historically, Hurricane Harvey (2017) stalled over South Texas and produced catastrophic flooding that became the wettest tropical cyclone in U.S. history. The 2026 Atlantic hurricane season runs June 1 through November 30, and early August sits in the climatological ramp toward the September peak, when Gulf sea-surface temperatures are warmest. Because Texas evacuations can mean 100-plus-mile drives inland and sustained power outages, residents should prepare generators safely, stock water and fuel, and know their county evacuation zone before a storm threatens.",
  louisiana: "Louisiana's Gulf coastline stretches nearly 400 miles, but its true exposure is measured in thousands of miles of bayous, estuaries, and low-lying parishes that sit at or below sea level behind a fragile levee system. Storms typically organize in the central or eastern Gulf and track northwest, threatening New Orleans, the River Parishes, and the Cajun coast around Lafourche and Terrebonne. Shallow warm water lets systems rapidly intensify just hours before landfall. Historically, Hurricane Katrina (2005) breached levees and flooded New Orleans, while Hurricane Rita struck only weeks later, together reshaping state evacuation policy. The 2026 Atlantic hurricane season runs June 1 through November 30, and early August is already inside the most active window, when Gulf heat content peaks. Because many Louisiana routes flood before peak wind, officials urge residents of low-lying parishes and mobile homes to decide early and keep documents, medications, and evacuation plans staged.",
  "north-carolina": "North Carolina's coastline runs about 300 miles from the Virginia line to the South Carolina border, but its hurricane identity is defined by Cape Hatteras and the Outer Banks, a string of narrow barrier islands in the Atlantic's busy recurvature lane. Storms riding the Gulf Stream often curve ashore here, slamming the islands before pushing into the sounds and inland rivers. The state's unique geography means wind damage on the coast and catastrophic river flooding hundreds of miles inland. Historically, Hurricane Florence (2018) stalled near the coast and unleashed historic rainfall that flooded communities from Wilmington to the Piedmont. The 2026 Atlantic hurricane season runs June 1 through November 30, and early August is within the active period, so Outer Banks and coastal residents should watch tropical outlooks and plan ferry and bridge timing, because island access closes well before the worst conditions arrive.",
  "south-carolina": "South Carolina's Atlantic coast spans roughly 185 miles, anchored by the Lowcountry around Charleston and the Grand Strand near Myrtle Beach. Hurricanes typically approach from the southeast or track up the Southeast seaboard, then curve into the coast where wide tidal estuaries and salt marshes magnify storm surge. The Lowcountry's bridges and causeways become vulnerable as winds rise, and heavy rain compounds coastal flooding. Historically, Hurricane Hugo (1989) made a devastating Category 4 landfall near Charleston, leveling timber and producing a memorable surge that remains the benchmark for the state. The 2026 Atlantic hurricane season runs June 1 through November 30, and early August is inside the active window, so coastal households should confirm their evacuation zone and plan to leave before the reversal of I-26 and other routes jams with traffic.",
  georgia: "Georgia's Atlantic coastline is short—about 100 miles—but densely developed from the Savannah metro down to Brunswick and the Golden Isles. Hurricanes usually reach Georgia after tracking up the Southeast seaboard or crossing Florida, often arriving as hurricanes or strong tropical storms with high rain rates and tornadoes. The coastal plain's rivers and tidal creeks flood readily, and tree damage from wind is a major power-outage driver. Historically, Hurricane Michael (2018) crossed into Georgia as a hurricane and inflicted historic wind damage across southwest Georgia's forests, the most damaging tropical cyclone in recent state memory. The 2026 Atlantic hurricane season runs June 1 through November 30, and early August is within the active period, so the coast from Savannah to St. Simons should stay alert, pair NWS alerts with county instructions, and keep an evacuation route ready.",
  alabama: "Alabama's coastline is the second-shortest among Gulf states at about 53 miles, centered on Mobile Bay and the white-sand communities of Baldwin County. Yet that compact shore sits where easterly Gulf storms often slow and pivot, and Mobile Bay's funnel shape can concentrate storm surge. Inland river systems then carry flooding far beyond the beach. Historically, Hurricane Sally (2020) crawled along the Alabama coast and produced extreme rainfall and flooding around Mobile and Gulf Shores, one of the most damaging recent storms for the state. The 2026 Atlantic hurricane season runs June 1 through November 30, and early August is inside the active window, so Mobile Bay residents—especially those in mobile homes—should stage plans early, because surge and flooding can cut coastal routes before peak wind arrives.",
  mississippi: "Mississippi's Gulf coast is the shortest of the hurricane-prone states at roughly 44 miles, yet it has absorbed some of the most violent landfalls in U.S. history. Storms typically approach from the southeast across warm Gulf water that fuels rapid intensification, then drive into Hancock, Harrison, and Jackson counties. The low, flat coast and the Bay of St. Louis make surge the dominant threat. Historically, Hurricane Camille (1969) came ashore as a catastrophic Category 5, among the strongest storms ever recorded, and Hurricane Katrina (2005) then devastated the coast and flooded coastal communities. The 2026 Atlantic hurricane season runs June 1 through November 30, and early August is already within the active period, when Gulf warmth peaks. Because much of the coast is low-lying, officials urge early evacuation for mobile-home residents and medically dependent households before routes close.",
  virginia: "Virginia's hurricane exposure centers on the Chesapeake Bay and the Hampton Roads region, with about 110 miles of tidal shoreline and a coastline that opens to the Atlantic. Systems usually reach Virginia after recurving up the Mid-Atlantic coast, arriving as hurricanes or strong tropical storms that drive tidal flooding through the bay, spawn tornadoes, and topple trees onto power lines. Bridge-tunnels become critical constraints during evacuations. Historically, Hurricane Isabel (2003) struck as a major hurricane and caused widespread wind damage, tidal flooding, and long outages across the Chesapeake region, the most damaging storm in recent Virginia memory. The 2026 Atlantic hurricane season runs June 1 through November 30, and early August is within the active window, so bay communities should monitor tropical threats and plan for tidal and river flooding, not just wind."
};
const adjacentStates: Record<string, string[]> = {
  florida: ["georgia", "alabama"],
  texas: ["louisiana"],
  louisiana: ["texas", "mississippi"],
  "north-carolina": ["south-carolina", "virginia"],
  "south-carolina": ["north-carolina", "georgia"],
  georgia: ["florida", "south-carolina"],
  alabama: ["florida", "mississippi"],
  mississippi: ["louisiana", "alabama"],
  virginia: ["north-carolina"]
};
const stateFaqs: Record<string, { season: string; worst: string; evac: string }> = {
  florida: {
    season: "The Atlantic hurricane season runs June 1 through November 30. Florida faces elevated risk from August through October, with the climatological peak around September 10. Early August is already inside the active window, so residents should keep supplies current and know their evacuation zone year-round.",
    worst: "Hurricane Michael (2018) was a catastrophic Category 5 landfall on the Florida Panhandle, among the strongest U.S. landfalls on record. Hurricane Ian (2022) caused deadly storm surge and historic flooding across southwest Florida, making it one of the costliest storms in state history.",
    evac: "Yes. Florida uses labeled evacuation zones (A, B, C and beyond) set by county emergency management, not ZIP code. Coastal and barrier-island residents should learn their zone, identify Contraflow routes, and plan to leave before bridges and causeways close."
  },
  texas: {
    season: "The Atlantic hurricane season runs June 1 to November 30, with Texas most active from August through September as Gulf waters peak in warmth. Early August is within the ramp to peak season, so Gulf Coast households should keep an evacuation and power-outage plan ready.",
    worst: "Hurricane Harvey (2017) stalled over South Texas and dropped more than 60 inches of rain near Houston, causing catastrophic flooding. It remains the wettest tropical cyclone in U.S. recorded history and one of the costliest disasters nationwide.",
    evac: "Yes. Texas coastal counties publish evacuation zones and use lane reversals (Contraflow) on major highways like I-45 and I-37. Residents should know their county zone, plan for long drives inland, and leave early because traffic and fuel shortages develop quickly."
  },
  louisiana: {
    season: "Louisiana's hurricane season follows the June 1–November 30 window, with the highest threat from August through September as Gulf heat content peaks. Early August is already inside the most active period, so low-lying parishes should pre-stage plans and documents.",
    worst: "Hurricane Katrina (2005) devastated southeast Louisiana, breaching levees and flooding New Orleans. Hurricane Rita struck weeks later. Together they remain the deadliest and costliest Gulf disasters for the state, reshaping evacuation and levee policy.",
    evac: "Yes. Louisiana designates coastal evacuation zones by parish and uses Contraflow on I-10, I-49, and I-59. Because many routes flood early, officials urge residents in low-lying parishes and mobile homes to decide before the storm strengthens."
  },
  "north-carolina": {
    season: "The Atlantic season runs June 1–November 30, and North Carolina peaks from August through September as Cape Hatteras sits in a frequent recurvature lane. Early August is inside the active window, so Outer Banks and coastal residents should watch tropical outlooks closely.",
    worst: "Hurricane Florence (2018) stalled near the coast and dumped historic rainfall across the Carolinas, causing catastrophic river flooding far inland. It was among the wettest and most destructive storms to hit North Carolina.",
    evac: "Yes. North Carolina uses lettered evacuation zones for coastal counties and reverses lanes on routes such as US-64 and NC-12 for the Outer Banks. Island residents must plan ferry and bridge timing because access closes before the worst wind arrives."
  },
  "south-carolina": {
    season: "South Carolina's season follows June 1–November 30, with the greatest danger from August through September as systems approach the Southeast coast. Early August is within the active period, so Lowcountry households should confirm zones before storms form.",
    worst: "Hurricane Hugo (1989) made landfall near Charleston as a major Category 4 storm, causing widespread wind damage and a devastating surge. It remains one of the most powerful hurricanes to strike the South Carolina coast.",
    evac: "Yes. South Carolina designates coastal evacuation zones by county and uses lane reversals on I-26 (the Charleston reversal) and other routes. Residents should learn their zone and leave early, since Lowcountry bridges and causeways close as winds rise."
  },
  georgia: {
    season: "Georgia's season runs June 1–November 30, with coastal risk highest from August through September as storms track up the Southeast seaboard. Early August is within the active window, so the coast from Brunswick to Savannah should stay alert.",
    worst: "Hurricane Michael (2018) crossed into Georgia as a hurricane and produced historic wind damage in southwest Georgia, including widespread timber losses. It was the most damaging tropical cyclone to hit the state in modern memory.",
    evac: "Yes. Georgia's coastal counties (Chatham, Glynn, Camden and neighbors) use evacuation zones and Contraflow on I-16 toward Macon. Residents should pair NWS alerts with county instructions and leave before coastal and river flooding peak."
  },
  alabama: {
    season: "Alabama's season runs June 1–November 30, with the greatest threat from August through September as Gulf storms approach from the south and southeast. Early August is inside the active period, so Mobile Bay communities should stay prepared.",
    worst: "Hurricane Sally (2020) stalled along the Alabama coast and produced extreme rainfall and flooding around Mobile and Baldwin counties, with a slow, destructive crawl. It was among the most damaging recent storms for the state.",
    evac: "Yes. Alabama's coastal counties use evacuation zones and coordinate Contraflow on I-10 and I-65. Mobile Bay residents, including those in mobile homes, should decide early because surge and flooding can cut routes before peak wind."
  },
  mississippi: {
    season: "Mississippi's season follows June 1–November 30, peaking from August through September as warm Gulf waters fuel rapid intensification. Early August is within the active window, so the Gulf Coast should keep plans current.",
    worst: "Hurricane Camille (1969) was a catastrophic Category 5 landfall on the Mississippi coast, among the strongest ever recorded in the U.S. Hurricane Katrina (2005) then devastated the coast and flooded coastal communities days apart decades later.",
    evac: "Yes. Mississippi's coastal counties use evacuation zones and Contraflow on I-10 and U.S. 49. Because much of the coast is low-lying, officials urge early departure for mobile-home residents and medically dependent households."
  },
  virginia: {
    season: "Virginia's season runs June 1–November 30, with risk highest from August through October as systems recurve up the Mid-Atlantic coast. Early August is within the active period, so Chesapeake Bay communities should monitor tropical threats.",
    worst: "Hurricane Isabel (2003) struck the Virginia coast as a major hurricane, causing widespread wind damage, tidal flooding, and prolonged power outages across the Chesapeake Bay region. It remains the most damaging hurricane in recent Virginia memory.",
    evac: "Yes. Virginia's coastal and Chesapeake communities use evacuation zones set by locality, with bridge-tunnel constraints on routes like the Hampton Roads crossings. Residents should follow local orders and plan for tidal and river flooding, not just wind."
  }
};
const f = stateFaqs[state.slug];
const pageFaqs = [
  {
    question: `When is hurricane season in ${state.name}?`,
    answer: f.season
  },
  {
    question: `What was the worst hurricane to hit ${state.name}?`,
    answer: f.worst
  },
  {
    question: `Does ${state.name} have hurricane evacuation routes?`,
    answer: f.evac
  }
];
const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title, description, url, dateModified: lastModified }),
  faqSchema(pageFaqs)
);
---
<Layout title={title} description={description} canonical={url} jsonLd={jsonLd} lastModified={lastModified}>
  <section class="band" aria-labelledby="state-tracker-title">
    <div class="inner">
      <p class="eyebrow">{state.region} decision support</p>
      <h1 id="state-tracker-title">{state.name} Hurricane Tracker – Live Updates</h1>
      <p class="answer">This page shows {state.name} hurricane risk using live NHC storm context, active NWS alerts, and a household decision level so residents can monitor, prepare, act, or leave using official warnings.</p>
    </div>
  </section>

  <section class="band" aria-labelledby="state-intro">
    <div class="inner">
      <h2 id="state-intro">About {state.name} Hurricane Risk</h2>
      <p class="answer">{stateIntro[state.slug]}</p>
    </div>
  </section>

  <section class="band" aria-labelledby="current-situation">
    <div class="inner grid-2">
      <article class="panel">
        <h2 id="current-situation">Current Situation</h2>
        <div class="metric" style="margin-top: 16px;">
          <strong>{decisionLevel}</strong>
          <span>{state.name} decision level from NWS alerts and active NHC storm context</span>
        </div>
        <p class="source-note">Last checked: {new Date(lastModified).toLocaleString("en-US", { timeZone: "UTC" })} UTC</p>
      </article>
      <article class="panel">
        <h2>Key {state.name} Risks</h2>
        <ul class="check-list">
          {state.risks.map((risk) => <li>{risk}</li>)}
        </ul>
        <p>{state.preparednessNote}</p>
      </article>
    </div>
  </section>

  <section class="band" aria-labelledby="local-actions">
    <div class="inner grid-2">
      <article class="panel">
        <h2 id="local-actions">{localAction.headline}</h2>
        <ul class="check-list">
          {localAction.points.map((point) => <li>{point}</li>)}
        </ul>
      </article>
      <article class="panel">
        <h2>Why it matters</h2>
        <p>{localAction.aside}</p>
        <p>Use this page together with the official state and county emergency management site. HurricaneHub is strongest when the alert feed, the storm context, and the route decision all agree.</p>
        <p><a class="action-link" href={`/tools/local-risk-plan/?state=${state.code}`}>Build a {state.name} action plan</a></p>
      </article>
    </div>
  </section>

  <section class="band" aria-labelledby="alerts-heading">
    <div class="inner">
      <h2 id="alerts-heading">Active {state.name} NWS Alerts</h2>
      <p class="source-note">Times are displayed in UTC. Read each official instruction and verify your county or evacuation zone before acting.</p>
      <StateAlerts state={state.code} />
    </div>
  </section>

  <section class="band" aria-labelledby="storm-heading">
    <div class="inner grid-2">
      <article>
        <h2 id="storm-heading">NHC Storm Context</h2>
        <div class="stack" style="margin-top: 18px;">
          {storms.length ? storms.slice(0, 4).map((storm) => (
            <article class="storm-row">
              <header>
                <h3>{storm.name ?? storm.id ?? "Active tropical system"}</h3>
                <span class="badge warn">{storm.classification ?? "NHC"}</span>
              </header>
              <p>{storm.summary ?? "NHC advisory data loaded for this system."}</p>
              <p class="small">Updated: {storm.lastUpdate ?? stormFeed?.fetchedAt ?? "pending"}</p>
              <a href={`/tracker/${encodeURIComponent(storm.id ?? storm.name ?? "storm")}/`}>View storm detail and compare your ZIP</a>
            </article>
          )) : (
            <article class="panel">
              <h3>No Active NHC Storms</h3>
              <p>No active NHC tropical cyclone is listed right now. Keep monitoring tropical outlooks during hurricane season because risk windows can change quickly.</p>
            </article>
          )}
        </div>
      </article>
      <article class="panel">
        <h2>County Planning Focus</h2>
        <p>Start with these high-exposure counties and then confirm your exact evacuation zone, flood zone, and shelter options locally.</p>
        <ul class="check-list">
          {state.counties.map((county) => <li>{county} County</li>)}
        </ul>
      </article>
    </div>
  </section>

  {stateCities.length > 0 && (
    <section class="band" aria-labelledby="city-trackers">
      <div class="inner">
        <p class="eyebrow">Local city guides</p>
        <h2 id="city-trackers">{state.name} City Hurricane Trackers</h2>
        <p class="answer">Use these local pages for city-specific surge, flooding, route, outage, and evacuation-planning notes tied back to the {state.name} tracker.</p>
        <div class="grid-3 section-grid">
          {stateCities.map((city) => (
            <article class="panel">
              <h3>{city.name} Hurricane Tracker</h3>
              <p>{city.planningNote}</p>
              <div class="risk-tags">
                {city.risks.slice(0, 3).map((risk) => <span class="risk-tag">{risk}</span>)}
              </div>
              <a href={`/hurricane-tracker/city/${city.slug}/`}>Open {city.name}</a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="band" aria-labelledby="decision-table">
    <div class="inner">
      <h2 id="decision-table">Household Decision Guide</h2>
      <table style="margin-top: 18px;">
        <thead><tr><th>Level</th><th>What it means</th><th>Action</th></tr></thead>
        <tbody>
          <tr><td>Monitor</td><td>No active local warning returned.</td><td>Check official advisories twice daily during hurricane season.</td></tr>
          <tr><td>Prepare</td><td>Storm context or watch-level hazards are present.</td><td>Finish supplies, documents, fuel, pet plans, and evacuation routes.</td></tr>
          <tr><td>Act</td><td>Warning-level wind, flood, surge, or tornado hazards are possible.</td><td>Move vulnerable people early and follow county emergency instructions.</td></tr>
          <tr><td>Leave</td><td>Evacuation, extreme wind, or life-threatening hazard language is present.</td><td>Follow official evacuation orders immediately if you can do so safely.</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="band" aria-labelledby="nearby-states">
    <div class="inner">
      <h2 id="nearby-states">Nearby State Hurricane Trackers</h2>
      <p class="source-note">Explore surrounding states for regional storm context and cross-state evacuation planning.</p>
      <ul class="check-list">
        {adjacentStates[state.slug].map((slug) => {
          const neighbor = getStateBySlug(slug);
          return neighbor ? <li><a href={`/tracker/${neighbor.slug}/`}>{neighbor.name} Hurricane Tracker</a></li> : null;
        })}
      </ul>
    </div>
  </section>

  <FaqBlock faqs={pageFaqs} />
</Layout>
