---
import FaqBlock from "../../components/FaqBlock.astro";
import Layout from "../../layouts/Layout.astro";
import ContentFigure from "../../components/ContentFigure.astro";
import { faqs, site } from "../../data/site";
import { getTopicPage, topicPages } from "../../data/topicPages";
import { articleSchema, breadcrumbSchema, faqSchema, graph, howToSchema, itemListSchema, websiteSchema } from "../../lib/schema";
import { getAtlanticOutlook } from "../../lib/nhcOutlook";
import { getNhcCurrentFeed } from "../../lib/nhcCurrent";

export const prerender = true;

export function getStaticPaths() {
  return topicPages.map((page) => ({ params: { topic: page.slug } }));
}

const page = getTopicPage(Astro.params.topic ?? "");
if (!page) {
  return Astro.redirect("/hurricane-tracker/live/");
}

const url = `${site.url}/hurricane-tracker/${page.slug}/`;
const lastModified = site.contentLastModified;
const gulfStatus = page.slug === "gulf" ? await getNhcCurrentFeed() : null;
const gulfStorms = gulfStatus?.feed.storms.filter((storm) => {
  const longitude = storm.longitudeNumeric;
  const latitude = storm.latitudeNumeric;
  return /^AL/i.test(storm.id ?? "") && typeof longitude === "number" && typeof latitude === "number" && longitude >= -98 && longitude <= -80 && latitude >= 18 && latitude <= 31;
}) ?? [];
const atlanticOutlook = page.slug === "gulf" ? await getAtlanticOutlook() : null;
const pageFaqs = [...page.faqs, ...faqs];
const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title: page.title, description: page.description, url, dateModified: lastModified }),
  howToSchema({
    name: `How to use ${page.title.toLowerCase()}`,
    description: page.description,
    url,
    steps: page.steps.map((step) => ({ name: step.title, text: step.body }))
  }),
  itemListSchema(page.nextLinks.map((link) => ({
    name: link.name,
    description: link.description,
    url: `${site.url}${link.href}`
  }))),
  faqSchema(pageFaqs),
  breadcrumbSchema([
    { name: "Home", url: site.canonicalUrl },
    { name: "Hurricane Tracker", url: `${site.url}/hurricane-tracker/live/` },
    { name: page.shortTitle, url }
  ])
);
---
<Layout title={page.title} description={page.description} canonical={url} jsonLd={jsonLd} lastModified={lastModified}>
  <section class="band" aria-labelledby="topic-title">
    <div class="inner">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1 id="topic-title">{page.title}</h1>
      <p class="answer">{page.intro}</p>
      <p class="section-actions">
        <a class="action-link" href={page.primaryAction.href}>{page.primaryAction.label}</a>
        <a class="action-link secondary-action" href={page.secondaryAction.href}>{page.secondaryAction.label}</a>
      </p>
    </div>
  </section>

  {page.slug === "gulf" && <section class="band" aria-labelledby="gulf-status-heading" data-gulf-status><div class="inner"><p class="eyebrow">Current NHC Gulf check</p><h2 id="gulf-status-heading" data-gulf-heading>{gulfStorms.length ? `${gulfStorms.length} Active Gulf Tropical System${gulfStorms.length === 1 ? "" : "s"}` : "No Active Gulf Tropical Cyclone"}</h2><p class="answer" data-gulf-answer>{gulfStorms.length ? `The latest NHC feed lists ${gulfStorms.map((storm) => storm.name ?? storm.id ?? "an unnamed system").join(", ")} in the Gulf region. Open the live tracker and official advisory for current position, forecast, and warnings.` : "The latest NHC feed does not list an active tropical cyclone in the Gulf region. A disturbance can still be monitored before it becomes a depression or named storm."}</p>{atlanticOutlook && <><p class="eyebrow">NHC Atlantic outlook · {atlanticOutlook.issued}</p><p>{atlanticOutlook.text}</p></>}<p class="section-actions"><a class="action-link" href="/hurricane-tracker/tropical-disturbances/">Open current disturbance outlook</a><a class="action-link secondary-action" href="/tracker/texas/">Texas hurricane tracker</a><a class="action-link secondary-action" href="/tracker/louisiana/">Louisiana hurricane tracker</a></p><p class="source-note" data-gulf-updated>A formation probability is not a forecast track, warning area, or landfall prediction. Verify the issue time with the official NHC outlook.</p></div></section>}

  {page.slug === "hurricane-categories" && <section class="band" aria-labelledby="category-visual"><div class="inner"><h2 id="category-visual">Hurricane Category Wind Thresholds</h2><ContentFigure src="/images/guides/hurricane-category-wind-scale.svg" alt="Saffir-Simpson hurricane wind scale showing Category 1 through 5 wind speed thresholds in miles per hour" caption="The Saffir-Simpson scale measures maximum sustained wind only. It does not measure storm surge, rainfall flooding, tornadoes, storm size, or duration." /></div></section>}
  {page.slug === "map" && <section class="band" aria-labelledby="map-visual"><div class="inner"><h2 id="map-visual">The Forecast Cone Is Not an Impact Boundary</h2><ContentFigure src="/images/guides/forecast-cone-impact-boundary.svg" alt="Diagram showing an NHC forecast cone for probable storm-center positions with hazards extending outside it" caption="Use the cone for storm-center uncertainty, then check NHC hazard products, NWS alerts, and local evacuation guidance for impacts." /></div></section>}
  {page.slug === "storm-surge-map" && <section class="band" aria-labelledby="surge-visual"><div class="inner"><h2 id="surge-visual">Use Each Hurricane Map for the Right Question</h2><ContentFigure src="/images/guides/storm-hazard-map-differences.svg" alt="Comparison of hurricane forecast track, storm surge, rainfall and flood maps, and local weather alerts" caption="Forecast tracks, surge maps, rainfall forecasts, and local alerts describe different hazards. Check the latest official products together before acting." /></div></section>}

  <section class="band" aria-labelledby="topic-workflow">
    <div class="inner">
      <p class="eyebrow">{page.intent}</p>
      <h2 id="topic-workflow">Start Here, Then Move Toward a Local Decision</h2>
      <div class="grid-3 section-grid">
        {page.steps.map((step, index) => (
          <article class="panel">
            <p class="eyebrow">Step {index + 1}</p>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
            <p><a class="action-link" href={step.href}>{step.label}</a></p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="topic-context">
    <div class="inner grid-2">
      {page.sections.map((section, index) => (
        <article class="panel">
          <p class="eyebrow">{section.eyebrow}</p>
          <h2 id={index === 0 ? "topic-context" : undefined}>{section.title}</h2>
          <p>{section.body}</p>
          <ul class="check-list">
            {section.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="band" aria-labelledby="topic-next">
    <div class="inner">
      <p class="eyebrow">Related hurricane resources</p>
      <h2 id="topic-next">Open the Next Best Page</h2>
      <div class="link-list">
        {page.nextLinks.map((link) => (
          <article class="link-row">
            <h3><a href={link.href}>{link.name}</a></h3>
            <p>{link.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="topic-official">
    <div class="inner grid-2">
      <article class="panel">
        <p class="eyebrow">Official-source check</p>
        <h2 id="topic-official">Verify Before You Act</h2>
        <p>HurricaneHub is a planning and interpretation layer. During an active threat, confirm storm advisories, watches, warnings, evacuation orders, shelters, and road restrictions with official sources.</p>
        <ul class="check-list">
          <li><a href="https://www.nhc.noaa.gov/" rel="noopener nofollow">National Hurricane Center</a></li>
          <li><a href="https://www.weather.gov/" rel="noopener nofollow">National Weather Service</a></li>
          <li><a href="/alerts/">Active NWS alerts on HurricaneHub</a></li>
        </ul>
      </article>
      <article class="panel">
        <p class="eyebrow">Local planning</p>
        <h2>Bring the Search Back to Your Location</h2>
        <p>After reading this hub, the most useful next page is usually a city tracker, state tracker, alert page, or household tool that matches the place you care about.</p>
        <ul class="check-list">
          <li><a href="/hurricane-tracker/city/">Browse city hurricane trackers</a></li>
          <li><a href="/tracker/">Browse state hurricane trackers</a></li>
          <li><a href="/tools/local-risk-plan/">Build a local risk plan</a></li>
        </ul>
      </article>
    </div>
  </section>

  <FaqBlock faqs={pageFaqs} />
</Layout>

{page.slug === "gulf" && <script>
  const heading = document.querySelector("[data-gulf-heading]");
  const answer = document.querySelector("[data-gulf-answer]");
  const updated = document.querySelector("[data-gulf-updated]");
  fetch("/api/nhc/current.json", { cache: "no-store" }).then((response) => response.ok ? response.json() : null).then((feed) => {
    if (!feed) return;
    const storms = (Array.isArray(feed.storms) ? feed.storms : []).filter((storm) => /^AL/i.test(String(storm.id ?? "")) && Number(storm.longitudeNumeric) >= -98 && Number(storm.longitudeNumeric) <= -80 && Number(storm.latitudeNumeric) >= 18 && Number(storm.latitudeNumeric) <= 31);
    if (heading) heading.textContent = storms.length ? `${storms.length} Active Gulf Tropical System${storms.length === 1 ? "" : "s"}` : "No Active Gulf Tropical Cyclone";
    if (answer) answer.textContent = storms.length ? `The latest NHC feed lists ${storms.map((storm) => storm.name ?? storm.id ?? "an unnamed system").join(", ")} in the Gulf region. Open the live tracker and official advisory for current position, forecast, and warnings.` : "The latest NHC feed does not list an active tropical cyclone in the Gulf region. A disturbance can still be monitored before it becomes a depression or named storm.";
    if (updated) updated.textContent = `Current-storm feed checked ${new Date(feed.updatedAt ?? feed.fetchedAt ?? Date.now()).toLocaleString("en-US", { timeZone: "UTC" })} UTC. A formation probability is not a forecast track, warning area, or landfall prediction.`;
  }).catch(() => {});
</script>}
