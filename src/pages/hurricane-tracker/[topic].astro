---
import FaqBlock from "../../components/FaqBlock.astro";
import Layout from "../../layouts/Layout.astro";
import ContentFigure from "../../components/ContentFigure.astro";
import { faqs, site } from "../../data/site";
import { getTopicPage, topicPages } from "../../data/topicPages";
import { articleSchema, breadcrumbSchema, faqSchema, graph, howToSchema, itemListSchema, websiteSchema } from "../../lib/schema";
import { getAtlanticOutlook } from "../../lib/nhcOutlook";
import { getNhcCurrentFeed } from "../../lib/nhcCurrent";

export const prerender = true;

export function getStaticPaths() {
  return topicPages.map((page) => ({ params: { topic: page.slug } }));
}

const page = getTopicPage(Astro.params.topic ?? "");
if (!page) {
  return Astro.redirect("/hurricane-tracker/live/");
}

const url = `${site.url}/hurricane-tracker/${page.slug}/`;
const lastModified = site.contentLastModified;
const gulfStatus = page.slug === "gulf" ? await getNhcCurrentFeed() : null;
const gulfStorms = gulfStatus?.feed.storms.filter((storm) => {
  const longitude = storm.longitudeNumeric;
  const latitude = storm.latitudeNumeric;
  return /^AL/i.test(storm.id ?? "") && typeof longitude === "number" && typeof latitude === "number" && longitude >= -98 && longitude <= -80 && latitude >= 18 && latitude <= 31;
}) ?? [];
const atlanticOutlook = page.slug === "gulf" ? await getAtlanticOutlook() : null;
const gulfOutlookClient = {
  issued: atlanticOutlook?.issued ?? "",
  issuedAt: atlanticOutlook?.issuedAt ?? "",
  chance48h: atlanticOutlook?.formationChance48h ?? null,
  chance7d: atlanticOutlook?.formationChance7d ?? null
};
const pageFaqs = [...page.faqs, ...faqs];
const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title: page.title, description: page.description, url, dateModified: lastModified }),
  howToSchema({
    name: `How to use ${page.title.toLowerCase()}`,
    description: page.description,
    url,
    steps: page.steps.map((step) => ({ name: step.title, text: step.body }))
  }),
  itemListSchema(page.nextLinks.map((link) => ({
    name: link.name,
    description: link.description,
    url: `${site.url}${link.href}`
  }))),
  faqSchema(pageFaqs),
  breadcrumbSchema([
    { name: "Home", url: site.canonicalUrl },
    { name: "Hurricane Tracker", url: `${site.url}/hurricane-tracker/live/` },
    { name: page.shortTitle, url }
  ])
);
---
<Layout title={page.title} description={page.description} canonical={url} jsonLd={jsonLd} lastModified={lastModified}>
  <section class="band" aria-labelledby="topic-title">
    <div class="inner">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1 id="topic-title">{page.title}</h1>
      <p class="answer">{page.intro}</p>
      <p class="section-actions">
        <a class="action-link" href={page.primaryAction.href}>{page.primaryAction.label}</a>
        <a class="action-link secondary-action" href={page.secondaryAction.href}>{page.secondaryAction.label}</a>
      </p>
    </div>
  </section>

  {page.slug === "gulf" && <section class="band" aria-labelledby="gulf-status-heading" data-gulf-status><div class="inner"><p class="eyebrow">Current NHC Gulf check</p><h2 id="gulf-status-heading" data-gulf-heading>{gulfStorms.length ? `${gulfStorms.length} Active Gulf Tropical System${gulfStorms.length === 1 ? "" : "s"}` : "No Active Gulf Tropical Cyclone"}</h2><p class="answer" data-gulf-answer>{gulfStorms.length ? `The latest NHC feed lists ${gulfStorms.map((storm) => storm.name ?? storm.id ?? "an unnamed system").join(", ")} in the Gulf region. Open the live tracker and official advisory for current position, forecast, and warnings.` : "The latest NHC feed does not list an active tropical cyclone in the Gulf region. A disturbance can still be monitored before it becomes a depression or named storm."}</p>{atlanticOutlook && <><p class="eyebrow" data-outlook-issued>NHC Atlantic outlook · {atlanticOutlook.issued}</p><p data-outlook-text>{atlanticOutlook.text}</p></>}<p class="section-actions"><a class="action-link" href="/hurricane-tracker/tropical-disturbances/">Open current disturbance outlook</a><a class="action-link secondary-action" href="/tracker/texas/">Texas hurricane tracker</a><a class="action-link secondary-action" href="/tracker/louisiana/">Louisiana hurricane tracker</a></p><p class="source-note" data-gulf-updated>A formation probability is not a forecast track, warning area, or landfall prediction. Verify the issue time with the official NHC outlook.</p></div></section>}

  {page.slug === "gulf" && <section class="band" aria-labelledby="gulf-probability-heading"><div class="inner"><p class="eyebrow">Formation probability explained</p><h2 id="gulf-probability-heading">What the Gulf Development Percentage Means</h2><p class="answer">The NHC percentage estimates the chance that a tropical cyclone will form somewhere inside the highlighted area during the stated time window. It does not estimate landfall, hurricane strength, or the chance that one city will be affected.</p><div class="grid-2 section-grid probability-grid"><article class="panel"><span class="probability-value" data-chance-48>{atlanticOutlook?.formationChance48h ?? "—"}{atlanticOutlook?.formationChance48h != null && "%"}</span><h3>Formation within 48 hours</h3><p>Near-term organization potential inside the NHC outlook area. This can rise or fall as the circulation, thunderstorms, wind shear, and surface observations change.</p></article><article class="panel"><span class="probability-value" data-chance-7>{atlanticOutlook?.formationChance7d ?? "—"}{atlanticOutlook?.formationChance7d != null && "%"}</span><h3>Formation within 7 days</h3><p>A longer window for a depression or named storm to form. It still does not identify a future track, landfall point, category, or local hazard.</p></article></div><div class="grid-2 section-grid"><article class="panel"><h3>Four probabilities people often confuse</h3><ul class="check-list"><li><strong>Formation:</strong> will a tropical cyclone form in the outlook area?</li><li><strong>Track:</strong> where could an established cyclone move?</li><li><strong>Landfall:</strong> where might its center cross the coast?</li><li><strong>Local impact:</strong> could a location receive surge, rain, wind, tornadoes, or outages?</li></ul></article><article class="panel"><h3>Why the number can change</h3><ul class="check-list"><li>Whether a closed circulation is becoming better organized</li><li>Thunderstorm persistence near the developing center</li><li>Vertical wind shear, dry air, and interaction with a front</li><li>How long the disturbance remains over supportive water</li></ul></article></div><p class="source-note">Only NHC assigns the official formation probability. Model runs and social posts can discuss possibilities but do not replace the outlook.</p></div></section>}

  {page.slug === "gulf" && <section class="band" aria-labelledby="outlook-history-heading"><div class="inner grid-2"><article class="panel"><p class="eyebrow">Outlook change log</p><h2 id="outlook-history-heading">What Changed Since Your Last Visit</h2><div data-outlook-history><p>Open this page again after a new NHC outlook to compare the official 48-hour and 7-day percentages on this device.</p></div><p class="source-note">This device-only history is a convenience, not an official advisory archive.</p></article><article class="panel"><p class="eyebrow">Social screenshot check</p><h2>Is That Hurricane Screenshot Still Current?</h2><form data-screenshot-check><label for="screenshot-time">Time shown on the screenshot or post</label><input id="screenshot-time" name="screenshotTime" type="datetime-local" required /><label for="screenshot-zone">Timezone shown or used</label><select id="screenshot-zone" name="screenshotZone"><option value="local">My device timezone</option><option value="-04:00">EDT (UTC-4)</option><option value="-05:00">EST/CDT (UTC-5)</option><option value="-06:00">CST (UTC-6)</option><option value="-07:00">MDT (UTC-7)</option><option value="-08:00">PDT (UTC-8)</option><option value="+00:00">UTC</option></select><button type="submit">Check timestamp</button></form><div class="screenshot-result" data-screenshot-result aria-live="polite"><p>Enter the timestamp printed on a social post, outlook map, or forecast screenshot. This checks time only; it cannot verify an edited image.</p></div></article></div></section>}

  {page.slug === "hurricane-categories" && <section class="band" aria-labelledby="category-visual"><div class="inner"><h2 id="category-visual">Hurricane Category Wind Thresholds</h2><ContentFigure src="/images/guides/hurricane-category-wind-scale.svg" alt="Saffir-Simpson hurricane wind scale showing Category 1 through 5 wind speed thresholds in miles per hour" caption="The Saffir-Simpson scale measures maximum sustained wind only. It does not measure storm surge, rainfall flooding, tornadoes, storm size, or duration." /></div></section>}
  {page.slug === "map" && <section class="band" aria-labelledby="map-visual"><div class="inner"><h2 id="map-visual">The Forecast Cone Is Not an Impact Boundary</h2><ContentFigure src="/images/guides/forecast-cone-impact-boundary.svg" alt="Diagram showing an NHC forecast cone for probable storm-center positions with hazards extending outside it" caption="Use the cone for storm-center uncertainty, then check NHC hazard products, NWS alerts, and local evacuation guidance for impacts." /></div></section>}
  {page.slug === "storm-surge-map" && <section class="band" aria-labelledby="surge-visual"><div class="inner"><h2 id="surge-visual">Use Each Hurricane Map for the Right Question</h2><ContentFigure src="/images/guides/storm-hazard-map-differences.svg" alt="Comparison of hurricane forecast track, storm surge, rainfall and flood maps, and local weather alerts" caption="Forecast tracks, surge maps, rainfall forecasts, and local alerts describe different hazards. Check the latest official products together before acting." /></div></section>}

  <section class="band" aria-labelledby="topic-workflow">
    <div class="inner">
      <p class="eyebrow">{page.intent}</p>
      <h2 id="topic-workflow">Start Here, Then Move Toward a Local Decision</h2>
      <div class="grid-3 section-grid">
        {page.steps.map((step, index) => (
          <article class="panel">
            <p class="eyebrow">Step {index + 1}</p>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
            <p><a class="action-link" href={step.href}>{step.label}</a></p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="topic-context">
    <div class="inner grid-2">
      {page.sections.map((section, index) => (
        <article class="panel">
          <p class="eyebrow">{section.eyebrow}</p>
          <h2 id={index === 0 ? "topic-context" : undefined}>{section.title}</h2>
          <p>{section.body}</p>
          <ul class="check-list">
            {section.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="band" aria-labelledby="topic-next">
    <div class="inner">
      <p class="eyebrow">Related hurricane resources</p>
      <h2 id="topic-next">Open the Next Best Page</h2>
      <div class="link-list">
        {page.nextLinks.map((link) => (
          <article class="link-row">
            <h3><a href={link.href}>{link.name}</a></h3>
            <p>{link.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="topic-official">
    <div class="inner grid-2">
      <article class="panel">
        <p class="eyebrow">Official-source check</p>
        <h2 id="topic-official">Verify Before You Act</h2>
        <p>HurricaneHub is a planning and interpretation layer. During an active threat, confirm storm advisories, watches, warnings, evacuation orders, shelters, and road restrictions with official sources.</p>
        <ul class="check-list">
          <li><a href="https://www.nhc.noaa.gov/" rel="noopener nofollow">National Hurricane Center</a></li>
          <li><a href="https://www.weather.gov/" rel="noopener nofollow">National Weather Service</a></li>
          <li><a href="/alerts/">Active NWS alerts on HurricaneHub</a></li>
        </ul>
      </article>
      <article class="panel">
        <p class="eyebrow">Local planning</p>
        <h2>Bring the Search Back to Your Location</h2>
        <p>After reading this hub, the most useful next page is usually a city tracker, state tracker, alert page, or household tool that matches the place you care about.</p>
        <ul class="check-list">
          <li><a href="/hurricane-tracker/city/">Browse city hurricane trackers</a></li>
          <li><a href="/tracker/">Browse state hurricane trackers</a></li>
          <li><a href="/tools/local-risk-plan/">Build a local risk plan</a></li>
        </ul>
      </article>
    </div>
  </section>

  <FaqBlock faqs={pageFaqs} />
</Layout>

{page.slug === "gulf" && <script is:inline define:vars={{ gulfOutlookClient }}>
  const heading = document.querySelector("[data-gulf-heading]");
  const answer = document.querySelector("[data-gulf-answer]");
  const updated = document.querySelector("[data-gulf-updated]");
  let outlook = gulfOutlookClient;
  const historyKey = "hurricanehub:gulf-outlook-history:v1";
  const historyEl = document.querySelector("[data-outlook-history]");
  fetch("/api/nhc/current.json", { cache: "no-store" }).then((response) => response.ok ? response.json() : null).then((feed) => {
    if (!feed) return;
    const storms = (Array.isArray(feed.storms) ? feed.storms : []).filter((storm) => /^AL/i.test(String(storm.id ?? "")) && Number(storm.longitudeNumeric) >= -98 && Number(storm.longitudeNumeric) <= -80 && Number(storm.latitudeNumeric) >= 18 && Number(storm.latitudeNumeric) <= 31);
    if (heading) heading.textContent = storms.length ? `${storms.length} Active Gulf Tropical System${storms.length === 1 ? "" : "s"}` : "No Active Gulf Tropical Cyclone";
    if (answer) answer.textContent = storms.length ? `The latest NHC feed lists ${storms.map((storm) => storm.name ?? storm.id ?? "an unnamed system").join(", ")} in the Gulf region. Open the live tracker and official advisory for current position, forecast, and warnings.` : "The latest NHC feed does not list an active tropical cyclone in the Gulf region. A disturbance can still be monitored before it becomes a depression or named storm.";
    if (updated) updated.textContent = `Current-storm feed checked ${new Date(feed.updatedAt ?? feed.fetchedAt ?? Date.now()).toLocaleString("en-US", { timeZone: "UTC" })} UTC. A formation probability is not a forecast track, warning area, or landfall prediction.`;
    if (feed.atlanticOutlook) {
      outlook = {
        issued: feed.atlanticOutlook.issued ?? "",
        issuedAt: feed.atlanticOutlook.issuedAt ?? "",
        chance48h: feed.atlanticOutlook.formationChance48h ?? null,
        chance7d: feed.atlanticOutlook.formationChance7d ?? null
      };
      const issuedEl = document.querySelector("[data-outlook-issued]");
      const textEl = document.querySelector("[data-outlook-text]");
      const chance48El = document.querySelector("[data-chance-48]");
      const chance7El = document.querySelector("[data-chance-7]");
      if (issuedEl) issuedEl.textContent = `NHC Atlantic outlook · ${outlook.issued}`;
      if (textEl) textEl.textContent = feed.atlanticOutlook.text ?? "";
      if (chance48El) chance48El.textContent = typeof outlook.chance48h === "number" ? `${outlook.chance48h}%` : "—";
      if (chance7El) chance7El.textContent = typeof outlook.chance7d === "number" ? `${outlook.chance7d}%` : "—";
    }
    renderOutlookHistory();
  }).catch(() => {});

  function renderOutlookHistory() {
    try {
      const stored = JSON.parse(localStorage.getItem(historyKey) || "[]");
      const history = Array.isArray(stored) ? stored : [];
      const previous = history.find((item) => item.issued && item.issued !== outlook.issued);
      if (historyEl && outlook.issued) {
        historyEl.innerHTML = previous
          ? `<p><strong>Current:</strong> ${outlook.chance48h ?? "—"}% in 48 hours; ${outlook.chance7d ?? "—"}% in 7 days.</p><p><strong>Previous on this device:</strong> ${previous.chance48h ?? "—"}% in 48 hours; ${previous.chance7d ?? "—"}% in 7 days.</p><p><strong>Change:</strong> 48-hour ${formatChange(previous.chance48h, outlook.chance48h)}; 7-day ${formatChange(previous.chance7d, outlook.chance7d)}.</p>`
          : `<p><strong>Current:</strong> ${outlook.chance48h ?? "—"}% in 48 hours; ${outlook.chance7d ?? "—"}% in 7 days.</p><p>No earlier outlook is saved on this device yet.</p>`;
      }
      const next = [outlook, ...history.filter((item) => item.issued !== outlook.issued)].filter((item) => item.issued).slice(0, 6);
      localStorage.setItem(historyKey, JSON.stringify(next));
    } catch {}
  }
  renderOutlookHistory();

  function formatChange(previous, current) {
    if (typeof previous !== "number" || typeof current !== "number") return "not available";
    const delta = current - previous;
    return delta === 0 ? "unchanged" : `${delta > 0 ? "up" : "down"} ${Math.abs(delta)} percentage points`;
  }

  const screenshotForm = document.querySelector("[data-screenshot-check]");
  const screenshotResult = document.querySelector("[data-screenshot-result]");
  screenshotForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(screenshotForm);
    const value = String(data.get("screenshotTime") || "");
    const zone = String(data.get("screenshotZone") || "local");
    const screenshotTime = new Date(zone === "local" ? value : `${value}:00${zone}`);
    const officialTime = new Date(outlook.issuedAt);
    if (!screenshotResult || Number.isNaN(screenshotTime.getTime()) || Number.isNaN(officialTime.getTime())) return;
    const differenceHours = (officialTime.getTime() - screenshotTime.getTime()) / 3_600_000;
    if (differenceHours < -1) {
      screenshotResult.innerHTML = `<p><strong>Timestamp mismatch.</strong> The entered time is later than the current official outlook (${outlook.issued}). Check the timezone and whether the post refers to another product.</p>`;
    } else if (differenceHours > 6) {
      screenshotResult.innerHTML = `<p><strong>Possibly superseded.</strong> The screenshot is about ${Math.round(differenceHours)} hours older than the current official outlook (${outlook.issued}). Use the latest NHC outlook before sharing or acting.</p>`;
    } else {
      screenshotResult.innerHTML = `<p><strong>Time appears current.</strong> The screenshot is within about ${Math.max(0, Math.round(differenceHours))} hours of the current official outlook (${outlook.issued}). Still verify the source URL and exact percentages because images can be edited.</p>`;
    }
  });
</script>}

<style>
  .probability-value { display: block; color: var(--ocean); font-size: clamp(2rem, 6vw, 4rem); font-weight: 900; line-height: 1; }
  [data-screenshot-check] { display: grid; gap: 10px; }
  [data-screenshot-check] label { font-weight: 800; }
  [data-screenshot-check] button { width: fit-content; }
  .screenshot-result { margin-top: 16px; padding: 14px; border-left: 4px solid var(--ocean); background: var(--surface, #f4f7f9); }
</style>
