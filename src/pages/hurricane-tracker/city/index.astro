---
import FaqBlock from "../../../components/FaqBlock.astro";
import Layout from "../../../layouts/Layout.astro";
import { hurricaneCities } from "../../../data/cities";
import { site } from "../../../data/site";
import { coastalStates } from "../../../data/states";
import { articleSchema, faqSchema, graph, itemListSchema, websiteSchema } from "../../../lib/schema";

const title = "City Hurricane Trackers";
const description = "Browse local hurricane tracker pages for coastal U.S. cities with storm surge, flooding, evacuation-route, outage, NWS alert, and NHC storm context.";
const url = `${site.url}/hurricane-tracker/city/`;
const lastModified = site.contentLastModified;
const faqs = [
  {
    question: "What is a city hurricane tracker?",
    answer:
      "A city hurricane tracker connects broad storm information with local planning context such as nearby counties, storm surge exposure, flooding concerns, evacuation-route issues, outages, and NWS alerts."
  },
  {
    question: "Should I use a city page instead of official evacuation information?",
    answer:
      "No. City pages are planning guides and tracker shortcuts. Exact evacuation zones, shelters, road closures, and orders must come from local emergency management and official weather alerts."
  },
  {
    question: "Why do city hurricane risks differ within the same state?",
    answer:
      "Cities can face different hazards because of coastline shape, bays, rivers, elevation, bridges, drainage, building types, tree cover, and how a storm approaches the area."
  },
  {
    question: "Do inland cities need hurricane tracker pages?",
    answer:
      "Yes. Inland areas may avoid storm surge but still face damaging wind, flash flooding, tornado warnings, falling trees, transportation disruption, and long power outages."
  },
  {
    question: "How should I pick the right local hurricane page?",
    answer:
      "Start with the nearest city page, then also check your state tracker and official county or local emergency management resources for address-specific instructions."
  }
];
const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title, description, url, dateModified: lastModified }),
  faqSchema(faqs),
  itemListSchema(hurricaneCities.map((city) => ({
    name: `${city.name} Hurricane Tracker`,
    description: city.planningNote,
    url: `${site.url}/hurricane-tracker/city/${city.slug}/`
  })))
);
const citiesByState = coastalStates
  .map((state) => ({
    state,
    cities: hurricaneCities.filter((city) => city.stateCode === state.code)
  }))
  .filter((group) => group.cities.length);
---
<Layout title={title} description={description} canonical={url} jsonLd={jsonLd} lastModified={lastModified}>
  <section class="band" aria-labelledby="city-index-title">
    <div class="inner">
      <p class="eyebrow">Local hurricane planning</p>
      <h1 id="city-index-title">City Hurricane Trackers</h1>
      <p class="answer">Browse city-level hurricane tracker pages for local storm surge, flooding, evacuation-route, bridge, outage, NWS alert, and NHC storm context.</p>
    </div>
  </section>

  <section class="band" aria-labelledby="city-list">
    <div class="inner">
      <h2 id="city-list">Choose a City</h2>
      <div class="grid-3 section-grid">
        {hurricaneCities.map((city) => (
          <article class="panel">
            <p class="eyebrow">{city.stateName}</p>
            <h3>{city.name} Hurricane Tracker</h3>
            <p>{city.planningNote}</p>
            <div class="risk-tags">
              {city.risks.slice(0, 3).map((risk) => <span class="risk-tag">{risk}</span>)}
            </div>
            <p><a class="action-link" href={`/hurricane-tracker/city/${city.slug}/`}>Open {city.name}</a></p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="city-state-clusters">
    <div class="inner">
      <p class="eyebrow">State-to-city clusters</p>
      <h2 id="city-state-clusters">City Hurricane Trackers by State</h2>
      <p class="answer">Use these state groups to move from a broad hurricane tracker to local pages for surge, flood, bridge, route, outage, and county-specific planning context.</p>
      <div class="grid-3 section-grid">
        {citiesByState.map(({ state, cities }) => (
          <article class="panel">
            <p class="eyebrow">{state.region}</p>
            <h3>{state.name} City Trackers</h3>
            <p>{state.preparednessNote}</p>
            <ul class="cluster-links" aria-label={`${state.name} city hurricane tracker links`}>
              {cities.map((city) => (
                <li><a href={`/hurricane-tracker/city/${city.slug}/`}>{city.name} hurricane tracker</a></li>
              ))}
            </ul>
            <p><a class="action-link" href={`/tracker/${state.slug}/`}>Open {state.name} state tracker</a></p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <FaqBlock faqs={faqs} />
</Layout>

<style>
  .cluster-links {
    display: grid;
    gap: 8px;
    margin: 16px 0 20px;
    padding-left: 18px;
  }

  .cluster-links a {
    font-weight: 700;
  }
</style>
