---
import FaqBlock from "../../../components/FaqBlock.astro";
import Layout from "../../../layouts/Layout.astro";
import { hurricaneCities, getCityBySlug } from "../../../data/cities";
import { faqs, site } from "../../../data/site";
import { coastalStates, getStateByCode } from "../../../data/states";
import { articleSchema, faqSchema, graph, itemListSchema, websiteSchema } from "../../../lib/schema";

export const prerender = true;

export function getStaticPaths() {
  return hurricaneCities.map((city) => ({
    params: { city: city.slug },
    props: { city }
  }));
}

const city = Astro.props.city ?? getCityBySlug(Astro.params.city);
if (!city) {
  return Astro.redirect("/tracker/");
}

const title = `${city.name} Hurricane Tracker and Local Risk Guide`;
const description = `Track ${city.name} hurricane risk with local NWS alerts, NHC storm context, storm surge, flooding, evacuation planning, and household decision tools.`;
const url = `${site.url}/hurricane-tracker/city/${city.slug}/`;
const lastModified = site.contentLastModified;
const state = getStateByCode(city.stateCode);
const stateSlug = state?.slug ?? city.stateName.toLowerCase().replaceAll(" ", "-");
const stateCities = hurricaneCities
  .filter((candidate) => candidate.stateCode === city.stateCode && candidate.slug !== city.slug)
  .slice(0, 6);
const nearbyCityLinks = stateCities.length
  ? stateCities
  : hurricaneCities.filter((candidate) => candidate.slug !== city.slug).slice(0, 6);
const nextStateLinks = coastalStates
  .filter((candidate) => candidate.code !== city.stateCode)
  .slice(0, 4);
const actionPaths = [
  {
    name: `${city.name} local risk action plan`,
    description: `Use active alerts and ${city.stateName} storm context to build a 72/48/24-hour household action plan for ${city.name}.`,
    href: `/tools/local-risk-plan/?state=${city.stateCode}`
  },
  {
    name: `${city.name} evacuation decision helper`,
    description: `Check whether housing type, flood exposure, transportation, pets, medical needs, or local orders should move a ${city.name} household from prepare to leave.`,
    href: "/tools/evacuation-decision-helper/"
  },
  {
    name: `${city.name} alert action decoder`,
    description: `Translate hurricane, surge, flood, tornado, and evacuation alert language into plain-language next actions for ${city.name}.`,
    href: "/tools/alert-action-decoder/"
  },
  {
    name: `${city.name} power outage planner`,
    description: `Plan charging, food safety, generator placement, refrigerated medicine, and communication backup for ${city.name} outages.`,
    href: "/tools/power-outage-planner/"
  }
];
const pageFaqs = [
  {
    question: `Is HurricaneHub an official ${city.name} evacuation source?`,
    answer: `No. HurricaneHub helps ${city.name} households organize official weather information, but evacuation zones, road closures, shelters, and orders come from local emergency management and weather.gov.`
  },
  {
    question: `What should ${city.name} residents check first during a hurricane threat?`,
    answer: `Check your exact evacuation zone, active NWS alerts for ${city.stateName}, current NHC advisory context, and whether your household needs extra time for medical, mobility, pet, or transportation needs.`
  },
  ...city.faqs,
  ...faqs
];
const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title, description, url, dateModified: lastModified }),
  faqSchema(pageFaqs),
  itemListSchema([
    {
      name: `${city.stateName} Hurricane Tracker`,
      description: state?.preparednessNote ?? `${city.stateName} state hurricane tracker and alert context.`,
      url: `${site.url}/tracker/${stateSlug}/`
    },
    ...nearbyCityLinks.map((nearbyCity) => ({
      name: `${nearbyCity.name} Hurricane Tracker`,
      description: nearbyCity.planningNote,
      url: `${site.url}/hurricane-tracker/city/${nearbyCity.slug}/`
    })),
    ...actionPaths.map((path) => ({
      name: path.name,
      description: path.description,
      url: `${site.url}${path.href}`
    }))
  ])
);
---
<Layout title={title} description={description} canonical={url} jsonLd={jsonLd} lastModified={lastModified}>
  <section class="band" aria-labelledby="city-title">
    <div class="inner">
      <p class="eyebrow">{city.region}</p>
      <h1 id="city-title">{city.name} Hurricane Tracker and Local Risk Guide</h1>
      <p class="answer">This page helps {city.name} residents connect state NWS alerts, NHC storm context, evacuation-zone checks, and household planning tools before wind, surge, flooding, or road constraints reduce options.</p>
      <p class="answer">{city.overview}</p>
    </div>
  </section>

  <section class="band" aria-labelledby="city-actions">
    <div class="inner grid-2">
      <article class="panel">
        <h2 id="city-actions">{city.name} Priority Risks</h2>
        <ul class="check-list">
          {city.risks.map((risk) => <li>{risk}</li>)}
        </ul>
        <p>{city.planningNote}</p>
      </article>
      <article class="panel">
        <h2>Start Here</h2>
        <ul class="check-list">
          <li><a href={`/tracker/${stateSlug}/`}>Open the {city.stateName} state tracker</a></li>
          <li><a href={`/tools/local-risk-plan/?state=${city.stateCode}`}>Build a local risk action plan</a></li>
          <li><a href="/radar/">Open live radar and satellite</a></li>
          <li><a href="/tools/hurricane-brief/">Generate a printable hurricane brief</a></li>
        </ul>
      </article>
    </div>
  </section>

  <section class="band" aria-labelledby="city-hazards">
    <div class="inner">
      <p class="eyebrow">Local hurricane risk</p>
      <h2 id="city-hazards">{city.name} Hurricane Hazards to Watch</h2>
      <div class="grid-3 section-grid">
        {city.localHazards.map((hazard) => (
          <article class="panel">
            <h3>{hazard.heading}</h3>
            <p>{hazard.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="city-counties">
    <div class="inner grid-2">
      <article>
        <h2 id="city-counties">Nearby Counties and Local Checks</h2>
        <p>Use these nearby county or city names as a starting point, then verify exact emergency instructions with local officials.</p>
        <ul class="check-list">
          {city.nearbyCounties.map((county) => <li>{county}</li>)}
        </ul>
      </article>
      <article class="panel">
        <h2>Decision Reminder</h2>
        <p>HurricaneHub can screen state-level alerts and storm context. It cannot determine your exact evacuation zone, shelter eligibility, bridge closure, or road safety.</p>
        <p><a class="action-link" href="/tools/alert-action-decoder/">Decode an official alert</a></p>
      </article>
    </div>
  </section>

  <section class="band" aria-labelledby="city-evacuation">
    <div class="inner grid-2">
      <article class="panel">
        <h2 id="city-evacuation">{city.name} Evacuation and Action Checklist</h2>
        <ul class="check-list">
          {city.evacuationFocus.map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article>
        <h2>Common Local Searches</h2>
        <p>These are the practical questions this page is built to answer during hurricane season.</p>
        <ul class="check-list">
          {city.localSearches.map((query) => <li>{query}</li>)}
        </ul>
      </article>
    </div>
  </section>

  <section class="band" aria-labelledby="city-action-paths">
    <div class="inner">
      <p class="eyebrow">Local action paths</p>
      <h2 id="city-action-paths">What Should {city.name} Residents Do Next?</h2>
      <p class="answer">Use the city tracker to understand local hurricane context, then move into the tool that matches the decision you need to make now.</p>
      <div class="grid-2 section-grid">
        {actionPaths.map((path) => (
          <article class="panel">
            <h3><a href={path.href}>{path.name}</a></h3>
            <p>{path.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="nearby-city-links">
    <div class="inner">
      <p class="eyebrow">Nearby hurricane tracker pages</p>
      <h2 id="nearby-city-links">Compare {city.name} With Other {city.stateName} Hurricane Trackers</h2>
      <p class="answer">A hurricane can shift risk from one metro area to another depending on track angle, coastline shape, rainfall placement, and evacuation routes. Use these nearby pages to compare storm surge, flooding, outage, and local-alert context before focusing on one location.</p>
      <div class="grid-3 section-grid">
        {nearbyCityLinks.map((nearbyCity) => (
          <article class="panel">
            <p class="eyebrow">{nearbyCity.region}</p>
            <h3>{nearbyCity.name} Hurricane Tracker</h3>
            <p>{nearbyCity.planningNote}</p>
            <a href={`/hurricane-tracker/city/${nearbyCity.slug}/`}>Open {nearbyCity.name}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="city-cluster-links">
    <div class="inner grid-2">
      <article class="panel">
        <h2 id="city-cluster-links">More {city.stateName} Hurricane Context</h2>
        <ul class="check-list">
          <li><a href={`/tracker/${stateSlug}/`}>Open the {city.stateName} state tracker</a></li>
          <li><a href="/hurricane-tracker/city/">Browse all city hurricane trackers</a></li>
          <li><a href="/hurricane-tracker/live/">Open the live hurricane tracker</a></li>
          <li><a href="/storm-archive/">Compare current threats with past storms</a></li>
        </ul>
      </article>
      <article>
        <p class="eyebrow">Regional comparison</p>
        <h2>Check Neighboring Coastal States</h2>
        <p class="answer">Track shifts can move the highest wind, surge, tornado, or rainfall risk across state lines. These state pages help compare the broader coastal setup.</p>
        <ul class="check-list">
          {nextStateLinks.map((stateLink) => (
            <li><a href={`/tracker/${stateLink.slug}/`}>{stateLink.name} hurricane tracker</a></li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  {city.officialResources?.length ? (
    <section class="band" aria-labelledby="official-resources">
      <div class="inner">
        <p class="eyebrow">Official source links</p>
        <h2 id="official-resources">{city.name} Official Hurricane Resources</h2>
        <p class="answer">Use these official sources for evacuation orders, shelters, road closures, local alerts, and current NHC advisories before making a life-safety decision.</p>
        <div class="grid-3 section-grid">
          {city.officialResources.map((resource) => (
            <article class="panel">
              <h3>{resource.name}</h3>
              <p>{resource.description}</p>
              <a href={resource.url} target="_blank" rel="noopener nofollow">Open official source</a>
            </article>
          ))}
        </div>
      </div>
    </section>
  ) : null}

  <section class="band" aria-labelledby="city-live">
    <div class="inner">
      <p class="eyebrow">Live from NWS</p>
      <h2 id="city-live">Active {city.name} Area Alerts</h2>
      <p class="answer">Active National Weather Service alerts for the {city.name} area, loaded live from the official NWS feed. Always confirm details with local emergency management.</p>
      <div id="city-alerts" class="alert-feed" data-lat={city.lat} data-lon={city.lon}>
        <p class="alert-feed-status">Loading live alerts…</p>
      </div>
    </div>
  </section>

  <FaqBlock faqs={pageFaqs} />
</Layout>

<style is:global>
  .alert-feed {
    display: grid;
    gap: 12px;
    margin-top: 14px;
  }
  .alert-feed-status,
  .alert-feed-empty,
  .alert-feed-error {
    color: var(--muted);
  }
  .alert-feed-error a {
    color: var(--accent);
  }
  .alert-item {
    border: 1px solid var(--line);
    border-left: 4px solid var(--accent);
    border-radius: 10px;
    padding: 12px 14px;
    background: rgba(127, 127, 127, 0.04);
  }
  .alert-item-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: baseline;
    flex-wrap: wrap;
  }
  .alert-event {
    font-weight: 700;
  }
  .alert-sev {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
  }
  .alert-headline {
    margin: 6px 0 4px;
  }
  .alert-meta {
    font-size: 0.8rem;
    color: var(--muted);
    margin: 0;
  }
  .sev-extreme {
    border-left-color: #b91c1c;
  }
  .sev-severe {
    border-left-color: #ef4444;
  }
  .sev-moderate {
    border-left-color: #f59e0b;
  }
  .sev-minor {
    border-left-color: #3b82f6;
  }
  .sev-unknown {
    border-left-color: var(--line);
  }
</style>

<script>
  // @ts-nocheck
  (function () {
    var el = document.getElementById("city-alerts");
    if (!el) return;
    var lat = el.dataset.lat;
    var lon = el.dataset.lon;
    if (!lat || !lon) return;
    var url = "https://api.weather.gov/alerts/active?point=" + lat + "," + lon;
    fetch(url, { headers: { Accept: "application/geo+json" } })
      .then(function (r) {
        if (!r.ok) throw new Error("bad status");
        return r.json();
      })
      .then(function (data) {
        var features = (data && data.features) || [];
        if (!features.length) {
          el.innerHTML =
            '<p class="alert-feed-empty">No active NWS alerts for this area right now. Check back during a storm threat.</p>';
          return;
        }
        el.innerHTML = features
          .map(function (f) {
            var p = f.properties || {};
            var sev = (p.severity || "unknown").toLowerCase();
            var expires = p.expires ? new Date(p.expires).toLocaleString() : "";
            var event = p.event || "Alert";
            var headline = p.headline || "";
            return (
              '<article class="alert-item sev-' + sev + '">' +
              '<div class="alert-item-head"><span class="alert-event">' + event + "</span>" +
              '<span class="alert-sev">' + (p.severity || "") + "</span></div>" +
              (headline ? '<p class="alert-headline">' + headline + "</p>" : "") +
              (expires ? '<p class="alert-meta">Expires: ' + expires + "</p>" : "") +
              "</article>"
            );
          })
          .join("");
      })
      .catch(function () {
        el.innerHTML =
          '<p class="alert-feed-error">Live alerts are temporarily unavailable. Check <a href="https://www.weather.gov/" target="_blank" rel="noopener">weather.gov</a> for official alerts.</p>';
      });
  })();
</script>
