---
import FaqBlock from "../../components/FaqBlock.astro";
import Layout from "../../layouts/Layout.astro";
import { site } from "../../data/site";
import { topicPages } from "../../data/topicPages";
import { articleSchema, breadcrumbSchema, faqSchema, graph, itemListSchema, websiteSchema } from "../../lib/schema";
import { advisoryUrl, type NhcStorm } from "../../lib/weather";
import OfficialUpdateStamp from "../../components/OfficialUpdateStamp.astro";

type StormFeed = {
  storms?: Array<NhcStorm & { summary?: string }>;
  fetchedAt?: string;
  updatedAt?: string;
};

const url = `${site.url}/hurricane-tracker/live/`;
let stormFeed: StormFeed | null = null;
try {
  const response = await fetch(new URL("/api/nhc/current.json", Astro.url));
  if (response.ok) stormFeed = await response.json() as StormFeed;
} catch (error) {
  console.error("HurricaneHub live tracker feed failed", { error });
}
const storms = stormFeed?.storms ?? [];
const activeStormNames = storms.map((storm) => storm.name).filter(Boolean).slice(0, 2);
const activeContext = activeStormNames.length ? ` Track ${activeStormNames.join(" and ")} now.` : "";
const title = "Live Hurricane Tracker Map: Current NHC Storms & Alerts";
const lastModified = stormFeed?.updatedAt ?? stormFeed?.fetchedAt ?? site.contentLastModified;
const updatedLabel = new Date(lastModified).toLocaleString("en-US", {
  timeZone: "UTC",
  month: "short",
  day: "numeric",
  year: "numeric",
  hour: "numeric",
  minute: "2-digit"
});
const description = `${storms.length ? `${storms.length} active NHC system${storms.length === 1 ? "" : "s"}.` : "No active NHC systems listed."} Open the live NHC hurricane tracking map for current paths, radar, satellite and alerts. Updated ${updatedLabel} UTC.${activeContext}`;
const liveTrackerPaths = [
  {
    name: "Check active storms",
    href: "/tracker/",
    description: "Open the live NHC storm feed and state alert snapshot before moving into local planning."
  },
  {
    name: "Compare radar and satellite",
    href: "/radar/",
    description: "Use radar and satellite layers to compare rain bands, storm structure, and local weather timing."
  },
  {
    name: "Watch the GOES satellite loop",
    href: "/radar/",
    description: "Open NOAA GOES-East GeoColor, infrared, or water-vapor views for Atlantic, Gulf, East Coast, and Caribbean cloud changes."
  },
  {
    name: "Follow the hurricane path",
    href: "/hurricane-tracker/path/",
    description: "Read the forecast track and cone correctly before treating a center line as a local impact forecast."
  },
  {
    name: "Review landfall forecast context",
    href: "/hurricane-tracker/hurricane-landfall-forecast/",
    description: "Compare official forecast uncertainty with surge, rainfall, and local alert context near a possible landfall area."
  },
  {
    name: "Review local NWS alerts",
    href: "/alerts/",
    description: "Check active watches, warnings, advisories, and alert wording before changing household plans."
  },
  {
    name: "Open city hurricane trackers",
    href: "/hurricane-tracker/city/",
    description: "Move from storm position to local surge, flood, route, outage, and evacuation context."
  },
  {
    name: "Browse named storm trackers",
    href: "/hurricane-tracker/storm/",
    description: "Open standing storm-name pages for current-feed checks and official NHC advisory links."
  },
  {
    name: "Estimate the impact window",
    href: "/tools/impact-window-estimator/",
    description: "Translate active alerts and storm context into Monitor, Prepare, Act, or Leave timing."
  },
  {
    name: "Calculate storm distance",
    href: "/tools/storm-distance-calculator/",
    description: "Compare a location with current NHC storm coordinates while keeping distance limits in context."
  },
  {
    name: "Decode warning language",
    href: "/tools/alert-action-decoder/",
    description: "Turn watches, warnings, surge, flood, tornado, and evacuation wording into planning prompts."
  }
];
const trackerTopicHubs = topicPages.map((page) => ({
  name: page.title,
  href: `/hurricane-tracker/${page.slug}/`,
  description: page.description
}));
const faqs = [
  {
    question: "Are there any hurricanes right now?",
    answer: storms.length ? `The latest NHC feed lists ${storms.length} active system${storms.length === 1 ? "" : "s"}. Open the current storm list and verify the advisory time before making decisions.` : "The latest NHC feed does not list an active named hurricane right now. Tropical outlooks and local NWS alerts can change, so keep monitoring official updates."
  },
  {
    question: "Where is the hurricane now?",
    answer: storms.length ? "The current storm list below shows the latest NHC-reported position and update time for each active system. Use the map and official advisory for the full forecast context." : "No active named hurricane is currently listed in the latest NHC feed. Check official tropical outlooks and local NWS alerts for changes."
  },
  {
    question: "Is there a hurricane in the Gulf right now?",
    answer: "Use the Gulf hurricane tracker for the current NHC Gulf status, then check Florida, Alabama, Mississippi, Louisiana, or Texas local pages for alerts and official instructions."
  },
  {
    question: "When does the NHC update hurricane tracks?",
    answer: "NHC advisories follow scheduled cycles and may include intermediate updates when conditions require them. Always use the timestamp attached to the latest official advisory."
  },
  {
    question: "What is the best way to use a live hurricane tracker?",
    answer:
      "Use the tracker for storm position and advisory context, then compare it with radar, local NWS alerts, and local emergency guidance before making travel, shelter, or evacuation decisions."
  },
  {
    question: "Does a live tracker show every local hurricane impact?",
    answer:
      "No. A tracker map helps with storm context, but local impacts such as storm surge, flooding rain, tornado warnings, bridge closures, and evacuation orders require local official sources."
  },
  {
    question: "How often should I check hurricane updates?",
    answer:
      "During an active threat, check official NHC advisories, local NWS alerts, and local emergency management updates regularly, especially when watches or warnings are issued."
  },
  {
    question: "Is a live hurricane tracker the same as the NHC forecast cone?",
    answer:
      "No. A live tracker can show current storm context and links, while the NHC forecast cone explains the likely track of the storm center. Neither one shows every local hazard, so use local alerts for wind, surge, flood, and tornado risk."
  },
  {
    question: "Why should I compare radar with hurricane tracker data?",
    answer:
      "Radar can show rain bands and local precipitation timing, while hurricane tracker data explains the larger tropical system. Looking at both helps users avoid focusing only on the storm center."
  },
  {
    question: "Where can I watch a hurricane satellite loop?",
    answer:
      "Open HurricaneHub radar, switch to Satellite, choose GeoColor, infrared, or water vapor, then use the loop control for the official NOAA GOES animation. Satellite shows observed cloud structure, not a landfall forecast or impact boundary."
  },
  {
    question: "Can I search for a specific storm name from the live tracker hub?",
    answer:
      "Yes. Use the named hurricane tracker hub to open standing pages for specific storm names, then confirm whether the current NHC feed lists that name as active."
  },
  {
    question: "Should I use a city tracker or a state tracker first?",
    answer:
      "Use the state tracker for broad NWS alert context and the city tracker for local planning notes, nearby counties, surge exposure, flooding concerns, and route or outage context."
  }
];
const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title, description, url, dateModified: lastModified }),
  itemListSchema(liveTrackerPaths.map((path) => ({
    name: path.name,
    description: path.description,
    url: `${site.url}${path.href}`
  }))),
  itemListSchema(trackerTopicHubs.map((hub) => ({
    name: hub.name,
    description: hub.description,
    url: `${site.url}${hub.href}`
  }))),
  faqSchema(faqs),
  breadcrumbSchema([
    { name: "Home", url: site.canonicalUrl },
    { name: "Live Hurricane Tracker", url }
  ])
);
---
<Layout title={title} description={description} canonical={url} jsonLd={jsonLd} lastModified={lastModified}>
  <section class="band" aria-labelledby="live-title">
    <div class="inner live-hero-grid">
      <div>
        <p class="eyebrow">Current NHC storm data</p>
        <h1 id="live-title">Live Hurricane Tracker and NHC Tracking Map</h1>
        <p class="answer">{storms.length ? `The latest NHC feed lists ${storms.length} active system${storms.length === 1 ? "" : "s"}${activeStormNames.length ? `: ${activeStormNames.join(" and ")}` : ""}.` : "The latest NHC feed lists no active tropical cyclones."} Last checked {updatedLabel} UTC. Open the interactive NHC tracking map below for current centers and forecast paths, then compare radar, satellite imagery, and local NWS alerts.</p>
        <p class="section-actions">
          <a class="action-link" href="#current-hurricanes">View current hurricanes</a>
          {activeStormNames[0] && <a class="action-link secondary-action" href={`/hurricane-tracker/storm/${String(activeStormNames[0]).toLowerCase()}/`}>Track {activeStormNames[0]}</a>}
          <a class="action-link secondary-action" href="/2026-hurricane-season/">2026 season storms and names</a>
        </p>
      </div>
      <aside class="panel live-snapshot" aria-label="Current hurricane tracker status">
        <p class="eyebrow">Live snapshot</p>
        <strong class="storm-count" data-live-storm-count>{storms.length}</strong>
        <span data-live-storm-label>{storms.length === 1 ? "active NHC system" : "active NHC systems"}</span>
        <p class="source-note" data-live-updated>Last checked {updatedLabel} UTC</p>
        <OfficialUpdateStamp updatedAt={lastModified} />
        <a href="https://www.nhc.noaa.gov/" rel="noopener nofollow">Verify with the National Hurricane Center</a>
      </aside>
    </div>
  </section>

  <section class="live-map-section" aria-labelledby="live-map-heading">
    <div class="inner">
      <div class="map-console">
        <div class="live-map-heading">
          <div>
            <p class="eyebrow"><span class="live-indicator"></span> Interactive weather operations</p>
            <h2 id="live-map-heading">Live NHC Hurricane Tracking Map</h2>
            <p>Explore current NHC hurricane positions, forecast tracks, live radar, and NOAA GOES satellite-loop views across the Atlantic basin.</p>
          </div>
          <div class="map-source-stack" aria-label="Live map sources">
            <span>NHC positions</span>
            <span>RainViewer radar</span>
            <span>GOES-East satellite</span>
          </div>
        </div>
        <div class="live-map-frame">
          <iframe
            src="/embed/radar?layer=radar&theme=dark&view=atlantic"
            title="Interactive live hurricane map with NHC storm positions, radar, and satellite"
            loading="eager"
            allow="fullscreen"
          ></iframe>
        </div>
        <div class="map-console-footer">
          <p><strong>How to read this map:</strong> switch layers to compare precipitation with cloud structure. NHC markers show the latest reported center, not the full hazard area.</p>
          <a href="#current-hurricanes">View storm details</a>
        </div>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="satellite-loop-heading">
    <div class="inner grid-2">
      <article>
        <p class="eyebrow">Observe cloud changes</p>
        <h2 id="satellite-loop-heading">Hurricane Satellite Loop and Radar Context</h2>
        <p class="answer">Use the GOES satellite loop when a system is offshore or organizing over open water. GeoColor shows broad cloud structure, infrared highlights colder cloud tops, and water vapor helps show surrounding moisture patterns. These observations do not predict landfall or local impacts.</p>
        <p class="section-actions"><a class="action-link" href="/radar/">Open GOES satellite loop</a><a class="action-link secondary-action" href="/hurricane-tracker/tropical-disturbances/">Check tropical disturbances</a></p>
      </article>
      <article class="panel">
        <p class="eyebrow">Use each layer correctly</p>
        <h3>Observation Before Action</h3>
        <ul>
          <li>Satellite: cloud structure and broad tropical environment.</li>
          <li>Radar: nearby rain bands and short-term precipitation timing.</li>
          <li>NHC: official status, forecast track, and advisory discussion.</li>
          <li>NWS and local officials: warnings, evacuation, roads, and shelters.</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="band" id="current-hurricanes" aria-labelledby="current-hurricanes-heading">
    <div class="inner">
      <p class="eyebrow">Hurricanes right now</p>
      <h2 id="current-hurricanes-heading">Current Hurricanes and NHC Tracks</h2>
      <p class="answer">This list reflects the latest available NHC feed and advisory update time. Open the interactive tracker for current-map context, forecast paths, radar, and local NWS alerts before making urgent decisions.</p>
      <p class="source-note">Looking for the latest hurricanes or tropical storms right now? This live list includes named systems currently reported by the NHC; disturbances are tracked separately in the outlook below.</p>
      <div class="stack current-storm-list" data-live-storm-list>
        {storms.length ? storms.map((storm) => (
          <article class="panel current-storm">
            <header>
              <div>
                <p class="eyebrow">{storm.classification ?? "NHC tropical system"}</p>
                <h3>{storm.name ?? storm.id ?? "Active tropical system"}</h3>
              </div>
              <span class="badge warn">{storm.intensity ? `${storm.intensity} kt` : storm.windSpeed ?? "Advisory active"}</span>
            </header>
            <p>{storm.summary ?? `Latest NHC position: ${storm.latitude ?? "pending"}, ${storm.longitude ?? "pending"}.`}</p>
            <p class="source-note">Position {storm.latitude ?? "pending"}, {storm.longitude ?? "pending"} · Updated {storm.lastUpdate ?? lastModified}</p>
            <p class="section-actions">
              <a class="action-link" href={`/hurricane-tracker/storm/${String(storm.name ?? storm.id ?? "storm").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "")}/`}>Open {storm.name ?? "storm"} live tracker</a>
              {advisoryUrl(storm.publicAdvisory) && <a class="action-link secondary-action" href={advisoryUrl(storm.publicAdvisory)} rel="noopener nofollow">NHC advisory</a>}
            </p>
          </article>
        )) : (
          <article class="panel no-active-storms">
            <h3>No Active NHC Tropical Cyclones</h3>
            <p>No active tropical cyclone is listed in the latest NHC feed. This is not an all-clear for every location: disturbances and local hazards can develop before a named system appears.</p>
            <p class="section-actions">
              <a class="action-link" href="https://www.nhc.noaa.gov/gtwo.php" rel="noopener nofollow">Check tropical outlook</a>
              <a class="action-link secondary-action" href="/alerts/">Check local alerts</a>
            </p>
          </article>
        )}
      </div>
      <p class="section-actions"><a class="action-link secondary-action" href="/2026-hurricane-season/">View the 2026 storm list and next name</a></p>
    </div>
  </section>

  <section class="band" aria-labelledby="disturbance-outlook">
    <div class="inner grid-2">
      <article>
        <p class="eyebrow">Before a storm is named</p>
        <h2 id="disturbance-outlook">Atlantic Tropical Disturbance Outlook</h2>
        <p class="answer">Monitor official NHC development areas, tropical waves, and disturbances before they become named storms. A colored outlook area indicates formation potential, not a forecast track or an impact area.</p>
        <p class="section-actions"><a class="action-link" href="/hurricane-tracker/tropical-disturbances/">Open disturbance tracker</a><a class="action-link secondary-action" href="https://www.nhc.noaa.gov/gtwo.php" rel="noopener nofollow">Open official NHC outlook</a></p>
      </article>
      <article class="panel outlook-panel">
        <img src="https://www.nhc.noaa.gov/xgtwo/two_atl_7d0.png" alt="Official NHC seven-day Atlantic tropical weather outlook" loading="lazy" width="900" height="679" />
        <p class="source-note">Official NHC seven-day Atlantic outlook. Check the issue time and accompanying NHC text before making decisions.</p>
      </article>
    </div>
  </section>

  <section class="band" aria-labelledby="live-workflow">
    <div class="inner">
      <p class="eyebrow">Live map workflow</p>
      <h2 id="live-workflow">Use the NHC Tracking Map, Radar, and Local Alerts Together</h2>
      <div class="grid-3 section-grid">
        <article class="panel">
          <h3>1. Start With the NHC Track</h3>
          <p>Use the current hurricane tracker for storm position, forecast movement, advisory time, and official NHC links.</p>
          <p><a class="action-link" href="/tracker/">Interactive tracking map</a></p>
        </article>
        <article class="panel">
          <h3>2. Compare Radar and Alerts</h3>
          <p>Use radar and active alerts to understand rain bands, local warnings, and changing weather near your area.</p>
          <p><a class="action-link" href="/alerts/">Active alerts</a></p>
        </article>
        <article class="panel">
          <h3>3. Use Local Pages</h3>
          <p>City and state pages help connect the storm map with evacuation zones, surge exposure, flooding, and outages.</p>
          <p><a class="action-link" href="/hurricane-tracker/city/">City trackers</a></p>
        </article>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="map-layers-heading">
    <div class="inner">
      <p class="eyebrow">Read each layer correctly</p>
      <h2 id="map-layers-heading">NHC Tracking Map vs Radar, Satellite, and Forecast Cone</h2>
      <p class="answer">These layers answer different questions. Compare them instead of treating any single map as a complete picture of hurricane risk.</p>
      <div class="grid-2 section-grid layer-guide">
        <article class="panel">
          <h3>NHC Hurricane Tracking Map</h3>
          <p>Shows the official storm center, classification, advisory time, and forecast track. Use it to understand where the system is and where the center may move.</p>
          <a href="https://www.nhc.noaa.gov/" rel="noopener nofollow">Check official NHC advisories</a>
        </article>
        <article class="panel">
          <h3>Weather Radar</h3>
          <p>Shows precipitation and rain-band movement near radar coverage. Radar is most useful as a storm approaches land, but it does not show the complete hurricane forecast.</p>
          <a href="/radar/">Open full hurricane radar</a>
        </article>
        <article class="panel">
          <h3>Satellite Imagery</h3>
          <p>Shows cloud structure and organization across the ocean, including systems beyond coastal radar range. It helps reveal storm shape, not exact local impacts.</p>
          <a href="/radar/">Compare satellite layers</a>
        </article>
        <article class="panel">
          <h3>NHC Forecast Cone</h3>
          <p>Shows probable uncertainty in the future position of the storm center. It is not an impact boundary: wind, surge, flooding, and tornadoes can occur outside it.</p>
          <a href="/blog/how-to-read-the-hurricane-cone-of-uncertainty/">Learn how to read the cone</a>
        </article>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="live-links">
    <div class="inner grid-2">
      <article class="panel">
        <p class="eyebrow">High-intent searches</p>
        <h2 id="live-links">Useful Hurricane Tracker Shortcuts</h2>
        <ul>
          <li><a href="/hurricane-tracker/map/">Hurricane tracker map</a></li>
          <li><a href="/hurricane-tracker/path/">Hurricane path tracker</a></li>
          <li><a href="/hurricane-tracker/hurricane-landfall-forecast/">Hurricane landfall forecast</a></li>
          <li><a href="/hurricane-tracker/tropical-disturbances/">Tropical disturbance tracker</a></li>
          <li><a href="/local-hurricane-risk/">Local hurricane risk</a></li>
          <li><a href="/hurricane-tracker/storm/">Named hurricane trackers</a></li>
          <li><a href="/tracker/florida/">Florida hurricane tracker</a></li>
          <li><a href="/tracker/georgia/">Georgia hurricane tracker</a></li>
          <li><a href="/tracker/north-carolina/">North Carolina hurricane tracker</a></li>
          <li><a href="/tracker/louisiana/">Louisiana hurricane tracker</a></li>
          <li><a href="/tracker/south-carolina/">South Carolina hurricane tracker</a></li>
          <li><a href="/tracker/texas/">Texas hurricane tracker</a></li>
          <li><a href="/tracker/virginia/">Virginia hurricane tracker</a></li>
          <li><a href="/tools/impact-window-estimator/">Impact window estimator</a></li>
          <li><a href="/tools/storm-distance-calculator/">Storm distance calculator</a></li>
        </ul>
      </article>
      <article class="panel">
        <p class="eyebrow">Official-source mindset</p>
        <h2>Maps Are Context, Alerts Drive Decisions</h2>
        <p>Live maps are useful for orientation, but local watches, warnings, evacuation orders, shelter instructions, and road restrictions should come from NHC, NWS, and local emergency management.</p>
        <ul>
          <li><a href="https://www.nhc.noaa.gov/" rel="noopener nofollow">National Hurricane Center</a></li>
          <li><a href="https://www.weather.gov/" rel="noopener nofollow">National Weather Service</a></li>
        </ul>
      </article>
    </div>
  </section>

  <section class="band" aria-labelledby="live-intent-paths">
    <div class="inner">
      <p class="eyebrow">Search intent paths</p>
      <h2 id="live-intent-paths">What To Open After the Live Hurricane Tracker</h2>
      <p class="answer">A live tracker answers where the storm is. These next paths help answer what it means for your location, timeline, alerts, and household decisions.</p>
      <div class="link-list">
        {liveTrackerPaths.map((path) => (
          <article class="link-row">
            <h3><a href={path.href}>{path.name}</a></h3>
            <p>{path.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="live-topic-hubs">
    <div class="inner">
      <p class="eyebrow">Popular tracker searches</p>
      <h2 id="live-topic-hubs">Hurricane Tracker Topic Hubs</h2>
      <p class="answer">Use these pages when your search is about a specific map, path, surge, or evacuation-zone question.</p>
      <div class="grid-2 section-grid">
        {trackerTopicHubs.map((hub) => (
          <article class="panel">
            <h3><a href={hub.href}>{hub.name}</a></h3>
            <p>{hub.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <FaqBlock faqs={faqs} />
</Layout>

<script>
  const countEl = document.querySelector<HTMLElement>("[data-live-storm-count]");
  const labelEl = document.querySelector<HTMLElement>("[data-live-storm-label]");
  const updatedEl = document.querySelector<HTMLElement>("[data-live-updated]");
  const listEl = document.querySelector<HTMLElement>("[data-live-storm-list]");
  const escapeHtml = (value: unknown) => String(value ?? "").replace(/[&<>'"]/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;" })[char] ?? char);
  const advisoryUrl = (value: unknown) => {
    const url = typeof value === "string" ? value : (value && typeof value === "object" ? (value as { url?: string }).url : "");
    return typeof url === "string" && /^https:\/\//.test(url) ? url : "";
  };
  function stormMarkup(storm: Record<string, any>) {
    const name = storm.name ?? storm.id ?? "Active tropical system";
    const slug = String(name).toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
    const advisory = advisoryUrl(storm.publicAdvisory);
    return `<article class="panel current-storm"><header><div><p class="eyebrow">${escapeHtml(storm.classification ?? "NHC tropical system")}</p><h3>${escapeHtml(name)}</h3></div><span class="badge warn">${escapeHtml(storm.intensity ? `${storm.intensity} kt` : storm.windSpeed ?? "Advisory active")}</span></header><p>${escapeHtml(storm.summary ?? `Latest NHC position: ${storm.latitude ?? "pending"}, ${storm.longitude ?? "pending"}.`)}</p><p class="source-note">Position ${escapeHtml(storm.latitude ?? "pending")}, ${escapeHtml(storm.longitude ?? "pending")} · Updated ${escapeHtml(storm.lastUpdate ?? "latest feed")}</p><p class="section-actions"><a class="action-link" href="/hurricane-tracker/storm/${slug}/">Open ${escapeHtml(name)} live tracker</a>${advisory ? `<a class="action-link secondary-action" href="${escapeHtml(advisory)}" rel="noopener nofollow">NHC advisory</a>` : ""}</p></article>`;
  }
  async function refreshStormList() {
    try {
      const response = await fetch("/api/nhc/current.json", { cache: "no-store" });
      if (!response.ok) return;
      const feed = await response.json() as { storms?: Array<Record<string, any>>; updatedAt?: string; fetchedAt?: string };
      const storms = Array.isArray(feed.storms) ? feed.storms : [];
      if (countEl) countEl.textContent = String(storms.length);
      if (labelEl) labelEl.textContent = storms.length === 1 ? "active NHC system" : "active NHC systems";
      if (updatedEl) updatedEl.textContent = `Last checked ${new Date(feed.updatedAt ?? feed.fetchedAt ?? Date.now()).toLocaleString("en-US", { timeZone: "UTC" })} UTC`;
      if (listEl && storms.length) listEl.innerHTML = storms.map(stormMarkup).join("");
    } catch {}
  }
  window.setInterval(refreshStormList, 10 * 60 * 1000);
</script>

<style>
  .live-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 380px);
    gap: clamp(24px, 4vw, 52px);
    align-items: center;
  }

  .live-snapshot {
    display: grid;
    gap: 10px;
  }

  .storm-count {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1;
  }

  .current-storm-list {
    margin-top: 22px;
  }

  .live-map-section {
    padding: 0 0 clamp(48px, 7vw, 86px);
  }

  .map-console {
    overflow: hidden;
    border: 1px solid #294656;
    border-radius: 8px;
    background: #0b1821;
    box-shadow: 0 28px 70px rgba(10, 28, 39, 0.22);
