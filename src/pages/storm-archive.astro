---
import FaqBlock from "../components/FaqBlock.astro";
import Layout from "../layouts/Layout.astro";
import { stormTrackerPages } from "../data/stormPages";
import { faqs, site } from "../data/site";
import { articleSchema, faqSchema, graph, itemListSchema, websiteSchema } from "../lib/schema";
import { advisoryUrl, type NhcStorm } from "../lib/weather";
import { readStormRegistry } from "../lib/stormRegistry";

type StormFeed = {
  storms?: Array<NhcStorm & { summary?: string }>;
  updatedAt?: string;
  fetchedAt?: string;
};

const title = "Storm Archive and Current Advisory History";
const description = "View current NHC storm records, advisory links, named-storm tracker shortcuts, and HurricaneHub storm history context.";
const url = `${site.url}/storm-archive/`;

let feed: StormFeed | null = null;
try {
  const response = await fetch(new URL("/api/nhc/current.json", Astro.url));
  if (response.ok) {
    feed = await response.json() as StormFeed;
  }
} catch (error) {
  console.error("HurricaneHub storm archive feed failed", { error });
}

const storms = feed?.storms ?? [];
const registryStorms = await readStormRegistry();
const lastModified = feed?.updatedAt ?? feed?.fetchedAt ?? site.contentLastModified;
const archiveIntents = [
  {
    title: "Find whether a named storm is active",
    body:
      "Searchers often land here after hearing a storm name. Start with the current NHC records, then open the named-storm page for live status checks and advisory shortcuts.",
    href: "/hurricane-tracker/storm/",
    label: "Browse named storm trackers"
  },
  {
    title: "Compare a current storm with past hurricanes",
    body:
      "Historical context is useful when you compare track shape, pressure, category, latitude, and landfall pattern against storms like Katrina, Ian, and Sandy.",
    href: "/compare/",
    label: "Open comparison tool"
  },
  {
    title: "Learn why historical category is not enough",
    body:
      "Past storm searches can over-focus on category. Use surge, rainfall, cone, radar, and local alert explainers to understand what actually drove impacts.",
    href: "/learn/",
    label: "Open learning center"
  },
  {
    title: "Move from history to local action",
    body:
      "A past storm can explain context, but today's decision still depends on local NWS alerts, city risk, evacuation zones, and household constraints.",
    href: "/hurricane-tracker/city/",
    label: "Browse city trackers"
  }
];
const comparisonGuides = [
  {
    title: "Cone of uncertainty",
    href: "/blog/how-to-read-the-hurricane-cone-of-uncertainty/",
    body: "Use this guide when comparing historical tracks with a current forecast cone."
  },
  {
    title: "Saffir-Simpson category",
    href: "/blog/saffir-simpson-hurricane-wind-scale-explained/",
    body: "Use this guide when a past storm's category is being used as the main comparison point."
  },
  {
    title: "Storm surge forecasting",
    href: "/blog/hurricane-storm-surge-forecasting/",
    body: "Use this guide when comparing water impacts, evacuation timing, and coastal flood depth."
  },
  {
    title: "Rapid intensification",
    href: "/blog/hurricane-rapid-intensification/",
    body: "Use this guide when a storm strengthens quickly near warm water or close to land."
  }
];
const namedStormArchives = [
  {
    name: "Arthur",
    code: "AL012026",
    classification: "Tropical Storm",
    status: "Dissipated (June 18, 2026)",
    href: "/storm/2026-arthur/",
    blurb: "The first named storm of the 2026 Atlantic season — its NHC data, timeline, coastal impacts, and how it compares with past Arthur storms."
  },
  {
    name: "Bertha",
    code: "AL022026",
    classification: "Tropical Storm",
    status: "Dissipated (July 23, 2026)",
    href: "/storm/2026-bertha/",
    blurb: "A slow westward Gulf Coast grinder — NHC data, timeline, coastal flooding and surge impacts, and comparison with past Bertha storms."
  },
  {
    name: "Cristobal",
    code: "AL032026",
    classification: "Tropical Storm",
    status: "Dissipated (August 13, 2026)",
    href: "/storm/2026-cristobal/",
    blurb: "A short-lived open-Atlantic fish storm — NHC data, timeline, and how the 2026 version compares with past Cristobal storms."
  }
];
const archiveWorkflows = [
  {
    title: "I searched a storm name",
    body:
      "First confirm whether the name appears in the current NHC feed. If it does not, treat the search as historical context and move to named-storm tracker pages or NHC source links.",
    links: [
      { label: "Named storm trackers", href: "/hurricane-tracker/storm/" },
      { label: "Live hurricane tracker", href: "/hurricane-tracker/live/" }
    ]
  },
  {
    title: "I want historical comparison",
    body:
      "Compare track shape, latitude, pressure, category, surge setup, rainfall risk, and landfall timing instead of relying on one remembered category.",
    links: [
      { label: "Hurricane comparison tool", href: "/compare/" },
      { label: "Saffir-Simpson guide", href: "/blog/saffir-simpson-hurricane-wind-scale-explained/" }
    ]
  },
  {
    title: "I need local action now",
    body:
      "Leave the archive and move to live local signals: NWS alerts, city tracker context, evacuation-zone guidance, radar, and household decision tools.",
    links: [
      { label: "City hurricane trackers", href: "/hurricane-tracker/city/" },
      { label: "Evacuation decision helper", href: "/tools/evacuation-decision-helper/" }
    ]
  }
];
const comparisonChecklist = [
  "Was the historical storm intensifying, weakening, or transitioning when impacts began?",
  "Did the main impact come from wind, surge, rainfall, tornadoes, or long-duration power loss?",
  "Was the landfall angle similar, or did water pile into a different bay, sound, or river system?",
  "Were local watches, warnings, and evacuation orders issued on a similar timeline?",
  "Does the current storm have different forward speed, size, rainfall shield, or surge setup?"
];
const pageFaqs = [
  {
    question: "Does HurricaneHub store historical NHC advisories?",
    answer: "HurricaneHub currently focuses on active NHC storm records, advisory links, named-storm tracker pages, and current storm context. Deeper advisory timelines can be added as the archive expands."
  },
  {
    question: "How should I use past hurricane names during an active storm?",
    answer:
      "Use past names as context only. Compare track, category, pressure, surge, and rainfall patterns, then return to the current NHC advisory, NWS alerts, and local emergency instructions for decisions."
  },
  {
    question: "Why does a storm archive matter during hurricane season?",
    answer:
      "Storm-name searches spike before, during, and after advisory cycles. A stable archive helps people find current status, named-storm pages, historical comparison tools, and plain-language explainers from one place."
  },
  ...faqs
];
const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title, description, url, dateModified: lastModified }),
  itemListSchema([
    ...stormTrackerPages.map((storm) => ({
      name: `Hurricane ${storm.name} Tracker`,
      description: storm.searchDemandNote,
      url: `${site.url}/hurricane-tracker/storm/${storm.slug}/`
    })),
    ...namedStormArchives.map((storm) => ({
      name: `${storm.name} 2026 Storm Archive`,
      description: storm.blurb,
      url: `${site.url}${storm.href}`
    })),
    ...archiveWorkflows.flatMap((workflow) => workflow.links.map((link) => ({
      name: link.label,
      description: workflow.body,
      url: `${site.url}${link.href}`
    })))
  ]),
  faqSchema(pageFaqs)
);
---
<Layout title={title} description={description} canonical={url} jsonLd={jsonLd} lastModified={lastModified}>
  <section class="band" aria-labelledby="archive-title">
    <div class="inner">
      <p class="eyebrow">Storm history foundation</p>
      <h1 id="archive-title">Storm Archive and Current Advisory History</h1>
      <p class="answer">This page lists current NHC storm records and advisory links, then connects users to named-storm tracker pages, live radar, state trackers, and learning resources for storm-history context.</p>
    </div>
  </section>

  <section class="band" aria-labelledby="current-storms">
    <div class="inner">
      <h2 id="current-storms">Current NHC Storm Records</h2>
      <div class="stack" style="margin-top: 18px;">
        {storms.length ? storms.map((storm) => (
          <article class="storm-row">
            <header>
              <h3>{storm.name ?? storm.id ?? "Active storm"}</h3>
              <span class="badge warn">{storm.classification ?? "NHC"}</span>
            </header>
            <p>{storm.summary ?? "Current NHC storm data loaded."}</p>
            <p class="small">Position: {storm.latitude ?? "pending"}, {storm.longitude ?? "pending"} · Updated: {storm.lastUpdate ?? lastModified}</p>
            <p>
              {advisoryUrl(storm.publicAdvisory) && <a href={advisoryUrl(storm.publicAdvisory)} rel="nofollow">NHC public advisory</a>}
              {advisoryUrl(storm.forecastAdvisory) && <> · <a href={advisoryUrl(storm.forecastAdvisory)} rel="nofollow">NHC forecast advisory</a></>}
            </p>
          </article>
        )) : (
          <article class="panel">
            <h3>No Active NHC Storms</h3>
            <p>No active NHC tropical cyclone is listed in the current feed. Use named-storm trackers, the learning center, and the live tracker for current storm context.</p>
          </article>
        )}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="archive-plan">
    <div class="inner grid-2">
      <article>
        <h2 id="archive-plan">Storm History Context</h2>
        <p>Use the archive alongside named-storm tracker pages, the live tracker, radar, and learning guides to understand active systems, past storm names, advisory language, and forecast products.</p>
        <p><a class="action-link secondary-action" href="/hurricane-tracker/storm/">Browse named storm trackers</a></p>
      </article>
      <article class="panel">
        <h2>Use Today</h2>
        <p>For current decisions, pair the tracker with state NWS alerts, radar, and local emergency instructions.</p>
        <p><a class="action-link" href="/hurricane-tracker/live/">Open live tracker</a></p>
      </article>
    </div>
  </section>

  {registryStorms.length > 0 && (
    <section class="band" aria-labelledby="preserved-storms">
      <div class="inner">
        <p class="eyebrow">Preserved storm records</p>
        <h2 id="preserved-storms">Named Storm Pages From This Season</h2>
        <p class="answer">These stable URLs remain available after a system leaves the active NHC feed, preserving its final recorded status and source context.</p>
        <div class="grid-3 section-grid">
          {registryStorms.map((storm) => (
            <article class="panel">
              <span class={`badge ${storm.active ? "warn" : ""}`}>{storm.active ? "Active" : "Archived"}</span>
              <h3>{storm.name ?? storm.id}</h3>
              <p>{storm.classification ?? "Tropical system"} · {storm.intensity ?? storm.windSpeed ?? "final intensity pending"}</p>
              <p class="source-note">Last NHC record {storm.lastSeen}</p>
              <a href={`/hurricane-tracker/storm/${storm.slug}/`}>Open {storm.name ?? "storm"} page</a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="band" aria-labelledby="named-archive-2026">
    <div class="inner">
      <p class="eyebrow">2026 season archive</p>
      <h2 id="named-archive-2026">2026 Named Storm Archive Pages</h2>
      <p class="answer">Final NHC records, timelines, impact summaries, and historical same-name comparisons for the 2026 Atlantic named storms. Each page preserves the storm's last recorded status and official source context.</p>
      <div class="grid-3 section-grid">
        {namedStormArchives.map((storm) => (
          <article class="panel">
            <span class="badge">{storm.classification}</span>
            <h3><a href={storm.href}>{storm.name} 2026 Archive</a></h3>
            <p>{storm.blurb}</p>
            <p class="source-note">{storm.code} · {storm.status}</p>
            <a href={storm.href}>Open {storm.name} 2026 archive</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="archive-workflow">
    <div class="inner">
      <p class="eyebrow">Archive to action</p>
      <h2 id="archive-workflow">How to Use Storm History During an Active Season</h2>
      <div class="grid-3 section-grid">
        <article class="panel">
          <h3>Start With the Current Feed</h3>
          <p>Check whether NHC is listing an active tropical cyclone now, then open the public advisory for the official position, intensity, and warning context.</p>
          <a href="/hurricane-tracker/live/">Open live tracker map</a>
        </article>
        <article class="panel">
          <h3>Use Named Storm Pages</h3>
          <p>Storm-name pages help searchers confirm whether Erin, Melissa, or another named storm is active and where to find current advisory links.</p>
          <a href="/hurricane-tracker/storm/">Browse named storm trackers</a>
        </article>
        <article class="panel">
          <h3>Move From History to Local Risk</h3>
          <p>Historical comparisons can explain context, but local NWS alerts, city trackers, and evacuation-zone instructions control real household decisions.</p>
          <a href="/hurricane-tracker/city/">Browse city hurricane trackers</a>
        </article>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="archive-intents">
    <div class="inner">
      <p class="eyebrow">Search paths</p>
      <h2 id="archive-intents">What People Usually Need From a Storm Archive</h2>
      <p class="answer">Storm archive searches are rarely only historical. Most users are trying to confirm a current named storm, compare it with a remembered hurricane, or move from storm history to local risk.</p>
      <div class="grid-2 section-grid">
        {archiveIntents.map((intent) => (
          <article class="panel">
            <h3>{intent.title}</h3>
            <p>{intent.body}</p>
            <p><a class="action-link secondary-action" href={intent.href}>{intent.label}</a></p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="archive-comparison-guides">
    <div class="inner">
      <p class="eyebrow">Historical comparison guides</p>
      <h2 id="archive-comparison-guides">Read These Before Comparing Hurricanes</h2>
      <p class="answer">The safest historical comparison looks beyond one number. Pair archive records with explainers for track uncertainty, category limits, surge, and rapid intensification.</p>
      <div class="grid-2 section-grid">
        {comparisonGuides.map((guide) => (
          <article class="panel">
            <h3><a href={guide.href}>{guide.title}</a></h3>
            <p>{guide.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="archive-search-workflow">
    <div class="inner">
      <p class="eyebrow">Search workflow</p>
      <h2 id="archive-search-workflow">Start Here Based on Why You Searched</h2>
      <p class="answer">Storm archive visitors usually need one of three paths: confirm whether a named storm is active, compare a current storm with history, or move from history to local action.</p>
      <div class="grid-3 section-grid">
        {archiveWorkflows.map((workflow) => (
          <article class="panel">
            <h3>{workflow.title}</h3>
            <p>{workflow.body}</p>
            <ul class="check-list">
              {workflow.links.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="archive-checklist">
    <div class="inner grid-2">
      <article>
        <p class="eyebrow">Comparison checklist</p>
        <h2 id="archive-checklist">Questions to Ask Before Comparing Two Hurricanes</h2>
        <p class="answer">Two storms with the same category can produce very different impacts. Use the archive as context, then verify today's official advisory and local alerts before making decisions.</p>
      </article>
      <article class="panel">
        <ul class="check-list">
          {comparisonChecklist.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </div>
  </section>

  <section class="band" aria-labelledby="archive-names">
    <div class="inner">
      <p class="eyebrow">Storm-name shortcuts</p>
      <h2 id="archive-names">Named Hurricane Tracker Pages</h2>
      <div class="grid-2 section-grid">
        {stormTrackerPages.map((storm) => (
          <article class="panel">
            <p class="eyebrow">{storm.basin}</p>
            <h3><a href={`/hurricane-tracker/storm/${storm.slug}/`}>Hurricane {storm.name} Tracker</a></h3>
            <p>{storm.searchDemandNote}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <FaqBlock faqs={pageFaqs} />
</Layout>
