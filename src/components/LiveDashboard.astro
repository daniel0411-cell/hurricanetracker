---
import { states } from "../data/site";
---
<section class="band dashboard-band" aria-labelledby="live-heading">
  <div class="inner">
    <div class="dashboard-header">
      <div>
        <p class="eyebrow">Live operations</p>
        <h2 id="live-heading">Decision Dashboard</h2>
      </div>
      <form class="dashboard-toolbar" id="alert-form">
        <label class="sr-only" for="state">State</label>
        <div class="select-wrap">
          <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
          <select id="state" name="state">
            {states.map(([code, name]) => <option value={code} selected={code === "FL"}>{name}</option>)}
          </select>
        </div>
        <button type="submit" aria-label="Refresh alerts" title="Refresh alerts">
          <i class="fa-solid fa-rotate" aria-hidden="true"></i>
        </button>
        <span id="feed-status" class="feed-status" role="status">Waiting for feed...</span>
      </form>
    </div>

    <div class="metric-strip" aria-label="Current operational metrics">
      <div class="metric">
        <i class="fa-solid fa-hurricane" aria-hidden="true"></i>
        <div>
          <strong id="storm-count">--</strong>
          <span>active NHC systems</span>
        </div>
      </div>
      <div class="metric">
        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
        <div>
          <strong id="alert-count">--</strong>
          <span>state alerts</span>
        </div>
      </div>
      <div class="metric">
        <i class="fa-solid fa-crosshairs" aria-hidden="true"></i>
        <div>
          <strong id="decision-level">--</strong>
          <span>decision level</span>
        </div>
      </div>
      <div class="metric">
        <i class="fa-solid fa-clock" aria-hidden="true"></i>
        <div>
          <strong>10m</strong>
          <span>cache window</span>
        </div>
      </div>
    </div>

    <div class="dashboard-body">
      <article class="panel storm-panel">
        <h3>Active Storms</h3>
        <div id="storm-list" class="storm-bar" aria-live="polite">
          <p class="source-note">Loading storms...</p>
        </div>
      </article>

      <article class="panel alert-panel">
        <h3>Priority Alerts</h3>
        <div id="alert-list" class="alert-list" aria-live="polite">
          <p class="source-note">Loading alerts...</p>
        </div>
      </article>
    </div>

    <p class="source-note dashboard-note">Official feeds are fetched through Cloudflare API routes and cached in KV when a binding is available.</p>
  </div>
</section>

<script>
  type Storm = {
    name?: string;
    id?: string;
    classification?: string;
    summary?: string;
    publicAdvisory?: string;
  };
  type Alert = {
    event?: string;
    headline?: string;
    areaDesc?: string;
    severity?: string;
    urgency?: string;
    expires?: string;
  };
  type StormFeed = {
    storms?: Storm[];
    fetchedAt?: string;
    updatedAt?: string;
  };
  type AlertFeed = {
    alerts?: Alert[];
    decisionLevel?: string;
    fetchedAt?: string;
    updatedAt?: string;
  };

  const form = document.querySelector("#alert-form");
  const stateSelect = document.querySelector("#state");
  const statusEl = document.querySelector("#feed-status");
  const stormCount = document.querySelector("#storm-count");
  const alertCount = document.querySelector("#alert-count");
  const decisionEl = document.querySelector("#decision-level");
  const stormList = document.querySelector("#storm-list");
  const alertList = document.querySelector("#alert-list");
  const DEFAULT_STATE = "FL";

  function severityClass(text: string) {
    if (/Extreme|Severe|Warning|Leave|Evacuation/i.test(text)) return "severity-leave";
    if (/Watch|Act|Flood|Tornado|Thunderstorm|Marine/i.test(text)) return "severity-act";
    return "severity-monitor";
  }

  function decisionClass(text: string) {
    if (/Leave/i.test(text)) return "decision-leave";
    if (/Act/i.test(text)) return "decision-act";
    if (/Prepare/i.test(text)) return "decision-prepare";
    return "decision-monitor";
  }

  function escapeHtml(value: unknown) {
    const replacements: Record<string, string> = {
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#039;"
    };
    return String(value ?? "").replace(/[&<>"']/g, (char) => replacements[char] ?? char);
  }

  async function loadFeeds(state = DEFAULT_STATE) {
    if (!statusEl || !stormCount || !alertCount || !decisionEl || !stormList || !alertList) return;
    statusEl.textContent = "Loading...";
    const [stormsResponse, alertsResponse] = await Promise.all([
      fetch("/api/nhc/current.json"),
      fetch(`/api/nws/alerts.json?state=${encodeURIComponent(state)}`)
    ]);
    const stormsData = await stormsResponse.json() as StormFeed;
    const alertsData = await alertsResponse.json() as AlertFeed;
    const storms = stormsData.storms ?? [];
    const alerts = alertsData.alerts ?? [];
    stormCount.textContent = String(storms.length);
    alertCount.textContent = String(alerts.length);
    const decision = alertsData.decisionLevel ?? "Monitor";
    decisionEl.textContent = decision;
    decisionEl.className = decisionClass(decision);
    const updatedAt = alertsData.updatedAt ?? alertsData.fetchedAt ?? stormsData.updatedAt ?? stormsData.fetchedAt;
    const updatedLabel = updatedAt
      ? new Date(updatedAt).toLocaleString([], { dateStyle: "medium", timeStyle: "short" })
      : "time unavailable";
    statusEl.textContent = `Checked ${updatedLabel}`;

    stormList.innerHTML = storms.length
      ? storms.slice(0, 5).map((storm) => {
        const severity = severityClass(storm.classification ?? "");
        return `
        <article class="storm-chip ${severity}">
          <span class="storm-name">${escapeHtml(storm.name ?? storm.id ?? "Active system")}</span>
          <span class="storm-class">${escapeHtml(storm.classification ?? "NHC")}</span>
          ${storm.publicAdvisory ? `<a href="${escapeHtml(storm.publicAdvisory)}" rel="nofollow" aria-label="NHC advisory">NHC</a>` : ""}
        </article>
      `;
      }).join("")
      : '<p class="source-note">No active NHC tropical cyclone in the current feed.</p>';

    alertList.innerHTML = alerts.length
      ? alerts.slice(0, 6).map((alert) => {
        const severity = severityClass(alert.severity ?? alert.event ?? "");
        return `
        <article class="alert-row ${severity}">
          <div class="alert-severity" aria-hidden="true"></div>
          <div class="alert-content">
            <header>
              <h4>${escapeHtml(alert.event)}</h4>
              <span class="badge">${escapeHtml(alert.severity)}</span>
            </header>
            <p>${escapeHtml(alert.headline || alert.areaDesc)}</p>
            <p class="small">${escapeHtml(alert.urgency)} · expires ${escapeHtml(alert.expires)}</p>
          </div>
        </article>
      `;
      }).join("")
      : '<p class="source-note">No active alerts returned for this state.</p>';
  }

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const state = stateSelect instanceof HTMLSelectElement ? stateSelect.value : DEFAULT_STATE;
    loadFeeds(state).catch(() => {
      if (statusEl) statusEl.textContent = "Feed unavailable; retry shortly.";
    });
  });

  loadFeeds().catch(() => {
    if (statusEl) statusEl.textContent = "Feed unavailable; retry shortly.";
  });
</script>
