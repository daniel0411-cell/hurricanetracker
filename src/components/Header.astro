---
import { site } from "../data/site";
import { useTranslations, type Lang } from "../i18n/ui";
import SearchModal from "./SearchModal.astro";

type Props = {
  lang?: Lang;
};

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const homeHref = "/";

const navItems = [
  { href: "/", label: t("nav.home") },
  { href: "/tracker/", label: t("nav.tracker") },
  { href: "/hurricane-tracker/city/", label: t("nav.cities") },
  { href: "/hurricane-tracker/storm/", label: t("nav.storms") },
  { href: "/alerts/", label: t("nav.alerts") },
  { href: "/radar/", label: t("nav.radar") },
  { href: "/learn/", label: t("nav.learn") },
  { href: "/preparedness/", label: t("nav.prepare") },
  { href: "/compare/", label: t("nav.compare") },
  { href: "/tools/", label: t("nav.tools") },
  { href: "/blog/", label: t("nav.blog") },
  { href: "/about/", label: t("nav.about") }
];
---

<header class="site-header">
  <a class="brand" href={homeHref} aria-label="HurricaneHub home">
    <span class="brand-mark" aria-hidden="true"></span>
    <span>{site.name}</span>
  </a>
  <button type="button" class="nav-toggle" id="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="primary-nav">
    <span class="bar"></span><span class="bar"></span><span class="bar"></span>
  </button>
  <nav class="primary-nav" id="primary-nav" aria-label="Primary">
    {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    <SearchModal variant="trigger" />
    <button type="button" id="theme-toggle" class="theme-toggle" aria-label={t("theme.toggle")} aria-pressed="false">
      <span class="theme-toggle-icon" aria-hidden="true">🌙</span>
      <span class="theme-toggle-label">{t("theme.dark")}</span>
    </button>
  </nav>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById("theme-toggle");
    if (!btn) return;
    var icon = btn.querySelector(".theme-toggle-icon");
    var label = btn.querySelector(".theme-toggle-label");
    function sync() {
      var dark = document.documentElement.dataset.theme === "dark";
      if (icon) icon.textContent = dark ? "☀️" : "🌙";
      if (label) label.textContent = dark ? "Light" : "Dark";
      btn.setAttribute("aria-pressed", String(dark));
    }
    sync();
    btn.addEventListener("click", function () {
      var dark = document.documentElement.dataset.theme === "dark";
      var next = dark ? "light" : "dark";
      if (next === "dark") document.documentElement.dataset.theme = "dark";
      else delete document.documentElement.dataset.theme;
      try { localStorage.setItem("hurricanehub:theme", next); } catch (e) {}
      sync();
    });
  })();

  (function () {
    var toggle = document.getElementById("nav-toggle");
    var nav = document.getElementById("primary-nav");
    if (!toggle || !nav) return;
    function setOpen(open) {
      nav.classList.toggle("open", open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    }
    toggle.addEventListener("click", function () {
      setOpen(!nav.classList.contains("open"));
    });
    nav.querySelectorAll("a").forEach(function (link) {
      link.addEventListener("click", function () { setOpen(false); });
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && nav.classList.contains("open")) setOpen(false);
    });
  })();
</script>

<style>
  .theme-toggle {
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-left: 6px;
    padding: 0 11px;
    border-radius: 6px;
    border: 1px solid rgba(122, 134, 142, 0.4);
    background: transparent;
    color: var(--muted);
    font-size: 0.86rem;
    font-weight: 800;
    cursor: pointer;
  }

  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    background: #e7eef1;
    color: var(--ink);
  }

  :root[data-theme="dark"] .theme-toggle {
    color: var(--muted);
    border-color: rgba(159, 176, 187, 0.5);
  }

  :root[data-theme="dark"] .theme-toggle:hover,
  :root[data-theme="dark"] .theme-toggle:focus-visible {
    background: #1c2e3b;
    color: var(--ink);
  }
</style>
