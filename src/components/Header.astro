---
import { site } from "../data/site";
import { useTranslations, type Lang, languages } from "../i18n/ui";

type Props = {
  lang?: Lang;
};

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const homeHref = lang === "es" ? "/es/" : "/";
const altLang = lang === "es" ? "en" : "es";
const altHref = lang === "es" ? "/" : "/es/";

const navItems = [
  { href: "/tracker/", label: t("nav.tracker") },
  { href: "/radar/", label: t("nav.radar") },
  { href: "/embed/radar", label: t("nav.standalone") },
  { href: "/compare/", label: t("nav.compare") },
  { href: "/tools/", label: t("nav.tools") },
  { href: "/blog/", label: t("nav.blog") },
  { href: "/about/", label: t("nav.about") }
];
---

<header class="site-header">
  <a class="brand" href={homeHref} aria-label="HurricaneHub home">
    <span class="brand-mark" aria-hidden="true"></span>
    <span>{site.name}</span>
  </a>
  <nav aria-label="Primary">
    {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    <a class="lang-switch" href={altHref} hreflang={altLang} aria-label={`${t("language.label")}: ${languages[altLang]}`}>
      {languages[altLang]}
    </a>
    <button type="button" id="theme-toggle" class="theme-toggle" aria-label={t("theme.toggle")} aria-pressed="false">
      <span class="theme-toggle-icon" aria-hidden="true">🌙</span>
      <span class="theme-toggle-label">{t("theme.dark")}</span>
    </button>
  </nav>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById("theme-toggle");
    if (!btn) return;
    var icon = btn.querySelector(".theme-toggle-icon");
    var label = btn.querySelector(".theme-toggle-label");
    function sync() {
      var dark = document.documentElement.dataset.theme === "dark";
      if (icon) icon.textContent = dark ? "☀️" : "🌙";
      if (label) label.textContent = dark ? "Light" : "Dark";
      btn.setAttribute("aria-pressed", String(dark));
    }
    sync();
    btn.addEventListener("click", function () {
      var dark = document.documentElement.dataset.theme === "dark";
      var next = dark ? "light" : "dark";
      if (next === "dark") document.documentElement.dataset.theme = "dark";
      else delete document.documentElement.dataset.theme;
      try { localStorage.setItem("hurricanehub:theme", next); } catch (e) {}
      sync();
    });
  })();
</script>

<style>
  .theme-toggle {
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-left: 6px;
    padding: 0 11px;
    border-radius: 6px;
    border: 1px solid rgba(122, 134, 142, 0.4);
    background: transparent;
    color: var(--muted);
    font-size: 0.86rem;
    font-weight: 800;
    cursor: pointer;
  }

  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    background: #e7eef1;
    color: var(--ink);
  }

  .lang-switch {
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    padding: 0 11px;
    border-radius: 6px;
    border: 1px solid rgba(122, 134, 142, 0.4);
    color: var(--muted);
    text-decoration: none;
    font-size: 0.86rem;
    font-weight: 800;
  }

  .lang-switch:hover,
  .lang-switch:focus-visible {
    background: #e7eef1;
    color: var(--ink);
  }

  :root[data-theme="dark"] .theme-toggle,
  :root[data-theme="dark"] .lang-switch {
    color: var(--muted);
    border-color: rgba(159, 176, 187, 0.5);
  }

  :root[data-theme="dark"] .theme-toggle:hover,
  :root[data-theme="dark"] .theme-toggle:focus-visible,
  :root[data-theme="dark"] .lang-switch:hover,
  :root[data-theme="dark"] .lang-switch:focus-visible {
    background: #1c2e3b;
    color: var(--ink);
  }
</style>
