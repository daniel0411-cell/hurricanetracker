---
import FaqBlock from "./FaqBlock.astro";
import Layout from "../layouts/Layout.astro";
import { site, states } from "../data/site";
import { preparednessSteps, type LocalPreparednessPage } from "../data/localPreparednessPages";
import { articleSchema, breadcrumbSchema, faqSchema, graph, howToSchema, websiteSchema } from "../lib/schema";

const { page } = Astro.props as { page: LocalPreparednessPage };
const path = page.kind === "state" ? `state/${page.slug}/preparedness/` : `city/${page.slug}/hurricane-tracker/`;
const url = `${site.url}/${path}`;
const statePage = `/state/${page.stateSlug}/preparedness/`;
const hasStateTracker = states.some(([, name]) => name === page.stateName);
const currentTracker = page.kind === "city" ? `/hurricane-tracker/city/${page.slug}/` : hasStateTracker ? `/tracker/${page.stateSlug}/` : "/hurricane-tracker/live/";
const currentTrackerLabel = page.kind === "city" || hasStateTracker ? `Current ${page.name} storm context and alerts` : "All-basin live hurricane tracker";
const lastModified = page.dateModified ?? site.contentLastModified;
const record = page.planningRecord;
const jsonLd = graph(
  websiteSchema(),
  articleSchema({ title: page.title, description: page.description, url, dateModified: lastModified }),
  faqSchema(page.faqs),
  howToSchema({ name: record ? record.title : `${page.name} seven-day hurricane preparedness checklist`, description: record?.intro ?? `Prepare a household in ${page.name} for evacuation, outages, flooding, and official hurricane alerts.`, url, steps: record?.steps ?? preparednessSteps }),
  breadcrumbSchema([{ name: "Home", url: site.canonicalUrl }, { name: page.stateName, url: page.kind === "state" ? url : `${site.url}${statePage}` }, { name: `${page.name} Hurricane Guide`, url }])
);
---

<Layout title={page.title} description={page.description} canonical={url} jsonLd={jsonLd} lastModified={lastModified}>
  <section class="band local-hero" aria-labelledby="local-title"><div class="inner"><p class="eyebrow">2026 Atlantic season readiness</p><h1 id="local-title">{page.name} Hurricane {page.kind === "state" ? "Preparedness" : "Preparedness and Evacuation"} Guide</h1><p class="answer">Use this standing guide to prepare supplies, transport, evacuation arrangements, and official contacts before a storm. It does not describe a current threat to {page.name}.</p>{page.dateModified && <p>Guide revised <time datetime={page.dateModified}>{page.dateModified}</time>.</p>}<p class="section-actions"><a class="action-link" href="/2026-hurricane-season/">2026 season hub</a><a class="action-link secondary-action" href={currentTracker}>{currentTrackerLabel}</a></p></div></section>

  <nav class="local-sections inner" aria-label={`${page.name} guide sections`}>
    <a href="#official-resources">Official resources</a>
    <a href="#evacuation-plan">Evacuation guidance</a>
    <a href={record ? "#household-record" : "#kit-checklist"}>{record ? "Household planning record" : "Supply checklist"}</a>
    <a href="#local-risk">Local risks</a>
    {!record && <a href="#storm-history">Storm history</a>}
    <a href="#faq-heading">FAQs</a>
  </nav>

  <section class="band" aria-labelledby="local-risk"><div class="inner"><p class="eyebrow">Local vulnerability</p><h2 id="local-risk">Why {page.name} Faces Hurricane Risk</h2>{page.risk.map((paragraph) => <p class="answer">{paragraph}</p>)}</div></section>

  {record ? <section class="band" aria-labelledby="household-record"><div class="inner"><p class="eyebrow">Household planning record</p><h2 id="household-record">{record.title}</h2><p class="answer">{record.intro}</p><ol class="record-steps">{record.steps.map((step) => <li><h3>{step.name}</h3><p>{step.text}</p></li>)}</ol><h3>Worked Record: Confirmed and Unfinished Arrangements</h3><p>{record.example}</p><p><a href="/tools/preparedness-checklist/">Build the separate household supply checklist</a> &middot; <a href="/blog/hurricane-medical-needs-registry-preparedness/">Work through medical and equipment confirmations</a></p></div></section> : <section class="band muted" aria-labelledby="storm-history"><div class="inner"><p class="eyebrow">Historical context</p><h2 id="storm-history">Past Storms and {page.name} Planning</h2><p>These events illustrate different planning hazards, not a forecast of the next storm. A storm's peak category is not necessarily the wind experienced in {page.name}, and does not measure rainfall, surge, or community impact.</p><div class="history-grid">{page.history.map((item) => <article><h3>{item.storm}</h3><p>{item.detail}</p></article>)}</div><p class="source-note">Source context: <a href="https://www.nhc.noaa.gov/data/tcr/" rel="noopener nofollow">NHC Tropical Cyclone Reports</a> and official state emergency guidance.</p></div></section>}

  <section class="band" aria-labelledby="evacuation-plan"><div class="inner"><p class="eyebrow">Leave by local order</p><h2 id="evacuation-plan">Evacuation Zones, Routes and Timing</h2>{page.evacuation.map((paragraph) => <p class="answer">{paragraph}</p>)}{page.sourceCheck && <p class="source-note">Source check {page.sourceCheck.date}: {page.sourceCheck.scope}</p>}<aside class="safety-note"><strong>Route safety:</strong> Never rely on a remembered route, automatic contraflow, or a forecast center line. Check the current local order, road conditions, destination risk, and arrival of tropical-storm-force winds.</aside></div></section>

  {!record && <section class="band muted" aria-labelledby="kit-checklist"><div class="inner"><p class="eyebrow">Seven-day baseline</p><h2 id="kit-checklist">{page.name} Hurricane Emergency Kit Checklist</h2><ol class="checklist">{preparednessSteps.map((step) => <li><h3>{step.name}</h3><p>{step.text}</p></li>)}</ol></div></section>}

  <section class="band" aria-labelledby="official-resources"><div class="inner"><p class="eyebrow">Decision sources</p><h2 id="official-resources">Official {page.name} Emergency Resources</h2><p class="answer">Shelter locations and evacuation orders change by event. Use the official links below for current information rather than treating this guide as an emergency directive.</p><div class="resource-grid">{page.resources.map((resource) => <a href={resource.href} rel="noopener nofollow">{resource.label}</a>)}<a href="https://www.weather.gov/" rel="noopener nofollow">National Weather Service alerts</a><a href="https://www.nhc.noaa.gov/" rel="noopener nofollow">National Hurricane Center</a></div></div></section>

  <section class="band link-band" aria-labelledby="planning-links"><div class="inner"><p class="eyebrow">Keep planning connected</p><h2 id="planning-links">Track the Storm, Then Check Local Risk</h2><div class="link-grid">{page.kind === "city" && <a href={statePage}>Open {page.stateName} preparedness guide</a>}{hasStateTracker && <a href={`/tracker/${page.stateSlug}/`}>Open {page.stateName} live tracker</a>}<a href="/hurricane-tracker/live/">Open live hurricane tracker</a><a href="/tools/preparedness-checklist/">Build a preparedness checklist</a><a href="/tools/storm-surge-checker/">Screen surge alerts at a ZIP representative point</a><a href="/hurricane-tracker/storm/">Current and archived named storms</a></div></div></section>

  <FaqBlock faqs={page.faqs} />
</Layout>

<style>
  .local-hero { background: #123644; color: #fff; }
  .local-hero .answer { color: #e1edf1; }
  .local-sections { display: flex; flex-wrap: wrap; gap: 12px 24px; padding-block: 20px; }
  .local-sections a { text-decoration: underline; text-underline-offset: 3px; }
  .local-sections a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  h2[id] { scroll-margin-top: 88px; }
  .muted { background: var(--surface, #f3f6f7); }
  .history-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin-top: 24px; }
  .history-grid article { padding: 18px; border-left: 4px solid var(--ocean); background: var(--bg, #fff); }
  .history-grid h3, .checklist h3 { margin: 0 0 8px; }
  .safety-note { margin-top: 20px; padding: 18px; border: 1px solid var(--line); border-radius: 8px; background: #fff3cd; color: #4b3900; }
  .checklist { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 28px; padding-left: 24px; }
  .checklist li { padding: 10px 12px; }
  .record-steps { padding-left: 24px; }
  .record-steps li { padding: 12px 0; border-bottom: 1px solid var(--line); }
  .record-steps h3 { margin: 0 0 8px; }
  .resource-grid, .link-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .resource-grid a, .link-grid a { padding: 14px; border: 1px solid var(--line); border-radius: 6px; background: var(--bg, #fff); font-weight: 800; }
  :global([data-theme="dark"]) .history-grid article, :global([data-theme="dark"]) .resource-grid a, :global([data-theme="dark"]) .link-grid a { background: #111d22; }
  :global([data-theme="dark"]) .safety-note { background: #3e3212; color: #fff0bd; }
  @media (max-width: 720px) { .history-grid, .checklist, .resource-grid, .link-grid { grid-template-columns: 1fr; } }
</style>
