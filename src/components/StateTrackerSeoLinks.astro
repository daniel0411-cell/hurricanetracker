---
import type { CoastalState } from "../data/states";
import type { HurricaneCity } from "../data/cities";
type Props = { state: CoastalState; cities: HurricaneCity[] };
const { state } = Astro.props;
---
<nav class="state-reading" aria-label={`${state.name} map reading guides`}>
  <h2>Read the Products Behind This Check</h2>
  <ul>
    <li><a href="/hurricane-tracker/map/">Track and cone: probable center positions</a></li>
    <li><a href="/hurricane-tracker/storm-surge-map/">Surge map: above-ground inundation and its legend</a></li>
    <li><a href="/hurricane-tracker/evacuation-zones/">Evacuation zones: local instructions for your address</a></li>
  </ul>
</nav>
<style>
  .state-reading { margin: 28px 0; border-top: 1px solid var(--line); padding-top: 20px; }
  .state-reading ul { display: grid; gap: 10px; padding-left: 1.2rem; }
</style>
