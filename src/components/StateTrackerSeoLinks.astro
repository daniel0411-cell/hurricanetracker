---
import type { CoastalState } from "../data/states";
import type { HurricaneCity } from "../data/cities";
import { topicPages } from "../data/topicPages";

type Props = {
  state: CoastalState;
  cities: HurricaneCity[];
};

const { state, cities } = Astro.props;
const featuredCities = cities.slice(0, 4);
const primaryRisks = state.risks.slice(0, 4);
const priorityTopics = ["live-tracker", "map", "radar", "spaghetti-models", "evacuation-zones", "storm-surge-map", "preparedness-checklist"]
  .map((slug) => topicPages.find((page) => page.slug === slug))
  .filter((page): page is NonNullable<typeof page> => Boolean(page));
const searchQueries = [
  `${state.name} hurricane tracker`,
  `hurricane tracker ${state.name}`,
  `${state.code.toLowerCase()} hurricane tracker`,
  `${state.name} hurricane alerts`,
  `${state.name} evacuation zones`,
  `${state.name} storm surge map`,
  `${state.name} hurricane radar`
];
const cityRiskQueries = featuredCities.flatMap((city) => [
  `${city.name} hurricane tracker`,
  `${city.name} storm surge`,
  `${city.name} evacuation zones`
]).slice(0, 12);
---
<section class="state-seo-block" aria-labelledby="state-seo-heading">
  <div class="grid-2 section-grid">
    <article class="panel">
      <p class="eyebrow">Local search path</p>
      <h2 id="state-seo-heading">Use This {state.name} Tracker With Local Pages</h2>
      <p>{state.preparednessNote}</p>
      <ul class="check-list">
        <li><a href="/hurricane-tracker/live/">Check the live hurricane tracker map</a></li>
        <li><a href="/local-hurricane-risk/">Check local hurricane risk by ZIP, city, or state</a></li>
        <li><a href="/alerts/">Review active NWS alerts by state</a></li>
        <li><a href="/tools/local-risk-plan/">Build a local 72-hour action plan</a></li>
        <li><a href="/hurricane-tracker/map/">Compare hurricane tracker map options</a></li>
        <li><a href="/learn/">Learn how to read hurricane tracker products</a></li>
      </ul>
    </article>
    <article class="panel">
      <p class="eyebrow">Risk context</p>
      <h2>{state.name} Hurricane Planning Signals</h2>
      <p>State trackers are broad screens. Pair this page with city trackers, county emergency management, and official weather.gov alerts before making evacuation or shelter decisions.</p>
      <div class="risk-tags">
        {primaryRisks.map((risk) => <span class="risk-tag">{risk}</span>)}
      </div>
      <p class="source-note">Common searches this page answers: {searchQueries.join(", ")}.</p>
    </article>
  </div>

  <div class="state-seo-cities" aria-labelledby="state-topic-shortcuts-heading">
    <h2 id="state-topic-shortcuts-heading">{state.name} Hurricane Topic Shortcuts</h2>
    <p class="source-note">Use these topic hubs to move from a state-level tracker into the specific hurricane question behind the search.</p>
    <div class="grid-3 section-grid">
      {priorityTopics.map((topic) => (
        <article class="panel compact-panel">
          <p class="eyebrow">{topic.intent}</p>
          <h3><a href={`/hurricane-tracker/${topic.slug}/`}>{topic.title}</a></h3>
          <p>{topic.description}</p>
        </article>
      ))}
    </div>
  </div>

  <div class="state-seo-cities" aria-labelledby="state-risk-shortcuts-heading">
    <h2 id="state-risk-shortcuts-heading">{state.name} Hurricane Risk Shortcuts</h2>
    <div class="grid-3 section-grid">
      <article class="panel compact-panel">
        <h3><a href="/local-hurricane-risk/">Local hurricane risk</a></h3>
        <p>Use ZIP, city, state, storm surge, evacuation-zone, and household planning paths for {state.name} risk checks.</p>
      </article>
      <article class="panel compact-panel">
        <h3><a href="/hurricane-tracker/evacuation-zones/">Evacuation zones</a></h3>
        <p>Understand how local evacuation zones, official orders, surge risk, and household constraints fit together.</p>
      </article>
      <article class="panel compact-panel">
        <h3><a href="/hurricane-tracker/storm-surge-map/">Storm surge map</a></h3>
        <p>Review why surge risk is local and separate from hurricane category, especially for coastal counties.</p>
      </article>
    </div>
  </div>

  {featuredCities.length ? (
    <div class="state-seo-cities" aria-labelledby="state-city-shortcuts-heading">
      <h2 id="state-city-shortcuts-heading">High-Intent {state.name} City Shortcuts</h2>
      <div class="grid-2 section-grid">
        {featuredCities.map((city) => (
          <article class="panel compact-panel">
            <h3><a href={`/hurricane-tracker/city/${city.slug}/`}>{city.name} Hurricane Tracker</a></h3>
            <p>{city.planningNote}</p>
          </article>
        ))}
      </div>
      <p class="source-note">Local searches covered by these city paths: {cityRiskQueries.join(", ")}.</p>
    </div>
  ) : null}
</section>

<style>
  .state-seo-block { margin-top: 34px; }
  .state-seo-cities { margin-top: 28px; }
  .compact-panel h3 { margin-top: 0; }
  .compact-panel p { margin-bottom: 0; }
</style>
