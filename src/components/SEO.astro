---
import { breadcrumbSchema, graph, organizationSchema, websiteSchema } from "../lib/schema";
import { site } from "../data/site";

type Props = {
  title: string;
  description: string;
  canonical: string;
  siteName: string;
  jsonLd?: object;
  lastModified?: string;
  image?: string;
  ogImage?: string;
  imageAlt?: string;
  publishedTime?: string;
};

const { title, description, canonical, siteName, jsonLd, lastModified, image, ogImage, imageAlt, publishedTime } = Astro.props;
const modified = lastModified ?? site.contentLastModified;
const schema = jsonLd ?? graph(websiteSchema(), organizationSchema());

// Canonicalize every page's canonical to https://www.<host>/... so it matches
// the sitemap URLs and the middleware redirect target exactly. Fixes the
// homepage's missing trailing slash (site.url has none) and any stray http://
// or non-www variants crawlers might discover.
const canonicalHost = new URL(site.url).hostname;
function normalizeCanonical(input: string): string {
  const u = new URL(input);
  u.protocol = "https:";
  u.hostname = canonicalHost;
  if (u.pathname === "") u.pathname = "/";
  return u.href;
}
const canonicalHref = normalizeCanonical(canonical);

const absoluteImage = image ? new URL(image, canonicalHref).href : undefined;
const absoluteOgImage = ogImage ? new URL(ogImage, canonicalHref).href : absoluteImage ?? new URL("/images/og/default-og.png", canonicalHref).href;

// Social cards from scripts/gen-og.mjs and the site default are always 1200x630.
// Only declare dimensions for those; a page-supplied hero `image` fallback has
// unknown intrinsic size and a wrong og:image:width breaks crawler previews.
const ogImageIsSocialCard = Boolean(ogImage) || !absoluteImage;
const ogImageAlt = imageAlt ?? `${title} — ${siteName}`;

// Blog article URLs are /blog/<slug>/; everything else stays a website.
// Derived from the canonical path so no page has to pass an extra prop.
const canonicalSegments = new URL(canonicalHref).pathname.split("/").filter(Boolean);
const isArticle = canonicalSegments[0] === "blog" && canonicalSegments.length === 2;
const ogType = isArticle ? "article" : "website";

function labelForSegment(segment: string) {
  return segment
    .split("-")
    .filter(Boolean)
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");
}

function breadcrumbsFor(canonicalUrl: string) {
  const url = new URL(canonicalUrl);
  const segments = url.pathname.split("/").filter(Boolean);
  const items = [{ name: site.name, url: site.canonicalUrl }];
  segments.forEach((segment, index) => {
    const path = `/${segments.slice(0, index + 1).join("/")}/`;
    items.push({
      name: labelForSegment(segment),
      url: new URL(path, site.url).href
    });
  });
  return breadcrumbSchema(items);
}

const breadcrumb = breadcrumbsFor(canonicalHref);
const schemaWithBreadcrumb = (() => {
  const current = schema as { "@graph"?: object[] };
  if (Array.isArray(current["@graph"])) {
    return {
      ...current,
      "@graph": [...current["@graph"], breadcrumb]
    };
  }
  return graph(current, breadcrumb);
})();
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalHref} />
<meta name="last-modified" content={modified} />
<meta name="robots" content="index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1" />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalHref} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="en_US" />
{absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}
{absoluteOgImage && <meta property="og:image:alt" content={ogImageAlt} />}
{absoluteOgImage && ogImageIsSocialCard && <meta property="og:image:width" content="1200" />}
{absoluteOgImage && ogImageIsSocialCard && <meta property="og:image:height" content="630" />}
{isArticle && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{isArticle && <meta property="article:modified_time" content={modified} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{absoluteOgImage && <meta name="twitter:image" content={absoluteOgImage} />}
{absoluteOgImage && <meta name="twitter:image:alt" content={ogImageAlt} />}
<script is:inline type="application/ld+json" set:html={JSON.stringify(schemaWithBreadcrumb)} />
