---
import { breadcrumbSchema, graph, organizationSchema, websiteSchema } from "../lib/schema";
import { site } from "../data/site";
import { contentModifiedFor } from "../data/contentDates";
import { imageMetadata, representativeImage } from "../lib/contentImages";

type Props = {
  title: string;
  description: string;
  canonical: string;
  siteName: string;
  jsonLd?: object;
  lastModified?: string;
  image?: string;
  ogImage?: string;
  imageAlt?: string;
  publishedTime?: string;
  noindex?: boolean;
};

const { title, description, canonical, siteName, jsonLd, lastModified, image, ogImage, imageAlt, publishedTime, noindex = false } = Astro.props;
const modified = contentModifiedFor(canonical, lastModified ?? site.contentLastModified);
const schema = jsonLd ?? graph(websiteSchema(), organizationSchema());

// Canonicalize every page's canonical to https://www.<host>/... so it matches
// the sitemap URLs and the middleware redirect target exactly. Fixes the
// homepage's missing trailing slash (site.url has none) and any stray http://
// or non-www variants crawlers might discover.
const canonicalHost = new URL(site.url).hostname;
function normalizeCanonical(input: string): string {
  const u = new URL(input);
  u.protocol = "https:";
  u.hostname = canonicalHost;
  if (u.pathname === "") u.pathname = "/";
  return u.href;
}
const canonicalHref = normalizeCanonical(canonical);
const preventIndex = noindex || new URL(canonicalHref).pathname === '/404/';
const representative = representativeImage(canonicalHref);

const absoluteImage = image ? new URL(image, canonicalHref).href : undefined;
const absoluteOgImage = representative ? new URL(representative.src, canonicalHref).href : ogImage ? new URL(ogImage, canonicalHref).href : absoluteImage ?? new URL("/images/og/default-og.png", canonicalHref).href;

// Declare measured local dimensions only, never assume an explicit OG URL is 1200x630.
const ogSize = new URL(absoluteOgImage).origin === new URL(canonicalHref).origin ? imageMetadata(absoluteOgImage) : undefined;
const isFallbackCard = !representative && (Boolean(ogImage) || !absoluteImage);
const ogImageAlt = representative?.alt ?? (isFallbackCard ? `${title} — ${siteName} editorial share card` : imageAlt ?? `${title} — ${siteName}`);

// Blog article URLs are /blog/<slug>/; everything else stays a website.
// Derived from the canonical path so no page has to pass an extra prop.
const canonicalSegments = new URL(canonicalHref).pathname.split("/").filter(Boolean);
const isArticle = canonicalSegments[0] === "blog" && canonicalSegments.length === 2;
const ogType = isArticle ? "article" : "website";

function labelForSegment(segment: string) {
  return segment
    .split("-")
    .filter(Boolean)
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");
}

function breadcrumbsFor(canonicalUrl: string) {
  const url = new URL(canonicalUrl);
  const segments = url.pathname.split("/").filter(Boolean);
  const items = [{ name: site.name, url: site.canonicalUrl }];
  segments.forEach((segment, index) => {
    const path = `/${segments.slice(0, index + 1).join("/")}/`;
    items.push({
      name: labelForSegment(segment),
      url: new URL(path, site.url).href
    });
  });
  return breadcrumbSchema(items);
}

const breadcrumb = breadcrumbsFor(canonicalHref);
const schemaWithBreadcrumb = (() => {
  const current = schema as { "@graph"?: object[] };
  const alignImage = (node: object) => {
    const item = node as Record<string, unknown>;
    const types = Array.isArray(item['@type']) ? item['@type'] : [item['@type']];
    return representative && types.some(t => ['Article', 'BlogPosting', 'LiveBlogPosting'].includes(String(t)))
      ? { ...item, image: absoluteOgImage } : item;
  };
  const pageImage = representative ? [{ '@type': 'WebPage', '@id': canonicalHref, url: canonicalHref, primaryImageOfPage: { '@type': 'ImageObject', url: absoluteOgImage, width: ogSize?.width, height: ogSize?.height, caption: representative.alt } }] : [];
  if (Array.isArray(current["@graph"])) {
    return {
      ...current,
      "@graph": [...current["@graph"].map(alignImage), ...pageImage, breadcrumb]
    };
  }
  return graph(alignImage(current), ...pageImage, breadcrumb);
})();
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalHref} />
<meta name="last-modified" content={modified} />
<meta name="robots" content={preventIndex ? "noindex,follow" : "index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1"} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalHref} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="en_US" />
{absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}
{absoluteOgImage && <meta property="og:image:alt" content={ogImageAlt} />}
{ogSize && <meta property="og:image:width" content={String(ogSize.width)} />}
{ogSize && <meta property="og:image:height" content={String(ogSize.height)} />}
{isArticle && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{isArticle && <meta property="article:modified_time" content={modified} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{absoluteOgImage && <meta name="twitter:image" content={absoluteOgImage} />}
{absoluteOgImage && <meta name="twitter:image:alt" content={ogImageAlt} />}
<script is:inline type="application/ld+json" set:html={JSON.stringify(schemaWithBreadcrumb)} />
