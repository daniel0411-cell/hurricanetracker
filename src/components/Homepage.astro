---
import Layout from "../layouts/Layout.astro";
import DecisionPathFlow from "./DecisionPathFlow.astro";
import FaqBlock from "./FaqBlock.astro";
import { coastalStates } from "../data/states";
import { hurricaneCities } from "../data/cities";
import { faqs, site } from "../data/site";
import { topicPages } from "../data/topicPages";
import { getAtlanticOutlook } from "../lib/nhcOutlook";
import { articleSchema, faqSchema, graph, websiteSchema } from "../lib/schema";
import { advisoryUrl, type NhcStorm, type NwsAlert } from "../lib/weather";
import { isStormFeedAvailable, isAlertFeedAvailable } from "../lib/weatherFeedStatus";

interface Props { preview?: boolean }
const { preview = false } = Astro.props;

type StormFeed = { storms?: NhcStorm[]; fetchedAt?: string };
type AlertFeed = { alerts?: NwsAlert[]; decisionLevel?: string; fetchedAt?: string };
async function loadJson<T>(path: string): Promise<T | null> {
  try {
    const response = await fetch(new URL(path, Astro.url), { signal: AbortSignal.timeout(8_000) });
    return response.ok ? await response.json() as T : null;
  } catch {
    return null;
  }
}
const [stormFeed, floridaAlertFeed, outlook] = await Promise.all([
  loadJson<StormFeed>("/api/nhc/current.json"),
  loadJson<AlertFeed>("/api/nws/alerts.json?area=FL"),
  getAtlanticOutlook()
]);
const stormsAvailable = isStormFeedAvailable(stormFeed);
const alertsAvailable = isAlertFeedAvailable(floridaAlertFeed);
const atlanticStorms = stormsAvailable ? stormFeed!.storms!.filter((storm) => /^AL/i.test(storm.id ?? "")) : [];
const pacificStorms = stormsAvailable ? stormFeed!.storms!.filter((storm) => /^(EP|CP)/i.test(storm.id ?? "")) : [];
const stormStatusClass = !stormsAvailable ? "status-unavailable" : atlanticStorms.length ? "status-active" : "status-calm";
const outlookAge = Date.now() - Date.parse(outlook?.issuedAt ?? "");
const outlookAvailable = Boolean(outlook && Number.isFinite(outlookAge) && outlookAge >= -15 * 60_000 && outlookAge <= 12 * 60 * 60_000);
const stormHeading = !stormsAvailable ? "Atlantic status unavailable"
  : atlanticStorms.length ? `${atlanticStorms.length} Atlantic NHC system${atlanticStorms.length === 1 ? "" : "s"}`
  : "No active Atlantic systems in this feed";
const checked = (value: string | undefined) => new Date(value!).toLocaleString("en-US", {
  timeZone: "UTC", month: "short", day: "numeric", hour: "numeric", minute: "2-digit"
}) + " UTC";
const cities = ["orlando", "clearwater", "morehead-city", "pensacola", "brownsville", "baton-rouge", "miami", "tampa", "houston", "new-orleans", "charleston"]
  .map((slug) => hurricaneCities.find((city) => city.slug === slug))
  .filter((city): city is NonNullable<typeof city> => Boolean(city));
const tools = [
  { icon: "fa-clipboard-check", title: "Pack for your household", description: "Build a supply checklist with household size, pet supplies, and document reminders.", href: "/tools/preparedness-checklist/", action: "Build a checklist" },
  { icon: "fa-route", title: "Organize an evacuation plan", description: "Review official orders, housing, flood exposure, transport, and medical needs. This helper does not issue evacuation orders.", href: "/tools/evacuation-decision-helper/", action: "Open the planning helper" },
  { icon: "fa-bolt", title: "Plan for a power outage", description: "Work through food storage, equipment, and backup-power questions before an outage.", href: "/tools/power-outage-planner/", action: "Open the outage planner" },
  { icon: "fa-house-shield", title: "Compare an insurance scenario", description: "Use your actual wind premium and an insurer-confirmed additional credit. Roof features alone do not determine savings.", href: "/tools/wind-mitigation-calculator/", action: "Compare confirmed figures" }
];
const lastModified = "2026-10-28T00:00:00.000Z";
const atlanticNames = atlanticStorms.map((storm) => storm.name).filter(Boolean);
const title = atlanticNames.length
  ? `Hurricane Tracker: ${atlanticNames.slice(0, 2).join(", ")} & NHC Map`
  : "Hurricane Tracker | Current Storms, NHC Map & Alerts";
const description = atlanticNames.length
  ? `Track ${atlanticNames.slice(0, 2).join(", ")} and current Atlantic hurricanes with NHC positions, forecast paths, live map, radar, Gulf status, state alerts, and local preparedness tools.`
  : "Track current hurricanes with NHC positions and forecast paths, then open the live map, radar, state NWS alerts, and local preparedness tools.";
const jsonLd = graph(websiteSchema(), articleSchema({ title, description, url: site.canonicalUrl, dateModified: lastModified }), faqSchema(faqs));
---

<Layout title={preview ? "Hurricane Tracker Homepage Preview" : title} description={description} canonical={site.url} jsonLd={jsonLd} lastModified={lastModified} showTopAd={!preview}>
  <Fragment slot="head">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  </Fragment>
  <div class="home-preview">
    {preview && <div class="preview-notice">
      <div class="inner">
        <span class="preview-badge"><i class="fa-solid fa-palette" aria-hidden="true"></i> Homepage Visual Preview</span>
        <a href="/">Compare with the current live homepage <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>}

    <!-- Hero Section -->
    <section class="preview-hero band" aria-labelledby="home-title">
      <div class="inner hero-layout">
        <div class="hero-primary">
          <p class="eyebrow"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Official-Source Tracking</p>
          <h1 id="home-title">Live Hurricane Tracker</h1>
          <p class="hero-summary">See what NHC is tracking, check the source time, then look up alerts for your area. A storm's track is not the boundary of its impacts.</p>
          <div class="hero-actions">
            <a class="action-link" href="/hurricane-tracker/live/">Open live tracker <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
            <a class="hero-secondary-link" href="/radar/"><i class="fa-solid fa-satellite" aria-hidden="true"></i> Radar &amp; satellite</a>
            <a class="hero-secondary-link" href="#local-alerts-heading"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> Check local alerts</a>
          </div>
        </div>

        <aside class="activity-summary" aria-labelledby="activity-heading">
          <div class="summary-top">
            <p class="eyebrow"><i class="fa-solid fa-satellite-dish" aria-hidden="true"></i> NHC Atlantic basin</p>
            <span class={`status-badge ${stormStatusClass}`}>
              {stormsAvailable ? (atlanticStorms.length > 0 ? "Active Systems" : "Feed Normal") : "Feed Alert"}
            </span>
          </div>
          <h2 id="activity-heading">{stormHeading}</h2>
          <p class="source-note" id="storm-feed-status">{stormsAvailable ? `Feed checked ${checked(stormFeed?.fetchedAt)}.` : "The feed failed validation, is stale, or could not be reached. This is not a zero-storm result."}</p>
          {pacificStorms.length > 0 && <p class="source-note pacific-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> {pacificStorms.length} additional NHC system{pacificStorms.length === 1 ? "" : "s"} in the Eastern or Central Pacific; not included in this Atlantic count.</p>}
          <p class="verify-link"><a href="https://www.nhc.noaa.gov/">Verify official NHC advisories <span aria-hidden="true">&rarr;</span></a></p>
          <p class="source-note disclaimer-note">No active system in a feed is not an all-clear for flooding, surf, or other local hazards.</p>
        </aside>
      </div>
    </section>

    <!-- Current Activity & Outlook Section -->
    <section class="band current-band" aria-labelledby="current-heading">
      <div class="inner">
        <p class="eyebrow"><i class="fa-solid fa-compass" aria-hidden="true"></i> NHC Atlantic activity</p>
        <h2 id="current-heading">Atlantic Systems &amp; Development Outlook</h2>
        {atlanticStorms.length > 0 && <div class="storm-links">{atlanticStorms.map((storm) => (
          <article class="storm-summary">
            <h3>{storm.name ?? storm.id}</h3>
            <p class="storm-meta">{storm.classification ?? "Classification unavailable"}{storm.intensity ? ` · ${storm.intensity} kt` : ""}</p>
            <p class="source-note">Advisory time: {storm.lastUpdate ?? "not provided; check NHC"}</p>
            <div class="storm-action-row">
              <a class="storm-track-link" href={`/hurricane-tracker/storm/${String(storm.name ?? storm.id).toLowerCase().replace(/[^a-z0-9]+/g, "-")}/`}>Open {storm.name ?? storm.id} tracker &rarr;</a>
              {advisoryUrl(storm.publicAdvisory) && <a class="storm-adv-link" href={advisoryUrl(storm.publicAdvisory)}>Official NHC advisory</a>}
            </div>
          </article>
        ))}</div>}
        <div class="outlook-layout">
          <div class="outlook-copy">
            <h3>7-day Atlantic outlook</h3>
            <p class="source-note outlook-timestamp">{outlookAvailable ? `NHC issue time: ${outlook!.issued}` : "Current outlook unavailable or outside the 12-hour freshness window. Formation chances have not been verified."}</p>
            {outlookAvailable && <p class="outlook-text">{outlook!.text}</p>}
            <p class="source-note caution-note">Formation chances apply to development areas, not a household's chance of impact. Read every area in the official bulletin.</p>
            <div class="text-links">
              <a href="https://www.nhc.noaa.gov/text/MIATWOAT.shtml">Read official NHC outlook &rarr;</a>
              <a href="/hurricane-tracker/tropical-disturbances/">Atlantic disturbances</a>
              <a href="/hurricane-tracker/gulf/">Gulf status</a>
            </div>
          </div>
          <aside class="state-example" aria-labelledby="state-example-heading">
            <p class="eyebrow">State example · Not your location</p>
            <h3 id="state-example-heading">Florida NWS alerts</h3>
            <div class="state-count-box">
              <p class="state-count">{alertsAvailable ? `${floridaAlertFeed!.alerts!.length} returned` : "Unavailable"}</p>
            </div>
            <p class="source-note">{alertsAvailable ? `Feed checked ${checked(floridaAlertFeed?.fetchedAt)}. Includes weather alerts across Florida, not only hurricanes.` : "Current Florida alerts could not be verified. Do not interpret this as no warnings."}</p>
            <a class="state-link" href="/tracker/florida/">Read Florida alerts and local resources &rarr;</a>
          </aside>
        </div>
      </div>
    </section>

    <!-- Local NWS Alert Screening -->
    <section class="band local-band" aria-labelledby="local-alerts-heading">
      <div class="inner">
        <p class="eyebrow"><i class="fa-solid fa-map-pin" aria-hidden="true"></i> Your area, not the whole basin</p>
        <h2 id="local-alerts-heading">Check Local NWS Alerts</h2>
        <p class="local-intro">Enter a US ZIP code to check NWS alerts at its representative point. A ZIP point does not identify your property's flood zone, evacuation zone, or safety.</p>

        <form id="preview-zip-form" class="zip-form">
          <label for="preview-zip">US ZIP code</label>
          <div class="zip-input-wrap">
            <i class="fa-solid fa-location-crosshairs zip-input-icon" aria-hidden="true"></i>
            <input id="preview-zip" name="zip" inputmode="numeric" autocomplete="postal-code" pattern="[0-9]{5}" maxlength="5" placeholder="33101" required aria-describedby="preview-local-status" />
          </div>
          <button type="submit">Check alerts <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
        </form>

        <p id="preview-local-status" class="source-note local-status-note" role="status">Check your street address and current evacuation instructions with local emergency management separately.</p>
        <div id="preview-local-result" class="local-result" aria-live="polite" hidden></div>
        <noscript><p><a href="https://www.weather.gov/">Open weather.gov for official local alerts</a>. On-page ZIP lookup requires JavaScript.</p></noscript>

        <nav class="city-links" aria-label="Featured city trackers">
          <span class="city-label">Featured coastal trackers:</span>
          <div class="city-chips">
            {cities.map((city) => <a class="city-chip" href={`/hurricane-tracker/city/${city.slug}/`}>{city.name}</a>)}
            <a class="city-chip" href="/hurricane-tracker/city/">All city trackers</a>
          </div>
        </nav>
      </div>
    </section>

    <!-- Decision Path Pipeline -->
    <section class="band" aria-labelledby="decision-path-heading">
      <div class="inner">
        <p class="eyebrow"><i class="fa-solid fa-route" aria-hidden="true"></i> Use the right source</p>
        <h2 id="decision-path-heading">From Hurricane Track to Local Action</h2>
        <DecisionPathFlow />
      </div>
    </section>

    <!-- Household Planning Tasks -->
    <section class="band planning-band" aria-labelledby="planning-heading">
      <div class="inner">
        <p class="eyebrow"><i class="fa-solid fa-list-check" aria-hidden="true"></i> Prepare before conditions deteriorate</p>
        <h2 id="planning-heading">Choose Your Next Planning Task</h2>
        <div class="planning-grid">
          {tools.map((tool) => (
            <article class="task-item">
              <div class="task-icon-wrap" aria-hidden="true">
                <i class={`fa-solid ${tool.icon}`}></i>
              </div>
              <div class="task-content">
                <h3>{tool.title}</h3>
                <p>{tool.description}</p>
                <a class="task-link" href={tool.href}>{tool.action} <span aria-hidden="true">&rarr;</span></a>
              </div>
            </article>
          ))}
        </div>
        <p class="source-note planning-note">For water storage and treatment, <a href="/blog/hurricane-water-storage-purification-emergency/">read the CDC-sourced water guide</a>. Storage quantities do not determine whether contaminated water can be made safe.</p>
        <p class="text-links"><a href="/tools/">All hurricane planning tools</a><a href="/preparedness/">Household preparedness</a><a href="/local-hurricane-risk/">Local hurricane risk</a><a href="/alerts/">NWS alert directory</a></p>
      </div>
    </section>

    <!-- State Directory -->
    <section class="band directory-band" aria-labelledby="directory-heading">
      <div class="inner">
        <p class="eyebrow"><i class="fa-solid fa-landmark" aria-hidden="true"></i> Local resources</p>
        <h2 id="directory-heading">Find Your Coastal State</h2>
        <div class="state-directory">
          {coastalStates.map((state) => (
            <article class="state-card">
              <div class="state-header">
                <span class="state-code-pill">{state.code}</span>
                <h3><a href={`/tracker/${state.slug}/`}>{state.name}</a></h3>
              </div>
              <p>{state.preparednessNote}</p>
              <a class="state-view-link" href={`/tracker/${state.slug}/`}>View {state.name} tracker &rarr;</a>
            </article>
          ))}
        </div>
      </div>
    </section>
    <section class="band" aria-labelledby="guides-heading">
      <div class="inner">
        <h2 id="guides-heading">Hurricane Maps, Updates &amp; Guides</h2>
        <nav class="text-links" aria-label="Hurricane coverage directories">
          <a href="/hurricane-tracker/">Hurricane tracker directory</a>
          <a href="/hurricane-tracker/storm/">Named storm trackers</a>
          <a href="/updates/">Latest hurricane updates</a>
          <a href="/2026-hurricane-season/">2026 hurricane season</a>
          <a href="/blog/">Preparedness guides</a>
          <a href="/topics/">All hurricane topics</a>
        </nav>
        <nav class="text-links" aria-label="Hurricane topic trackers">
          {topicPages.map((topic) => <a href={`/hurricane-tracker/${topic.slug}/`}>{topic.title}</a>)}
        </nav>
      </div>
    </section>
    <FaqBlock faqs={faqs} />
  </div>
</Layout>

<script>
  import { isAlertFeedAvailable } from "../lib/weatherFeedStatus";
  type Alert = { event: string; headline?: string; expires?: string };
  type AlertFeed = { alerts?: Alert[]; fetchedAt?: string; decisionLevel?: string };
  const form = document.querySelector<HTMLFormElement>("#preview-zip-form");
  const input = document.querySelector<HTMLInputElement>("#preview-zip");
  const status = document.querySelector<HTMLElement>("#preview-local-status");
  const result = document.querySelector<HTMLElement>("#preview-local-result");
  let requestNumber = 0;
  const escapeHtml = (value: unknown) => String(value ?? "").replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" })[char]!);
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!input || !status || !result || !form.reportValidity()) return;
    const request = ++requestNumber;
    const zip = input.value.trim();
    result.hidden = true;
    result.replaceChildren();
    status.textContent = `Checking ZIP ${zip} and current NWS alerts...`;
    try {
      const response = await fetch(`/api/location/zip?zip=${encodeURIComponent(zip)}`, { signal: AbortSignal.timeout(8_000) });
      const location = await response.json() as Record<string, unknown> | null;
      if (!response.ok || !location || location.error) throw new Error("ZIP location unavailable");
      const latitude = Number(location.latitude);
      const longitude = Number(location.longitude);
      if (!["string", "number"].includes(typeof location.latitude) || !["string", "number"].includes(typeof location.longitude) || String(location.latitude).trim() === "" || String(location.longitude).trim() === "" || !Number.isFinite(latitude) || !Number.isFinite(longitude) || Math.abs(latitude) > 90 || Math.abs(longitude) > 180) throw new Error("ZIP coordinates unavailable");
      const alertResponse = await fetch(`/api/nws/alerts.json?point=${encodeURIComponent(`${latitude},${longitude}`)}`, { signal: AbortSignal.timeout(8_000) });
      const feed: AlertFeed = await alertResponse.json();
      if (!alertResponse.ok || !isAlertFeedAvailable(feed)) throw new Error("Current NWS alerts unavailable or stale");
      if (request !== requestNumber) return;
      const alerts = feed.alerts!;
      const pointUrl = `https://forecast.weather.gov/MapClick.php?lat=${latitude}&lon=${longitude}`;
      result.innerHTML = `<h3>${escapeHtml(location.city || zip)}${location.state ? `, ${escapeHtml(location.state)}` : ""}</h3>
        <p><strong>${alerts.length} active NWS alert${alerts.length === 1 ? "" : "s"} returned for this ZIP point.</strong> This is not an all-clear or an address-level safety determination.</p>
        ${alerts.length ? `<ul>${alerts.map((alert) => `<li><strong>${escapeHtml(alert.event)}</strong>${alert.headline ? `: ${escapeHtml(alert.headline)}` : ""}${alert.expires ? ` · Expires ${escapeHtml(alert.expires)}` : ""}</li>`).join("")}</ul>` : ""}
        <p><a href="${pointUrl}">Read official weather.gov details for this point</a></p>
        <p>Separately check your street address in the local evacuation-zone lookup and read current emergency-management instructions. Follow official orders and respond to immediate danger.</p>`;
      result.hidden = false;
      status.textContent = `NWS feed checked ${new Date(feed.fetchedAt!).toLocaleString()}. ZIP ${zip} is a screening point, not your property boundary.`;
    } catch {
      if (request !== requestNumber) return;
      status.textContent = "Local lookup unavailable, invalid, or stale. No current alert conclusion can be drawn. Check weather.gov and local emergency management.";
      result.innerHTML = '<p><a href="https://www.weather.gov/">Check official NWS alerts</a></p>';
      result.hidden = false;
    }
  });
  input?.addEventListener("input", () => {
    requestNumber++;
    if (result) { result.hidden = true; result.replaceChildren(); }
    if (status) status.textContent = "Enter a complete five-digit US ZIP code and check alerts again.";
  });
</script>

<style>
  .home-preview {
    --preview-link: #0e6f8f;
    --preview-card-bg: var(--panel, #ffffff);
    --preview-border: var(--line, #d7dde2);
    color: var(--ink);
  }
  .home-preview a {
    text-underline-offset: 3px;
  }
  .home-preview .inner {
    min-width: 0;
  }

  /* ── Preview notice banner ── */
  .preview-notice {
    padding: 10px var(--page-x);
    border-bottom: 1px solid var(--line);
    background: #0f172a;
    color: #cbd5e1;
    font-size: 0.85rem;
  }
  .preview-notice .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 20px;
  }
  .preview-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    color: #38bdf8;
  }
  .preview-notice a {
    color: #38bdf8;
    text-decoration: underline;
    font-weight: 600;
  }
  .home-preview a:not(.action-link):not(.hero-secondary-link):not(.city-chip) {
    color: var(--preview-link);
  }

  /* ── Typography & Global Section Spacing ── */
  h1 {
    font-size: 2.85rem;
    line-height: 1.15;
    margin: 0 0 16px;
    color: var(--ink);
    font-weight: 850;
    letter-spacing: 0;
  }
  h2, h3 {
    color: var(--ink);
    letter-spacing: 0;
  }
  h2 {
    font-size: 1.85rem;
    line-height: 1.28;
    margin: 0 0 10px;
  }
  .home-preview .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0;
    padding: 3px 8px;
    border-radius: 4px;
    background: rgba(14, 111, 143, 0.1);
    color: var(--preview-link);
    margin: 0 0 12px;
  }

  /* ── Hero Section ── */
  .preview-hero {
    background: var(--panel);
    padding-top: clamp(36px, 5vw, 56px);
    padding-bottom: clamp(36px, 5vw, 56px);
  }
  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.9fr);
    gap: 40px;
    align-items: stretch;
  }
  .hero-primary {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .hero-summary {
    max-width: 620px;
    font-size: 1.08rem;
    line-height: 1.6;
    margin: 0 0 24px;
    color: var(--muted);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .hero-actions .action-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 11px 20px;
    font-weight: 700;
  }
  .hero-secondary-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 16px;
    border: 1px solid var(--preview-border);
    border-radius: 6px;
    background: var(--surface);
    color: var(--ink) !important;
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none !important;
    transition: all 0.15s ease;
  }
  .hero-secondary-link:hover {
    background: var(--panel);
    border-color: var(--preview-link);
    color: var(--preview-link) !important;
  }

  /* ── Right-Side Activity Summary Card ── */
  .activity-summary {
    display: flex;
    flex-direction: column;
    padding: 24px 22px;
    background: var(--surface);
    border: 1px solid var(--preview-border);
    border-left: 4px solid var(--preview-link);
    border-radius: 8px;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
  }
  .summary-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 8px;
  }
  .summary-top .eyebrow {
    margin: 0;
  }
  .status-badge {
    font-size: 0.74rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0;
    padding: 3px 8px;
    border-radius: 4px;
  }
  .status-calm {
    background: rgba(47, 125, 79, 0.14);
    color: #15803d;
  }
  .status-active {
    background: rgba(193, 68, 46, 0.15);
    color: #c1442e;
  }
  .status-unavailable {
    background: rgba(161, 98, 7, 0.12);
    color: #854d0e;
  }
  .activity-summary h2 {
    font-size: 1.35rem;
    line-height: 1.35;
    margin: 6px 0 10px;
    color: var(--ink);
  }
  .activity-summary p {
    margin: 8px 0 0;
  }
  .pacific-note {
    font-size: 0.84rem;
    color: var(--muted);
    padding: 6px 10px;
    background: rgba(0, 0, 0, 0.03);
    border-radius: 4px;
    margin-top: 10px !important;
  }
  .verify-link {
    margin-top: 14px !important;
    font-weight: 700;
    font-size: 0.94rem;
