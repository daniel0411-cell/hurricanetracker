---
type Props = {
  placement: "top" | "bottom" | "in-content";
  enabled?: boolean;
};

const { placement, enabled = false } = Astro.props;
---
{enabled && (
  <aside class:list={["ad-placement", `ad-placement-${placement}`]} aria-label="Sponsor Notice">
    <span class="ad-label">Partner Notice</span>
    <div class="ad-content">
      <!-- Reserved for policy-compliant editorial partners -->
    </div>
  </aside>
)}

<style>
  .ad-placement {
    width: min(100%, 760px);
    min-height: 160px;
    margin: 24px auto;
    padding: 8px;
    border: 1px solid var(--line);
    background: var(--panel);
    color: var(--muted);
    font-size: 0.75rem;
  }
  .ad-placement-bottom {
    width: min(100%, 320px);
    min-height: 250px;
  }
  .ad-label {
    display: block;
    margin-bottom: 6px;
    text-align: center;
  }
  .ad-content {
    display: grid;
    place-items: center;
  }
  .ad-content-rectangle {
    min-height: 250px;
  }
</style>
