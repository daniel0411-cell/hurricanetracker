---
type Props = {
  source?: string;
};

const { source = "HurricaneHub reminder form" } = Astro.props;
---
<section class="band reminder-signup" aria-labelledby="reminder-title">
  <div class="inner grid-2">
    <article>
      <p class="eyebrow">Reminder capture</p>
      <h2 id="reminder-title">Get a Hurricane Readiness Reminder</h2>
      <p class="answer">Save a ZIP code and email for future readiness reminders, or enable device alerts to get a push notification the moment NWS issues a hurricane, tropical storm, or storm-surge alert for your area.</p>
    </article>
    <form class="panel reminder-form" id="reminder-form" data-source={source}>
      <label for="reminder-email">Email</label>
      <input id="reminder-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
      <label for="reminder-zip">ZIP code</label>
      <input id="reminder-zip" name="zip" inputmode="numeric" autocomplete="postal-code" maxlength="5" pattern="\d{5}" placeholder="e.g. 33139" />
      <button type="submit">Save reminder request</button>
      <button type="button" id="enable-push" class="secondary">Enable device alerts</button>
      <p id="reminder-status" class="small" role="status">Save your details, then enable device alerts for instant push notifications.</p>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("#reminder-form");
  const statusEl = document.querySelector<HTMLElement>("#reminder-status");
  const pushBtn = document.querySelector<HTMLButtonElement>("#enable-push");

  const urlBase64ToUint8Array = (base64String: string): Uint8Array => {
    const padding = "=".repeat((4 - (base64String.length % 4)) % 4);
    const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/");
    const raw = atob(base64);
    const out = new Uint8Array(raw.length);
    for (let i = 0; i < raw.length; i++) out[i] = raw.charCodeAt(i);
    return out;
  };

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    try {
      if (statusEl) statusEl.textContent = "Saving reminder request...";
      const response = await fetch("/api/reminders/subscribe", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          email: data.get("email"),
          zip: data.get("zip"),
          source: form.dataset.source
        })
      });
      const body = await response.json() as { message?: string; error?: string };
      if (!response.ok) throw new Error(body.error ?? "Request failed");
      if (statusEl) statusEl.textContent = body.message ?? "Reminder request saved.";
      form.reset();
    } catch (error) {
      console.error("HurricaneHub reminder form failed", error);
      if (statusEl) statusEl.textContent = "Could not save this reminder request right now.";
    }
  });

  pushBtn?.addEventListener("click", async () => {
    if (!("serviceWorker" in navigator) || !("PushManager" in window)) {
      if (statusEl) statusEl.textContent = "This browser does not support push notifications.";
      return;
    }
    try {
      if (statusEl) statusEl.textContent = "Requesting notification permission...";
      const permission = await Notification.requestPermission();
      if (permission !== "granted") {
        if (statusEl) statusEl.textContent = "Notification permission was not granted.";
        return;
      }
      const reg = await navigator.serviceWorker.register("/sw.js");
      await navigator.serviceWorker.ready;
      const { publicKey } = (await (await fetch("/api/vapid-public")).json()) as { publicKey: string | null };
      if (!publicKey) {
        if (statusEl) statusEl.textContent = "Push is not configured on the server yet.";
        return;
      }
      const existing = await reg.pushManager.getSubscription();
      const subscription =
        existing ||
        (await reg.pushManager.subscribe({
          userVisibleOnly: true,
          applicationServerKey: urlBase64ToUint8Array(publicKey) as BufferSource
        }));
      const zipEl = document.querySelector<HTMLInputElement>("#reminder-zip");
      const emailEl = document.querySelector<HTMLInputElement>("#reminder-email");
      const response = await fetch("/api/reminders/subscribe", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          subscription,
          zip: zipEl?.value ?? "",
          email: emailEl?.value ?? "",
          source: form?.dataset.source ?? "device"
        })
      });
      const body = await response.json() as { message?: string; error?: string };
      if (!response.ok) throw new Error(body.error ?? "Subscription failed");
      if (statusEl) statusEl.textContent = body.message ?? "Device alerts enabled.";

      // Store the monitor location in the SW so it can check NWS directly from
      // the browser (no server egress needed) and show local notifications.
      try {
        const regNow = await navigator.serviceWorker.ready;
        const zipVal = (document.querySelector<HTMLInputElement>("#reminder-zip")?.value || "").trim();
        let monitor: { zip?: string; lat: number; lon: number; state?: string } | null = null;
        if (zipVal) {
          try {
            const locRes = await fetch(`/api/location/zip?zip=${encodeURIComponent(zipVal)}`);
            if (locRes.ok) {
              const loc = (await locRes.json()) as { latitude: number; longitude: number; stateName?: string };
              monitor = { zip: zipVal, lat: loc.latitude, lon: loc.longitude, state: loc.stateName };
            }
          } catch {
            /* zip geocode failed; fall back to geolocation */
          }
        }
        if (!monitor && navigator.geolocation) {
          monitor = await new Promise((resolve) => {
            navigator.geolocation.getCurrentPosition(
              (pos) => resolve({ lat: pos.coords.latitude, lon: pos.coords.longitude, zip: zipVal }),
              () => resolve(null),
              { timeout: 8000 }
            );
          });
        }
        if (monitor && regNow.active) {
          regNow.active.postMessage({ type: "hh-set-monitor", monitor });
          try {
            localStorage.setItem("hh-subscribed", "1");
          } catch {
            /* ignore */
          }
          // Best-effort background sync on Chromium (needs periodic-background-sync permission).
          try {
            const perms = await (navigator.permissions.query as any)({ name: "periodic-background-sync" });
            if (perms && perms.state === "granted" && "periodicSync" in regNow) {
              await (regNow as any).periodicSync.register("hh-alerts", { minInterval: 15 * 60 * 1000 });
            }
          } catch {
            /* not supported — foreground page poll will cover it */
          }
        }
      } catch {
        /* non-fatal: real Web Push subscription already succeeded */
      }
    } catch (error) {
      console.error("HurricaneHub push subscribe failed", error);
      if (statusEl) statusEl.textContent = "Could not enable device alerts right now.";
    }
  });
</script>

<style>
  .reminder-form {
    display: grid;
    gap: 10px;
  }
  .reminder-form label {
    font-weight: 800;
  }
  .reminder-form .secondary {
    background: transparent;
    border: 1px solid var(--accent, #0e6f8f);
    color: var(--accent, #0e6f8f);
  }
</style>
