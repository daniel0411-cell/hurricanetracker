---
import Disclaimer from "../components/Disclaimer.astro";
import Footer from "../components/Footer.astro";
import GoogleTag from "../components/GoogleTag.astro";
import Header from "../components/Header.astro";
import SEO from "../components/SEO.astro";
import { site } from "../data/site";
import { defaultLang, type Lang } from "../i18n/ui";

type Props = {
  title: string;
  description: string;
  canonical?: string;
  jsonLd?: object;
  lastModified?: string;
  image?: string;
  ogImage?: string;
  lang?: Lang;
  showTopAd?: boolean;
  showBottomAd?: boolean;
};

const {
  title,
  description,
  canonical = Astro.url.href,
  jsonLd,
  lastModified,
  image,
  ogImage,
  lang = defaultLang,
  showTopAd = false,
  showBottomAd = false
} = Astro.props;
const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <GoogleTag />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("hurricanehub:theme");
          var prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
          if (saved === "dark" || (!saved && prefersDark)) {
            document.documentElement.dataset.theme = "dark";
          }
        } catch (e) {}
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <SEO
      title={pageTitle}
      description={description}
      canonical={canonical}
      siteName={site.name}
      jsonLd={jsonLd}
      lastModified={lastModified}
      image={image}
      ogImage={ogImage}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="HurricaneHub Blog" href="/rss.xml" />
    <slot name="head" />
  </head>
  <body class="site-body flex flex-col min-h-screen">
    <Header lang={lang} />
    <Disclaimer lang={lang} />
    {showTopAd && <div class="ad-slot ad-slot-top"><!-- AD SLOT 1: 728x90 Desktop / 320x100 Mobile --></div>}
    <main class="flex-grow">
      <slot />
      {showBottomAd && <div class="ad-slot ad-slot-bottom"><!-- AD SLOT 2: 300x250 Rectangle --></div>}
    </main>
    <Footer lang={lang} />
    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
          navigator.serviceWorker.register("/sw.js").catch(function (e) {
            console.warn("HurricaneHub service worker registration failed", e);
          });
          // For subscribed users, periodically ask the SW to check local NWS
          // alerts from the browser (covers foreground; background uses Periodic Sync).
          try {
            if (localStorage.getItem("hh-subscribed") === "1") {
              navigator.serviceWorker.ready.then(function (reg) {
                setInterval(function () {
                  if (reg.active) reg.active.postMessage({ type: "hh-check-now" });
                }, 15 * 60 * 1000);
              });
            }
          } catch (e) {}
        });
      }
    </script>
    <script is:inline>
      (function () {
        var INDEX_URL = "/search-index.json";
        var indexCache = null;
        var modal = document.getElementById("search-modal");
        var toggle = document.getElementById("search-toggle");
        var modalInput = document.getElementById("search-input-modal");
        var modalResults = document.getElementById("search-results-modal");

        function loadIndex() {
          if (indexCache) return Promise.resolve(indexCache);
          return fetch(INDEX_URL)
            .then(function (r) { return r.json(); })
            .then(function (data) { indexCache = (data && data.entries) || []; return indexCache; })
            .catch(function () { return []; });
        }

        function escapeHtml(s) {
          return String(s).replace(/[&<>"']/g, function (c) {
            return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
          });
        }

        function scoreEntry(entry, terms) {
          var title = (entry.title || "").toLowerCase();
          var desc = (entry.description || "").toLowerCase();
          var body = (entry.body || "").toLowerCase();
          var cat = (entry.category || "").toLowerCase();
          var score = 0;
          for (var i = 0; i < terms.length; i++) {
            var t = terms[i];
            if (!t) continue;
            if (title.indexOf(t) !== -1) score += title.indexOf(t) === 0 ? 12 : 8;
            if (cat.indexOf(t) !== -1) score += 6;
            if (desc.indexOf(t) !== -1) score += 3;
            if (body.indexOf(t) !== -1) score += 1;
          }
          return score;
        }

        function render(container, entries, query) {
          if (!container) return;
          if (!query) { container.innerHTML = ""; return; }
          var terms = query.toLowerCase().split(/\s+/).filter(Boolean);
          var scored = entries
            .map(function (e) { return { e: e, s: scoreEntry(e, terms) }; })
            .filter(function (x) { return x.s > 0; })
            .sort(function (a, b) { return b.s - a.s; })
            .slice(0, 8);
          if (!scored.length) {
            container.innerHTML = '<p class="search-empty">No results for "' + escapeHtml(query) + '". Try another term.</p>';
            return;
          }
          container.innerHTML = scored.map(function (x) {
            var e = x.e;
            return '<a class="search-result" href="' + encodeURI(e.url) + '">' +
              '<span class="sr-cat">' + escapeHtml(e.category) + '</span>' +
              '<span class="sr-title">' + escapeHtml(e.title) + '</span>' +
              '<span class="sr-desc">' + escapeHtml(e.description) + '</span>' +
              '</a>';
          }).join("");
        }

        function openModal() {
          if (!modal) return;
          modal.hidden = false;
          if (toggle) toggle.setAttribute("aria-expanded", "true");
          if (modalInput) modalInput.focus();
        }

        function closeModal() {
          if (!modal) return;
          modal.hidden = true;
          if (toggle) toggle.setAttribute("aria-expanded", "false");
        }

        if (toggle) {
          toggle.addEventListener("click", function () {
            if (modal && !modal.hidden) closeModal();
            else { loadIndex(); openModal(); }
          });
        }

        if (modal) {
          modal.querySelectorAll("[data-search-close]").forEach(function (el) {
            el.addEventListener("click", closeModal);
          });
        }

        document.addEventListener("keydown", function (e) {
          var tag = (e.target && e.target.tagName) || "";
          if (e.key === "/" && !/^(INPUT|TEXTAREA|SELECT)$/.test(tag) && !(e.target && e.target.isContentEditable)) {
            if (modal) { e.preventDefault(); loadIndex(); openModal(); }
          } else if (e.key === "Escape" && modal && !modal.hidden) {
            closeModal();
          }
        });

        function bindInput(input, results) {
          if (!input || !results) return;
          input.addEventListener("input", function () {
            var q = input.value.trim();
            loadIndex().then(function (entries) { render(results, entries, q); });
          });
        }

        bindInput(modalInput, modalResults);

        var inline = document.querySelector(".search-inline .hh-search-input");
        var inlineResults = document.querySelector(".search-inline .hh-search-results");
        bindInput(inline, inlineResults);
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --container: 1120px;
    --page-x: clamp(18px, 4vw, 48px);
    --section-y: clamp(44px, 6vw, 72px);
    --section-y-tight: clamp(30px, 4vw, 48px);
    --ink: #17212b;
    --muted: #5b6670;
    --line: #d7dde2;
    --panel: #ffffff;
    --surface: #f4f7f8;
    --ocean: #0e6f8f;
    --signal: #c1442e;
    --amber: #c9891a;
    --green: #2f7d4f;
    --navy: #20384d;
    --shadow: 0 18px 50px rgba(23, 33, 43, 0.12);
    --soft-shadow: 0 8px 24px rgba(23, 33, 43, 0.06);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--surface);
    color: var(--ink);
  }

  .site-body,
  .flex {
    display: flex;
  }

  .flex-col {
    flex-direction: column;
  }

  .min-h-screen {
    min-height: 100vh;
  }

  .flex-grow {
    flex-grow: 1;
  }

  .w-full {
    width: 100%;
  }

  .h-\[70vh\] {
    height: 70vh;
  }

  .bg-red-100 {
    background: #fee2e2;
  }

  .p-2 {
    padding: 0.5rem;
  }

  .text-center {
    text-align: center;
  }

  .text-sm {
    font-size: 0.875rem;
  }

  a {
    color: inherit;
  }

  .site-header {
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 64px;
    padding: 0 var(--page-x);
    border-bottom: 1px solid var(--line);
    background: #ffffff;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 800;
    letter-spacing: 0;
  }

  .brand-mark {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background:
      radial-gradient(circle at 62% 38%, #fff 0 12%, transparent 13%),
      conic-gradient(from 210deg, var(--ocean), #74b7c9, var(--signal), var(--ocean));
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.7);
  }

  .site-header nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: flex-end;
  }

  .site-header nav a {
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    padding: 0 12px;
    border-radius: 6px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.94rem;
    font-weight: 700;
  }

  .site-header nav a:hover,
  .site-header nav a:focus-visible {
    background: #e7eef1;
    color: var(--ink);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: transparent;
    cursor: pointer;
  }

  .nav-toggle .bar {
    display: block;
    width: 20px;
    height: 2px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .nav-toggle[aria-expanded="true"] .bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .nav-toggle[aria-expanded="true"] .bar:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle[aria-expanded="true"] .bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .disclaimer {
    background: linear-gradient(90deg, #d47b08, #b9481f);
    color: #fff;
    padding: 10px var(--page-x);
    font-weight: 800;
  }

  .disclaimer p {
    width: min(var(--container), 100%);
    margin: 0 auto;
    line-height: 1.5;
    text-align: center;
  }

  .disclaimer a {
    color: #fff;
    text-decoration-thickness: 2px;
  }

  .ad-slot {
    width: min(var(--container), calc(100% - 36px));
    margin: 16px auto;
    border: 1px dashed #b8c0c7;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.6);
  }

  /* Keep reserved ad markup out of the layout until a real placement exists. */
  .ad-slot:empty {
    display: none;
  }

  .ad-slot-top {
    min-height: 90px;
  }

  .ad-slot-bottom,
  .ad-slot-incontent {
    min-height: 250px;
  }

  .ad-slot-compact {
    min-height: 0;
    height: 1px;
    margin: 24px 0;
    opacity: 0.55;
  }

  main {
    min-height: 75vh;
  }

  section,
  article {
    scroll-margin-top: 88px;
  }

  .band {
    padding: var(--section-y) var(--page-x);
  }

  .band + .band {
    border-top: 1px solid rgba(215, 221, 226, 0.72);
  }

  .inner {
    width: min(var(--container), 100%);
    margin: 0 auto;
  }

  .hero {
    min-height: clamp(560px, 72vh, 720px);
    display: grid;
    align-items: center;
    background:
      linear-gradient(90deg, rgba(10, 30, 45, 0.9), rgba(14, 111, 143, 0.58)),
      url("https://images.unsplash.com/photo-1527482797697-8795b05a13fe?auto=format&fit=crop&w=1800&q=80");
    background-size: cover;
    background-position: center;
    color: #fff;
    padding-top: clamp(76px, 10vw, 132px);
    padding-bottom: clamp(76px, 10vw, 132px);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 420px);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
  }

  .eyebrow {
    margin: 0 0 10px;
    text-transform: uppercase;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    font-weight: 800;
    color: #a6dae8;
  }

  h1,
  h2,
  h3 {
    margin: 0;
    line-height: 1.06;
    letter-spacing: 0;
  }

  h1 {
    max-width: 760px;
    font-size: clamp(2.6rem, 7vw, 5.8rem);
  }

  h2 {
    font-size: clamp(1.8rem, 4vw, 3.2rem);
  }

  h3 {
    font-size: 1.08rem;
  }

  p {
    line-height: 1.65;
  }

  .answer {
    max-width: 760px;
    margin: 20px 0 0;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
  }

  .section-intro {
    max-width: 760px;
  }

  .section-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    margin-top: 22px;
  }

  .action-link {
    min-height: 42px;
    color: #fff;
    background: var(--signal);
    border-radius: 6px;
    align-items: center;
    padding: 0 14px;
    font-weight: 800;
    text-decoration: none;
    display: inline-flex;
  }

  .action-link:hover,
  .action-link:focus-visible {
    background: #9f2d1f;
  }

  .toolbar,
  .panel,
  .metric,
  .alert-row,
  .storm-row,
  .faq-item,
  .post-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: var(--soft-shadow);
  }

  .hero .panel,
  .hero .metric {
    background: rgba(255, 255, 255, 0.92);
    color: var(--ink);
  }

  .dashboard {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .compact-dashboard {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .decision-card {
    display: grid;
    gap: 16px;
    align-self: stretch;
    padding: clamp(20px, 3vw, 30px);
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(12px);
    box-shadow: var(--shadow);
  }

  .decision-card h2 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    color: #fff;
  }

  .decision-card p {
    margin: 0;
    color: rgba(255, 255, 255, 0.92);
  }

  .decision-card .metric {
    min-height: 92px;
  }

  .decision-card .metric strong {
    font-size: clamp(1.4rem, 3vw, 2.1rem);
  }

  .metric {
    min-height: 116px;
    padding: 16px;
  }

  .metric strong {
    display: block;
    font-size: clamp(1.7rem, 4vw, 2.6rem);
    line-height: 1;
  }

  .metric span,
  .source-note,
  .small {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .grid-2,
  .grid-3 {
    display: grid;
    gap: clamp(16px, 2vw, 22px);
    align-items: start;
  }

  .grid-2 {
    grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr);
  }

  .grid-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .panel,
  .post-card {
    padding: clamp(18px, 3vw, 28px);
    min-width: 0;
  }

  .panel > :first-child,
  .post-card > :first-child {
    margin-top: 0;
  }

  .panel > :last-child,
  .post-card > :last-child {
    margin-bottom: 0;
  }

  .post-image,
  .article-hero-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #dcecef;
  }

  .post-image {
    margin: 0 0 16px;
  }

  .article-hero-image {
    margin-top: 28px;
    box-shadow: var(--shadow);
  }

  .panel h2,
  .post-card h2 {
    font-size: clamp(1.35rem, 2.2vw, 2rem);
  }

  .article-grid {
    align-items: start;
  }

  .article-grid > aside {
    align-self: start;
  }

  .stack {
    display: grid;
    gap: clamp(14px, 2vw, 18px);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: clamp(16px, 2vw, 22px);
    align-items: stretch;
  }

  /* Each card is a flex column so the "Read article" link can be pinned to
     the bottom; combined with align-items:stretch this keeps every card in a
     row the same height and the links bottom-aligned (no jagged rows). */
  .blog-grid .post-card {
    display: flex;
    flex-direction: column;
  }

  .post-card-media {
    display: block;
  }

  .post-card-title {
    color: inherit;
    text-decoration: none;
  }

  .post-card-title:hover,
  .post-card-title:focus-visible {
    text-decoration: underline;
  }

  .blog-grid .post-card-link {
    margin-top: auto;
  }

  .check-list {
    padding-left: 1.2rem;
    line-height: 1.7;
  }

  .decision-tool {
    display: grid;
    gap: 16px;
  }

  .decision-tool label {
    display: grid;
    gap: 7px;
    font-weight: 800;
  }

  fieldset {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  legend {
    padding: 0 6px;
    font-weight: 800;
  }

  fieldset label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
  }

  .storm-row,
  .alert-row {
    padding: 14px;
    box-shadow: none;
  }

  .storm-row header,
  .alert-row header {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 12px;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0 9px;
    border-radius: 999px;
    background: #e8f3f5;
    color: var(--ocean);
    font-size: 0.8rem;
    font-weight: 800;
    white-space: nowrap;
  }

  .badge.warn {
    background: #fff3d7;
    color: #8b5a00;
  }

  .badge.danger {
    background: #ffe3de;
    color: #9f2d1f;
  }

  .map-shell {
    min-height: 420px;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background:
      linear-gradient(30deg, rgba(14, 111, 143, 0.14), transparent 45%),
      #dcecef;
  }

  .map-shell::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, transparent 0 37%, rgba(47, 125, 79, 0.5) 38% 41%, transparent 42%),
      radial-gradient(circle at 72% 45%, rgba(193, 68, 46, 0.26) 0 9%, transparent 10%),
      radial-gradient(circle at 58% 62%, rgba(201, 137, 26, 0.22) 0 14%, transparent 15%);
  }

  .map-label {
    position: absolute;
    left: 18px;
    bottom: 18px;
    right: 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    padding: 12px;
    margin-bottom: 16px;
  }

  /* --- Live Decision Dashboard (homepage) --- */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .dashboard-band .inner {
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 2vw, 22px);
  }

  .dashboard-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
  }

  .dashboard-header .eyebrow {
    margin-bottom: 6px;
  }

  .dashboard-header h2 {
    margin: 0;
  }

  .dashboard-toolbar {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .select-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .select-wrap > i {
    position: absolute;
    left: 11px;
    color: var(--ocean);
    font-size: 0.85rem;
    pointer-events: none;
  }

  .select-wrap select {
    padding-left: 30px;
    min-height: 38px;
    border-radius: 999px;
    border-color: var(--line);
  }

  .dashboard-toolbar button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    min-height: 38px;
    padding: 0;
    border-radius: 50%;
    background: var(--ocean);
    color: #fff;
    border: none;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .dashboard-toolbar button:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(14, 111, 143, 0.35);
  }

  .feed-status {
    font-size: 0.85rem;
    color: var(--muted);
  }

