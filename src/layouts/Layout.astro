---
import Disclaimer from "../components/Disclaimer.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SEO from "../components/SEO.astro";
import { site } from "../data/site";

type Props = {
  title: string;
  description: string;
  canonical?: string;
  jsonLd?: object;
  lastModified?: string;
  image?: string;
  showTopAd?: boolean;
  showBottomAd?: boolean;
};

const {
  title,
  description,
  canonical = Astro.url.href,
  jsonLd,
  lastModified,
  image,
  showTopAd = false,
  showBottomAd = false
} = Astro.props;
const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO
      title={pageTitle}
      description={description}
      canonical={canonical}
      siteName={site.name}
      jsonLd={jsonLd}
      lastModified={lastModified}
      image={image}
    />
    <link rel="manifest" href="/manifest.webmanifest" />
  </head>
  <body>
    <Header />
    <Disclaimer />
    {showTopAd && <div class="ad-slot ad-slot-top"><!-- AD SLOT 1: 728x90 Desktop / 320x100 Mobile --></div>}
    <main>
      <slot />
      {showBottomAd && <div class="ad-slot ad-slot-bottom"><!-- AD SLOT 2: 300x250 Rectangle --></div>}
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --ink: #17212b;
    --muted: #5b6670;
    --line: #d7dde2;
    --panel: #ffffff;
    --surface: #f4f7f8;
    --ocean: #0e6f8f;
    --signal: #c1442e;
    --amber: #c9891a;
    --green: #2f7d4f;
    --navy: #20384d;
    --shadow: 0 18px 50px rgba(23, 33, 43, 0.12);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--surface);
    color: var(--ink);
  }

  a {
    color: inherit;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 14px clamp(18px, 4vw, 56px);
    border-bottom: 1px solid var(--line);
    background: rgba(244, 247, 248, 0.94);
    backdrop-filter: blur(14px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 800;
    letter-spacing: 0;
  }

  .brand-mark {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background:
      radial-gradient(circle at 62% 38%, #fff 0 12%, transparent 13%),
      conic-gradient(from 210deg, var(--ocean), #74b7c9, var(--signal), var(--ocean));
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.7);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: flex-end;
  }

  nav a {
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    padding: 0 12px;
    border-radius: 6px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.94rem;
    font-weight: 700;
  }

  nav a:hover,
  nav a:focus-visible {
    background: #e7eef1;
    color: var(--ink);
  }

  .disclaimer {
    background: linear-gradient(90deg, #d47b08, #b9481f);
    color: #fff;
    padding: 12px clamp(18px, 4vw, 56px);
    font-weight: 800;
  }

  .disclaimer p {
    width: min(1180px, 100%);
    margin: 0 auto;
    line-height: 1.5;
  }

  .disclaimer a {
    color: #fff;
    text-decoration-thickness: 2px;
  }

  .ad-slot {
    width: min(1180px, calc(100% - 36px));
    margin: 16px auto;
    border: 1px dashed #b8c0c7;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.6);
  }

  .ad-slot-top {
    min-height: 90px;
  }

  .ad-slot-bottom,
  .ad-slot-incontent {
    min-height: 250px;
  }

  .ad-slot-compact {
    min-height: 0;
    height: 1px;
    margin: 24px 0;
    opacity: 0.55;
  }

  main {
    min-height: 75vh;
  }

  section,
  article {
    scroll-margin-top: 88px;
  }

  .band {
    padding: clamp(34px, 6vw, 76px) clamp(18px, 4vw, 56px);
  }

  .inner {
    width: min(1180px, 100%);
    margin: 0 auto;
  }

  .hero {
    min-height: calc(100vh - 122px);
    display: grid;
    align-items: center;
    background:
      linear-gradient(90deg, rgba(10, 30, 45, 0.9), rgba(14, 111, 143, 0.58)),
      url("https://images.unsplash.com/photo-1527482797697-8795b05a13fe?auto=format&fit=crop&w=1800&q=80");
    background-size: cover;
    background-position: center;
    color: #fff;
    padding-bottom: min(10vh, 80px);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(300px, 0.95fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: end;
  }

  .eyebrow {
    margin: 0 0 10px;
    text-transform: uppercase;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    font-weight: 800;
    color: #a6dae8;
  }

  h1,
  h2,
  h3 {
    margin: 0;
    line-height: 1.06;
    letter-spacing: 0;
  }

  h1 {
    max-width: 760px;
    font-size: clamp(2.6rem, 7vw, 5.8rem);
  }

  h2 {
    font-size: clamp(1.8rem, 4vw, 3.2rem);
  }

  h3 {
    font-size: 1.08rem;
  }

  p {
    line-height: 1.65;
  }

  .answer {
    max-width: 760px;
    margin: 20px 0 0;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
  }

  .toolbar,
  .panel,
  .metric,
  .alert-row,
  .storm-row,
  .faq-item,
  .post-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 1px 0 rgba(23, 33, 43, 0.04);
  }

  .hero .panel,
  .hero .metric {
    background: rgba(255, 255, 255, 0.92);
    color: var(--ink);
  }

  .dashboard {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .metric {
    min-height: 116px;
    padding: 16px;
  }

  .metric strong {
    display: block;
    font-size: clamp(1.7rem, 4vw, 2.6rem);
    line-height: 1;
  }

  .metric span,
  .source-note,
  .small {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .grid-2,
  .grid-3 {
    display: grid;
    gap: 18px;
  }

  .grid-2 {
    grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr);
  }

  .grid-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .panel,
  .post-card {
    padding: clamp(18px, 3vw, 28px);
  }

  .post-image,
  .article-hero-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #dcecef;
  }

  .post-image {
    margin: 0 0 16px;
  }

  .article-hero-image {
    margin-top: 28px;
    box-shadow: var(--shadow);
  }

  .panel h2,
  .post-card h2 {
    font-size: clamp(1.35rem, 2.2vw, 2rem);
  }

  .article-grid {
    align-items: start;
  }

  .article-grid > aside {
    align-self: start;
  }

  .stack {
    display: grid;
    gap: 14px;
  }

  .check-list {
    padding-left: 1.2rem;
    line-height: 1.7;
  }

  .decision-tool {
    display: grid;
    gap: 16px;
  }

  .decision-tool label {
    display: grid;
    gap: 7px;
    font-weight: 800;
  }

  fieldset {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  legend {
    padding: 0 6px;
    font-weight: 800;
  }

  fieldset label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
  }

  .storm-row,
  .alert-row {
    padding: 14px;
    box-shadow: none;
  }

  .storm-row header,
  .alert-row header {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 12px;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0 9px;
    border-radius: 999px;
    background: #e8f3f5;
    color: var(--ocean);
    font-size: 0.8rem;
    font-weight: 800;
    white-space: nowrap;
  }

  .badge.warn {
    background: #fff3d7;
    color: #8b5a00;
  }

  .badge.danger {
    background: #ffe3de;
    color: #9f2d1f;
  }

  .map-shell {
    min-height: 420px;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background:
      linear-gradient(30deg, rgba(14, 111, 143, 0.14), transparent 45%),
      #dcecef;
  }

  .map-shell::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, transparent 0 37%, rgba(47, 125, 79, 0.5) 38% 41%, transparent 42%),
      radial-gradient(circle at 72% 45%, rgba(193, 68, 46, 0.26) 0 9%, transparent 10%),
      radial-gradient(circle at 58% 62%, rgba(201, 137, 26, 0.22) 0 14%, transparent 15%);
  }

  .map-label {
    position: absolute;
    left: 18px;
    bottom: 18px;
    right: 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    padding: 12px;
    margin-bottom: 16px;
  }

  select,
  button,
  input,
  textarea {
    min-height: 40px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: #fff;
    color: var(--ink);
    padding: 0 12px;
    font: inherit;
    font-weight: 700;
  }

  button {
    background: var(--ocean);
    color: #fff;
    cursor: pointer;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  th,
  td {
    padding: 13px 10px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  th {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .faq-item {
    padding: 18px;
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 18px;
    padding: 28px clamp(18px, 4vw, 56px);
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  .site-footer p {
    margin: 0;
    max-width: 820px;
  }

  .footer-links {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  @media (max-width: 860px) {
    .site-header,
    .hero-grid,
    .grid-2,
    .grid-3 {
      grid-template-columns: 1fr;
    }

    .site-header {
      position: static;
      align-items: flex-start;
      display: grid;
    }

    nav {
      justify-content: flex-start;
    }

    .dashboard {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .dashboard {
      grid-template-columns: 1fr;
    }

    h1 {
      font-size: 2.45rem;
    }

    .hero {
      min-height: auto;
    }
  }
</style>
