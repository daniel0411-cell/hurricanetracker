---
import Layout from "./Layout.astro";

type Props = {
  title: string;
  description: string;
  canonical?: string;
  jsonLd?: object;
  lastModified?: string;
  image?: string;
  ogImage?: string;
};

const { title, description, canonical, jsonLd, lastModified, image, ogImage } = Astro.props;
---
<Layout title={title} description={description} canonical={canonical} jsonLd={jsonLd} lastModified={lastModified} image={image} ogImage={ogImage}>
  <slot />
</Layout>
