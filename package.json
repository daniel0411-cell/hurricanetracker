{
  "name": "hurricanehub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "verify:city-data": "node scripts/verify-city-data.mjs",
    "verify:official-resources": "node scripts/verify-official-resources.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "metadata:audit": "node scripts/metadata-audit.mjs",
    "seo:opportunities": "node scripts/seo-opportunity-report.mjs",
    "seo:keywords": "node scripts/keyword-coverage-report.mjs",
    "links:audit": "node scripts/internal-link-audit.mjs",
    "rss:audit": "node scripts/rss-audit.mjs",
    "coverage:audit": "node scripts/coverage-audit.mjs",
    "schema:audit": "node scripts/schema-audit.mjs",
    "faq:audit": "node scripts/faq-audit.mjs",
    "content:audit": "node scripts/content-audit.mjs",
    "media:audit": "node scripts/media-audit.mjs",
    "search:audit": "node scripts/search-audit.mjs",
    "seo:full": "npm run build && npm run seo:audit && npm run metadata:audit && npm run seo:opportunities && npm run seo:keywords && npm run schema:audit && npm run links:audit && npm run rss:audit && npm run coverage:audit && npm run faq:audit && npm run content:audit && npm run media:audit && npm run search:audit",
    "prebuild": "npm run verify:city-data && node scripts/gen-og.mjs",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 WRANGLER_LOG_PATH=.wrangler/logs astro dev --host 127.0.0.1",
    "build": "ASTRO_TELEMETRY_DISABLED=1 WRANGLER_LOG_PATH=.wrangler/logs astro build",
    "check": "ASTRO_TELEMETRY_DISABLED=1 WRANGLER_LOG_PATH=.wrangler/logs astro check",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 WRANGLER_LOG_PATH=.wrangler/logs astro preview --host 127.0.0.1",
    "astro": "ASTRO_TELEMETRY_DISABLED=1 WRANGLER_LOG_PATH=.wrangler/logs astro",
    "indexnow": "node scripts/indexnow-submit.mjs",
    "gindex": "node scripts/gindex-submit.mjs",
    "indexall": "node scripts/indexnow-submit.mjs && node scripts/gindex-submit.mjs",
    "verify:seo": "node scripts/verify-seo-endpoints.mjs",
    "deploy": "wrangler deploy --config wrangler.deploy.toml && node scripts/verify-seo-endpoints.mjs && (node scripts/indexnow-submit.mjs || true) && (node scripts/gindex-submit.mjs || true)",
    "deploy:monitor": "wrangler deploy --config wrangler.monitor.toml",
    "ship": "node scripts/ship.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/cloudflare": "^14.2.1",
    "astro": "^7.2.1",
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260813.1",
    "@resvg/resvg-js": "^2.6.2",
    "wrangler": "^4.122.0"
  }
}
